#!/bin/bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Data-loss guard (runs first, < 50ms, NOT skippable) ──────────
# Catches files corrupted by lean-ctx shadow-mode compression markers.
# These appear when an edit tool reads through ctx_read and writes the
# compressed output back as file content. See: #1301, #1302
# Rust sources are scanned too (light mode runs no clippy that would catch a
# marker in a comment or string). For them only the lines the commit adds
# count, so marker literals that already exist in detector code never block,
# and these detector/fixture files are exempt by name because their job is to
# contain such literals. Add a file here only when it must spell a marker.
MARKER_DETECTOR_FILES=(
    rust/build.rs
    rust/crates/lean-ctx-compress/src/markdown_compact.rs
    rust/crates/lean-ctx-hooks/src/hook_handlers/deny.rs
    rust/crates/lean-ctx-hooks/src/hook_handlers/edit_health.rs
    rust/crates/lean-ctx-server/src/tools/ctx_read/tests_compression.rs
    rust/src/core/bypass_hint.rs
    rust/src/core/entropy.rs
    rust/src/core/entropy_omission.rs
)
# Prints the staged text the marker checks judge: the whole staged file, or
# for Rust sources only the added lines. Returns 1 for exempt files.
marker_scan_text() {
    local file="$1" exempt
    case "$file" in
        *.githooks/*|*tests/*) return 1 ;;
        *.rs)
            for exempt in "${MARKER_DETECTOR_FILES[@]}"; do
                [ "$file" = "$exempt" ] && return 1
            done
            git diff --cached --no-color --no-ext-diff --no-textconv -U0 -- "$file" 2>/dev/null \
                | sed -n -e '/^+++ /d' -e 's/^+//p'
            ;;
        *) git show ":$file" 2>/dev/null ;;
    esac
}

marker_hits=""
while IFS= read -r file; do
    scan=$(marker_scan_text "$file") || continue
    if grep -qF -- '[lean-ctx: omitted' <<<"$scan"; then
        marker_hits="$marker_hits  - $file"$'\n'
    fi
done < <(git diff --cached --name-only --diff-filter=d)

if [ -n "$marker_hits" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  BLOCKED: lean-ctx compression markers in staged files     ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║                                                            ║"
    echo "║  These files contain '[lean-ctx: omitted N lines]' text    ║"
    echo "║  that was written by a corrupted edit tool read.           ║"
    echo "║                                                            ║"
    echo "║  Fix: restore from the last clean commit:                  ║"
    echo "║    LEAN_CTX_DISABLED=1 git restore --source=HEAD -- <file> ║"
    echo "║                                                            ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "Affected files:"
    echo "$marker_hits"
    exit 1
fi

# Also catch the ctx_compose footer marker and build_header corruption (#1323)
while IFS= read -r file; do
    staged=$(marker_scan_text "$file") || continue
    if grep -qF -- '--- lean-ctx:' <<<"$staged"; then
        echo "pre-commit: BLOCKED — '$file' contains lean-ctx footer marker."
        echo "  Fix: LEAN_CTX_DISABLED=1 git restore --source=HEAD -- $file"
        exit 1
    fi
    # Detect ctx_read build_header corruption: "filename.ext NNL" on first line
    # (always judged on the whole staged file: the header sits at its top).
    head_lines=$(git show ":$file" 2>/dev/null | head -2) || true
    if printf '%s\n' "$head_lines" | head -1 | grep -qE '^[^ ]+\.[a-z]+ [0-9]+L$'; then
        if printf '%s\n' "$head_lines" | sed -n '2p' | grep -qE '^ (deps|exports) '; then
            echo "pre-commit: BLOCKED — '$file' contains ctx_read header corruption."
            echo "  Fix: LEAN_CTX_DISABLED=1 git restore --source=HEAD -- $file"
            exit 1
        fi
    fi
    # Detect cognitive/signatures mode section markers (#1444)
    for section in '§ function' '§ block' '§ impl'; do
        if grep -qF -- "$section" <<<"$staged"; then
            echo "pre-commit: BLOCKED — '$file' contains §-section markers (cognitive mode corruption)."
            echo "  Fix: LEAN_CTX_DISABLED=1 git restore --source=HEAD -- $file"
            exit 1
        fi
    done
done < <(git diff --cached --name-only --diff-filter=d)

# ── Rust quality checks ──────────────────────────────────────────
# Change-aware: cargo only runs when the staged diff can change what Rust
# compiles — anything under rust/ or packages/ (workspace members), or a
# deletion/rename anywhere (include_str!/include_bytes! reach repo-root files).
# Docs-, CI-, script- and skill-only commits skip the cargo steps; CI still
# runs the full matrix. Force them with PRECOMMIT_FORCE_CARGO=1.
staged_names=$(git diff --cached --name-only)
staged_removed=$(git diff --cached --name-only --diff-filter=DR)
if [ "${PRECOMMIT_FORCE_CARGO:-0}" != "1" ] \
    && ! printf '%s\n' "$staged_names" | grep -qE '^(rust|packages)/' \
    && [ -z "$staged_removed" ]; then
    echo "pre-commit: no Rust-relevant files staged — skipping cargo checks."
    exit 0
fi

# Tree stamp: `make precommit-check` runs these checks before the commit; the
# commit's own hook then skips them when the staged tree is the one checked.
# Cargo checks the working tree, so a stamp is only written (and only trusted)
# when rust/ and packages/ have no unstaged changes against the index.
STAMP="$(git rev-parse --git-path lean-ctx-precommit.stamp)"
staged_tree=$(git write-tree)
rust_matches_index() { git diff --quiet -- rust packages; }
if [ "${PRECOMMIT_FORCE_CARGO:-0}" != "1" ] && rust_matches_index \
    && [ "$(cat "$STAMP" 2>/dev/null)" = "$staged_tree" ]; then
    echo "pre-commit: staged tree ${staged_tree:0:12} already passed the checks — skipping cargo."
    exit 0
fi
stamp_ok=0
rust_matches_index && stamp_ok=1

cd "$REPO_ROOT/rust"

# Each step prints a progress line and logs to its own file, so long clippy
# runs are visibly alive and a failure shows the real compiler output instead
# of a bare "check failed".
LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/lean-ctx-precommit.XXXXXX")"
run_step() {
    local label="$1" hint="$2" log started
    shift 2
    log="$LOG_DIR/$(printf '%s' "$label" | tr -c 'a-zA-Z0-9' '_').log"
    started=$SECONDS
    echo "pre-commit: ▸ $label ..."
    if ! "$@" >"$log" 2>&1; then
        echo "pre-commit: ✗ $label failed after $((SECONDS - started))s. $hint"
        echo "──── last 80 lines of $log ────"
        tail -n 80 "$log"
        exit 1
    fi
    echo "pre-commit: ✓ $label ($((SECONDS - started))s)"
}

run_step "cargo fmt --check" "Run 'cargo fmt' first." \
    cargo fmt --check

# Light mode (owner decision 2026-11-19): on agent/feature branches the heavy
# cargo gates (clippy, gen_docs, testbench) run once on pounce, in the MR CI or
# the Weave check service, not on every local commit. A shared Mac target lock
# made each commit wait 1-3 h. MRs are undrafted and landed only on a green check.
# Full local gates: LEANCTX_HOOKS=full git commit ...  Always full on main and
# on a detached HEAD (release checkouts, commits on a tag or a main tip).
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [[ "${LEANCTX_HOOKS:-light}" != "full" && -n "$branch" && "$branch" != "main" ]]; then
    echo "pre-commit: light mode (fmt + marker checks); clippy/docs run in pounce CI. LEANCTX_HOOKS=full for local gates."
    exit 0
fi

# Production code: strict — unwrap_used is DENIED. --all-features matches the
# CI Clippy job and preflight.sh, so the pre-push clippy step reuses these
# check artifacts instead of compiling a second feature set.
run_step "clippy (production)" "Fix warnings before committing." \
    cargo clippy --all-features --lib --bins --examples -- -D warnings -A clippy::too_many_lines

# Test code: unwrap() and is_empty() assertions are intentional test idioms.
test_clippy_args=(-A clippy::too_many_lines -A clippy::unwrap_used)
# This pedantic style lint was added in Clippy 1.98. Detect it so older toolchains
# do not fail on an unknown lint; keep the production check above strict.
if clippy-driver -W help 2>/dev/null | grep -F 'clippy::assert-is-empty' >/dev/null; then
    test_clippy_args+=(-A clippy::assert_is_empty)
fi
# Same feature set as the production step, so dependencies and build scripts are
# compiled once for both steps; only the lean-ctx test crates are checked again.
run_step "clippy (tests)" "Fix warnings before committing." \
    cargo clippy --all-features --tests -- -D warnings "${test_clippy_args[@]}"

# Generated reference docs must match the tool/config definitions —
# the CI Documentation job runs the same check and fails otherwise.
if printf '%s\n' "$staged_names" | grep -qE '^rust/src/(tools|tool_defs|core/config)'; then
    run_step "generated docs" "Run: cd rust && cargo run -p lean-ctx-server --example gen_docs --features dev-tools" \
        cargo run -p lean-ctx-server --quiet --example gen_docs --features dev-tools -- --check
fi

rm -rf "$LOG_DIR"

cd "$REPO_ROOT"
if [ "$stamp_ok" = 1 ] && rust_matches_index && [ "$(git write-tree)" = "$staged_tree" ]; then
    printf '%s\n' "$staged_tree" >"$STAMP"
fi
