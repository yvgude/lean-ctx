# ── Generated / worktrees (local) ──
website/
.worktrees/
# Per-worktree CARGO_TARGET_DIR. Parallel worktrees need their own target dir to
# avoid fighting over one build lock; `target/` above does not match it (the name
# only contains "target", it does not end in it), so these trees were untracked
# but not ignored — ~25k artifacts one `git add -A` away from a commit, and
# counted as "changed files" by preflight's change classification.
.ctarget/
target-wt*/
# Machine-local build tuning (rust/scripts/setup-fast-build.sh: linker, sccache).
# The shared `cargo fast` alias is tracked in rust/.cargo/config.toml.
/.cargo/config.toml
AGENTS.md.lean-ctx.*.bak
docs/gpt/

# ── Internal strategy (never public) ──
/THINKERY-VISION.md
/packages/jetbrains-lean-ctx/build/

# ── Local AI-tooling / scratch dirs (not for OSS) ──
/tmp/
tmp/
markdownai/
.idea/
.serena/
.claude/*
# Share only this portable skill link; machine settings and worktrees stay private.
!.claude/skills/
.claude/skills/*
!.claude/skills/leanctx-gateway-delivery
*.kt
# Keep imported SDK build inputs visible in the consolidated checkout.
!/sdk/packages/typescript/package-lock.json
!/sdk/packages/jvm/src/**/*.kt
# Reviewed product build inputs; per-installation suite.toml stays ignored.
!/ee/governance/docker-compose.yml
!/ee/services/cloud/docker-compose.yml
!/ee/governance/admin/package-lock.json
!/ee/governance/dashboard/package-lock.json
!/ee/governance/portal/package-lock.json
!/ee/governance/apps/console/package-lock.json

