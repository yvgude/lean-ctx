{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict.schema.json",
  "title": "LeanCTX Team Context Conflict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "conflict_id",
    "scope",
    "left_object_id",
    "left_digest",
    "right_object_id",
    "right_digest",
    "detected_at",
    "state",
    "resolution_policy",
    "version",
    "idempotency_key"
  ],
  "properties": {
    "v": { "const": 1 },
    "conflict_id": { "$ref": "common.schema.json#/$defs/id" },
    "scope": { "$ref": "common.schema.json#/$defs/scope" },
    "left_object_id": { "$ref": "common.schema.json#/$defs/id" },
    "left_digest": { "$ref": "common.schema.json#/$defs/recordDigest" },
    "right_object_id": { "$ref": "common.schema.json#/$defs/id" },
    "right_digest": { "$ref": "common.schema.json#/$defs/recordDigest" },
    "detected_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "state": { "enum": ["open", "resolved", "superseded"] },
    "resolution_policy": {
      "enum": ["manual_authority", "newer_valid_authority", "explicit_supersession"]
    },
    "resolved_by": { "$ref": "common.schema.json#/$defs/memberId" },
    "resolved_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "winner": {
      "description": "The winning branch, and the only representation of the winner. The winning object digest is read from left_digest or right_digest accordingly; there is deliberately no winner_digest field, so a third, unrelated digest cannot be recorded as the winner even by an implementation that skips cross-field validation.",
      "enum": ["left", "right"]
    },
    "reason_code": { "$ref": "common.schema.json#/$defs/reasonCode" },
    "superseded_by": {
      "$ref": "common.schema.json#/$defs/recordDigest",
      "description": "Cross-object supersession: record digest of the conflict record that replaced this one."
    },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "parent_digest": { "$ref": "common.schema.json#/$defs/recordDigest" },
    "idempotency_key": { "$ref": "common.schema.json#/$defs/idempotencyKey" }
  },
  "allOf": [
    { "$ref": "common.schema.json#/$defs/casLineage" },
    {
      "if": {
        "properties": { "state": { "const": "resolved" } },
        "required": ["state"]
      },
      "then": {
        "required": ["resolved_by", "resolved_at", "winner", "reason_code"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["resolved_by"] },
            { "required": ["resolved_at"] },
            { "required": ["winner"] },
            { "required": ["reason_code"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "superseded" } },
        "required": ["state"]
      },
      "then": { "required": ["superseded_by"] },
      "else": { "not": { "required": ["superseded_by"] } }
    }
  ]
}
