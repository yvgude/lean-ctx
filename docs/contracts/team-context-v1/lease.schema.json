{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lease.schema.json",
  "title": "LeanCTX Team Access Lease v1",
  "description": "Short-lived, revocable grant derived from an active membership and role binding. Makes the architecture's 'revocation invalidates active leases without erasing history' representable: revocation writes a new lease version with state 'revoked' and retains the whole lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "lease_id",
    "scope",
    "member_id",
    "membership_digest",
    "role_binding_digest",
    "role",
    "granted_by",
    "granted_at",
    "expires_at",
    "state",
    "version",
    "idempotency_key"
  ],
  "properties": {
    "v": { "const": 1 },
    "lease_id": { "$ref": "common.schema.json#/$defs/id" },
    "scope": { "$ref": "common.schema.json#/$defs/scope" },
    "member_id": { "$ref": "common.schema.json#/$defs/memberId" },
    "membership_digest": {
      "$ref": "common.schema.json#/$defs/recordDigest",
      "description": "Record digest of the exact same-scope membership version this lease was derived from. Revoking that membership invalidates every lease naming it."
    },
    "role_binding_digest": {
      "$ref": "common.schema.json#/$defs/recordDigest",
      "description": "Record digest of the exact same-scope workspace-role version whose allowed_actions bound this lease."
    },
    "role": { "$ref": "common.schema.json#/$defs/role" },
    "granted_by": { "$ref": "common.schema.json#/$defs/memberId" },
    "granted_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp",
      "description": "Exclusive end of the lease. Must be strictly greater than granted_at."
    },
    "state": { "enum": ["active", "released", "revoked", "expired"] },
    "released_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "revoked_by": { "$ref": "common.schema.json#/$defs/memberId" },
    "revoked_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "revocation_reason_code": { "$ref": "common.schema.json#/$defs/reasonCode" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "parent_digest": { "$ref": "common.schema.json#/$defs/recordDigest" },
    "idempotency_key": { "$ref": "common.schema.json#/$defs/idempotencyKey" }
  },
  "allOf": [
    { "$ref": "common.schema.json#/$defs/casLineage" },
    {
      "if": {
        "properties": { "state": { "const": "revoked" } },
        "required": ["state"]
      },
      "then": { "required": ["revoked_by", "revoked_at", "revocation_reason_code"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["revoked_by"] },
            { "required": ["revoked_at"] },
            { "required": ["revocation_reason_code"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "released" } },
        "required": ["state"]
      },
      "then": { "required": ["released_at"] },
      "else": { "not": { "required": ["released_at"] } }
    }
  ]
}
