{
  "case": "restore_missing_target",
  "description": "restore of a node that does not exist",
  "base": "events/restore.json",
  "patch": [
    {
      "op": "replace",
      "path": "/target",
      "value": "n_zzzzzzzzzzzzzzzzzzzzzzzzza"
    }
  ],
  "resign_with": "instance_a",
  "expect": {
    "layer": "target_state",
    "code": "invalid_event",
    "reason": "target_state"
  }
}
