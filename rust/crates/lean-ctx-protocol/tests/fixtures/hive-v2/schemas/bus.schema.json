    "frame": {
      "description": "One WebSocket text frame: members of the frame body plus the discriminator t (flat, as in C0 1.x).",
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "enum": [
            "hello",
            "hello.ack",
            "place.publish",
            "message.stored",
            "message.deliver",
            "presence.update",
            "control",
            "place.denied",
            "resync",
            "lease.granted",
            "lease.renewed",
            "lease.released",
            "lease.expired",
            "log.advanced",
            "trust.advanced",
            "need.match",
            "swarm.event",
            "consent.answered",
            "error",
            "ping",
            "pong"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "t": {
                "const": "hello"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_hello"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "hello.ack"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_hello_ack"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "place.publish"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/publish_fields"
              }
            ],
            "required": [
              "worker_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "message.stored"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_message_stored"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "message.deliver"
              }
            }
          },
          "then": {
            "allOf": [
              {
                "$ref": "#/$defs/message_fields"
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "presence.update"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_presence_update"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "control"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_control"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "place.denied"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_place_denied"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "resync"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_resync"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "enum": [
                  "lease.granted",
                  "lease.renewed",
                  "lease.released",
                  "lease.expired"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_lease"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "log.advanced"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_log_advanced"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "trust.advanced"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_trust_advanced"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "need.match"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_need_match"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "swarm.event"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_swarm_event"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "consent.answered"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_consent_answered"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "const": "error"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_error"
          }
        },
        {
          "if": {
            "properties": {
              "t": {
                "enum": [
                  "ping",
                  "pong"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/f_ping"
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "f_hello": {
      "required": [
        "protocol",
        "subscribe",
        "cursors",
        "presence"
      ],
      "properties": {
        "protocol": {
