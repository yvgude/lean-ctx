    },
    "f_error": {
      "description": "error frame; a quota_exceeded refusal names the quota like the HTTP body (API.md §8.1): resource, limit, used, reset_at (RFC 3339, when the month resets or a cooling-down slot frees; null otherwise) and, for a monthly resource, retry_after_s",
      "required": [
        "code"
      ],
      "properties": {
        "client_msg_id": {
          "$ref": "#/$defs/ulid"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "resource": {
          "enum": [
            "registered_engines",
            "connected_engines",
            "private_vaults",
            "storage_bytes",
            "transfer_bytes",
            "bus_messages"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "reset_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_s": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "code": {
            "const": "quota_exceeded"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "required": [
          "resource",
          "limit",
          "used",
          "reset_at"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "resource"
              ]
            },
            {
              "required": [
                "limit"
              ]
            },
            {
              "required": [
                "used"
              ]
            },
            {
              "required": [
                "reset_at"
              ]
            }
          ]
        }
      }
    },
    "f_ping": {
      "properties": {}
    },
    "publish_response": {
      "description": "E17 201 body",
      "type": "object",
      "required": [
        "id",
        "seq",
        "thread_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/msg_id"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "thread_id": {
          "$ref": "common.schema.json#/$defs/msg_id"
        }
      }
    },
    "history_response": {
      "description": "E16; a message whose key is gone is returned purged without body (R52)",
      "type": "object",
      "required": [
        "items",
        "next_before"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/message"
              },
              {
                "$ref": "#/$defs/purged_message"
              }
            ]
          }
        },
        "next_before": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "purged_message": {
      "type": "object",
      "required": [
        "id",
        "seq",
        "thread_id",
        "type",
        "purged"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/msg_id"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "thread_id": {
          "$ref": "common.schema.json#/$defs/msg_id"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "received_at": {
          "$ref": "common.schema.json#/$defs/ms"
        },
        "purged": {
          "const": true
        }
      }
    },
    "poll_response": {
      "description": "E15 GET /v1/bus/poll: v2 frames as a JSON list",
      "type": "object",
      "required": [
        "frames",
        "cursor"
      ],
      "additionalProperties": false,
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
