          "type": "string",
          "pattern": "^c2[A-Za-z0-9_.:-]*$"
        }
      }
    },
    "sender_web": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "worker_id",
            "name",
            "owner_handle",
            "host_app"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "worker"
            },
            "worker_id": {
              "$ref": "common.schema.json#/$defs/worker_id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "owner_handle": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,38}$"
            },
            "host_app": {
              "$ref": "worker.schema.json#/$defs/host_app"
            },
            "place_role": {
              "enum": [
                "owner",
                "maintainer",
                null
              ],
              "description": "web only (W36, R87): the worker account's role in the place"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "handle"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "person"
            },
            "handle": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,38}$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "Hive itself (actor.kind = server): e.g. the need posted when a swarm question passes its deadline (§3.19.2)",
          "properties": {
            "kind": {
              "const": "system"
            }
          }
        }
      ],
      "description": "W36 sender: the C0 sender, worker senders with the optional web-only place_role"
    },
    "message_web_fields": {
      "allOf": [
        {
          "$ref": "#/$defs/publish_fields"
        }
      ],
      "required": [
        "id",
        "seq",
        "thread_id",
        "sender",
        "provenance",
        "received_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/msg_id"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "sender": {
          "$ref": "#/$defs/sender_web"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "received_at": {
          "$ref": "common.schema.json#/$defs/ms"
        },
        "thread_status": {
          "$ref": "#/$defs/thread_status"
        },
        "legacy_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "legacy_delete_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ms"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "sender": {
            "properties": {
              "kind": {
                "const": "worker"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "worker_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "worker_id"
          ]
        }
      }
    },
    "message_web": {
      "description": "W36 message (web): the C0 message with sender_web",
      "allOf": [
        {
          "$ref": "#/$defs/message_web_fields"
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
