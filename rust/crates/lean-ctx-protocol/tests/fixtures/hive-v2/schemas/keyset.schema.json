{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.leanctx.com/hive-v2/schemas/keyset.schema.json",
  "title": "E13 GET /v1/keys key set v3 (RESOLUTIONS R55 as amended by R103: no min_image_version, no revoked_image_keys in 3.12.0)",
  "$defs": {
    "purpose": {
      "enum": [
        "policy",
        "event",
        "snapshot",
        "revocation",
        "consent",
        "control",
        "purge"
      ]
    },
    "keyset": {
      "type": "object",
      "required": [
        "schema",
        "keys",
        "signatures",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "leanctx.hive.keyset/v3"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key_id",
              "public_key",
              "purposes",
              "created_at",
              "revoked_at"
            ],
            "additionalProperties": false,
            "properties": {
              "key_id": {
                "$ref": "common.schema.json#/$defs/key_id"
              },
              "public_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$",
                "description": "base64url of the raw 32-byte Ed25519 key"
              },
              "purposes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/purpose"
                }
              },
              "created_at": {
                "$ref": "common.schema.json#/$defs/ms"
              },
              "revoked_at": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/ms"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "hex Ed25519 by each hosted root over \"leanctx.hive.keyset.v3\\n\" ‖ canonical_json({schema, keys}); old and new root from release day",
          "items": {
            "type": "object",
            "required": [
              "key_id",
              "signature"
            ],
            "additionalProperties": false,
            "properties": {
              "key_id": {
                "$ref": "common.schema.json#/$defs/key_id"
              },
              "signature": {
                "$ref": "common.schema.json#/$defs/signature"
              }
            }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "description": "legacy: standard base64 Ed25519 by the old root over \"leanctx.hive.keyset.v1\\n\" ‖ canonical_json(key set without signature), the C0 1.x rule"
        }
      }
    },
    "keyset_v1": {
      "description": "the C0 1.x key set, served unchanged to instances that send Hive-Protocol 1.x (byte copy of contracts/hive-v1/fixtures/keyset.response.json)",
      "type": "object",
      "required": [
        "schema",
        "keys",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "leanctx.hive.keyset/v1"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kid",
              "ed25519_pub",
              "not_after"
            ],
            "additionalProperties": false,
            "properties": {
              "kid": {
                "type": "string"
              },
              "ed25519_pub": {
                "type": "string"
              },
              "not_after": {
                "type": "string"
              }
            }
          }
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "lease_envelope": {
      "description": "lease envelope for 2.x instances: unchanged v1 envelope, kid = the key_id of the key set v3 key with purpose policy; signature = standard base64 Ed25519 over \"leanctx.hive.lease.v1\\n\" ‖ canonical_json(lease); the lease has no policy_signer_keys",
      "type": "object",
      "required": [
        "schema",
        "lease",
        "kid",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "leanctx.hive.lease-envelope/v1"
        },
        "lease": {
          "type": "object"
        },
        "kid": {
          "$ref": "common.schema.json#/$defs/key_id"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "enrollment_for_2x": {
      "description": "POST /v1/device/token answer (EnrollmentV1, leanctx.hive.enrollment/v1) to a Hive-Protocol 2.1+ request: keys is the key set v3 of GET /v1/keys and lease is a 2.x lease envelope whose kid is the key_id of its key with purpose policy; below 2.1 the answer keeps the C0 1.x key set v1 and a v1 lease kid. org.company (a team of a company) and sharing (C0 2.1 device setup) are sent only when they apply",
      "type": "object",
      "required": [
        "schema",
        "instance_id",
        "org",
        "lease",
        "keys",
        "org_salt_id",
        "web_url"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "leanctx.hive.enrollment/v1"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^inst_[0-9a-z]{26,32}$"
        },
        "org": {
          "type": "object",
          "required": [
            "id",
            "name",
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^org_[0-9a-z_]{1,40}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "personal",
                "team"
              ]
            },
            "company": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "lease": {
          "$ref": "#/$defs/lease_envelope"
        },
        "keys": {
          "$ref": "#/$defs/keyset"
        },
        "org_salt_id": {
          "type": "string",
          "pattern": "^salt_[0-9a-z_]{1,40}$"
        },
        "web_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "sharing": {
          "$ref": "device.schema.json#/$defs/enrollment_sharing"
        }
      }
    }
  }
}
