{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.leanctx.com/hive-v2/schemas/link.schema.json",
  "title": ".lean-ctx-hive.json link file",
  "description": "v2 carries the vault address <ws>/<vault>[@<server>]; engines keep reading v1 ({repo: {ns, name}}) as a hosted address ns/name",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "vault"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "leanctx.hive.link/v2"
        },
        "vault": {
          "$ref": "common.schema.json#/$defs/vault_address"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "repo"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "leanctx.hive.link/v1"
        },
        "repo": {
          "type": "object",
          "required": [
            "ns",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "ns": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,38}$"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,40}$"
            }
          }
        }
      }
    }
  ]
}
