{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.leanctx.com/hive-v2/schemas/records.schema.json",
  "title": "Snapshot manifest (E2), segment record stream (E3), tail (E4), trust (E7) (SPEC-CONTRACT-SERVER §3.13, §3.14, RESOLUTIONS R48, R52, R59, R90)",
  "$defs": {
    "manifest": {
      "description": "leanctx.hive.snapshot/v1, signed by the Hive key of purpose snapshot, domain leanctx.hive.snapshot.v1\\n, over the manifest without signature; id_salt only for non-sealed places",
      "type": "object",
      "required": ["schema", "place", "rev", "seq", "epoch", "created_at", "server_time", "segments", "key_id", "signature"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "leanctx.hive.snapshot/v1" },
        "place": { "$ref": "common.schema.json#/$defs/place_ref" },
        "rev": { "type": "integer", "minimum": 1 },
        "seq": { "$ref": "common.schema.json#/$defs/u64" },
        "id_salt": { "$ref": "common.schema.json#/$defs/hex64" },
        "epoch": { "$ref": "common.schema.json#/$defs/u64" },
        "scope": { "type": "string", "pattern": "^subtree:g_[a-z2-7]{26}$", "description": "swarm ad-hoc manifests only" },
        "created_at": { "$ref": "common.schema.json#/$defs/ms" },
        "server_time": { "$ref": "common.schema.json#/$defs/ms" },
        "segments": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["n", "seq_from", "seq_to", "count", "envelope_root"], "additionalProperties": false,
            "properties": {
              "n": { "type": "integer", "minimum": 0 },
              "seq_from": { "type": "integer", "minimum": 1 },
              "seq_to": { "type": "integer", "minimum": 1 },
              "count": { "type": "integer", "minimum": 1 },
              "envelope_root": { "$ref": "common.schema.json#/$defs/hex64" }
            }
          }
        },
        "key_id": { "$ref": "common.schema.json#/$defs/key_id" },
        "signature": { "$ref": "common.schema.json#/$defs/signature" }
      }
    },
    "signed_envelope": {
      "description": "the signed envelope members plus signature (never body, ck_wrapped or server fields)",
      "type": "object", "required": ["schema", "event_id", "place", "op", "key_id", "signature"],
      "not": { "anyOf": [{ "required": ["body"] }, { "required": ["ck_wrapped"] }, { "required": ["seq"] }, { "required": ["review_state"] }] }
    },
    "server_fields": {
      "type": "object", "required": ["seq", "received_at", "provenance", "review_state", "reviewed_by", "batch_id"], "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "received_at": { "$ref": "common.schema.json#/$defs/ms" },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
        "review_state": { "$ref": "common.schema.json#/$defs/review_state" },
        "reviewed_by": { "$ref": "common.schema.json#/$defs/reviewed_by" },
        "review_id": { "$ref": "common.schema.json#/$defs/review_id" },
        "batch_id": { "$ref": "common.schema.json#/$defs/batch_id" },
        "purged": { "type": "boolean" },
        "revoked_signer": { "type": "boolean" },
        "legacy": { "type": "boolean" }
      }
    },
    "leaf": { "$ref": "common.schema.json#/$defs/hex64", "description": "blake3(0x00 ‖ canonical_json(signed envelope))" },
    "record": {
      "description": "one line of the E3 ndjson stream (canonical JSON per line, seq order)",
      "oneOf": [
        { "type": "object", "required": ["seq", "envelope", "server_fields", "body"], "additionalProperties": false,
          "properties": { "seq": { "type": "integer", "minimum": 1 }, "envelope": { "$ref": "#/$defs/signed_envelope" }, "server_fields": { "$ref": "#/$defs/server_fields" }, "body": { "type": "object" } } },
        { "type": "object", "required": ["seq", "envelope", "server_fields", "sealed"], "additionalProperties": false,
          "properties": { "seq": { "type": "integer", "minimum": 1 }, "envelope": { "$ref": "#/$defs/signed_envelope" }, "server_fields": { "$ref": "#/$defs/server_fields" },
            "sealed": { "type": "object", "required": ["ct", "nonce", "ck_wrapped", "epoch"], "additionalProperties": false,
              "properties": { "ct": { "$ref": "common.schema.json#/$defs/base64url" }, "nonce": { "$ref": "common.schema.json#/$defs/hex48" },
                "ck_wrapped": { "$ref": "event.schema.json#/properties/ck_wrapped" }, "epoch": { "$ref": "common.schema.json#/$defs/u32" } } } } },
        { "type": "object", "required": ["seq", "envelope", "server_fields", "purged"], "additionalProperties": false,
          "properties": { "seq": { "type": "integer", "minimum": 1 }, "envelope": { "$ref": "#/$defs/signed_envelope" }, "server_fields": { "$ref": "#/$defs/server_fields" }, "purged": { "const": true } } },
        { "type": "object", "required": ["seq", "withheld", "leaf"], "additionalProperties": false,
          "properties": { "seq": { "type": "integer", "minimum": 1 }, "withheld": { "const": true }, "leaf": { "$ref": "#/$defs/leaf" } } },
        { "type": "object", "required": ["seq", "converted", "leaf"], "additionalProperties": false,
          "properties": { "seq": { "type": "integer", "minimum": 1 }, "converted": { "const": true }, "leaf": { "$ref": "#/$defs/leaf" } } }
      ]
    },
    "segment": {
      "description": "fixture form of an E3 response (application/x-ndjson, zstd): the records in seq order, one per line on the wire",
      "type": "object", "required": ["place", "rev", "n", "records"], "additionalProperties": false,
      "properties": {
        "place": { "$ref": "common.schema.json#/$defs/place_ref" }, "rev": { "type": "integer", "minimum": 1 }, "n": { "type": "integer", "minimum": 0 },
        "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } }
      }
    },
    "tail_event": {
      "description": "an event in E4: the full envelope with server fields (event schema), or the episode summary view, or a key_lost event, or a converted stub",
      "anyOf": [
        { "$ref": "event.schema.json" },
        { "type": "object", "required": ["node_type", "body", "body_omitted"],
          "properties": { "node_type": { "const": "episode" }, "body_omitted": { "const": true },
            "body": { "type": "object", "required": ["summary_view"], "additionalProperties": false,
              "properties": { "summary_view": { "type": "object", "required": ["goal", "outcome", "summary"], "additionalProperties": false,
                "properties": { "goal": { "type": "string" }, "outcome": { "type": "string" }, "summary": { "type": "string" } } } } } } },
        { "type": "object", "required": ["event_id", "body", "key_lost"], "properties": { "body": { "type": "null" }, "key_lost": { "const": true } } },
        { "type": "object", "required": ["seq", "converted"], "additionalProperties": false, "properties": { "seq": { "type": "integer", "minimum": 1 }, "converted": { "const": true } } }
      ]
    },
    "tail_response": {
      "description": "E4 GET /v1/places/{p}/events?since=&limit=&episode_bodies=&trust_since=",
      "type": "object",
      "required": ["events", "withheld", "released", "held_results", "next_since", "head_seq", "trust_rev", "epoch", "server_time"],
      "additionalProperties": false,
      "properties": {
        "events": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/tail_event" } },
        "withheld": { "type": "array", "items": { "type": "object", "required": ["seq"], "additionalProperties": false, "properties": { "seq": { "type": "integer", "minimum": 1 } } } },
        "released": { "type": "array", "items": { "$ref": "event.schema.json" } },
        "held_results": {
          "type": "array", "maxItems": 1000,
          "items": {
            "type": "object", "required": ["event_id", "review_id", "status"], "additionalProperties": false,
            "properties": { "event_id": { "$ref": "common.schema.json#/$defs/event_id" }, "review_id": { "$ref": "common.schema.json#/$defs/review_id" }, "status": { "enum": ["accepted", "rejected"] }, "seq": { "type": "integer", "minimum": 1 } },
            "if": { "properties": { "status": { "const": "accepted" } } }, "then": { "required": ["seq"] }, "else": { "not": { "required": ["seq"] } }
          }
        },
        "next_since": { "$ref": "common.schema.json#/$defs/u64" },
        "head_seq": { "$ref": "common.schema.json#/$defs/u64" },
        "trust_rev": { "$ref": "common.schema.json#/$defs/u64" },
        "epoch": { "$ref": "common.schema.json#/$defs/u64" },
        "server_time": { "$ref": "common.schema.json#/$defs/ms" }
      }
    },
    "trust_response": {
      "description": "E7 GET /v1/places/{p}/trust?since_rev=; scores are never sent; sealed places 409 sealed_plaintext",
      "type": "object", "required": ["trust_rev", "changes", "next_rev"], "additionalProperties": false,
      "properties": {
        "trust_rev": { "$ref": "common.schema.json#/$defs/u64" },
        "changes": { "type": "array", "maxItems": 10000, "items": { "type": "object", "required": ["node_id", "bucket", "review_state", "reviewed_by"], "additionalProperties": false,
          "properties": { "node_id": { "$ref": "common.schema.json#/$defs/node_id" }, "bucket": { "enum": ["high", "normal", "low"] }, "review_state": { "$ref": "common.schema.json#/$defs/review_state" }, "reviewed_by": { "$ref": "common.schema.json#/$defs/reviewed_by" } } } },
        "next_rev": { "anyOf": [{ "$ref": "common.schema.json#/$defs/u64" }, { "type": "null" }] }
      }
    }
  }
}
