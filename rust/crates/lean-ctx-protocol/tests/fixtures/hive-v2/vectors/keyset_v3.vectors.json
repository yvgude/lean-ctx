  "rules": {
    "engine_3_12": "accept iff some signatures[] entry verifies with a root of HOSTED_ROOT_KEYS (root_new); a valid signature only from RETIRED_ROOT_KEYS (root_old) → reject retired_root_only",
    "key_use": "an object is accepted with key k for purpose p iff k is in keys, p ∈ k.purposes, created_at ≤ received_at and (revoked_at null or received_at < revoked_at)",
    "lease": "a lease envelope verifies with the v3 key whose key_id = kid, purpose policy, created_at ≤ received_at < revoked_at",
    "legacy": "signature = base64(Ed25519(root_old, \"leanctx.hive.keyset.v1\\n\" ‖ canonical_json(key set without signature))), the C0 1.x verification rule",
    "negotiation": "GET /v1/keys answers by the Hive-Protocol major of the request: 1.x → the v1 set unchanged (routes/keyset.v1.for_1x.response.json), 2.x → key set v3 (routes/keyset.v3.response.json), which also lists the lease/policy signer under purpose policy",
    "roots": "test roots in signing.vectors.json keys.root_old / keys.root_new (test-only)",
    "signatures": "signatures[i] = hex(Ed25519(root_i, \"leanctx.hive.keyset.v3\\n\" ‖ canonical_json({schema, keys})))"
  },
