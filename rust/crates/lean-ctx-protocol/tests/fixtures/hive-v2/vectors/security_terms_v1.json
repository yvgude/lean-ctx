  "rules": {
    "matching": "R1: any reference target or file/symbol anchor path matches a glob case-insensitively (** = any directories, * and ? stay inside one path segment, {a,b} = alternatives); R2: statement, title, steps or rationale contains one strong term as whole words (case-insensitive, words split at non-alphanumerics); R3: ≥ 2 distinct weak terms as whole words; match = R1 or R2 or R3 (first rule reported)",
    "r1_globs": [
      "**/{security,auth,authn,authz,crypto,secrets,policy,policies,iam,permissions,sandbox,pathjail}/**",
      "**/*{auth,crypto,secret,policy,sandbox,jail,egress,redact,permission,acl,rbac,tls,cert,keyring,kms}*.*",
      "**/.github/workflows/**",
      "**/.gitlab-ci.yml",
      "**/CODEOWNERS",
      "**/SECURITY.md",
      "**/THREAT-MODEL*"
    ],
    "r2_strong": [
      "password",
      "secret",
      "credential",
      "api key",
      "private key",
      "access token",
      "encryption key",
      "signing key",
      "certificate",
