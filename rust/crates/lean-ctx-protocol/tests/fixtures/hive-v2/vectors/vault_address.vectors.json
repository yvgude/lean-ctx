{
  "cases": [
    {
      "input": "acme/payments",
      "output": {
        "hosted": true,
        "origin": "https://hive.leanctx.com",
        "server": null,
        "valid": true,
        "vault": "payments",
        "ws": "acme"
      }
    },
    {
      "input": "acme/payments@hive.leanctx.com",
      "output": {
        "hosted": true,
        "origin": "https://hive.leanctx.com",
        "server": null,
        "valid": true,
        "vault": "payments",
        "ws": "acme"
      }
    },
    {
      "input": "acme/payments@hive.acme.example",
      "output": {
        "hosted": false,
        "origin": "https://hive.acme.example",
        "server": "hive.acme.example",
        "valid": true,
        "vault": "payments",
        "ws": "acme"
      }
    },
    {
      "input": "acme/payments@Hive.Acme.Example:8443",
      "output": {
        "hosted": false,
        "origin": "https://hive.acme.example:8443",
        "server": "hive.acme.example:8443",
        "valid": true,
        "vault": "payments",
        "ws": "acme"
      }
    },
    {
      "input": "acme/payments@localhost:8443",
      "output": {
        "hosted": false,
        "origin": "https://localhost:8443",
        "server": "localhost:8443",
        "valid": true,
        "vault": "payments",
        "ws": "acme"
      }
    },
    {
      "input": "acme/payments@10.0.0.5",
      "output": {
        "hosted": false,
        "origin": "https://10.0.0.5",
        "server": "10.0.0.5",
        "valid": true,
        "vault": "payments",
        "ws": "acme"
      }
    },
    {
      "input": "acme/payments@[::1]:8443",
      "output": {
        "hosted": false,
        "origin": "https://[::1]:8443",
        "server": "[::1]:8443",
        "valid": true,
        "vault": "payments",
        "ws": "acme"
      }
    },
    {
      "input": "acme/payments@localhost",
      "output": {
        "reason": "server_ambiguous",
        "valid": false
      }
    },
    {
      "input": "acme/payments@",
      "output": {
        "reason": "server_empty",
        "valid": false
      }
    },
    {
      "input": "acme/payments@hive.acme.example:0",
      "output": {
        "reason": "port_invalid",
        "valid": false
      }
    },
    {
      "input": "acme/payments@hive.acme.example:70000",
      "output": {
        "reason": "port_invalid",
        "valid": false
      }
    },
    {
      "input": "Acme/payments",
      "output": {
        "reason": "ws_invalid",
        "valid": false
      }
    },
    {
      "input": "acme",
      "output": {
        "reason": "vault_missing",
        "valid": false
      }
    },
    {
      "input": "acme/payments/extra",
      "output": {
        "reason": "vault_invalid",
        "valid": false
      }
    },
    {
      "input": "acme/p@x.example@y.example",
      "output": {
        "reason": "vault_invalid",
        "valid": false
      }
    }
  ],
  "rules": {
    "grammar": "<ws>/<vault>[@<server>]; ws [a-z0-9][a-z0-9-]{0,38}; vault [a-z0-9-]{2,40}; server = DNS name with at least one dot [+ :port] | name:port | [IPv6]:port; port 1–65535",
    "hosted": "no @server, or @hive.leanctx.com → hosted, origin https://hive.leanctx.com",
    "normalise": "server lowercased; ws and vault must already be lowercase",
    "self_hosted": "origin https://<server> (server lowercased)",
    "used_in": ".lean-ctx-hive.json (link/v2 vault), CLI vault arguments and flags, environment values"
  }
}
