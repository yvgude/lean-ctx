{
  "route": "W94",
  "method": "PUT",
  "path": "/api/v1/orgs/acme/compute/caps",
  "request": {
    "max_concurrent_jobs": 2,
    "max_runtime_s": 1800,
    "max_job_credits": 120,
    "daily_credits": 300
  },
  "response": {
    "status": 200,
    "body": {
      "caps": {
        "max_concurrent_jobs": 2,
        "max_runtime_s": 1800,
        "max_job_credits": 120,
        "daily_credits": 300
      },
      "maxima": {
        "max_concurrent_jobs": 8,
        "max_runtime_s": 3600,
        "max_job_credits": 1000,
        "daily_credits": 10000
      },
      "max_queued_jobs": 32,
      "bundle_bytes": 1073741824,
      "entitled": true,
      "provider": "fake"
    }
  },
  "errors": [
    {
      "status": 400,
      "body": {
        "error": {
          "code": "invalid_request",
          "message": "max_runtime_s must be 10 to 3600",
          "field": "max_runtime_s"
        }
      }
    },
    {
      "status": 403,
      "body": {
        "error": {
          "code": "human_session_required",
          "message": "this action needs a person signed in on the web; tokens are refused"
        }
      }
    },
    {
      "status": 403,
      "body": {
        "error": {
          "code": "step_up_required",
          "message": "confirm with your second factor first"
        }
      }
    },
    {
      "status": 404,
      "body": {
        "error": {
          "code": "feature_disabled",
          "message": "this feature is switched off on this Hive",
          "feature": "compute"
        }
      }
    }
  ]
}
