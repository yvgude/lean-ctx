#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Write, show and verify ECCP change envelopes stored in git notes.

A change envelope (schema ``leanctx.change-envelope/v1``) records the intent
of a merge request and the evidence for it. It is stored as a JSON git note
under ``refs/notes/eccp`` on the merge request's head commit.

    eccp-envelope write --base-ref origin/main --task 157 --check unit=pass \
        --observed-reads-from-session
    eccp-envelope show [COMMIT]
    eccp-envelope verify [COMMIT]
    eccp-envelope verify-reads [--json] [COMMIT]

Standard library only. Exit codes: 0 ok, 1 invalid envelope (verify-reads:
also reads not covered), 2 usage or git error (including a commit without an
envelope).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import PurePosixPath
import re
import shlex
import subprocess
import sys

try:  # Python 3.11+
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - older interpreters
    tomllib = None

SCHEMA_ID = "leanctx.change-envelope/v1"
NOTES_REF = "eccp"  # git expands this to refs/notes/eccp
CLASSES = ("L", "I", "G")
CHECK_RESULTS = ("pass", "fail", "skip", "error")
TOOLCHAIN_FILES = ("rust-toolchain.toml", "rust-toolchain", "rust/rust-toolchain.toml", "rust/rust-toolchain")
DERIVATIONS_FILE = "ci/derivations.toml"
SHA_RE = re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$")
DIGEST_RE = re.compile(r"^sha256:[0-9a-f]{64}$")
READSET_SCHEMA = "leanctx.session-readset/v1"
COVERAGE_SCHEMA = "leanctx.read-coverage/v1"
# A Rust function declaration and the attributes that make it a test.
FN_RE = re.compile(r"^\s*((?:#\[[^\]]*\]\s*)*)(?:pub(?:\([^)]*\))?\s+)?(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+([A-Za-z_][A-Za-z0-9_]*)")
TEST_ATTR_RE = re.compile(r"(?:^|\s)#\[(?:[A-Za-z_][A-Za-z0-9_]*::)*(?:test|rstest|test_case|proptest)\b")
HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


class EnvelopeError(Exception):
    """Usage or git failure (exit 2)."""


def git(*args: str, check: bool = True, input_text: str | None = None) -> subprocess.CompletedProcess:
    proc = subprocess.run(
        ["git", *args],
        input=input_text,
        capture_output=True,
        text=True,
        check=False,
    )
    if check and proc.returncode != 0:
        raise EnvelopeError(f"git {' '.join(args)} failed: {proc.stderr.strip()}")
    return proc


def rev(commitish: str) -> str:
    return git("rev-parse", "--verify", "--quiet", f"{commitish}^{{commit}}").stdout.strip()


def blob_exists(commit: str, path: str) -> bool:
    return git("cat-file", "-e", f"{commit}:{path}", check=False).returncode == 0


def read_blob(commit: str, path: str) -> str:
    return git("show", f"{commit}:{path}").stdout


def is_ancestor(ancestor: str, descendant: str) -> bool:
    return git("merge-base", "--is-ancestor", ancestor, descendant, check=False).returncode == 0


# ---------------------------------------------------------------- read set


def crate_name(manifest: str) -> str | None:
    if tomllib is not None:
        try:
            name = tomllib.loads(manifest).get("package", {}).get("name")
            return name if isinstance(name, str) else None
        except tomllib.TOMLDecodeError:
            return None
    section = re.search(r"^\[package\]\s*$(.*?)(?=^\[|\Z)", manifest, re.M | re.S)
    found = section and re.search(r'^name\s*=\s*"([^"]+)"', section.group(1), re.M)
    return found.group(1) if found else None


def changed_paths(base: str, head: str) -> list[str]:
    return sorted(set(git("diff", "--name-only", "--no-renames", f"{base}..{head}").stdout.splitlines()))


def crate_dirs(base: str, head: str) -> dict[str, str]:
    """Cargo packages owning the files changed between base and head: {name: directory}."""
    manifests: dict[str, str | None] = {}
    crates: dict[str, str] = {}
    for path in changed_paths(base, head):
        for parent in PurePosixPath(path).parents:
            manifest = "Cargo.toml" if str(parent) == "." else f"{parent}/Cargo.toml"
            if manifest not in manifests:
                manifests[manifest] = crate_name(read_blob(head, manifest)) if blob_exists(head, manifest) else None
            if manifests[manifest]:
                crates[manifests[manifest]] = str(parent)
                break
    return dict(sorted(crates.items()))


def crates_touched(base: str, head: str) -> list[str]:
    return list(crate_dirs(base, head))


def toolchain(head: str, rustc_version: str | None) -> dict:
    pinned = None
    for path in TOOLCHAIN_FILES:
        if blob_exists(head, path):
            pinned = {"path": path, "content": read_blob(head, path).strip()}
            break
    if rustc_version is None:
        try:
            proc = subprocess.run(["rustc", "-V"], capture_output=True, text=True, check=False)
            rustc_version = proc.stdout.strip() if proc.returncode == 0 else None
        except OSError:
            rustc_version = None
    return {"rust_toolchain": pinned, "rustc": rustc_version or None}


def load_json_file(path: str, what: str):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        raise EnvelopeError(f"cannot read {what} from {path}: {exc}") from exc


def parse_observed_reads(text: str, origin: str) -> tuple[list[str], dict | None]:
    """Observed reads and, for a LeanCTX read-set export, its source record.

    Accepts the JSON printed by ``lean-ctx session readset --json`` (schema
    ``leanctx.session-readset/v1``), a JSON list of paths, or one path per line.
    """
    stripped = text.strip()
    source = None
    try:
        if stripped.startswith("{"):
            export = json.loads(stripped)
            if export.get("schema") != READSET_SCHEMA or not isinstance(export.get("reads"), list):
                raise EnvelopeError(f"{origin}: expected a {READSET_SCHEMA} export")
            reads = [entry.get("path") if isinstance(entry, dict) else None for entry in export["reads"]]
            sessions = export.get("sessions", [])
            if not isinstance(sessions, list) or not all(isinstance(s, str) for s in sessions):
                raise EnvelopeError(f"{origin}: sessions must be a list of ids")
            source = {
                "schema": READSET_SCHEMA,
                "sessions": sessions,
                "complete": export.get("complete") is True,
            }
        elif stripped.startswith("["):
            reads = json.loads(stripped)
        else:
            reads = [line.strip() for line in stripped.splitlines() if line.strip()]
    except json.JSONDecodeError as exc:
        raise EnvelopeError(f"{origin}: not JSON: {exc}") from exc
    if not isinstance(reads, list) or not all(isinstance(item, str) and item for item in reads):
        raise EnvelopeError(f"{origin}: observed reads must be a list of paths")
    return sorted(set(reads)), source


def load_observed_reads(path: str) -> tuple[list[str], dict | None]:
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except OSError as exc:
        raise EnvelopeError(f"cannot read observed reads from {path}: {exc}") from exc
    return parse_observed_reads(text, path)


def session_readset(session_ids: list[str]) -> str:
    """``lean-ctx session readset --json`` for this repository's root."""
    root = git("rev-parse", "--show-toplevel").stdout.strip()
    command = [*shlex.split(os.environ.get("LEAN_CTX_BIN", "lean-ctx")), "session", "readset", "--json", "--root", root]
    for session_id in session_ids:
        command += ["--id", session_id]
    try:
        proc = subprocess.run(command, capture_output=True, text=True, check=False)
    except OSError as exc:
        raise EnvelopeError(f"cannot run {command[0]}: {exc}") from exc
    if proc.returncode != 0:
        raise EnvelopeError(f"{' '.join(command[:4])} failed (exit {proc.returncode}): {proc.stderr.strip()}")
    return proc.stdout


def tracked_paths(*commits: str) -> set[str]:
    paths: set[str] = set()
    for commit in commits:
        paths.update(git("ls-tree", "-r", "--name-only", commit).stdout.splitlines())
    return paths


# --------------------------------------------------------------- write set


def _enclosing_test(lines: list[str], index: int) -> str | None:
    """Name of the test function around 0-based line ``index``, if any.

    Heuristic: the nearest function declaration at or above the line, a test
    when one of the attributes directly above it is #[test], #[tokio::test],
    #[rstest], #[test_case] or #[proptest].
    """
    for i in range(min(index, len(lines) - 1), -1, -1):
        found = FN_RE.match(lines[i])
        if not found:
            continue
        if TEST_ATTR_RE.search(found.group(1)):
            return found.group(2)
        j = i - 1
        while j >= 0 and (lines[j].strip().startswith(("#[", "///", "//")) or not lines[j].strip()):
            if TEST_ATTR_RE.search(lines[j]):
                return found.group(2)
            j -= 1
        return None
    return None


def test_functions(base: str, head: str) -> list[str]:
    """Rust test functions the change adds, edits or removes: ``path::name``.

    Test functions count to the write set (W5-08): evidence that ran a test
    the change edited is never reused for it.
    """
    diff = git("diff", "-U0", "--no-renames", "--no-color", f"{base}..{head}", "--", "*.rs").stdout
    found: set[str] = set()
    old_path = new_path = None
    sources: dict[tuple[str, str], list[str]] = {}

    def source(commit: str, path: str) -> list[str]:
        if (commit, path) not in sources:
            sources[(commit, path)] = read_blob(commit, path).splitlines() if blob_exists(commit, path) else []
        return sources[(commit, path)]

    for line in diff.splitlines():
        if line.startswith("--- "):
            old_path = line[6:] if line.startswith("--- a/") else None
        elif line.startswith("+++ "):
            new_path = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("@@"):
            hunk = HUNK_RE.match(line)
            if not hunk:
                continue
            old_start, old_len = int(hunk.group(1)), int(hunk.group(2) or 1)
            new_start, new_len = int(hunk.group(3)), int(hunk.group(4) or 1)
            for commit, path, start, length in ((base, old_path, old_start, old_len), (head, new_path, new_start, new_len)):
                if not path or not length:
                    continue
                lines = source(commit, path)
                for number in range(start, start + length):
                    name = _enclosing_test(lines, number - 1)
                    if name:
                        found.add(f"{path}::{name}")
    return sorted(found)


def write_set(base: str, head: str) -> dict:
    return {"paths": changed_paths(base, head), "test_functions": test_functions(base, head)}


# ------------------------------------------------------------------- hooks


def classify(args, base: str, head: str) -> str | None:
    """Change class. Hook for the W1b-02 classifier.

    ``--class`` wins; otherwise ``$ECCP_CLASSIFIER`` (a command) is run with
    the base and head commits as arguments and must print L, I or G. Without
    either the class stays null (unknown).
    """
    if args.change_class:
        return args.change_class
    command = os.environ.get("ECCP_CLASSIFIER")
    if not command:
        return None
    proc = subprocess.run([*shlex.split(command), base, head], capture_output=True, text=True, check=False)
    value = proc.stdout.strip()
    if proc.returncode != 0 or value not in CLASSES:
        raise EnvelopeError(f"classifier failed (exit {proc.returncode}, output {value!r})")
    return value


def derivations(args, head: str) -> list[dict]:
    """Inputs of generated files. Hook for W4-05 (ci/derivations.toml).

    ``--derivations FILE`` (JSON list) wins. Otherwise ``ci/derivations.toml``
    at the head commit is read when present: each ``[[derivation]]`` table
    names an ``output`` and its ``inputs``; the envelope records each input
    with its blob id at head instead of the generated output.
    """
    if args.derivations:
        entries = load_json_file(args.derivations, "derivations")
        if not isinstance(entries, list):
            raise EnvelopeError("--derivations must hold a JSON list")
        return entries
    if not blob_exists(head, DERIVATIONS_FILE) or tomllib is None:
        return []
    try:
        table = tomllib.loads(read_blob(head, DERIVATIONS_FILE))
    except tomllib.TOMLDecodeError as exc:
        raise EnvelopeError(f"{DERIVATIONS_FILE}: {exc}") from exc
    result = []
    for entry in table.get("derivation", table.get("derivations", [])):
        output = entry.get("output")
        inputs = entry.get("inputs", [])
        if not isinstance(output, str) or not isinstance(inputs, list):
            raise EnvelopeError(f"{DERIVATIONS_FILE}: each derivation needs output and inputs")
        recorded = []
        for path in sorted(inputs):
            blob = git("rev-parse", "--verify", "--quiet", f"{head}:{path}", check=False).stdout.strip()
            recorded.append({"path": path, "blob": blob or None})
        result.append({"output": output, "inputs": recorded})
    return sorted(result, key=lambda item: item["output"])


# ---------------------------------------------------------------- evidence


def read_set_digest(read_set: dict, dirs: dict[str, str], commit: str) -> str:
    """Address of a check by the read set of the build and test run (W5-08).

    sha256 over the canonical JSON of the toolchain, the feature set, the
    public API hashes and, for each crate the change touches, the git tree id
    of the crate directory at the commit the check ran on. A verdict store
    reuses a verdict only while this digest is unchanged.
    """
    trees = {}
    for name, directory in dirs.items():
        spec = f"{commit}^{{tree}}" if directory == "." else f"{commit}:{directory}"
        trees[name] = git("rev-parse", "--verify", "--quiet", spec, check=False).stdout.strip() or None
    material = {
        "crates": trees,
        "features": read_set.get("features", []),
        "public_api_hashes": read_set.get("public_api_hashes", {}),
        "toolchain": read_set["toolchain"],
    }
    canonical = json.dumps(material, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def parse_check(spec: str, head: str) -> dict:
    """``name=result`` or ``name=result@commit``."""
    name, sep, rest = spec.partition("=")
    if not sep or not name:
        raise EnvelopeError(f"--check {spec!r}: expected name=result[@commit]")
    result, _, commitish = rest.partition("@")
    if result not in CHECK_RESULTS:
        raise EnvelopeError(f"--check {spec!r}: result must be one of {', '.join(CHECK_RESULTS)}")
    commit = rev(commitish) if commitish else head
    if not commit:
        raise EnvelopeError(f"--check {spec!r}: unknown commit {commitish!r}")
    return {"name": name, "result": result, "commit": commit}


# ------------------------------------------------------------------ build


def build_envelope(args) -> dict:
    head = rev(args.commit)
    if not head:
        raise EnvelopeError(f"unknown commit {args.commit!r}")
    base_tip = rev(args.base_ref)
    if not base_tip:
        raise EnvelopeError(f"unknown base ref {args.base_ref!r}")
    base = git("merge-base", base_tip, head).stdout.strip()

    dirs = crate_dirs(base, head)
    read_set = {
        "crates": list(dirs),
        "toolchain": toolchain(head, args.rustc_version),
    }
    if args.features:
        read_set["features"] = sorted({f.strip() for spec in args.features for f in spec.split(",") if f.strip()})
    if args.public_api_hashes:
        hashes = load_json_file(args.public_api_hashes, "public API hashes")
        if not isinstance(hashes, dict):
            raise EnvelopeError("--public-api-hashes must hold a JSON object {crate: hash}")
        read_set["public_api_hashes"] = dict(sorted(hashes.items()))
    if args.observed_reads and args.observed_reads_from_session:
        raise EnvelopeError("--observed-reads and --observed-reads-from-session exclude each other")
    if args.session_id and not args.observed_reads_from_session:
        raise EnvelopeError("--session-id needs --observed-reads-from-session")
    source = None
    if args.observed_reads:
        read_set["observed_reads"], source = load_observed_reads(args.observed_reads)
    elif args.observed_reads_from_session:
        read_set["observed_reads"], source = parse_observed_reads(session_readset(args.session_id or []), "lean-ctx session readset")
    if source is not None:
        # Only files of the repository can conflict with another change; a
        # session's reads of untracked or ignored files stay out of the note.
        tracked = tracked_paths(base, head)
        kept = [path for path in read_set["observed_reads"] if path in tracked]
        source["untracked_dropped"] = len(read_set["observed_reads"]) - len(kept)
        read_set["observed_reads"] = kept
        read_set["observed_reads_source"] = source

    checks = [parse_check(spec, head) for spec in args.check or []]
    digests: dict[str, str] = {}
    for check in checks:
        if check["commit"] not in digests:
            digests[check["commit"]] = read_set_digest(read_set, dirs, check["commit"])
        check["read_set_digest"] = digests[check["commit"]]
    return {
        "schema": SCHEMA_ID,
        "head": head,
        "intent": {
            "task": args.task,
            "plan_url": args.plan_url,
            "acceptance": sorted(set(args.acceptance or [])),
        },
        "base": {"ref": args.base_ref, "commit": base},
        "class": classify(args, base, head),
        "read_set": read_set,
        "write_set": write_set(base, head),
        "derivations": derivations(args, head),
        "evidence": {"checks": sorted(checks, key=lambda c: (c["name"], c["commit"]))},
    }


def render(envelope: dict) -> str:
    return json.dumps(envelope, indent=2, sort_keys=True) + "\n"


# --------------------------------------------------------------- validate


def schema_errors(env) -> list[str]:
    """Structural check equivalent to docs/contracts/change-envelope-v1.schema.json."""
    errors: list[str] = []

    def expect(cond: bool, message: str) -> bool:
        if not cond:
            errors.append(message)
        return cond

    def keys(obj, path: str, required: set[str], optional: set[str] = frozenset()) -> bool:
        if not expect(isinstance(obj, dict), f"{path}: must be an object"):
            return False
        missing = required - obj.keys()
        extra = obj.keys() - required - optional
        expect(not missing, f"{path}: missing {', '.join(sorted(missing))}")
        expect(not extra, f"{path}: unexpected {', '.join(sorted(extra))}")
        return not missing

    def sha(value, path: str) -> None:
        expect(isinstance(value, str) and bool(SHA_RE.match(value)), f"{path}: must be a full commit id")

    def str_list(value, path: str) -> None:
        expect(isinstance(value, list) and all(isinstance(v, str) and v for v in value), f"{path}: must be a list of strings")

    top = {"schema", "head", "intent", "base", "class", "read_set", "derivations", "evidence"}
    if not keys(env, "envelope", top, {"write_set"}):
        return errors
    expect(env["schema"] == SCHEMA_ID, f"schema: must be {SCHEMA_ID!r}")
    sha(env["head"], "head")

    if keys(env["intent"], "intent", {"task", "plan_url", "acceptance"}):
        intent = env["intent"]
        expect(isinstance(intent["task"], str) and intent["task"] != "", "intent.task: must be a non-empty string")
        expect(intent["plan_url"] is None or isinstance(intent["plan_url"], str), "intent.plan_url: must be a string or null")
        str_list(intent["acceptance"], "intent.acceptance")

    if keys(env["base"], "base", {"ref", "commit"}):
        expect(isinstance(env["base"]["ref"], str) and env["base"]["ref"] != "", "base.ref: must be a non-empty string")
        sha(env["base"]["commit"], "base.commit")

    expect(env["class"] is None or env["class"] in CLASSES, "class: must be L, I, G or null")

    if keys(env["read_set"], "read_set", {"crates", "toolchain"},
            {"public_api_hashes", "observed_reads", "observed_reads_source", "features"}):
        rs = env["read_set"]
        str_list(rs["crates"], "read_set.crates")
        if keys(rs["toolchain"], "read_set.toolchain", {"rust_toolchain", "rustc"}):
            pinned = rs["toolchain"]["rust_toolchain"]
            if pinned is not None and keys(pinned, "read_set.toolchain.rust_toolchain", {"path", "content"}):
                expect(all(isinstance(pinned[k], str) for k in ("path", "content")), "read_set.toolchain.rust_toolchain: path and content must be strings")
            rustc = rs["toolchain"]["rustc"]
            expect(rustc is None or isinstance(rustc, str), "read_set.toolchain.rustc: must be a string or null")
        if "public_api_hashes" in rs:
            hashes = rs["public_api_hashes"]
            expect(isinstance(hashes, dict) and all(isinstance(v, str) for v in hashes.values()), "read_set.public_api_hashes: must map crate to hash string")
        if "observed_reads" in rs:
            str_list(rs["observed_reads"], "read_set.observed_reads")
        if "features" in rs:
            str_list(rs["features"], "read_set.features")
        if "observed_reads_source" in rs:
            expect("observed_reads" in rs, "read_set.observed_reads_source: needs observed_reads")
            src = rs["observed_reads_source"]
            if keys(src, "read_set.observed_reads_source", {"schema", "sessions", "complete"}, {"untracked_dropped"}):
                expect(src["schema"] == READSET_SCHEMA, f"read_set.observed_reads_source.schema: must be {READSET_SCHEMA!r}")
                str_list(src["sessions"], "read_set.observed_reads_source.sessions")
                expect(isinstance(src["complete"], bool), "read_set.observed_reads_source.complete: must be a boolean")
                if "untracked_dropped" in src:
                    dropped = src["untracked_dropped"]
                    expect(isinstance(dropped, int) and not isinstance(dropped, bool) and dropped >= 0,
                           "read_set.observed_reads_source.untracked_dropped: must be a non-negative integer")

    if "write_set" in env and keys(env["write_set"], "write_set", {"paths", "test_functions"}):
        str_list(env["write_set"]["paths"], "write_set.paths")
        str_list(env["write_set"]["test_functions"], "write_set.test_functions")

    if expect(isinstance(env["derivations"], list), "derivations: must be a list"):
        for i, entry in enumerate(env["derivations"]):
            path = f"derivations[{i}]"
            if keys(entry, path, {"output", "inputs"}):
                expect(isinstance(entry["output"], str) and entry["output"] != "", f"{path}.output: must be a non-empty string")
                if expect(isinstance(entry["inputs"], list), f"{path}.inputs: must be a list"):
                    for j, item in enumerate(entry["inputs"]):
                        if keys(item, f"{path}.inputs[{j}]", {"path", "blob"}):
                            expect(isinstance(item["path"], str), f"{path}.inputs[{j}].path: must be a string")
                            expect(item["blob"] is None or (isinstance(item["blob"], str) and bool(SHA_RE.match(item["blob"]))), f"{path}.inputs[{j}].blob: must be an object id or null")

    if keys(env["evidence"], "evidence", {"checks"}) and expect(isinstance(env["evidence"]["checks"], list), "evidence.checks: must be a list"):
        for i, check in enumerate(env["evidence"]["checks"]):
            path = f"evidence.checks[{i}]"
            if keys(check, path, {"name", "result", "commit"}, {"read_set_digest"}):
                expect(isinstance(check["name"], str) and check["name"] != "", f"{path}.name: must be a non-empty string")
                expect(check["result"] in CHECK_RESULTS, f"{path}.result: must be one of {', '.join(CHECK_RESULTS)}")
                sha(check["commit"], f"{path}.commit")
                if "read_set_digest" in check:
                    expect(isinstance(check["read_set_digest"], str) and bool(DIGEST_RE.match(check["read_set_digest"])),
                           f"{path}.read_set_digest: must be sha256:<64 hex>")
    return errors


def graph_errors(env: dict, commit: str) -> list[str]:
    """Checks against the repository: head, base ancestry, evidence commits."""
    errors = []
    if env["head"] != commit:
        errors.append(f"head: envelope names {env['head']} but is attached to {commit}")
    base = env["base"]["commit"]
    if not rev(base):
        errors.append(f"base.commit: {base} is not in this repository")
    elif not is_ancestor(base, commit):
        errors.append(f"base.commit: {base} is not an ancestor of {commit}")
    for i, check in enumerate(env["evidence"]["checks"]):
        if not rev(check["commit"]):
            errors.append(f"evidence.checks[{i}].commit: {check['commit']} is not in this repository")
        elif not is_ancestor(check["commit"], commit):
            errors.append(f"evidence.checks[{i}].commit: {check['commit']} is not {commit} or an ancestor")
    return errors


def read_note(commitish: str) -> tuple[str, dict]:
    commit = rev(commitish)
    if not commit:
        raise EnvelopeError(f"unknown commit {commitish!r}")
    proc = git("notes", "--ref", NOTES_REF, "show", commit, check=False)
    if proc.returncode != 0:
        raise EnvelopeError(f"no envelope in refs/notes/{NOTES_REF} for {commit}")
    try:
        return commit, json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise ValueError(f"note is not JSON: {exc}") from exc


# ---------------------------------------------------------- read coverage


def changes(base: str, commit: str) -> dict[str, str]:
    """{path: status} between base and commit; status A, M, D or T (no renames)."""
    fields = git("diff", "--name-status", "--no-renames", "-z", f"{base}..{commit}").stdout.split("\0")
    return {fields[i + 1]: fields[i][:1] for i in range(0, len(fields) - 1, 2)}


def required_reads(env: dict, commit: str, at_base: set[str]) -> tuple[list[dict], list[str], list[dict]]:
    """What the change up to ``commit`` depends on and so must have read (W5-08).

    Required, each with its reasons: every path changed since ``base.commit``
    that existed there (``changed``: edited or deleted), every acceptance file
    (``acceptance``) and, for a changed path the envelope declares as a
    derivation output, each input of it (``derivation-input``); the derived
    output itself needs no read. Paths absent at ``base.commit`` are authored
    by the change, not read. Returns (required, authored, derived).
    """
    outputs = {entry["output"]: sorted(i["path"] for i in entry["inputs"]) for entry in env["derivations"]}
    reasons: dict[str, set[str]] = {}
    authored: list[str] = []
    derived: list[dict] = []
    for path, status in sorted(changes(env["base"]["commit"], commit).items()):
        if path in outputs:
            derived.append({"path": path, "inputs": outputs[path]})
            for source in outputs[path]:
                reasons.setdefault(source, set()).add("derivation-input")
        elif status == "A":
            authored.append(path)
        else:
            reasons.setdefault(path, set()).add("changed")
    for path in env["intent"]["acceptance"]:
        reasons.setdefault(path, set()).add("acceptance")
    required = [{"path": path, "reasons": sorted(why)} for path, why in sorted(reasons.items()) if path in at_base]
    return required, authored, derived


def write_set_errors(env: dict, commit: str) -> list[str]:
    """The recorded write set must be the change's: a claim cannot shrink it."""
    if "write_set" not in env:
        return []
    actual = changed_paths(env["base"]["commit"], commit)
    if sorted(env["write_set"]["paths"]) != actual:
        return [f"write_set.paths: does not match the files changed in {env['base']['commit']}..{commit}"]
    return []


def read_coverage(env: dict, commit: str) -> dict:
    """Verdict whether the observed read set proves the change was read (W5-08).

    Deterministic and offline: only the envelope and the local repository.
    ``covered`` when every required read is in ``read_set.observed_reads``,
    ``missing_reads`` when one is not, ``unproven`` without observed reads.
    Each evidence check is ``backed`` when the reads required by the change up
    to its commit were all observed.
    """
    rs = env["read_set"]
    proven = "observed_reads" in rs
    observed = set(rs.get("observed_reads", []))
    source = rs.get("observed_reads_source")
    at_base = tracked_paths(env["base"]["commit"])
    required, authored, derived = required_reads(env, commit, at_base)
    missing = [entry for entry in required if entry["path"] not in observed]
    unread: dict[str, list[str]] = {}
    checks = []
    for check in env["evidence"]["checks"]:
        at = check["commit"]
        if at not in unread:
            needed = required if at == commit else required_reads(env, at, at_base)[0]
            unread[at] = [entry["path"] for entry in needed if entry["path"] not in observed]
        checks.append({
            "name": check["name"],
            "result": check["result"],
            "commit": at,
            "backed": proven and not unread[at],
            "missing": unread[at],
        })
    return {
        "schema": COVERAGE_SCHEMA,
        "head": commit,
        "base": env["base"]["commit"],
        "verdict": "unproven" if not proven else "missing_reads" if missing else "covered",
        "observed_reads": len(observed),
        "complete": source["complete"] if source else None,
        "sessions": source["sessions"] if source else [],
        "required": required,
        "missing": missing,
        "authored": authored,
        "derived": derived,
        "checks": sorted(checks, key=lambda c: (c["name"], c["commit"])),
    }


# --------------------------------------------------------------- commands


def cmd_write(args) -> int:
    envelope = build_envelope(args)
    errors = schema_errors(envelope)
    if errors:
        raise EnvelopeError("built envelope is invalid: " + "; ".join(errors))
    text = render(envelope)
    if args.dry_run:
        sys.stdout.write(text)
        return 0
    git("notes", "--ref", NOTES_REF, "add", "-f", "-F", "-", envelope["head"], input_text=text)
    print(f"envelope written to refs/notes/{NOTES_REF} for {envelope['head']}")
    return 0


def cmd_show(args) -> int:
    try:
        _, envelope = read_note(args.commit)
    except ValueError as exc:
        print(f"invalid: {exc}", file=sys.stderr)
        return 1
    sys.stdout.write(render(envelope))
    return 0


def cmd_verify(args) -> int:
    try:
        commit, envelope = read_note(args.commit)
    except ValueError as exc:
        print(f"invalid: {exc}", file=sys.stderr)
        return 1
    errors = schema_errors(envelope)
    if not errors:
        errors = graph_errors(envelope, commit)
    if errors:
        for error in errors:
            print(f"invalid: {error}", file=sys.stderr)
        return 1
    stale = sum(1 for c in envelope["evidence"]["checks"] if c["commit"] != commit)
    print(f"ok: {SCHEMA_ID} on {commit} ({len(envelope['evidence']['checks'])} checks, {stale} on an earlier commit)")
    return 0


def cmd_verify_reads(args) -> int:
    try:
        commit, envelope = read_note(args.commit)
    except ValueError as exc:
        print(f"invalid: {exc}", file=sys.stderr)
        return 1
    errors = schema_errors(envelope) or graph_errors(envelope, commit) or write_set_errors(envelope, commit)
    if errors:
        for error in errors:
            print(f"invalid: {error}", file=sys.stderr)
        return 1
    report = read_coverage(envelope, commit)
    if args.json:
        sys.stdout.write(render(report))
    else:
        print(f"{report['verdict']}: {len(report['required']) - len(report['missing'])} of "
              f"{len(report['required'])} required reads observed on {commit}")
        for entry in report["missing"]:
            print(f"missing read: {entry['path']} ({', '.join(entry['reasons'])})")
        for check in report["checks"]:
            if not check["backed"]:
                print(f"unbacked evidence: {check['name']}={check['result']}@{check['commit']}")
        if report["verdict"] == "unproven":
            print("no observed reads in the envelope: write it with --observed-reads-from-session")
        elif report["missing"] and report["complete"] is False:
            print("the session history is incomplete: evicted reads cannot be proven")
    return 0 if report["verdict"] == "covered" else 1


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="eccp-envelope", description=__doc__.split("\n\n")[0])
    sub = root.add_subparsers(dest="command", required=True)

    write = sub.add_parser("write", help="build the envelope and store it as a git note")
    write.add_argument("--commit", default="HEAD", help="merge request head commit (default HEAD)")
    write.add_argument("--base-ref", required=True, help="target branch ref, e.g. origin/integration/3.12.3")
    write.add_argument("--task", required=True, help="task id, e.g. 157")
    write.add_argument("--plan-url", help="plan page URL")
    write.add_argument("--acceptance", action="append", metavar="PATH", help="acceptance test file (repeatable)")
    write.add_argument("--class", dest="change_class", choices=CLASSES, help="change class; else $ECCP_CLASSIFIER, else null")
    write.add_argument("--check", action="append", metavar="NAME=RESULT[@COMMIT]", help="evidence check (repeatable)")
    write.add_argument("--public-api-hashes", metavar="FILE", help="JSON object {crate: hash}")
    write.add_argument("--observed-reads", metavar="FILE",
                       help="observed reads: `lean-ctx session readset --json` output, a JSON list or one path per line")
    write.add_argument("--observed-reads-from-session", action="store_true",
                       help="run `lean-ctx session readset --json` ($LEAN_CTX_BIN) for this repository's root")
    write.add_argument("--session-id", action="append", metavar="ID",
                       help="LeanCTX session to read (repeatable; default: the latest one for the root)")
    write.add_argument("--features", action="append", metavar="LIST",
                       help="cargo feature set of the checks, comma separated (repeatable)")
    write.add_argument("--derivations", metavar="FILE", help="JSON list overriding ci/derivations.toml")
    write.add_argument("--rustc-version", help="rustc -V output to record instead of running rustc")
    write.add_argument("--dry-run", action="store_true", help="print the envelope, write no note")
    write.set_defaults(func=cmd_write)

    for name, func, text in (("show", cmd_show, "print the envelope"), ("verify", cmd_verify, "check schema and ancestry")):
        command = sub.add_parser(name, help=text)
        command.add_argument("commit", nargs="?", default="HEAD")
        command.set_defaults(func=func)

    reads = sub.add_parser("verify-reads", help="check that the observed reads cover what the change depends on")
    reads.add_argument("commit", nargs="?", default="HEAD")
    reads.add_argument("--json", action="store_true", help=f"print the {COVERAGE_SCHEMA} verdict")
    reads.set_defaults(func=cmd_verify_reads)
    return root


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        return args.func(args)
    except EnvelopeError as exc:
        print(f"eccp-envelope: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
