{
  "kind": "manifest",
  "manifest": {
    "schema_version": 1,
    "capability_id": "capability://leanctx/tool-output-optimizer",
    "provider": "leanctx",
    "kind": "tool",
    "version": "1.0.0",
    "surfaces": ["mcp", "shell"],
    "support_matrix": {
      "mcp": {
