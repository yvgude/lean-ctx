{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:tools": "node scripts/generate-tool-docs.mjs",
    "validate:tools": "node scripts/validate-tool-docs.mjs",
    "validate:i18n-dupes": "node scripts/validate-i18n-duplicates.mjs",
    "build": "node scripts/generate-tool-docs.mjs && node scripts/validate-tool-docs.mjs && node scripts/validate-i18n-duplicates.mjs && astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.8",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "pagefind": "^1.4.0"
  }
}
