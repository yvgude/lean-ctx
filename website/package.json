{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:tools": "node scripts/generate-tool-docs.mjs",
    "validate:tools": "node scripts/validate-tool-docs.mjs",
    "validate:docs-coverage": "node scripts/validate-docs-coverage.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:i18n-dupes": "node scripts/validate-i18n-duplicates.mjs",
    "validate:positioning": "node scripts/validate-positioning.mjs",
    "validate:facts": "node scripts/validate-facts.mjs",
    "validate:journeys": "node scripts/validate-journeys.mjs",
    "validate": "npm run validate:manifest && npm run validate:positioning && npm run validate:facts && npm run validate:journeys && npm run validate:i18n && npm run validate:i18n-dupes && npm run validate:docs-coverage",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.8",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "pagefind": "^1.4.0"
  }
}
