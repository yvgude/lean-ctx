---
const capabilities = [
  {
    label: "Understand",
    iconPath: "M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178zM15 12a3 3 0 11-6 0 3 3 0 016 0z",
    color: "green",
    features: [
      "10 read modes",
      "Context visibility",
      "Token counting",
      "Intent detection",
    ],
  },
  {
    label: "Compress",
    iconPath: "M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25",
    color: "green",
    features: [
      "Tree-sitter AST (18 langs)",
      "95+ shell patterns",
      "CDC reorder (Rabin-Karp)",
      "64 KB budget, 500 ms deadline",
    ],
  },
  {
    label: "Remember",
    iconPath: "M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125",
    color: "green",
    features: [
      "Session cache (zstd, in-memory)",
      "13-token re-reads",
      "Knowledge graph (SQLite)",
      "Cross-session memory",
    ],
  },
  {
    label: "Verify",
    iconPath: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
    color: "green",
    features: [
      "PathJail sandbox",
      "OS-level isolation",
      "Shell allowlist (deny-by-default)",
      "Full audit trail",
    ],
  },
  {
    label: "Connect",
    iconPath: "M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.364-3.06a4.5 4.5 0 00-6.364 0l-4.5 4.5a4.5 4.5 0 006.364 6.364l1.757-1.757",
    color: "green",
    features: [
      "GitHub · GitLab · Jira · Linear",
      "Postgres · REST · MCP Bridge",
      "Hybrid search (BM25 + semantic)",
      "Config-based providers (TOML)",
    ],
  },
];
---

<div class="dia animate-entrance" role="img" aria-label="LeanCTX architecture">

  <!-- ── TOP NODE ── -->
  <div class="dia-endpoint">
    <div class="dia-endpoint-dot"></div>
    <span class="dia-endpoint-label">Your AI Tool</span>
    <span class="dia-endpoint-sub">Cursor · Claude Code · Copilot · Windsurf</span>
  </div>

  <!-- ── CONNECTOR DOWN ── -->
  <div class="dia-connector">
    <div class="dia-connector-line"></div>
    <div class="dia-connector-tag">MCP · CLI · HTTP</div>
    <div class="dia-connector-line"></div>
    <div class="dia-connector-chevron">
      <svg width="16" height="10" viewBox="0 0 16 10"><path d="M2 2l6 6 6-6" stroke="var(--color-accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>

  <!-- ── MAIN RUNTIME BOX ── -->
  <div class="dia-runtime">

    <!-- Header -->
    <div class="dia-header">
      <span class="dia-title font-display">lean-ctx</span>
      <span class="dia-subtitle">Cognitive Context Layer · Single binary · 68 tools</span>
    </div>

    <!-- Pipeline -->
    <div class="dia-pipeline">
      {capabilities.map((cap, i) => (
        <div class="dia-cell">
          <div class={`dia-card dia-card--${cap.color}`}>
            <div class="dia-card-head">
              <svg class="dia-card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={cap.iconPath}/></svg>
              <span class="dia-card-title">{cap.label}</span>
            </div>
            <ul class="dia-card-features">
              {cap.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
          {i < capabilities.length - 1 && (
            <div class="dia-card-arrow">
              <svg width="28" height="16" viewBox="0 0 28 16">
                <path d="M2 8h18m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Stats -->
    <div class="dia-stats">
      <div class="dia-stat"><strong>10</strong><span>read modes</span></div>
      <div class="dia-stat-dot"></div>
      <div class="dia-stat"><strong>13</strong><span>tokens per re-read</span></div>
      <div class="dia-stat-dot"></div>
      <div class="dia-stat"><strong>18</strong><span>languages (AST)</span></div>
    </div>
  </div>

  <!-- ── CONNECTOR DOWN ── -->
  <div class="dia-connector">
    <div class="dia-connector-chevron" style="transform: rotate(180deg);">
      <svg width="16" height="10" viewBox="0 0 16 10"><path d="M2 2l6 6 6-6" stroke="var(--color-accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="dia-connector-line"></div>
    <div class="dia-connector-tag">optimized context</div>
    <div class="dia-connector-line"></div>
    <div class="dia-connector-chevron">
      <svg width="16" height="10" viewBox="0 0 16 10"><path d="M2 2l6 6 6-6" stroke="var(--color-accent)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>

  <!-- ── BOTTOM NODE ── -->
  <div class="dia-endpoint">
    <div class="dia-endpoint-dot dia-endpoint-dot--accent"></div>
    <span class="dia-endpoint-label">LLM</span>
    <span class="dia-endpoint-sub">Less noise · Higher signal · Better results</span>
  </div>
</div>

<style>
  .dia {
    --dia-border: var(--color-border);
    --dia-border-light: var(--color-border-light);

    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ═══ Endpoint nodes ═══ */

  .dia-endpoint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: clamp(1rem, 0.8rem + 0.5vw, 1.5rem) clamp(2rem, 1.5rem + 1vw, 3rem);
    border: 1px dashed var(--dia-border-light);
    border-radius: 999px;
    background: var(--color-surface);
    position: relative;
  }

  .dia-endpoint-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dia-border-light);
    margin-bottom: 0.125rem;
  }

  .dia-endpoint-dot--accent {
    background: var(--color-accent);
  }

  .dia-endpoint-label {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1rem + 0.2vw, 1.25rem);
    font-weight: 700;
    color: var(--color-text-bright);
  }

  .dia-endpoint-sub {
    font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);
    color: var(--color-muted);
  }

  /* ═══ Vertical connectors ═══ */

  .dia-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 0.125rem 0;
  }

  .dia-connector-line {
    width: 1px;
    height: clamp(14px, 1.2vw, 20px);
    background: var(--dia-border-light);
  }

  .dia-connector-tag {
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem);
    font-weight: 600;
    color: var(--color-muted);
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--dia-border);
    border-radius: 999px;
    background: var(--color-surface);
    letter-spacing: 0.03em;
  }

  .dia-connector-chevron {
    line-height: 0;
  }

  /* ═══ Main runtime box ═══ */

  .dia-runtime {
    width: 100%;
    border: 1px solid var(--dia-border-light);
    border-radius: clamp(16px, 1.2vw, 24px);
    background: var(--color-surface);
    overflow: hidden;
    position: relative;
  }

  /* Header */
  .dia-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: clamp(1.25rem, 1rem + 0.75vw, 2rem);
    border-bottom: 1px solid var(--dia-border);
    position: relative;
  }

  .dia-title {
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text-bright);
    line-height: 1;
  }

  .dia-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem);
    color: var(--color-muted);
  }

  /* ═══ Pipeline grid ═══ */

  .dia-pipeline {
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
    padding: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    gap: 0;
    position: relative;
  }

  .dia-cell {
    display: flex;
    align-items: center;
  }

  .dia-card {
    display: flex;
    flex-direction: column;
    width: clamp(155px, 13vw, 200px);
    border: 1px solid var(--dia-border);
    border-radius: clamp(10px, 0.8vw, 14px);
    background: var(--color-bg);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .dia-card:hover {
    transform: translateY(-4px);
  }

  .dia-card--green { border-color: color-mix(in srgb, var(--color-accent) 22%, transparent); }
  .dia-card--green:hover { border-color: color-mix(in srgb, var(--color-accent) 50%, transparent); }

  /* Card head */
  .dia-card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: clamp(0.625rem, 0.5rem + 0.25vw, 0.875rem) clamp(0.75rem, 0.6rem + 0.3vw, 1rem);
    border-bottom: 1px solid var(--dia-border);
  }

  .dia-card--green .dia-card-head { background: color-mix(in srgb, var(--color-accent) 6%, transparent); }

  .dia-card-icon {
    width: clamp(1.125rem, 1rem + 0.3vw, 1.375rem);
    height: clamp(1.125rem, 1rem + 0.3vw, 1.375rem);
    flex-shrink: 0;
  }

  .dia-card--green .dia-card-icon { color: var(--color-accent); }

  .dia-card-title {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.88rem + 0.18vw, 1.0625rem);
    font-weight: 700;
    color: var(--color-text-bright);
  }

  /* Card features */
  .dia-card-features {
    list-style: none;
    margin: 0;
    padding: clamp(0.625rem, 0.5rem + 0.25vw, 0.875rem) clamp(0.75rem, 0.6rem + 0.3vw, 1rem);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .dia-card-features li {
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
    color: var(--color-muted);
    line-height: 1.35;
    padding-left: 1.125rem;
    position: relative;
  }

  .dia-card-features li::before {
    content: '→';
    position: absolute;
    left: 0;
    font-size: 0.75em;
    font-weight: 700;
    opacity: 0.5;
  }

  .dia-card--green .dia-card-features li::before { color: var(--color-accent); }

  /* Flow arrows between cards */
  .dia-card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 clamp(0.25rem, 0.2vw, 0.5rem);
    color: var(--color-muted);
    opacity: 0.4;
    flex-shrink: 0;
  }

  /* ═══ Stats bar ═══ */

  .dia-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    padding: clamp(1rem, 0.75rem + 0.5vw, 1.25rem);
    border-top: 1px solid var(--dia-border);
  }

  .dia-stat {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .dia-stat strong {
    font-family: var(--font-mono);
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
  }

  .dia-stat span {
    font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);
    color: var(--color-muted);
  }

  .dia-stat-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--dia-border-light);
    flex-shrink: 0;
  }

  /* ═══ Responsive ═══ */

  @media (max-width: 1100px) {
    .dia-pipeline { gap: clamp(0.5rem, 0.3rem + 0.4vw, 0.75rem); }
    .dia-card-arrow { display: none; }
    .dia-card { width: calc(33.333% - 0.75rem); min-width: 145px; flex: 1 1 auto; }
  }

  @media (max-width: 700px) {
    .dia-pipeline {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    }

    .dia-cell {
      width: 100%;
    }

    .dia-card {
      width: 100%;
    }

    .dia-cell:last-child {
      grid-column: 1 / -1;
    }

    .dia-endpoint {
      padding: 0.75rem 1.25rem;
    }

    .dia-endpoint-sub {
      font-size: 0.6875rem;
    }

    .dia-connector-tag {
      font-size: 0.625rem;
      padding: 0.1875rem 0.5rem;
    }

    .dia-header {
      padding: clamp(1rem, 0.75rem + 0.5vw, 1.25rem);
    }

    .dia-title {
      font-size: clamp(1.375rem, 1.2rem + 0.5vw, 1.75rem);
    }

    .dia-card-head {
      padding: 0.5rem 0.625rem;
    }

    .dia-card-features {
      padding: 0.5rem 0.625rem;
      gap: 0.25rem;
    }

    .dia-card-features li {
      font-size: 0.6875rem;
    }

    .dia-stats {
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.875rem;
    }

    .dia-stat-dot { display: none; }
  }

  @media (max-width: 420px) {
    .dia-pipeline {
      grid-template-columns: 1fr;
    }

    .dia-cell:last-child {
      grid-column: auto;
    }
  }
</style>
