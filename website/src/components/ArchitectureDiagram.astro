---
const capabilities = [
  { label: "Understand", sub: "Context visibility", color: "accent" },
  { label: "Compress", sub: "10 read modes", color: "accent" },
  { label: "Remember", sub: "Cross-session memory", color: "accent-2" },
  { label: "Verify", sub: "Quality & budgets", color: "accent-2" },
  { label: "Connect", sub: "Any data source", color: "accent-3" },
];

const architectureLayers = [
  {
    label: "Smart I/O",
    color: "accent",
    items: ["Tree-sitter AST (18 langs)", "95+ shell patterns", "Session cache (zstd)", "13-token re-reads"],
  },
  {
    label: "Intelligence",
    color: "accent-2",
    items: ["Hybrid search (BM25 + semantic)", "Knowledge graph (SQLite)", "Intent classification", "Progressive throttling"],
  },
  {
    label: "Security",
    color: "accent-3",
    items: ["PathJail sandbox", "Shell allowlist", "OS-level isolation", "Full audit trail"],
  },
];
---

<div class="ad animate-entrance" role="img" aria-label="lean-ctx architecture diagram">

  <div class="ad-endpoint ad-endpoint--top">
    <span class="ad-endpoint-label">Your AI Tool</span>
    <span class="ad-endpoint-sub">Cursor · Claude Code · Copilot · 24+ more</span>
  </div>

  <div class="ad-connector">
    <svg width="2" height="28" viewBox="0 0 2 28"><line x1="1" y1="0" x2="1" y2="28" stroke="var(--color-border)" stroke-width="1.5"/></svg>
  </div>

  <div class="ad-runtime">
    <div class="ad-runtime-header">
      <span class="ad-runtime-title font-display">lean-ctx</span>
      <span class="ad-runtime-sub">Context Runtime · Single binary · 62 MCP tools</span>
    </div>

    <div class="ad-pipeline">
      {capabilities.map((cap, i) => (
        <div class="ad-step-wrap">
          <div class={`ad-step ad-step--${cap.color}`}>
            <span class="ad-step-label">{cap.label}</span>
            <span class="ad-step-sub">{cap.sub}</span>
          </div>
          {i < capabilities.length - 1 && (
            <svg class="ad-arrow" width="20" height="12" viewBox="0 0 20 12">
              <path d="M0 6h14m0 0l-4-4m4 4l-4 4" stroke="var(--color-muted)" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            </svg>
          )}
        </div>
      ))}
    </div>

    <div class="ad-divider">
      <span class="ad-divider-label">powered by</span>
    </div>

    <div class="ad-layers">
      {architectureLayers.map((layer) => (
        <div class={`ad-layer ad-layer--${layer.color}`}>
          <span class="ad-layer-title">{layer.label}</span>
          <ul class="ad-layer-list">
            {layer.items.map((item) => (
              <li class="ad-layer-item">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="ad-connector">
    <svg width="2" height="28" viewBox="0 0 2 28"><line x1="1" y1="0" x2="1" y2="28" stroke="var(--color-border)" stroke-width="1.5"/></svg>
  </div>

  <div class="ad-endpoint ad-endpoint--bottom">
    <span class="ad-endpoint-label">LLM</span>
    <span class="ad-endpoint-sub">Optimized context · less noise · higher signal</span>
  </div>
</div>

<style>
  .ad {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .ad-endpoint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.75rem 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: 2rem;
    background: var(--color-surface);
    text-align: center;
  }

  .ad-endpoint-label {
    font-family: var(--font-display);
    font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);
    font-weight: 600;
    color: var(--color-text-bright);
  }

  .ad-endpoint-sub {
    font-size: clamp(0.625rem, 0.6rem + 0.08vw, 0.75rem);
    color: var(--color-muted);
  }

  .ad-connector {
    display: flex;
    justify-content: center;
  }

  .ad-runtime {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    animation: runtime-glow 4s ease-in-out infinite;
  }

  @keyframes runtime-glow {
    0%, 100% { box-shadow: 0 0 24px rgba(52, 211, 153, 0.04), 0 0 64px rgba(52, 211, 153, 0.02); }
    50% { box-shadow: 0 0 32px rgba(52, 211, 153, 0.08), 0 0 80px rgba(52, 211, 153, 0.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ad-runtime { animation: none; }
  }

  .ad-runtime-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .ad-runtime-title {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-bright);
    line-height: 1;
  }

  .ad-runtime-sub {
    font-family: var(--font-mono);
    font-size: clamp(0.5625rem, 0.55rem + 0.05vw, 0.6875rem);
    color: var(--color-muted);
  }

  .ad-pipeline {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
  }

  .ad-step-wrap {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .ad-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.5rem 0.875rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    text-align: center;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .ad-step:hover {
    transform: translateY(-2px);
  }

  .ad-step--accent:hover { border-color: rgba(52, 211, 153, 0.3); }
  .ad-step--accent-2:hover { border-color: rgba(129, 140, 248, 0.3); }
  .ad-step--accent-3:hover { border-color: rgba(212, 160, 255, 0.3); }

  .ad-step-label {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
    font-weight: 700;
    color: var(--color-text-bright);
    line-height: 1.2;
  }

  .ad-step-sub {
    font-size: clamp(0.5625rem, 0.55rem + 0.04vw, 0.625rem);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .ad-arrow {
    flex-shrink: 0;
    margin: 0 0.125rem;
  }

  .ad-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
  }

  .ad-divider::before,
  .ad-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .ad-divider-label {
    font-family: var(--font-mono);
    font-size: clamp(0.5625rem, 0.55rem + 0.04vw, 0.625rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .ad-layers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 768px) {
    .ad-layers { grid-template-columns: repeat(3, 1fr); }
  }

  .ad-layer {
    padding: clamp(0.875rem, 0.75rem + 0.3vw, 1.25rem);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .ad-layer { border-top: none; }
    .ad-layer + .ad-layer { border-left: 1px solid var(--color-border); }
  }

  .ad-layer-title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .ad-layer--accent .ad-layer-title { color: var(--color-accent); }
  .ad-layer--accent-2 .ad-layer-title { color: var(--color-accent-2); }
  .ad-layer--accent-3 .ad-layer-title { color: var(--color-accent-3); }

  .ad-layer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ad-layer-item {
    font-size: clamp(0.625rem, 0.6rem + 0.08vw, 0.75rem);
    color: var(--color-muted);
    line-height: 1.4;
    padding-left: 0.75rem;
    position: relative;
  }

  .ad-layer-item::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-border);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .ad-pipeline {
      gap: 0.25rem;
    }

    .ad-arrow {
      display: none;
    }

    .ad-step-wrap {
      flex: 1;
      min-width: calc(50% - 0.25rem);
    }

    .ad-step {
      width: 100%;
    }
  }
</style>
