---
const layers = [
  {
    id: "io",
    label: "Smart I/O",
    accent: "accent",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>`,
    groups: [
      {
        title: "Read Modes",
        items: ["full", "map", "signatures", "aggressive", "entropy", "auto", "diff", "lines", "task", "reference"],
      },
      {
        title: "Shell Compression",
        items: ["95+ patterns", "git", "npm/yarn", "cargo", "docker", "kubectl", "pytest", "make"],
      },
      {
        title: "Parsing",
        items: ["Tree-sitter AST", "18 languages", "Markdown headings", "JSON/YAML/TOML keys", "Lock file summaries"],
      },
      {
        title: "Caching",
        items: ["Session cache", "Content-hash dedup", "13-token re-reads", "TTL eviction"],
      },
    ],
  },
  {
    id: "intel",
    label: "Intelligence",
    accent: "accent-2",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/><path d="M12 2a10 10 0 0 1 10 10"/><path d="M12 12l8-2"/></svg>`,
    groups: [
      {
        title: "Search",
        items: ["BM25 index", "Semantic embeddings", "Graph proximity", "RRF fusion", "Adaptive pipeline"],
      },
      {
        title: "Knowledge",
        items: ["Knowledge graph", "Cross-session memory", "Context checkpoints", "Project facts"],
      },
      {
        title: "Compression Quality",
        items: ["AST preservation (50%)", "Identifier preservation (30%)", "Line preservation (20%)", "Minimum density (15% ρ)", "Quality threshold (≥95%)"],
      },
      {
        title: "Context Control",
        items: ["Intent classification", "Progressive throttling", "Token budgets", "Terse mode", "Profile-based access"],
      },
    ],
  },
  {
    id: "integrations",
    label: "Integrations",
    accent: "accent-3",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
    groups: [
      {
        title: "Integration Modes",
        items: ["CLI-Redirect", "Hybrid MCP", "Full MCP", "HTTP/SSE server"],
      },
      {
        title: "Tooling",
        items: ["24+ AI tools", "Auto-setup", "Shell hooks", "LaunchAgent daemon"],
      },
      {
        title: "Data Sources",
        items: ["GitHub / GitLab", "Jira / Linear", "Postgres / REST", "Config-based providers", "TOML definitions"],
      },
      {
        title: "Security",
        items: ["PathJail sandbox", "Shell allowlist", "Bounded locks", "Full audit trail", "OWASP aligned"],
      },
    ],
  },
];
---

<div class="arch-root animate-entrance" role="region" aria-label="Architecture diagram">
  <div class="arch-core">
    <div class="arch-core-inner">
      <span class="arch-core-title font-display">lean-ctx</span>
      <span class="arch-core-subtitle">Context Runtime for AI Agents</span>
    </div>
  </div>

  <div class="arch-columns">
    {layers.map((layer) => (
      <div class={`arch-col arch-col--${layer.accent}`}>
        <div class="arch-col-header">
          <span class="arch-col-icon" set:html={layer.icon} />
          <span class="arch-col-title">{layer.label}</span>
        </div>

        <div class="arch-col-body">
          {layer.groups.map((group) => (
            <div class="arch-group">
              <span class="arch-group-title">{group.title}</span>
              <div class="arch-group-items">
                {group.items.map((item, j) => (
                  <span
                    class={`arch-pill arch-pill--${layer.accent}`}
                    style={`--pill-i: ${j}`}
                  >{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .arch-root {
    width: 100%;
  }

  .arch-core {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);
  }

  .arch-core-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 1.25rem 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg);
    background: var(--color-surface);
    animation: core-glow 4s ease-in-out infinite;
  }

  .arch-core-title {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-text-bright);
    line-height: 1;
  }

  .arch-core-subtitle {
    font-size: clamp(0.6875rem, 0.65rem + 0.12vw, 0.8125rem);
    color: var(--color-muted);
  }

  @keyframes core-glow {
    0%, 100% {
      box-shadow: 0 0 20px rgba(52, 211, 153, 0.06), 0 0 60px rgba(52, 211, 153, 0.03);
    }
    50% {
      box-shadow: 0 0 30px rgba(52, 211, 153, 0.12), 0 0 80px rgba(52, 211, 153, 0.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-core-inner {
      animation: none;
      box-shadow: 0 0 20px rgba(52, 211, 153, 0.06);
    }
  }

  .arch-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 0.75rem + 0.5vw, 1.25rem);
  }

  @media (min-width: 768px) {
    .arch-columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .arch-col {
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .arch-col--accent:hover { border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border)); }
  .arch-col--accent-2:hover { border-color: color-mix(in srgb, var(--color-accent-2) 30%, var(--color-border)); }
  .arch-col--accent-3:hover { border-color: color-mix(in srgb, var(--color-accent-3) 30%, var(--color-border)); }

  .arch-col-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: clamp(0.875rem, 0.75rem + 0.3vw, 1.125rem) clamp(1rem, 0.875rem + 0.4vw, 1.25rem);
    border-bottom: 1px solid var(--color-border);
  }

  .arch-col-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
  }

  .arch-col--accent .arch-col-icon { color: var(--color-accent); background: rgba(52, 211, 153, 0.08); }
  .arch-col--accent-2 .arch-col-icon { color: var(--color-accent-2); background: rgba(129, 140, 248, 0.08); }
  .arch-col--accent-3 .arch-col-icon { color: var(--color-accent-3); background: rgba(212, 160, 255, 0.08); }

  .arch-col-title {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1.0625rem);
    font-weight: 700;
    color: var(--color-text-bright);
  }

  .arch-col-body {
    padding: clamp(0.875rem, 0.75rem + 0.3vw, 1.125rem) clamp(1rem, 0.875rem + 0.4vw, 1.25rem);
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 0.75rem + 0.5vw, 1.25rem);
  }

  .arch-group-title {
    display: block;
    font-size: clamp(0.6875rem, 0.66rem + 0.08vw, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 0.375rem;
  }

  .arch-group-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .arch-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: clamp(0.5625rem, 0.55rem + 0.06vw, 0.6875rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .arch-pill--accent {
    background: rgba(52, 211, 153, 0.06);
    border: 1px solid rgba(52, 211, 153, 0.14);
    color: var(--color-accent);
  }

  .arch-pill--accent-2 {
    background: rgba(129, 140, 248, 0.06);
    border: 1px solid rgba(129, 140, 248, 0.14);
    color: var(--color-accent-2);
  }

  .arch-pill--accent-3 {
    background: rgba(212, 160, 255, 0.06);
    border: 1px solid rgba(212, 160, 255, 0.14);
    color: var(--color-accent-3);
  }
</style>
