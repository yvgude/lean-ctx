---
const steps = [
  { label: "Understand", color: "green" },
  { label: "Compress", color: "green" },
  { label: "Remember", color: "indigo" },
  { label: "Verify", color: "indigo" },
  { label: "Connect", color: "purple" },
];

const layers = [
  { label: "Smart I/O", detail: "10 modes · AST · 95+ patterns", color: "green" },
  { label: "Intelligence", detail: "Search · Knowledge · Memory", color: "indigo" },
  { label: "Security", detail: "PathJail · Sandbox · Audit", color: "purple" },
];
---

<div class="dia animate-entrance" role="img" aria-label="lean-ctx architecture">

  <!-- TOP NODE -->
  <div class="dia-node">
    <span class="dia-node-label">Your AI Tool</span>
  </div>

  <div class="dia-line"></div>

  <!-- MAIN BOX -->
  <div class="dia-box">
    <div class="dia-box-head">
      <span class="dia-box-title font-display">lean-ctx</span>
    </div>

    <!-- PIPELINE -->
    <div class="dia-pipeline">
      {steps.map((s, i) => (
        <div class="dia-step-group">
          <div class={`dia-step dia-step--${s.color}`}>
            <span class="dia-step-label">{s.label}</span>
          </div>
          {i < steps.length - 1 && (
            <svg class="dia-arrow" viewBox="0 0 20 12" width="20" height="12">
              <path d="M2 6h12m0 0l-4-4m4 4l-4 4" stroke="var(--color-border-light)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </div>
      ))}
    </div>

    <!-- LAYER BAR -->
    <div class="dia-layers">
      {layers.map((l) => (
        <div class={`dia-layer dia-layer--${l.color}`}>
          <span class="dia-layer-label">{l.label}</span>
          <span class="dia-layer-detail">{l.detail}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="dia-line"></div>

  <!-- BOTTOM NODE -->
  <div class="dia-node">
    <span class="dia-node-label">LLM</span>
    <span class="dia-node-sub">~96% fewer tokens</span>
  </div>
</div>

<style>
  .dia {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Nodes (top/bottom) ── */

  .dia-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.625rem 1.75rem;
    border: 1.5px dashed var(--color-border-light);
    border-radius: 999px;
    background: var(--color-surface);
  }

  .dia-node-label {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 0.88rem + 0.2vw, 1.125rem);
    font-weight: 700;
    color: var(--color-text-bright);
  }

  .dia-node-sub {
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 0.6rem + 0.08vw, 0.75rem);
    color: var(--color-accent);
    font-weight: 600;
  }

  /* ── Connector line ── */

  .dia-line {
    width: 1.5px;
    height: clamp(24px, 2vw, 36px);
    background: var(--color-border);
  }

  /* ── Main box ── */

  .dia-box {
    width: 100%;
    max-width: 56rem;
    border: 2px solid var(--color-border-light);
    border-radius: clamp(12px, 1vw, 20px);
    background: var(--color-surface);
    overflow: hidden;
    animation: glow 4s ease-in-out infinite;
  }

  @keyframes glow {
    0%, 100% { box-shadow: 0 0 40px rgba(52, 211, 153, 0.04); }
    50% { box-shadow: 0 0 60px rgba(52, 211, 153, 0.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dia-box { animation: none; }
  }

  .dia-box-head {
    padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    text-align: center;
    border-bottom: 1.5px solid var(--color-border);
    background: linear-gradient(180deg, rgba(52, 211, 153, 0.03) 0%, transparent 100%);
  }

  .dia-box-title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text-bright);
  }

  /* ── Pipeline (horizontal flow) ── */

  .dia-pipeline {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: clamp(1.25rem, 1rem + 0.75vw, 2rem) clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
  }

  .dia-step-group {
    display: flex;
    align-items: center;
  }

  .dia-step {
    padding: clamp(0.5rem, 0.4rem + 0.2vw, 0.75rem) clamp(0.875rem, 0.7rem + 0.4vw, 1.25rem);
    border: 1.5px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    transition: border-color 0.2s, transform 0.2s;
    cursor: default;
  }

  .dia-step:hover { transform: translateY(-2px); }
  .dia-step--green { border-color: rgba(52, 211, 153, 0.25); }
  .dia-step--green:hover { border-color: rgba(52, 211, 153, 0.6); }
  .dia-step--indigo { border-color: rgba(129, 140, 248, 0.25); }
  .dia-step--indigo:hover { border-color: rgba(129, 140, 248, 0.6); }
  .dia-step--purple { border-color: rgba(212, 160, 255, 0.25); }
  .dia-step--purple:hover { border-color: rgba(212, 160, 255, 0.6); }

  .dia-step-label {
    font-family: var(--font-display);
    font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);
    font-weight: 700;
    color: var(--color-text-bright);
    white-space: nowrap;
  }

  .dia-arrow {
    flex-shrink: 0;
    margin: 0 clamp(0.125rem, 0.1vw, 0.375rem);
  }

  /* ── Layer bar (bottom of box) ── */

  .dia-layers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1.5px solid var(--color-border);
  }

  .dia-layer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: clamp(0.75rem, 0.5rem + 0.5vw, 1.125rem) 0.5rem;
    text-align: center;
  }

  .dia-layer + .dia-layer {
    border-left: 1px solid var(--color-border);
  }

  .dia-layer-label {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
    font-weight: 700;
  }

  .dia-layer--green .dia-layer-label { color: var(--color-accent); }
  .dia-layer--indigo .dia-layer-label { color: var(--color-accent-2); }
  .dia-layer--purple .dia-layer-label { color: var(--color-accent-3); }

  .dia-layer-detail {
    font-size: clamp(0.625rem, 0.6rem + 0.08vw, 0.75rem);
    color: var(--color-muted);
  }

  /* ── Mobile ── */

  @media (max-width: 640px) {
    .dia-pipeline { gap: 0.375rem; }
    .dia-arrow { display: none; }
    .dia-step-group { flex: 1; min-width: calc(50% - 0.25rem); }
    .dia-step { width: 100%; text-align: center; }
    .dia-layers { grid-template-columns: 1fr; }
    .dia-layer + .dia-layer { border-left: none; border-top: 1px solid var(--color-border); }
  }
</style>
