const art = scenes[variant] || scenes['index'];

const tileHorizontally = (block: string, repeats: number) => {
  const lines = block.split('\n');
  const maxLen = Math.max(...lines.map(l => l.length));
  const padded = lines.map(l => l.padEnd(maxLen));
  return padded.map(line => Array(repeats).fill(line).join('  ')).join('\n');
};

const tiledArt = tileHorizontally(art, 3);
const fullArt = tiledArt + '\n' + tiledArt;
---

<div class="ascii-hero-bg" aria-hidden="true">
  <pre set:text={fullArt} />
</div>

<style>
  .ascii-hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: -2;
    pointer-events: none;
    contain: strict;
  }
  .ascii-hero-bg pre {
    font-family: var(--font-mono);
    font-size: clamp(9px, 1.1vw, 15px);
    line-height: 1.3;
    white-space: pre;
    text-align: left;
    margin: 0;
    padding: 0;
    user-select: none;
    color: transparent;
    background: linear-gradient(
      90deg,
      #34d399 0%,
      #818cf8 25%,
      #34d399 50%,
      #818cf8 75%,
      #34d399 100%
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0.45;
    animation: ascii-color-flow 15s linear infinite;
    will-change: background-position;
    transform: translateZ(0);
  }
  @keyframes ascii-color-flow {
    0% { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }
</style>
