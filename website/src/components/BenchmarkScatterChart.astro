---
const points = [
  { id: 'full',       x: 100, y: 100, label: 'full',       dim: true },
  { id: 'map',        x: 26,  y: 88,  label: 'map',        dim: false },
  { id: 'auto',       x: 18,  y: 90,  label: 'auto',       dim: false },
  { id: 'entropy',    x: 12,  y: 78,  label: 'entropy',    dim: false },
  { id: 'signatures', x: 8,   y: 65,  label: 'signatures', dim: false },
  { id: 'aggressive', x: 5,   y: 60,  label: 'aggressive', dim: false },
];

const xMin = 0, xMax = 100;
const yMin = 50, yMax = 100;
const svgLeft = 80, svgRight = 560;
const svgTop = 40, svgBottom = 350;

function toSvgX(val: number) {
  return svgLeft + ((val - xMin) / (xMax - xMin)) * (svgRight - svgLeft);
}
function toSvgY(val: number) {
  return svgBottom - ((val - yMin) / (yMax - yMin)) * (svgBottom - svgTop);
}

const yTicks = [50, 60, 70, 80, 90, 100];
const xTicks = [0, 20, 40, 60, 80, 100];

const mapped = points.map((p, i) => ({
  ...p,
  sx: toSvgX(p.x),
  sy: toSvgY(p.y),
  index: i,
}));
---

<div class="scatter-chart animate-entrance">
  <svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Scatter chart comparing lean-ctx read modes by token consumption versus information preserved">

    {/* Grid lines */}
    {yTicks.map(t => (
      <line
        x1={svgLeft} y1={toSvgY(t)}
        x2={svgRight} y2={toSvgY(t)}
        stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4"
      />
    ))}
    {xTicks.map(t => (
      <line
        x1={toSvgX(t)} y1={svgTop}
        x2={toSvgX(t)} y2={svgBottom}
        stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4"
      />
    ))}

    {/* Axes */}
    <line x1={svgLeft} y1={svgBottom} x2={svgRight} y2={svgBottom} stroke="var(--color-border)" stroke-width="1" />
    <line x1={svgLeft} y1={svgTop} x2={svgLeft} y2={svgBottom} stroke="var(--color-border)" stroke-width="1" />

    {/* Y-axis ticks & labels */}
    {yTicks.map(t => (
      <text x={svgLeft - 10} y={toSvgY(t) + 4} text-anchor="end" class="scatter-tick">{t}%</text>
    ))}

    {/* X-axis ticks & labels */}
    {xTicks.map(t => (
      <text x={toSvgX(t)} y={svgBottom + 20} text-anchor="middle" class="scatter-tick">{t}%</text>
    ))}

    {/* Axis labels */}
    <text x={(svgLeft + svgRight) / 2} y={svgBottom + 38} text-anchor="middle" class="scatter-axis-label">Tokens consumed %</text>
    <text
      x={18} y={(svgTop + svgBottom) / 2}
      text-anchor="middle" class="scatter-axis-label"
      transform={`rotate(-90, 18, ${(svgTop + svgBottom) / 2})`}
    >Information preserved %</text>

    {/* "BEST" indicator */}
    <text x={svgLeft + 14} y={svgTop + 18} class="scatter-best">BEST &#x2197;</text>

    {/* Data points */}
    {mapped.map(p => (
      <g class={`scatter-point ${p.dim ? 'scatter-point--dim' : ''}`} style={`--i: ${p.index}`} data-point={p.id}>
        <circle cx={p.sx} cy={p.sy} r="8" class="scatter-dot" />
        <text
          x={p.sx + (p.id === 'full' ? -14 : p.id === 'auto' ? 0 : 14)}
          y={p.sy + (p.id === 'auto' ? -16 : p.id === 'full' ? -14 : -14)}
          text-anchor={p.id === 'full' ? 'end' : p.id === 'auto' ? 'middle' : 'start'}
          class="scatter-label"
        >{p.label}</text>

        {/* Tooltip */}
        <g class="scatter-tooltip" style={`--tx: ${p.sx}px; --ty: ${p.sy}px`}>
          <rect
            x={p.sx - 52} y={p.sy - 46}
            width="104" height="30" rx="4"
            fill="var(--color-surface-2)" stroke="var(--color-border)" stroke-width="1"
          />
          <text x={p.sx} y={p.sy - 27} text-anchor="middle" class="scatter-tooltip-text">
            {p.x}% tok · {p.y}% info
          </text>
        </g>
      </g>
    ))}
  </svg>
</div>

<style>
  .scatter-chart {
    width: 100%;
    max-width: 100%;
  }

  .scatter-chart svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .scatter-tick {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-muted);
  }

  .scatter-axis-label {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-text);
    letter-spacing: 0.02em;
  }

  .scatter-best {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    fill: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .scatter-dot {
    fill: var(--color-accent);
    transition: r 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .scatter-point--dim .scatter-dot {
    fill: var(--color-muted);
    opacity: 0.5;
  }

  .scatter-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    fill: var(--color-text-bright);
  }

  .scatter-point--dim .scatter-label {
    fill: var(--color-muted);
  }

  .scatter-tooltip {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .scatter-tooltip-text {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-text-bright);
  }

  .scatter-point:hover .scatter-dot {
    r: 12;
  }

  .scatter-point:hover .scatter-tooltip {
    opacity: 1;
  }

  .scatter-point {
    opacity: 0;
    transform: scale(0);
  }

  .scatter-chart.is-visible .scatter-point {
    animation: scatter-pop 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 0.1s);
  }

  @keyframes scatter-pop {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scatter-point {
      opacity: 1;
      transform: none;
    }
    .scatter-chart.is-visible .scatter-point {
      animation: none;
    }
  }
</style>
