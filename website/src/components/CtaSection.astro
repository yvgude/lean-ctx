---
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

interface CtaAction {
  label: string;
  href: string;
  variant: 'primary' | 'outline';
  external?: boolean;
  icon?: 'arrow' | 'github';
}

interface Props {
  eyebrow?: string;
  title: string;
  titleHighlight?: string;
  description?: string;
  descriptionHtml?: string;
  align?: 'left' | 'center';
  actions: CtaAction[];
}

const {
  eyebrow,
  title,
  titleHighlight,
  description,
  descriptionHtml,
  align = 'left',
  actions,
} = Astro.props;

const centered = align === 'center';
---

<section class="cta-section section-y">
  <div class="content-grid">
    <div class:list={['cta-inner', 'animate-entrance', centered && 'cta-center']}>

      {eyebrow && (
        <span class="cta-eyebrow kicker-pill text-muted">{eyebrow}</span>
      )}

      <h2 class="cta-title font-display">
        {title}
        {titleHighlight && (
          <>
            {' '}<span class="italic-accent">{titleHighlight}</span>
          </>
        )}
      </h2>

      {descriptionHtml ? (
        <p class="cta-desc" set:html={descriptionHtml} />
      ) : description ? (
        <p class="cta-desc">{description}</p>
      ) : null}

      <slot />

      <div class="cta-actions">
        {actions.map((a) => (
          <a
            href={a.href}
            class:list={['cta-btn', a.variant === 'primary' ? 'btn-primary' : 'btn-outline']}
            {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {a.icon === 'github' && (
              <svg class="cta-btn-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            )}
            {a.label}
            {a.icon === 'arrow' && (
              <svg class="cta-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            )}
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }
  .cta-center {
    align-items: center;
    text-align: center;
  }

  .cta-eyebrow {
    margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);
  }

  .cta-title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--weight-semibold);
    color: var(--color-text-bright);
    max-width: 48rem;
    margin: 0 0 clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    text-wrap: balance;
  }

  .cta-desc {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
    max-width: 44rem;
    margin: 0 0 clamp(2rem, 1.5rem + 1.5vw, 3.5rem);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: clamp(0.75rem, 0.6rem + 0.35vw, 1rem) clamp(1.5rem, 1.1rem + 0.8vw, 2.25rem);
    font-size: clamp(0.875rem, 0.84rem + 0.12vw, 1rem);
    font-weight: var(--weight-semibold);
    border-radius: var(--card-radius);
    text-decoration: none;
    line-height: 1;
  }

  .cta-btn-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .cta-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
