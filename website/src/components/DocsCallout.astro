---
interface Props {
  variant?: 'note' | 'warn' | 'danger';
  title?: string;
  class?: string;
  style?: string;
}
const { variant = 'note', title, class: className = '', style } = Astro.props;

const icons = {
  note: 'M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z',
  warn: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z',
  danger: 'M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z',
};
const path = icons[variant];
---
<aside class={`docs-callout docs-callout--${variant} not-prose ${className}`.trim()} style={style}>
  <svg class="docs-callout__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d={path} />
  </svg>
  <div class="docs-callout__body">
    {title && <p class="docs-callout__title">{title}</p>}
    <slot />
  </div>
</aside>
