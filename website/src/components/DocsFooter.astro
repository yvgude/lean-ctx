---
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { BRAND } from '../lib/positioning';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const year = new Date().getFullYear();
---

<footer class="docs-footer">
  <div class="docs-footer-inner">
    <p class="docs-footer-copy">
      &copy; {year} {BRAND} &middot; Apache-2.0 &middot;
      <a href={lp('/privacy')}>{t('footer.privacy')}</a> &middot;
      <a href={lp('/terms')}>Terms</a> &middot;
      <a href={lp('/imprint')}>Imprint</a>
    </p>
    <p class="docs-footer-swiss">
      <svg class="docs-footer-flag" viewBox="0 0 32 32" width="13" height="13" aria-hidden="true"><rect width="32" height="32" rx="4" fill="#D52B1E"/><rect x="6" y="13" width="20" height="6" rx="1" fill="#fff"/><rect x="13" y="6" width="6" height="20" rx="1" fill="#fff"/></svg>
      {t('footer.madeInSwitzerland')}
    </p>
  </div>
</footer>

<style>
  .docs-footer { border-top: 1px solid var(--color-border); margin-top: auto; }
  .docs-footer-inner {
    max-width: 96rem;
    margin-inline: auto;
    padding: 1.25rem clamp(1rem, 0.5rem + 1.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  @media (min-width: 640px) {
    .docs-footer-inner { flex-direction: row; justify-content: space-between; }
  }
  .docs-footer-copy { margin: 0; font-size: 0.75rem; color: var(--color-muted); opacity: 0.8; }
  .docs-footer-copy a { color: inherit; text-decoration: none; }
  .docs-footer-copy a:hover { color: var(--color-accent); }
  .docs-footer-swiss { margin: 0; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: var(--color-muted); opacity: 0.8; }
  .docs-footer-flag { flex-shrink: 0; }
</style>
