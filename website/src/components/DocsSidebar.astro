---
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { docsTree } from '../lib/docsTree';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const currentPath = Astro.url.pathname.replace(/\/$/, '');

function isActive(href: string): boolean {
  const page = lp(href).replace(/\/$/, '');
  return currentPath === page;
}
---

<!-- Mobile: one inline collapsible "Documentation" browser -->
<nav class="lg:hidden mb-8">
  <details class="docs-mobile-nav group">
    <summary>
      <span class="font-medium text-muted">{t('docs.documentation')}</span>
      <svg class="w-4 h-4 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </summary>
    <div class="px-2 pb-3 pt-1">
      {docsTree.map((group) => (
        <div class="mb-4 last:mb-0">
          <h4 class="docs-sb-group-title px-2">{group.title}</h4>
          {group.items.map((item) => (
            <a
              href={lp(item.href)}
              class:list={['docs-sb-link', isActive(item.href) && 'is-active']}
            >
              {item.label}
              {item.badge && <span class="docs-sb-badge">{item.badge}</span>}
            </a>
          ))}
        </div>
      ))}
    </div>
  </details>
</nav>

<!-- Desktop: persistent, grouped left rail (the wrapping .docs-rail handles sticky + scroll) -->
<aside class="hidden lg:block">
  <nav class="docs-sb">
    {docsTree.map((group) => {
      return (
        <details class="docs-sb-section" open>
          <summary class="docs-sb-summary">
            <span class="docs-sb-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${group.iconPath}"/></svg>`} />
            <h4 class="docs-sb-group-title m-0">{group.title}</h4>
            <svg class="docs-sb-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <ul class="docs-sb-list">
            {group.items.map((item) => (
              <li>
                <a
                  href={lp(item.href)}
                  class:list={['docs-sb-link', isActive(item.href) && 'is-active']}
                >
                  {item.label}
                  {item.badge && <span class="docs-sb-badge">{item.badge}</span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
  </nav>
</aside>

<style>
  .docs-sb {
    scrollbar-width: thin;
    scrollbar-color: var(--overlay-heavy) transparent;
  }
  .docs-sb::-webkit-scrollbar { width: 4px; }
  .docs-sb::-webkit-scrollbar-thumb { background: var(--overlay-heavy); border-radius: 2px; }

  /* Group title (eyebrow style, shared mobile + desktop) */
  .docs-sb-group-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--color-muted);
    opacity: 0.7;
    margin-bottom: 0.35rem;
  }

  /* Desktop section disclosure */
  .docs-sb-section { margin-bottom: 1rem; }
  .docs-sb-section:last-child { margin-bottom: 0; }
  .docs-sb-summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    cursor: pointer;
    list-style: none;
    border-radius: 9px;
    transition: background 0.15s ease;
  }
  .docs-sb-summary::-webkit-details-marker { display: none; }
  .docs-sb-summary:hover { background: var(--overlay-hover); }
  .docs-sb-icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    color: var(--color-muted);
    opacity: 0.75;
    flex: 0 0 auto;
  }
  .docs-sb-icon :global(svg) { width: 16px; height: 16px; }
  .docs-sb-summary .docs-sb-group-title { flex: 1 1 auto; margin-bottom: 0; }
  .docs-sb-chevron {
    color: var(--color-muted);
    opacity: 0.4;
    transition: transform 0.2s ease;
    flex: 0 0 auto;
  }
  .docs-sb-section[open] .docs-sb-chevron { transform: rotate(180deg); }

  .docs-sb-list {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0 0 0 0.5rem;
    border-inline-start: 1px solid var(--color-border);
    margin-inline-start: 0.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .docs-sb-link {
    display: block;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .docs-sb-link:hover { color: var(--color-text-bright); background: var(--overlay-hover); }
  .docs-sb-link.is-active {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 11%, transparent);
    font-weight: var(--weight-medium);
  }

  .docs-sb-badge {
    display: inline-block;
    font-size: 0.5625rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.0625rem 0.375rem;
    margin-inline-start: 0.4rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    vertical-align: middle;
  }

  /* Mobile disclosure shell */
  .docs-mobile-nav {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .docs-mobile-nav summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
  }
  .docs-mobile-nav summary::-webkit-details-marker { display: none; }
  .docs-mobile-nav summary svg { transition: transform 0.2s ease; }
  .docs-mobile-nav[open] summary svg { transform: rotate(180deg); }
  .docs-mobile-nav[open] { border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border)); }
  .docs-mobile-nav .docs-sb-link { font-size: 0.8125rem; }
</style>
