---
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

interface SidebarItem {
  label: string;
  href: string;
  badge?: string;
}

interface SidebarSection {
  title: string;
  compact?: boolean;
  collapsed?: boolean;
  items: SidebarItem[];
}

interface Props {
  sections?: SidebarSection[];
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const defaultSections: SidebarSection[] = [
  {
    title: t('docs.sidebarGettingStarted'),
    items: [
      { label: t('docs.sidebarOverview'), href: lp('/docs/getting-started') },
      { label: t('docs.sidebarQuickRef'), href: lp('/docs/quick-reference') },
      { label: 'IDE Setup', href: lp('/docs/ide-setup') },
      { label: t('docs.sidebarConfiguration'), href: lp('/docs/configuration') },
    ],
  },
  {
    title: 'Concepts',
    items: [
      { label: 'Read Modes', href: lp('/docs/concepts/read-modes'), badge: 'new' },
      { label: 'Caching & Compression', href: lp('/docs/concepts/caching'), badge: 'new' },
      { label: 'Shell Patterns', href: lp('/docs/concepts/shell-patterns'), badge: 'new' },
      { label: 'Protocols', href: lp('/docs/concepts/protocols'), badge: 'new' },
      { label: 'Multi-Agent', href: lp('/docs/concepts/multi-agent'), badge: 'new' },
      { label: 'Token Savings', href: lp('/docs/concepts/token-savings'), badge: 'new' },
    ],
  },
  {
    title: t('docs.sidebarReference'),
    items: [
      { label: t('docs.sidebarToolApi') + ' (46)', href: lp('/docs/tools') },
      { label: 'Core Tools', href: lp('/docs/tools/core') },
      { label: 'Intelligence', href: lp('/docs/tools/intelligence') },
      { label: 'Memory & Multi-Agent', href: lp('/docs/tools/memory') },
      { label: 'Session & Monitoring', href: lp('/docs/tools/session') },
      { label: 'Workflow', href: lp('/docs/tools/workflow'), badge: 'new' },
      { label: 'Analysis & Graphs', href: lp('/docs/tools/analysis'), badge: 'new' },
    ],
  },
  {
    title: 'Guides',
    items: [
      { label: 'First Session', href: lp('/docs/guides/first-session'), badge: 'new' },
      { label: 'Workflow Blueprint', href: lp('/docs/guides/workflow-blueprint'), badge: 'new' },
      { label: 'Docker & Container', href: lp('/docs/guides/docker'), badge: 'new' },
      { label: 'Remote Setup', href: lp('/docs/remote-setup') },
      { label: 'Editor Integrations', href: lp('/docs/guides/editor-integrations'), badge: 'new' },
      { label: 'Observatory Dashboard', href: lp('/docs/guides/observatory'), badge: 'new' },
    ],
  },
  {
    title: 'Configuration',
    collapsed: true,
    items: [
      { label: 'config.toml Reference', href: lp('/docs/configuration') },
      { label: 'Environment Variables', href: lp('/docs/configuration/env-vars'), badge: 'new' },
      { label: 'CLI Reference', href: lp('/docs/cli-reference') },
    ],
  },
  {
    title: 'Advanced',
    collapsed: true,
    items: [
      { label: 'Intelligence Layer', href: lp('/docs/intelligence-layer') },
      { label: 'Tree-Sitter', href: lp('/docs/tree-sitter') },
      { label: 'Analytics & Dashboard', href: lp('/docs/analytics') },
      { label: 'Cloud', href: lp('/docs/cloud') },
      { label: 'Changelog', href: lp('/docs/changelog'), badge: 'new' },
    ],
  },
];

const sections = Astro.props.sections ?? defaultSections;
const currentPath = Astro.url.pathname.replace(/\/$/, '');

function isSectionActive(section: SidebarSection): boolean {
  return section.items.some(item => {
    const itemPage = item.href.split('#')[0].replace(/\/$/, '');
    return currentPath === itemPage || currentPath.startsWith(itemPage + '/');
  });
}
---

<!-- Mobile: inline collapsible nav -->
<nav class="lg:hidden mb-8">
  <details class="docs-mobile-nav group">
    <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none" style="font-size: clamp(0.8125rem, 0.78rem + 0.1vw, 0.875rem);">
      <span class="font-medium text-muted">{t('docs.onThisPage')}</span>
      <svg class="w-4 h-4 text-muted/60 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </summary>
    <div class="px-2 pb-3 pt-1">
      {sections.map(section => (
        <div class="mb-3 last:mb-0">
          <h4 class="fluid-label text-muted/50 mb-1 px-2">{section.title}</h4>
          <div>
            {section.items.map(item => {
              const itemPage = item.href.split('#')[0].replace(/\/$/, '');
              const isPageActive = currentPath === itemPage || currentPath.startsWith(itemPage + '/');
              return (
                <a
                  href={item.href}
                  class:list={[
                    'docs-nav-link block py-1.5 px-2 rounded-md transition-colors duration-150',
                    isPageActive
                      ? 'text-accent font-medium'
                      : 'text-muted hover:text-text-bright'
                  ]}
                  style="font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.8125rem);"
                  data-anchor={item.href.includes('#') ? item.href.split('#')[1] : undefined}
                >
                  {item.label}
                  {item.badge && <span class="sidebar-badge">{item.badge}</span>}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </details>
</nav>

<!-- Desktop: sticky sidebar -->
<aside class="hidden lg:block">
  <nav class="sticky top-24 space-y-1 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2 sidebar-scroll">
    {sections.map(section => {
      const active = isSectionActive(section);
      const shouldCollapse = section.collapsed && !active;
      return (
        <details class="sidebar-section" open={!shouldCollapse}>
          <summary class="sidebar-section-title cursor-pointer select-none flex items-center justify-between">
            <h4 class="fluid-label text-muted font-display m-0">{section.title}</h4>
            <svg class="sidebar-chevron w-3 h-3 text-muted/40 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <ul class:list={['relative mt-1 mb-3', section.compact ? 'space-y-0' : 'space-y-0.5']}>
            {section.items.map(item => {
              const itemPage = item.href.split('#')[0].replace(/\/$/, '');
              const isPageActive = currentPath === itemPage || currentPath.startsWith(itemPage + '/');
              return (
                <li>
                  <a
                    href={item.href}
                    data-anchor={item.href.includes('#') ? item.href.split('#')[1] : undefined}
                    class:list={[
                      'docs-nav-link block rounded-lg transition-all duration-200 relative',
                      section.compact ? 'py-1 px-3' : 'py-1.5 px-3',
                      isPageActive
                        ? 'text-accent bg-accent/8 font-medium sidebar-active'
                        : 'text-muted hover:text-text-bright hover:bg-surface-2'
                    ]}
                    style={`font-size: ${section.compact ? 'clamp(0.75rem, 0.72rem + 0.1vw, 0.8125rem)' : 'clamp(0.8125rem, 0.78rem + 0.1vw, 0.875rem)'};`}
                  >
                    {item.label}
                    {item.badge && <span class="sidebar-badge">{item.badge}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </nav>
</aside>

<style>
  .sidebar-active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background: linear-gradient(180deg, var(--color-accent), var(--color-accent-2));
    border-radius: 1px;
  }

  .docs-nav-link.is-scrolled-to {
    color: var(--color-accent) !important;
    background: rgba(52, 211, 153, 0.06);
  }

  .docs-mobile-nav {
    background: var(--color-surface);
    border: 1px solid rgba(26, 26, 48, 0.5);
    border-radius: 12px;
  }
  .docs-mobile-nav summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    list-style: none;
  }
  .docs-mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .docs-mobile-nav summary svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }
  .docs-mobile-nav[open] summary svg {
    transform: rotate(180deg);
  }
  .docs-mobile-nav[open] {
    border-color: rgba(52, 211, 153, 0.15);
  }

  .sidebar-section summary {
    list-style: none;
    padding: 0.5rem 0.25rem;
  }
  .sidebar-section summary::-webkit-details-marker {
    display: none;
  }
  .sidebar-section[open] .sidebar-chevron {
    transform: rotate(180deg);
  }
  .sidebar-section:not([open]) .sidebar-chevron {
    transform: rotate(-90deg);
  }

  .sidebar-badge {
    display: inline-block;
    font-size: 0.5625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.0625rem 0.375rem;
    margin-left: 0.375rem;
    border-radius: 4px;
    background: rgba(52, 211, 153, 0.12);
    color: var(--color-accent);
    vertical-align: middle;
    line-height: 1.4;
  }

  .sidebar-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .sidebar-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .sidebar-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
  }
  .sidebar-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.15);
  }
</style>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.docs-nav-link[data-anchor]');
  if (navLinks.length > 0) {
    const anchors: { id: string; el: Element }[] = [];
    navLinks.forEach(link => {
      const id = link.dataset.anchor;
      if (id) {
        const target = document.getElementById(id);
        if (target) anchors.push({ id, el: target });
      }
    });

    if (anchors.length > 0) {
      function updateActive() {
        let currentId = '';
        const scrollY = window.scrollY + 120;
        for (const a of anchors) {
          if ((a.el as HTMLElement).offsetTop <= scrollY) {
            currentId = a.id;
          }
        }
        navLinks.forEach(link => {
          link.classList.toggle('is-scrolled-to', link.dataset.anchor === currentId);
        });
      }
      window.addEventListener('scroll', updateActive, { passive: true });
      updateActive();
    }
  }
</script>
