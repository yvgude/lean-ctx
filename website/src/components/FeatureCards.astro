---
import { getMcpManifest } from '../lib/mcpManifest';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const manifest = getMcpManifest();
const mcpToolCount = manifest.counts.granular;
const readModeCount = manifest.read_modes.count;

const features = [
  { title: 'ctx_read', desc: t('features.ctxReadDesc', { count: String(readModeCount) }), savings: 'up to 99%' },
  { title: 'ctx_search', desc: t('features.ctxSearchDesc'), savings: '50–80%' },
  { title: 'ctx_shell', desc: t('features.ctxShellDesc'), savings: '60–90%' },
  { title: 'ctx_compress', desc: t('features.ctxCompressDesc'), savings: '90–95%' },
  { title: 'ctx_graph', desc: t('features.ctxGraphDesc'), savings: 'Structural' },
  { title: 'ctx_intent', desc: t('features.ctxIntentDesc'), savings: 'Context-aware' },
  { title: 'ctx_smart_read', desc: t('features.ctxSmartReadDesc'), savings: 'Automatic' },
  { title: 'ctx_benchmark', desc: t('features.ctxBenchmarkDesc'), savings: 'Data-driven' },
  { title: 'ctx_metrics', desc: t('features.ctxMetricsDesc'), savings: 'Real-time' },
  { title: 'ctx_session', desc: t('features.ctxSessionDesc'), savings: 'CCP' },
  { title: 'ctx_wrapped', desc: t('features.ctxWrappedDesc'), savings: 'Report' },
  { title: 'CEP Engine', desc: t('features.cepEngineDesc'), savings: 'Smart' },
  { title: 'lctx', desc: t('features.lctxDesc'), savings: 'One command' },
  { title: 'lean-ctx gain', desc: t('features.gainDesc'), savings: 'Persistent' },
  { title: 'lean-ctx init', desc: t('features.initDesc'), savings: 'Auto-setup' },
];
---

<section class="relative py-20 sm:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid lg:grid-cols-[1fr_2fr] gap-10 lg:gap-16 items-start">
      <div class="lg:sticky lg:top-24">
        <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-accent mb-3">{t('features.eyebrow')}</p>
        <h2 class="font-display text-2xl sm:text-[2.25rem] font-bold tracking-tight leading-[1.15] text-text-bright mb-4" set:html={t('features.heading', { count: String(mcpToolCount) })} />
        <p class="text-sm text-muted leading-relaxed mb-6">{t('features.desc')}</p>
        <a href="/docs/tools" class="btn-outline-glossy inline-flex items-center px-6 py-2.5 text-xs font-medium rounded-lg text-text">
          {t('features.exploreAll')}
          <svg class="ml-2 w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

      <div class="grid sm:grid-cols-2 gap-0">
        {features.map((f, i) => (
          <div class:list={['py-5 sm:py-6 px-0 sm:px-5 animate-entrance', i < 2 ? '' : 'border-t border-white/[0.06]', i % 2 === 0 ? 'sm:border-r sm:border-r-white/[0.06]' : '']}>
            <div class="flex items-baseline justify-between gap-3 mb-1.5">
              <h3 class="text-[13px] font-bold font-mono text-text-bright">{f.title}</h3>
              <span class="text-[11px] text-accent font-mono shrink-0">{f.savings}</span>
            </div>
            <p class="text-[13px] text-muted leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 sm:mt-14 flex flex-col sm:flex-row gap-3 lg:hidden">
      <a href="/docs/tools" class="btn-outline-glossy inline-flex items-center justify-center px-8 py-3.5 text-sm font-medium rounded-xl text-text">
        {t('features.exploreAll')}
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>
