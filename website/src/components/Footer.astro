---
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const year = new Date().getFullYear();
---

<footer class="footer-root">
  <div class="content-grid-wide footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={lp('/')} class="footer-logo">
          <span class="footer-logo-ascii"><Fragment set:html={'&lt;<span style="color:var(--color-accent)">|</span>&gt;'} /></span>
          <span class="font-display footer-logo-text">
            <span class="text-text-bright">Lean</span><span class="text-accent">CTX</span>
          </span>
        </a>
        <p class="footer-tagline">{t('footer.tagline')}</p>
        <ul class="footer-social" aria-label={t('footer.community')}>
          <li><a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://crates.io/crates/lean-ctx" target="_blank" rel="noopener">crates.io</a></li>
          <li><a href="https://discord.gg/pTHkG9Hew9" target="_blank" rel="noopener">Discord</a></li>
          <li><a href="https://ctxpkg.org" target="_blank" rel="noopener">.ctxpkg</a></li>
          <li><a href="https://buymeacoffee.com/yvgude" target="_blank" rel="noopener">{t('footer.buyMeACoffee')}</a></li>
        </ul>
      </div>

      <div class="footer-columns">
        <div class="footer-col">
          <h4 class="footer-col-title">{t('nav.getStartedLabel')}</h4>
          <ul class="footer-links">
            <li><a href={lp('/docs/getting-started')}>{t('nav.learn.gettingStarted')}</a></li>
            <li><a href={lp('/compatibility')}>{t('nav.getStarted.compatibility')}</a></li>
            <li><a href={lp('/docs/quick-reference')}>{t('nav.learn.quickReference')}</a></li>
            <li><a href={lp('/docs/cli-reference')}>{t('nav.docs.cliComplete')}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">{t('nav.learn.understand')}</h4>
          <ul class="footer-links">
            <li><a href={lp('/how-it-works')}>{t('nav.learn.howItWorks')}</a></li>
            <li><a href={lp('/what-is-context-engineering')}>{t('nav.learn.whatIsCe')}</a></li>
            <li><a href={lp('/context-os')}>{t('nav.arch.overview')}</a></li>
            <li><a href={lp('/compare')}>{t('nav.getStarted.compare')}</a></li>
            <li><a href={lp('/context-os/benchmark')}>{t('nav.learn.benchmark')}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">{t('nav.do.label')}</h4>
          <ul class="footer-links">
            <li><a href={lp('/docs/concepts/read-modes')}>{t('nav.do.codebase')}</a></li>
            <li><a href={lp('/docs/concepts/token-savings')}>{t('nav.do.bill')}</a></li>
            <li><a href={lp('/docs/cortex')}>{t('nav.do.memory')}</a></li>
            <li><a href={lp('/docs/concepts/multi-agent')}>{t('nav.do.agents')}</a></li>
            <li><a href={lp('/docs/tools')}>{t('nav.tools.allTools')}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">{t('nav.docs.reference')}</h4>
          <ul class="footer-links">
            <li><a href={lp('/docs/api-reference')}>{t('nav.docs.apiReference')}</a></li>
            <li><a href={lp('/docs/configuration')}>{t('nav.docs.configuration')}</a></li>
            <li><a href={lp('/docs/security')}>{t('nav.docs.security')}</a></li>
            <li><a href={lp('/docs/data-sources')}>{t('nav.docs.dataSources')}</a></li>
            <li><a href={lp('/docs/changelog')}>{t('nav.docs.changelog')}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {year} lean-ctx &middot; Apache-2.0 &middot; <a href={lp('/privacy')} style="color:inherit;text-decoration:none;">{t('footer.privacy')}</a> &middot; <a href={lp('/terms')} style="color:inherit;text-decoration:none;">Terms</a> &middot; <a href={lp('/imprint')} style="color:inherit;text-decoration:none;">Imprint</a> &middot; {t('footer.madeWith')}</p>
      <p class="footer-swiss"><svg class="swiss-flag" viewBox="0 0 32 32" width="13" height="13" aria-hidden="true"><rect width="32" height="32" rx="4" fill="#D52B1E"/><rect x="6" y="13" width="20" height="6" rx="1" fill="#fff"/><rect x="13" y="6" width="6" height="20" rx="1" fill="#fff"/></svg> {t('footer.madeInSwitzerland')}</p>
    </div>
  </div>
</footer>

<style>
  .footer-root { position: relative; border-top: 1px solid var(--color-border); background: linear-gradient(180deg, color-mix(in srgb, var(--color-surface) 55%, var(--color-bg)) 0%, var(--color-bg) 55%); }
  .footer-root::before { content: ""; position: absolute; top: -1px; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--color-accent) 55%, transparent), transparent); }
  .footer-inner { padding-top: clamp(2.75rem, 2rem + 2vw, 4rem); padding-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); }
  .footer-top { display: grid; grid-template-columns: 1fr; gap: clamp(2.25rem, 1.75rem + 2vw, 3.25rem); margin-bottom: clamp(2.25rem, 1.75rem + 1.5vw, 3.25rem); }
  @media (min-width: 768px) { .footer-top { grid-template-columns: 1.4fr 3fr; gap: clamp(2.5rem, 1.5rem + 3vw, 5rem); align-items: start; } }
  .footer-brand { display: flex; flex-direction: column; gap: 0.85rem; }
  .footer-logo { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .footer-logo-ascii { font-family: var(--font-mono); font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem); font-weight: 700; color: var(--color-text-bright); line-height: 1; font-variant-ligatures: none; -webkit-font-feature-settings: "liga" 0, "clig" 0; font-feature-settings: "liga" 0, "clig" 0; }
  .footer-logo-text { font-size: clamp(0.9rem, 0.85rem + 0.2vw, 1.1rem); font-weight: 700; }
  .footer-tagline { font-size: clamp(0.8125rem, 0.78rem + 0.1vw, 0.875rem); color: var(--color-muted); line-height: 1.55; max-width: 22rem; }
  .footer-social { list-style: none; padding: 0; margin: 0.35rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .footer-social li { display: inline-flex; }
  .footer-social a { font-size: 0.75rem; line-height: 1; color: var(--color-muted); text-decoration: none; padding: 0.34rem 0.62rem; border: 1px solid var(--color-border); border-radius: 999px; transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease; }
  .footer-social a:hover { color: var(--color-accent); border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border)); background: color-mix(in srgb, var(--color-accent) 8%, transparent); }
  .footer-columns { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 1rem + 1.5vw, 3rem); }
  @media (max-width: 640px) { .footer-columns { grid-template-columns: 1fr 1fr; } }
  .footer-col-title { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-display); font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-bright); margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1.1rem); }
  .footer-col-title::before { content: ""; width: 0.6rem; height: 1px; background: var(--color-accent); opacity: 0.7; }
  .footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: clamp(0.375rem, 0.25rem + 0.2vw, 0.5rem); }
  .footer-links a { font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.8125rem); color: var(--color-muted); text-decoration: none; transition: color 0.15s ease, transform 0.15s ease; }
  .footer-links a:hover { color: var(--color-accent); transform: translateX(2px); }
  .footer-divider { height: 1px; background: linear-gradient(90deg, transparent, var(--color-border), transparent); margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem); }
  .footer-bottom { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  @media (min-width: 640px) { .footer-bottom { flex-direction: row; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1.5rem; } }
  .footer-copy { font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem); color: var(--color-muted); opacity: 0.75; margin: 0; }
  .footer-copy a:hover { color: var(--color-accent); }
  .footer-swiss { display: inline-flex; align-items: center; gap: 0.35rem; font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem); color: var(--color-muted); opacity: 0.75; margin: 0; }
  .swiss-flag { flex-shrink: 0; }
</style>
