---
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const year = new Date().getFullYear();
---

<footer class="footer-root">
  <div class="content-grid-wide footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={lp('/')} class="footer-logo">
          <span class="footer-logo-ascii"><Fragment set:html={'&lt;<span style="color:var(--color-accent)">|</span>&gt;'} /></span>
          <span class="font-display footer-logo-text">
            <span class="text-text-bright">Lean</span><span class="text-accent">CTX</span>
          </span>
        </a>
        <p class="footer-tagline">{t('footer.tagline')}</p>
      </div>

      <div class="footer-columns">
        <div class="footer-col">
          <h4 class="footer-col-title">{t('footer.product')}</h4>
          <ul class="footer-links">
            <li><a href={lp('/how-it-works')}>{t('nav.learn.howItWorks')}</a></li>
            <li><a href={lp('/compare')}>{t('nav.getStarted.compare')}</a></li>
            <li><a href={lp('/compatibility')}>{t('nav.getStarted.compatibility')}</a></li>
            <li><a href={lp('/context-os/benchmark')}>{t('nav.learn.benchmark')}</a></li>
            <li><a href={lp('/context-os')}>{t('nav.arch.overview')}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">{t('footer.documentation')}</h4>
          <ul class="footer-links">
            <li><a href={lp('/docs/getting-started')}>{t('nav.learn.gettingStarted')}</a></li>
            <li><a href={lp('/docs/quick-reference')}>{t('nav.learn.quickReference')}</a></li>
            <li><a href={lp('/docs/cli-reference')}>{t('nav.docs.cliComplete')}</a></li>
            <li><a href={lp('/docs/api-reference')}>{t('nav.docs.apiReference')}</a></li>
            <li><a href={lp('/docs/configuration')}>{t('nav.docs.configuration')}</a></li>
            <li><a href={lp('/docs/security')}>{t('nav.docs.security')}</a></li>
            <li><a href={lp('/docs/changelog')}>{t('nav.docs.changelog')}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">{t('footer.community')}</h4>
          <ul class="footer-links">
            <li><a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener">GitHub</a></li>
            <li><a href="https://crates.io/crates/lean-ctx" target="_blank" rel="noopener">crates.io</a></li>
            <li><a href="https://discord.gg/pTHkG9Hew9" target="_blank" rel="noopener">Discord</a></li>
            <li><a href="https://buymeacoffee.com/yvgude" target="_blank" rel="noopener">{t('footer.buyMeACoffee')}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">{t('footer.resources')}</h4>
          <ul class="footer-links">
            <li><a href={lp('/docs/tools')}>{t('nav.tools.allTools')}</a></li>
            <li><a href={lp('/what-is-context-engineering')}>{t('nav.learn.contextEngineering')}</a></li>
            <li><a href={lp('/privacy')}>{t('footer.privacy')}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {year} LeanCTX &middot; Apache-2.0 &middot; <a href={lp('/privacy')} style="color:inherit;text-decoration:none;">{t('footer.privacy')}</a> &middot; {t('footer.madeWith')}</p>
      <div class="footer-bottom-links">
        <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="footer-ascii-link">[git]</a>
        <a href="https://discord.gg/pTHkG9Hew9" target="_blank" rel="noopener" class="footer-ascii-link">[dsc]</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-root { border-top: 1px solid var(--color-border); background: var(--color-bg); }
  .footer-inner { padding-top: clamp(5rem, 3.5rem + 6vw, 10rem); padding-bottom: clamp(2rem, 1.5rem + 1.5vw, 3.5rem); }
  .footer-top { display: grid; grid-template-columns: 1fr; gap: clamp(3rem, 2rem + 3vw, 5rem); margin-bottom: clamp(4rem, 3rem + 3vw, 7rem); }
  @media (min-width: 768px) { .footer-top { grid-template-columns: 1.5fr 3fr; gap: clamp(4rem, 3rem + 4vw, 8rem); } }
  .footer-brand { display: flex; flex-direction: column; gap: 0.75rem; }
  .footer-logo { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .footer-logo-ascii { font-family: var(--font-mono); font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem); font-weight: 700; color: var(--color-text-bright); line-height: 1; }
  .footer-logo-text { font-size: clamp(0.9rem, 0.85rem + 0.2vw, 1.1rem); font-weight: 700; }
  .footer-tagline { font-size: clamp(0.8125rem, 0.78rem + 0.1vw, 0.875rem); color: var(--color-muted); line-height: 1.5; max-width: 18rem; }
  .footer-columns { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 1rem + 1.5vw, 3rem); }
  @media (max-width: 640px) { .footer-columns { grid-template-columns: 1fr 1fr; } }
  .footer-col-title { font-family: var(--font-display); font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-bright); margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem); }
  .footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: clamp(0.375rem, 0.25rem + 0.2vw, 0.5rem); }
  .footer-links a { font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.8125rem); color: var(--color-muted); text-decoration: none; transition: color 0.15s ease; }
  .footer-links a:hover { color: var(--color-text-bright); }
  .footer-divider { height: 1px; background: linear-gradient(90deg, transparent, var(--color-border), transparent); margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); }
  .footer-bottom { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  @media (min-width: 640px) { .footer-bottom { flex-direction: row; justify-content: space-between; } }
  .footer-copy { font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem); color: var(--color-muted); opacity: 0.7; }
  .footer-bottom-links { display: flex; align-items: center; gap: 0.75rem; }
  .footer-bottom-links a { color: var(--color-muted); transition: color 0.15s ease; opacity: 0.7; }
  .footer-bottom-links a:hover { color: var(--color-text-bright); opacity: 1; }
  .footer-ascii-link { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; text-decoration: none; }
</style>
