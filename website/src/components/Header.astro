<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (menu?.classList.contains('mobile-menu-closed')) {
      menu.classList.remove('mobile-menu-closed');
      menu.classList.add('mobile-menu-open');
    } else {
      menu?.classList.remove('mobile-menu-open');
      menu?.classList.add('mobile-menu-closed');
    }
  });

  const header = document.getElementById('site-header');
  if (header) {
    const update = () => {
      header.dataset.scrolled = window.scrollY > 20 ? 'true' : 'false';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  function positionPanel(wrapper: HTMLElement) {
    const panel = wrapper.querySelector<HTMLElement>('.mega-dd-panel');
    if (!panel) return;
    panel.style.left = '0';
    const triggerRect = wrapper.getBoundingClientRect();
    const panelWidth = panel.offsetWidth;
    const viewportW = window.innerWidth;
    const pad = 12;
    let idealLeft = (triggerRect.width - panelWidth) / 2;
    const absLeft = triggerRect.left + idealLeft;
    const absRight = absLeft + panelWidth;
    if (absLeft < pad) {
      idealLeft += pad - absLeft;
    } else if (absRight > viewportW - pad) {
      idealLeft -= absRight - (viewportW - pad);
    }
    panel.style.left = `${idealLeft}px`;
  }

  document.querySelectorAll<HTMLDivElement>('.mega-dd-wrapper').forEach(wrapper => {
    const trigger = wrapper.querySelector('.mega-dd-trigger');
    let closeTimer: ReturnType<typeof setTimeout>;
    function open() {
      clearTimeout(closeTimer);
      document.querySelectorAll('.mega-dd-wrapper.is-open').forEach(w => {
        if (w !== wrapper) w.classList.remove('is-open');
      });
      wrapper.classList.add('is-open');
      trigger?.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => positionPanel(wrapper));
    }
    function close() {
      closeTimer = setTimeout(() => {
        wrapper.classList.remove('is-open');
        trigger?.setAttribute('aria-expanded', 'false');
      }, 180);
    }
    wrapper.addEventListener('mouseenter', open);
    wrapper.addEventListener('mouseleave', close);
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      wrapper.classList.contains('is-open') ? close() : open();
    });
    trigger?.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        wrapper.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
    const panel = wrapper.querySelector('.mega-dd-panel');
    panel?.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    panel?.addEventListener('mouseleave', close);
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.mega-dd-wrapper')) {
      document.querySelectorAll('.mega-dd-wrapper.is-open').forEach(w => {
        w.classList.remove('is-open');
        w.querySelector('.mega-dd-trigger')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  fetch('/api/stats')
    .then(r => r.json())
    .then(data => {
      const el = document.getElementById('gh-stars');
      if (el && data.stars > 0) {
        const count = data.stars;
        el.textContent = count >= 1000 ? (count / 1000).toFixed(1) + 'k' : String(count);
      }
    })
    .catch(() => {});

  function getTheme(): string {
    if (typeof (window as any).__leanctxGetTheme === 'function') return (window as any).__leanctxGetTheme();
    return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function setThemeButtonState(btn: Element, theme: string) {
    const isDark = theme === 'dark';
    const el = btn as HTMLElement;
    el.dataset.theme = isDark ? 'dark' : 'light';
    btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    const darkLabel = el.dataset.labelDark || 'Switch to dark mode';
    const lightLabel = el.dataset.labelLight || 'Switch to light mode';
    const nextLabel = isDark ? lightLabel : darkLabel;
    btn.setAttribute('aria-label', nextLabel);
    btn.setAttribute('title', nextLabel);
  }

  function applyTheme(theme: string) {
    document.documentElement.classList.add('theme-transition');
    if (typeof (window as any).__leanctxSetTheme === 'function') {
      (window as any).__leanctxSetTheme(theme);
    } else {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
      try { localStorage.setItem('leanctx-theme', theme); } catch (_) {}
    }
    window.dispatchEvent(new CustomEvent('leanctx-theme-change', { detail: { theme } }));
    setTimeout(() => document.documentElement.classList.remove('theme-transition'), 350);
  }

  function bindThemeToggles() {
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      if ((btn as HTMLElement).dataset.boundThemeToggle === 'true') return;
      (btn as HTMLElement).dataset.boundThemeToggle = 'true';
      setThemeButtonState(btn, getTheme());
      btn.addEventListener('click', () => {
        const next = getTheme() === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        document.querySelectorAll('[data-theme-toggle]').forEach((b) => setThemeButtonState(b, next));
      });
    });
  }

  bindThemeToggles();
  document.addEventListener('astro:page-load', bindThemeToggles);

  if (!(window as any).__leanctxThemeToggleListenerBound) {
    (window as any).__leanctxThemeToggleListenerBound = true;
    window.addEventListener('leanctx-theme-change', ((event: CustomEvent) => {
      const theme = event?.detail?.theme === 'dark' ? 'dark' : 'light';
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => setThemeButtonState(btn, theme));
    }) as EventListener);
  }
</script>
