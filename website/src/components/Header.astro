---
import { getMcpManifest } from '../lib/mcpManifest';
const manifest = getMcpManifest();
const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  return currentPath.startsWith(path);
}
---

<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-bg focus:text-sm">
  Skip to content
</a>

<header id="site-header" class="header-root" data-scrolled="false">
  <nav class="content-grid-wide">
    <div class="header-inner">
      <a href="/" class="header-logo">
        <svg class="header-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="7" fill="#0a0a12"/>
          <path d="M6 16L13 9" stroke="#34d399" stroke-width="2.8" stroke-linecap="round"/>
          <path d="M6 16L13 23" stroke="#34d399" stroke-width="2.8" stroke-linecap="round"/>
          <rect x="17" y="10" width="2.2" height="12" rx="1.1" fill="#34d399"/>
          <rect x="22" y="12" width="2.2" height="8" rx="1.1" fill="#34d399" opacity="0.6"/>
          <rect x="27" y="14" width="2.2" height="4" rx="1.1" fill="#34d399" opacity="0.3"/>
        </svg>
        <span class="header-logo-text font-display">
          <span class="text-text-bright">Lean</span><span class="text-accent">CTX</span>
        </span>
      </a>

      <div class="header-center">
        <a href="/how-it-works/" class:list={["header-nav-item", { "is-active": isActive("/how-it-works") }]}>How It Works</a>
        <a href="/setup/" class:list={["header-nav-item", { "is-active": isActive("/setup") }]}>Setup</a>
        <a href="/docs/" class:list={["header-nav-item", { "is-active": isActive("/docs") }]}>Docs</a>
        <a href="/tools/" class:list={["header-nav-item", { "is-active": isActive("/tools") }]}>Tools <span class="nav-badge">{manifest.counts.granular}</span></a>
      </div>

      <div class="header-right">
        <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="header-github-cta">
          <svg class="header-gh-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          <span class="header-gh-label">Star</span>
          <span class="header-gh-divider"></span>
          <span id="gh-stars" class="header-gh-count">-</span>
        </a>

        <a href="/setup/" class="header-cta">
          Install lean-ctx
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>

        <button
          type="button"
          class="header-theme-toggle"
          data-theme-toggle
          aria-label="Toggle theme"
        >
          <span class="header-theme-toggle-track" aria-hidden="true">
            <svg class="header-theme-icon header-theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <svg class="header-theme-icon header-theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
            </svg>
          </span>
        </button>

        <button id="mobile-menu-btn" class="header-mobile-btn" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu-closed">
    <div class="mobile-menu-inner">
      <a href="/how-it-works/" class="mobile-nav-link">How It Works</a>
      <a href="/setup/" class="mobile-nav-link">Setup</a>
      <a href="/docs/" class="mobile-nav-link">Docs</a>
      <a href="/tools/" class="mobile-nav-link">Tools</a>
      <a href="/compare/" class="mobile-nav-link">Compare</a>
      <a href="/benchmark/" class="mobile-nav-link">Benchmark</a>
      <div class="mobile-cta-area">
        <a href="/setup/" class="mobile-get-started">
          Install lean-ctx
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .header-root {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    transition: background 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .header-root[data-scrolled="true"] {
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: clamp(3.5rem, 3rem + 2vw, 4.5rem);
  }
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .header-logo-icon { width: 1.75rem; height: 1.75rem; }
  .header-logo-text { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.02em; }
  .header-center {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  @media (min-width: 768px) { .header-center { display: flex; } }
  .header-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 450;
    color: var(--color-muted);
    transition: color 0.2s ease;
    text-decoration: none;
    border-radius: 8px;
  }
  .header-nav-item:hover { color: var(--color-text-bright); }
  .header-nav-item.is-active { color: var(--color-text-bright); background: var(--overlay-hover); }
  .nav-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    background: var(--overlay-faint);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header-github-cta {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    color: var(--color-text-bright);
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .header-github-cta:hover { border-color: var(--color-border-light); background: var(--overlay-hover); }
  .header-gh-icon { width: 16px; height: 16px; }
  .header-gh-label { font-weight: 600; }
  .header-gh-divider { width: 1px; height: 14px; background: var(--color-border-light); }
  .header-gh-count { font-variant-numeric: tabular-nums; color: var(--color-muted); font-size: 0.75rem; }
  @media (min-width: 640px) { .header-github-cta { display: inline-flex; } }
  .header-cta {
    display: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 12px;
    background: var(--color-accent);
    color: var(--color-bg);
    transition: all 0.25s ease;
    text-decoration: none;
  }
  .header-cta:hover { opacity: 0.92; box-shadow: 0 0 20px rgba(52, 211, 153, 0.15); }
  @media (min-width: 640px) { .header-cta { display: inline-flex; } }
  .header-theme-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 12px;
    border: 1px solid var(--color-border-light);
    background: transparent;
    cursor: pointer;
    transition: all 0.25s ease;
    color: var(--color-muted);
  }
  .header-theme-toggle:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .header-theme-toggle-track { width: 18px; height: 18px; position: relative; }
  .header-theme-icon { width: 18px; height: 18px; position: absolute; top: 0; left: 0; transition: opacity 0.25s ease, transform 0.25s ease; }
  .header-theme-icon-sun { opacity: 0; transform: rotate(-30deg) scale(0.8); }
  .header-theme-icon-moon { opacity: 1; transform: rotate(0) scale(1); }
  .header-theme-toggle[data-theme='light'] .header-theme-icon-sun { opacity: 1; transform: rotate(0) scale(1); }
  .header-theme-toggle[data-theme='light'] .header-theme-icon-moon { opacity: 0; transform: rotate(30deg) scale(0.8); }
  @media (min-width: 640px) { .header-theme-toggle { display: inline-flex; } }
  .header-mobile-btn {
    display: flex;
    align-items: center;
    color: var(--color-muted);
    padding: 0.375rem;
    border: none;
    background: none;
    cursor: pointer;
  }
  .header-mobile-btn:hover { color: var(--color-text-bright); }
  @media (min-width: 768px) { .header-mobile-btn { display: none; } }
  .mobile-menu-closed { display: none; }
  .mobile-menu-open {
    display: block;
    background: color-mix(in srgb, var(--color-bg) 98%, transparent);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--color-border);
    animation: menuReveal 0.25s ease;
  }
  @keyframes menuReveal { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
  @media (min-width: 768px) { .mobile-menu-open { display: none; } }
  .mobile-menu-inner {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-nav-link {
    display: block;
    padding: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
    border-radius: 8px;
    text-decoration: none;
  }
  .mobile-nav-link:hover { color: var(--color-text-bright); background: var(--overlay-hover); }
  .mobile-cta-area { padding-top: 0.75rem; }
  .mobile-get-started {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 12px;
    background: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('mobile-menu-closed');
    menu?.classList.toggle('mobile-menu-open');
  });

  const header = document.getElementById('site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.dataset.scrolled = window.scrollY > 20 ? 'true' : 'false';
    }, { passive: true });
  }

  fetch('/api/stats').then(r => r.json()).then(data => {
    const el = document.getElementById('gh-stars');
    if (el && data.stars > 0) {
      el.textContent = data.stars >= 1000 ? (data.stars / 1000).toFixed(1) + 'k' : String(data.stars);
    }
  }).catch(() => {});

  function initThemeToggle() {
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      const el = btn as HTMLElement;
      const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      el.dataset.theme = theme;
      btn.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        if (typeof (window as any).__leanctxSetTheme === 'function') {
          (window as any).__leanctxSetTheme(next);
        }
        document.querySelectorAll('[data-theme-toggle]').forEach(b => (b as HTMLElement).dataset.theme = next);
      });
    });
  }
  initThemeToggle();
</script>
