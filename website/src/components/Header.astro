---
import MegaDropdown from './MegaDropdown.astro';
import SearchModal from './SearchModal.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const currentPath = Astro.url.pathname;

const ico = {
  doc: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>',
  clock: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  list: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  gear: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6"/><path d="M12 16v6"/><path d="M4.93 4.93l4.24 4.24"/><path d="M14.83 14.83l4.24 4.24"/><path d="M2 12h6"/><path d="M16 12h6"/><path d="M4.93 19.07l4.24-4.24"/><path d="M14.83 9.17l4.24-4.24"/><circle cx="12" cy="12" r="3"/></svg>',
  flow: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>',
  bar: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>',
  bulb: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 017 7c0 2.38-1.19 4.47-3 5.74V17a2 2 0 01-2 2h-4a2 2 0 01-2-2v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 017-7z"/><path d="M9 22h6"/></svg>',
  shield: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  check: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>',
  grid: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 2v20"/><path d="M17 2v20"/><path d="M2 12h20"/></svg>',
  server: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><circle cx="6" cy="6" r="1"/><circle cx="6" cy="18" r="1"/></svg>',
  share: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>',
  code: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  book: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>',
  dollar: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>',
  term: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>',
  cli: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8l4 4-4 4"/><line x1="13" y1="16" x2="17" y2="16"/></svg>',
  cog: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>',
  users: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>',
  monitor: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
  sliders: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/></svg>',
  graph: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 012 2v7"/><path d="M6 9v12"/></svg>',
  wrench: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>',
};

// Product mega-dropdown = the journey story: Start → Understand → What you can do
const productColumns = [
  {
    title: t('nav.getStartedLabel'),
    items: [
      { label: t('nav.learn.gettingStarted'), href: lp('/docs/getting-started/'), description: t('nav.learn.gettingStartedDesc'), icon: ico.doc, badge: t('nav.learn.startHereBadge') },
      { label: t('nav.getStarted.compatibility'), href: lp('/compatibility/'), description: t('nav.getStarted.compatibilityDesc'), icon: ico.gear },
      { label: t('nav.learn.quickReference'), href: lp('/docs/quick-reference/'), description: t('nav.learn.quickReferenceDesc'), icon: ico.list },
    ],
  },
  {
    title: t('nav.learn.understand'),
    items: [
      { label: t('nav.learn.howItWorks'), href: lp('/how-it-works/'), description: t('nav.learn.howItWorksDesc'), icon: ico.flow },
      { label: t('nav.learn.whatIsCe'), href: lp('/what-is-context-engineering/'), description: t('nav.learn.whatIsCeDesc'), icon: ico.bulb },
      { label: t('nav.arch.overview'), href: lp('/context-os/'), description: t('nav.arch.overviewDesc'), icon: ico.grid },
      { label: t('nav.getStarted.compare'), href: lp('/compare/'), description: t('nav.getStarted.compareDesc'), icon: ico.bar },
    ],
  },
  {
    title: t('nav.do.label'),
    items: [
      { label: t('nav.do.codebase'), href: lp('/docs/concepts/read-modes/'), description: t('nav.do.codebaseDesc'), icon: ico.graph },
      { label: t('nav.do.bill'), href: lp('/docs/concepts/token-savings/'), description: t('nav.do.billDesc'), icon: ico.dollar },
      { label: t('nav.do.memory'), href: lp('/docs/cortex/'), description: t('nav.do.memoryDesc'), icon: ico.server },
      { label: t('nav.do.agents'), href: lp('/docs/concepts/multi-agent/'), description: t('nav.do.agentsDesc'), icon: ico.users },
      { label: t('nav.learn.benchmark'), href: lp('/context-os/benchmark/'), description: t('nav.learn.benchmarkDesc'), icon: ico.bar },
    ],
  },
];

const docsColumns = [
  {
    title: t('nav.docs.reference'),
    items: [
      { label: t('nav.docs.cliComplete'), href: lp('/docs/cli-reference/'), description: t('nav.docs.cliCompleteDesc'), icon: ico.cli },
      { label: t('nav.docs.apiReference'), href: lp('/docs/api-reference/'), description: t('nav.docs.apiReferenceDesc'), icon: ico.code },
      { label: t('nav.docs.configuration'), href: lp('/docs/configuration/'), description: t('nav.docs.configurationDesc'), icon: ico.cog },
      { label: t('nav.docs.security'), href: lp('/docs/security/'), description: t('nav.docs.securityDesc'), icon: ico.shield },
      { label: t('nav.docs.changelog'), href: lp('/docs/changelog/'), description: t('nav.docs.changelogDesc'), icon: ico.clock },
    ],
  },
  {
    title: 'Features',
    items: [
      { label: t('nav.docs.dataSources'), href: lp('/docs/data-sources/'), description: t('nav.docs.dataSourcesDesc'), icon: ico.flow },
      { label: t('nav.docs.cortex'), href: lp('/docs/cortex/'), description: t('nav.docs.cortexDesc'), icon: ico.bulb },
      { label: 'Context Packages', href: lp('/docs/context-packages/'), description: 'Layers, CLI, auto-load, integrity', icon: ico.doc },
      { label: t('nav.docs.contextControl'), href: lp('/docs/context-control/'), description: t('nav.docs.contextControlDesc'), icon: ico.sliders },
      { label: t('nav.docs.budgets'), href: lp('/docs/budgets-and-slos/'), description: t('nav.docs.budgetsDesc'), icon: ico.dollar },
    ],
  },
  {
    title: 'Configuration',
    items: [
      { label: 'Plan Mode', href: lp('/docs/plan-mode/'), description: 'IDE plan mode compatibility and setup', icon: ico.doc },
      { label: t('nav.docs.observatory'), href: lp('/docs/observatory/'), description: t('nav.docs.observatoryDesc'), icon: ico.monitor },
    ],
  },
];

const toolsColumns = [
  {
    title: t('nav.tools.browse'),
    items: [
      { label: t('nav.tools.allTools'), href: lp('/docs/tools/'), description: t('nav.tools.allToolsDesc'), icon: ico.wrench, badge: t('nav.tools.toolsBadge') },
    ],
  },
  {
    title: t('nav.tools.categories'),
    items: [
      { label: t('nav.tools.coreTools'), href: lp('/docs/tools/core/'), description: t('nav.tools.coreToolsDesc'), icon: ico.doc },
      { label: t('nav.tools.intelligence'), href: lp('/docs/tools/intelligence/'), description: t('nav.tools.intelligenceDesc'), icon: ico.bulb },
      { label: t('nav.tools.memorySession'), href: lp('/docs/tools/memory/'), description: t('nav.tools.memorySessionDesc'), icon: ico.grid },
      { label: t('nav.tools.sessionTools'), href: lp('/docs/tools/session/'), description: t('nav.tools.sessionToolsDesc'), icon: ico.server },
      { label: t('nav.tools.workflowAnalysis'), href: lp('/docs/tools/workflow/'), description: t('nav.tools.workflowAnalysisDesc'), icon: ico.graph },
      { label: t('nav.tools.analysisTools'), href: lp('/docs/tools/analysis/'), description: t('nav.tools.analysisToolsDesc'), icon: ico.bar },
    ],
  },
];
---

<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-bg focus:text-sm">
  {t('nav.skipToContent')}
</a>

<header id="site-header" class="header-root" data-scrolled="false">
  <nav class="content-grid-wide">
    <div class="header-inner">
      <a href={lp('/')} class="header-logo">
        <span class="header-logo-ascii"><Fragment set:html={'&lt;<span style="color:var(--color-accent)">|</span>&gt;'} /></span>
        <span class="header-logo-text font-display">
          <span class="text-text-bright">Lean</span><span class="text-accent">CTX</span>
        </span>
      </a>

      <div class="header-center">
        <MegaDropdown id="product" label={t('nav.productLabel')} columns={productColumns} />
        <MegaDropdown id="docs" label={t('nav.docs')} columns={docsColumns} />
        <MegaDropdown id="tools" label={t('nav.tools')} columns={toolsColumns} />
      </div>

      <div class="header-right">
        <button data-search-trigger class="header-search-btn" aria-label={t('nav.searchLabel')}>
          <svg class="w-[16px] h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <span class="header-search-label">{t('nav.search')}</span>
          <kbd class="header-search-kbd">⌘K</kbd>
        </button>

        <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="header-github-cta">
          <svg class="header-gh-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          <span class="header-gh-label">{t('nav.star')}</span>
          <span class="header-gh-divider"></span>
          <span id="gh-stars" class="header-gh-count">-</span>
        </a>

        <a href="https://discord.gg/pTHkG9Hew9" target="_blank" rel="noopener" class="header-discord" aria-label="Discord">
          <svg class="header-discord-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          <span class="header-discord-label">{t('nav.discord')}</span>
          <span class="header-discord-divider"></span>
          <span class="header-discord-join">{t('nav.discordJoin')}</span>
        </a>

        <a href={lp('/docs/getting-started')} class="header-cta">
          {t('nav.install')}
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>

        <button
          type="button"
          class="header-theme-toggle"
          data-theme-toggle
          data-label-dark={t('nav.switchToDarkMode')}
          data-label-light={t('nav.switchToLightMode')}
          aria-label={t('nav.switchToDarkMode')}
          aria-pressed="false"
          title={t('nav.switchToDarkMode')}
        >
          <span class="header-theme-toggle-track" aria-hidden="true">
            <svg class="header-theme-icon header-theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <svg class="header-theme-icon header-theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
            </svg>
          </span>
        </button>

        <LanguageSwitcher />

        <button id="mobile-menu-btn" class="header-mobile-btn" aria-label={t('nav.menu')}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu-closed">
    <div class="mobile-menu-inner">
      <div class="mobile-section">
        <span class="mobile-section-title">{t('nav.getStartedLabel')}</span>
        <a href={lp('/docs/getting-started')} class="mobile-nav-link">{t('nav.learn.gettingStarted')}</a>
        <a href={lp('/compatibility')} class="mobile-nav-link">{t('nav.getStarted.compatibility')}</a>
        <a href={lp('/docs/quick-reference')} class="mobile-nav-link">{t('nav.learn.quickReference')}</a>
      </div>

      <div class="mobile-section">
        <span class="mobile-section-title">{t('nav.learn.understand')}</span>
        <a href={lp('/how-it-works')} class="mobile-nav-link">{t('nav.learn.howItWorks')}</a>
        <a href={lp('/what-is-context-engineering')} class="mobile-nav-link">{t('nav.learn.whatIsCe')}</a>
        <a href={lp('/context-os')} class="mobile-nav-link">{t('nav.arch.overview')}</a>
        <a href={lp('/compare')} class="mobile-nav-link">{t('nav.getStarted.compare')}</a>
      </div>

      <div class="mobile-section">
        <span class="mobile-section-title">{t('nav.do.label')}</span>
        <a href={lp('/docs/concepts/read-modes')} class="mobile-nav-link">{t('nav.do.codebase')}</a>
        <a href={lp('/docs/concepts/token-savings')} class="mobile-nav-link">{t('nav.do.bill')}</a>
        <a href={lp('/docs/cortex')} class="mobile-nav-link">{t('nav.do.memory')}</a>
        <a href={lp('/docs/concepts/multi-agent')} class="mobile-nav-link">{t('nav.do.agents')}</a>
        <a href={lp('/context-os/benchmark')} class="mobile-nav-link">{t('nav.learn.benchmark')}</a>
      </div>

      <div class="mobile-section">
