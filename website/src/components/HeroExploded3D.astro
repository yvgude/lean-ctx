---
interface Props {
  toolCount: number;
  unifiedToolCount: number;
  readModeCount: number;
  schemaVersion: number;
}

const { toolCount, unifiedToolCount, readModeCount, schemaVersion } = Astro.props;
---

<div class="hero-visual" data-hero-visual aria-hidden="true">
  <div class="hero-3d">
    <div class="hero-layer hero-layer--a" data-i="0">
      <div class="hero-window">
        <div class="hero-window-top">
          <span class="hero-dot hero-dot--r"></span>
          <span class="hero-dot hero-dot--y"></span>
          <span class="hero-dot hero-dot--g"></span>
          <span class="hero-window-title">ctx_read</span>
        </div>
        <div class="hero-window-body">
          <div class="hero-line"><span class="hero-k">→</span> <span class="hero-v">generated/mcp-tools.json</span> <span class="hero-m">map</span></div>
          <div class="hero-line hero-line--muted">schema_version: {schemaVersion}</div>
          <div class="hero-line"><span class="hero-k">tools</span> granular: <span class="hero-v">{toolCount}</span></div>
          <div class="hero-line"><span class="hero-k">tools</span> unified: <span class="hero-v">{unifiedToolCount}</span></div>
          <div class="hero-line hero-line--muted">read_modes: {readModeCount}</div>
        </div>
      </div>
    </div>

    <div class="hero-layer hero-layer--b" data-i="1">
      <div class="hero-window">
        <div class="hero-window-top">
          <span class="hero-dot hero-dot--r"></span>
          <span class="hero-dot hero-dot--y"></span>
          <span class="hero-dot hero-dot--g"></span>
          <span class="hero-window-title">ctx_metrics</span>
        </div>
        <div class="hero-window-body">
          <div class="hero-metric">
            <span class="hero-metric-label">granular tools</span>
            <span class="hero-metric-value">{toolCount}</span>
          </div>
          <div class="hero-metric">
            <span class="hero-metric-label">unified tools</span>
            <span class="hero-metric-value">{unifiedToolCount}</span>
          </div>
          <div class="hero-metric">
            <span class="hero-metric-label">read modes</span>
            <span class="hero-metric-value">{readModeCount}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-layer hero-layer--c" data-i="2">
      <div class="hero-card glass">
        <div class="hero-card-top">
          <span class="pill-tag">tools</span>
          <span class="hero-card-title">{toolCount}</span>
        </div>
        <div class="hero-card-lines">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-shards" data-hero-shards>
    {Array.from({ length: 18 }).map((_, i) => (
      <span class="hero-shard" data-s={i}></span>
    ))}
  </div>
</div>

