---
import { PILLARS } from '../lib/positioning';

const proofByPillar: Record<string, string> = {
  perceive: 'ctx_overview → repo mapped in one call',
  compress: 'ctx_read → 4,200 → 920 tokens (78% saved)',
  remember: 'ctx_session → restored · 0 re-reads',
  route: 'ctx_intent → right mode + budget per task',
  govern: 'ctx_verify → paths ok · secrets blocked',
};

const steps = PILLARS.map((p) => ({
  num: String(p.order).padStart(2, '0'),
  title: p.verb,
  tagline: p.tagline,
  desc: p.description,
  proof: proofByPillar[p.id],
  iconPath: p.iconPath,
}));
---

<div class="steps-grid">
  {steps.map((step) => (
    <div class="step-card">
      <div class="step-header">
        <span class="step-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={step.iconPath} />
          </svg>
        </span>
        <span class="step-num font-mono">{step.num}</span>
      </div>
      <h3 class="step-title font-display">{step.title}</h3>
      <p class="step-tagline">{step.tagline}</p>
      <p class="step-desc">{step.desc}</p>
      <code class="step-proof font-mono">{step.proof}</code>
    </div>
  ))}
</div>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);
  }

  @media (max-width: 1100px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 700px) {
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .step-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 1rem + 0.5vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg);
    background: var(--overlay-faint);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .step-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 4%, var(--overlay-faint));
  }

  .step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(0.75rem, 0.5rem + 0.4vw, 1.25rem);
  }

  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, var(--color-border));
    color: var(--color-accent);
  }

  .step-num {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-muted);
    opacity: 0.5;
    letter-spacing: 0.05em;
  }

  .step-title {
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 700;
    color: var(--color-text-bright);
    margin: 0 0 0.25rem;
    letter-spacing: -0.02em;
  }

  .step-tagline {
    font-size: clamp(0.8125rem, 0.78rem + 0.1vw, 0.875rem);
    color: var(--color-accent);
    margin: 0 0 0.75rem;
    line-height: 1.4;
  }

  .step-desc {
    font-size: clamp(0.8125rem, 0.78rem + 0.1vw, 0.875rem);
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .step-proof {
    display: block;
    margin-top: clamp(0.75rem, 0.5rem + 0.4vw, 1.25rem);
    padding: 0.5rem 0.65rem;
    font-size: 0.6875rem;
    line-height: 1.45;
    color: var(--color-text);
    background: var(--overlay-medium);
    border: 1px solid var(--color-border);
    border-radius: 7px;
    word-break: break-word;
  }
</style>
