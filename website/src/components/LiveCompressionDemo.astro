---
const inputCode = `import { verify, sign } from 'jsonwebtoken';
import { Redis } from 'ioredis';

const redis = new Redis(process.env.REDIS_URL);
const JWT_SECRET = process.env.JWT_SECRET!;

export async function authenticate(token: string) {
  const payload = verify(token, JWT_SECRET);
  const session = await redis.get(\`session:\${payload.sub}\`);
  if (!session) throw new Error('Session expired');
  return JSON.parse(session);
}

export function refreshSession(userId: string) {
  return sign({ sub: userId }, JWT_SECRET, { expiresIn: '1h' });
}`;

const modes = [
  {
    id: 'map',
    label: 'map',
    tokens: 180,
    output: `exports: authenticate(token), refreshSession(userId)
deps: jsonwebtoken, ioredis
types: string → Promise<object>, string → string
lines: 17  size: 4,200 → 180 tokens
cached: 13 tokens on re-read`,
  },
  {
    id: 'signatures',
    label: 'signatures',
    tokens: 95,
    output: `fn authenticate(token: string): Promise<object>
fn refreshSession(userId: string): string

4,200 → 95 tokens
cached: 13 tokens`,
  },
  {
    id: 'auto',
    label: 'auto',
    tokens: 150,
    output: `exports: authenticate(token), refreshSession(userId)
deps: jsonwebtoken (verify, sign), ioredis (Redis)
pattern: JWT auth + Redis sessions
4,200 → 150 tokens
cached: 13 tokens`,
  },
];

const inputTokens = '4,200';
---

<div class="lcd animate-entrance" id="live-compression-demo">
  <div class="lcd-panels">
    {/* Input panel */}
    <div class="lcd-panel lcd-input">
      <div class="lcd-header">
        <div class="lcd-dots">
          <span class="font-mono text-[10px] text-[#ff5f57]">[x]</span>
          <span class="font-mono text-[10px] text-[#febc2e]">[-]</span>
          <span class="font-mono text-[10px] text-[#28c840]">[o]</span>
        </div>
        <span class="lcd-filename">src/lib/auth.ts</span>
      </div>
      <pre class="lcd-code"><code>{inputCode}</code></pre>
    </div>

    {/* Arrow */}
    <div class="lcd-arrow">
      <div class="lcd-arrow-line">
        <span class="lcd-arrow-dot"></span>
        <span class="lcd-arrow-symbol">→</span>
      </div>
      <span class="lcd-arrow-brand">lean-ctx</span>
      <span class="lcd-arrow-mode" id="lcd-active-mode">map mode</span>
    </div>

    {/* Output panel */}
    <div class="lcd-panel lcd-output">
      <div class="lcd-header">
        <div class="lcd-dots">
          <span class="font-mono text-[10px] text-[#ff5f57]">[x]</span>
          <span class="font-mono text-[10px] text-[#febc2e]">[-]</span>
          <span class="font-mono text-[10px] text-[#28c840]">[o]</span>
        </div>
        <span class="lcd-filename">ctx_read output</span>
      </div>
      {modes.map((m, i) => (
        <pre
          class="lcd-code lcd-mode-output"
          data-mode={m.id}
          style={i !== 0 ? 'display:none' : ''}
        ><code>{m.output}</code></pre>
      ))}
    </div>
  </div>

  {/* Token counter + mode toggle */}
  <div class="lcd-footer">
    <div class="lcd-counter">
      <span class="lcd-counter-text">
        {inputTokens} → <span class="lcd-counter-value" id="lcd-token-count">{modes[0].tokens}</span> tokens
      </span>
      <span class="lcd-badge" id="lcd-savings-badge">
        {Math.round((1 - modes[0].tokens / 4200) * 100)}% saved
      </span>
    </div>
    <div class="lcd-modes" role="tablist" aria-label="Compression mode">
      {modes.map((m, i) => (
        <button
          class={`lcd-mode-btn ${i === 0 ? 'lcd-mode-btn--active' : ''}`}
          data-target={m.id}
          data-tokens={m.tokens}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >{m.label}</button>
      ))}
    </div>
  </div>
</div>

<style>
  .lcd {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }

  .lcd-panels {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    align-items: stretch;
  }

  @media (max-width: 767px) {
    .lcd-panels {
      grid-template-columns: 1fr;
    }
  }

  /* Panels */
  .lcd-panel {
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .lcd-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }

  .lcd-dots {
    display: flex;
    gap: 0.5rem;
  }

  .lcd-filename {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    margin-left: 0.75rem;
  }

  .lcd-code {
    padding: 1rem 1.125rem;
    font-family: var(--font-mono);
    font-size: clamp(10px, 0.6rem + 0.2vw, 12px);
    line-height: 1.65;
    color: var(--color-text);
    overflow-x: auto;
    margin: 0;
    white-space: pre;
    min-height: 180px;
  }

  .lcd-output .lcd-code {
    color: var(--color-accent);
  }

  /* Arrow */
  .lcd-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.25rem;
    gap: 0.375rem;
  }

  @media (max-width: 767px) {
    .lcd-arrow {
      flex-direction: row;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
    }
    .lcd-arrow-line {
      flex-direction: row !important;
    }
  }

  .lcd-arrow-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .lcd-arrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: lcd-pulse 2s ease-in-out infinite;
  }

  .lcd-arrow-symbol {
    font-size: 1.5rem;
    color: var(--color-accent);
    font-weight: 700;
    line-height: 1;
  }

  .lcd-arrow-brand {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }

  .lcd-arrow-mode {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
  }

  @keyframes lcd-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  /* Footer */
  .lcd-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .lcd-counter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lcd-counter-text {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text);
  }

  .lcd-counter-value {
    color: var(--color-accent);
    font-weight: 700;
  }

  .lcd-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  /* Mode toggle */
  .lcd-modes {
    display: flex;
    gap: 0.375rem;
  }

  .lcd-mode-btn {
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lcd-mode-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-light);
  }

  .lcd-mode-btn--active {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }

  .lcd .lcd-input {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lcd .lcd-output {
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s,
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
  }

  .lcd .lcd-arrow {
    opacity: 0;
    transition: opacity 0.5s ease 0.15s;
  }

  .lcd .lcd-footer {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease 0.5s,
                transform 0.5s ease 0.5s;
  }

  .lcd.is-visible .lcd-input,
  .lcd.is-visible .lcd-output {
    opacity: 1;
    transform: translateX(0);
  }

  .lcd.is-visible .lcd-arrow {
    opacity: 1;
  }

  .lcd.is-visible .lcd-footer {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .lcd .lcd-input,
    .lcd .lcd-output,
    .lcd .lcd-arrow,
    .lcd .lcd-footer {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .lcd-arrow-dot {
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var demo = document.getElementById('live-compression-demo');
    if (!demo) return;

    var buttons = demo.querySelectorAll('.lcd-mode-btn');
    var outputs = demo.querySelectorAll('.lcd-mode-output');
    var tokenEl = document.getElementById('lcd-token-count');
    var badgeEl = document.getElementById('lcd-savings-badge');
    var modeLabel = document.getElementById('lcd-active-mode');
    var inputTokens = 4200;

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = btn.getAttribute('data-target');
        var tokens = parseInt(btn.getAttribute('data-tokens'), 10);

        buttons.forEach(function (b) {
          b.classList.remove('lcd-mode-btn--active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('lcd-mode-btn--active');
        btn.setAttribute('aria-selected', 'true');

        outputs.forEach(function (o) {
          o.style.display = o.getAttribute('data-mode') === target ? '' : 'none';
        });

        if (tokenEl) tokenEl.textContent = tokens;
        if (badgeEl) badgeEl.textContent = Math.round((1 - tokens / inputTokens) * 100) + '% saved';
        if (modeLabel) modeLabel.textContent = target + ' mode';
      });
    });
  })();
</script>
