---
import { getMcpManifest } from '../lib/mcpManifest';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const manifest = getMcpManifest();
const mcpToolCount = manifest.counts.granular;

const features = [
  {
    eyebrow: t('power.graphEyebrow'),
    title: t('power.graphTitle'),
    description: t('power.graphDesc'),
    actions: [
      { cmd: 'ctx_graph build', desc: t('power.graphBuild') },
      { cmd: 'ctx_graph related', desc: t('power.graphRelated') },
      { cmd: 'ctx_graph symbol', desc: t('power.graphSymbol') },
      { cmd: 'ctx_graph impact', desc: t('power.graphImpact') },
      { cmd: 'ctx_graph status', desc: t('power.graphStatus') },
    ],
    terminal: {
      title: '$ lean-ctx graph build',
      lines: [
        { text: 'GRAPH BUILD — /Users/you/project', style: 'bright' },
        { text: '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', style: 'dim' },
        { text: 'Scanned: 142 files (38 new, 104 cached)', style: 'muted' },
        { text: 'Symbols: 847 exports across 12 languages', style: 'muted' },
        { text: 'Edges:   1,203 import relationships', style: 'muted' },
        { text: '', style: 'muted' },
        { text: 'Index: ~/.lean-ctx/graphs/a3f8c1/index.json', style: 'accent' },
        { text: 'Build time: 340ms (incremental)', style: 'accent' },
      ],
    },
    link: '/docs/tools/intelligence',
  },
  {
    eyebrow: t('power.dashboardEyebrow'),
    title: t('power.dashboardTitle'),
    description: t('power.dashboardDesc'),
    actions: [
      { cmd: 'lean-ctx gain', desc: t('power.dashboardGain') },
      { cmd: 'gain --live', desc: t('power.dashboardLive') },
      { cmd: 'gain --daily', desc: t('power.dashboardDaily') },
      { cmd: 'gain --wrapped', desc: t('power.dashboardWrapped') },
      { cmd: 'lean-ctx dashboard', desc: t('power.dashboardWeb') },
    ],
    terminal: {
      title: '$ lean-ctx gain --live',
      lines: [
        { text: 'LEAN-CTX SAVINGS — live', style: 'bright' },
        { text: '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', style: 'dim' },
        { text: 'Tokens saved:  1,284,331  ($4.27 USD)', style: 'accent' },
        { text: 'Compression:   68.2%  ████████████░░░░░', style: 'muted' },
        { text: 'Cache hits:    3,847 reads  (92% hit rate)', style: 'muted' },
        { text: 'Shell patterns: 2,104 commands compressed', style: 'muted' },
        { text: '', style: 'muted' },
        { text: 'Top saver: ctx_read (map mode)  412,000 tok', style: 'accent' },
      ],
    },
    link: '/docs/tools/analysis',
  },
  {
    eyebrow: t('power.gotchaEyebrow'),
    title: t('power.gotchaTitle'),
    description: t('power.gotchaDesc'),
    actions: [
      { cmd: 'gotchas list', desc: t('power.gotchaList') },
      { cmd: 'gotchas stats', desc: t('power.gotchaStats') },
      { cmd: 'gotchas export', desc: t('power.gotchaExport') },
      { cmd: 'gotchas clear', desc: t('power.gotchaClear') },
    ],
    terminal: {
      title: '$ lean-ctx gotchas list',
      lines: [
        { text: 'BUG MEMORY — 7 patterns tracked', style: 'bright' },
        { text: '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', style: 'dim' },
        { text: '  95%  "missing lifetime in impl block"', style: 'accent' },
        { text: '       Fix: add explicit lifetime parameter', style: 'muted' },
        { text: '  87%  "unused import warning in tests"', style: 'accent' },
        { text: '       Fix: cfg(test) gate the import', style: 'muted' },
        { text: '  72%  "type mismatch: expected &str, got String"', style: 'accent' },
        { text: '       Fix: call .as_str() on the String', style: 'muted' },
      ],
    },
    link: '/docs/tools',
  },
  {
    eyebrow: t('power.graphExplorerEyebrow'),
    title: t('power.graphExplorerTitle'),
    description: t('power.graphExplorerDesc'),
    actions: [
      { cmd: 'graph export-html --out graph.html', desc: t('power.graphExplorerExport') },
      { cmd: '--max-nodes 100', desc: t('power.graphExplorerMaxNodes') },
      { cmd: 'Export PNG button', desc: t('power.graphExplorerPng') },
    ],
    terminal: {
      title: '$ lean-ctx graph export-html --out graph.html',
      lines: [
        { text: '/Users/you/project/graph.html', style: 'accent' },
        { text: '', style: 'muted' },
        { text: '  142 nodes, 203 edges', style: 'muted' },
        { text: '  Pan / Zoom / Search', style: 'muted' },
        { text: '  Click node  →  imports & dependents', style: 'muted' },
        { text: '  Right-click →  highlight reverse deps', style: 'accent' },
        { text: '  Export PNG  →  download canvas', style: 'accent' },
        { text: '', style: 'muted' },
        { text: 'Self-contained HTML — works offline', style: 'bright' },
      ],
    },
    link: '/docs/tools/intelligence',
  },
  {
    eyebrow: t('power.teamServerEyebrow'),
    title: t('power.teamServerTitle'),
    description: t('power.teamServerDesc'),
    actions: [
      { cmd: 'team serve --config team.json', desc: t('power.teamServerServe') },
      { cmd: 'team token create --scopes search,graph', desc: t('power.teamServerToken') },
      { cmd: 'team sync --workspace dev', desc: t('power.teamServerSync') },
      { cmd: 'GET /health', desc: t('power.teamServerHealth') },
    ],
    terminal: {
      title: '$ lean-ctx team serve --config team.json',
      lines: [
        { text: 'Team Server — 127.0.0.1:9877', style: 'bright' },
        { text: '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━', style: 'dim' },
        { text: 'Workspaces: 2 (frontend, backend)', style: 'muted' },
        { text: 'Tokens:     3 active', style: 'muted' },
        { text: `Tools:      ${mcpToolCount} available`, style: 'muted' },
        { text: '', style: 'muted' },
        { text: 'Auth:       Bearer token (SHA-256)', style: 'accent' },
        { text: 'Rate limit: 100 req/s, burst 200', style: 'accent' },
        { text: 'Audit log:  /var/log/lean-ctx/audit.log', style: 'accent' },
      ],
    },
    link: '/docs/configuration',
  },
];
---

<section class="relative py-20 sm:py-32">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-radial-[at_50%_50%] from-accent/[0.03] to-transparent"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 sm:mb-16">
      <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-accent mb-3">{t('power.beyondCompression')}</p>
      <h2 class="font-display text-2xl sm:text-[2.5rem] font-bold tracking-tight leading-[1.1] text-text-bright mb-4" set:html={t('power.heading')} />
      <p class="text-sm text-muted leading-relaxed max-w-2xl mx-auto">{t('power.desc')}</p>
    </div>

    <div class="space-y-8 sm:space-y-12">
      {features.map((f, i) => (
        <div class:list={[
          'power-feature animate-entrance grid lg:grid-cols-2 gap-6 lg:gap-10 items-start p-6 sm:p-8 rounded-2xl border border-white/[0.06] bg-surface/50 hover:border-accent/15 transition-colors duration-300',
          i % 2 === 1 ? 'lg:[direction:rtl] lg:*:[direction:ltr]' : ''
        ]}>
          <div>
            <div class="flex items-center gap-3 mb-3">
              <p class="text-[11px] font-medium uppercase tracking-[0.15em] text-accent">{f.eyebrow}</p>
            </div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-text-bright mb-3">{f.title}</h3>
            <p class="text-sm text-muted leading-relaxed mb-5">{f.description}</p>

            <div class="space-y-1.5 mb-5">
              {f.actions.map(a => (
                <div class="flex items-baseline gap-3 text-[13px]">
                  <code class="text-[11px] font-mono text-accent font-semibold shrink-0">{a.cmd}</code>
                  <span class="text-muted">{a.desc}</span>
                </div>
              ))}
            </div>

            <a href={f.link} class="inline-flex items-center text-xs text-accent hover:text-accent/80 transition-colors font-medium">
              {t('power.learnMore')}
              <svg class="ml-1 w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>

          <div class="terminal-chrome">
            <div class="terminal-header flex items-center gap-1.5 px-4 py-2.5">
              <span class="font-mono text-[9px] text-[#ef4444]">[x]</span>
              <span class="font-mono text-[9px] text-[#eab308]">[-]</span>
              <span class="font-mono text-[9px] text-[#34d399]">[o]</span>
              <span class="text-muted text-[11px] ml-2">{f.terminal.title}</span>
            </div>
            <div class="terminal-body px-4 py-3 font-mono text-[12px] sm:text-[13px] leading-relaxed">
              {f.terminal.lines.map(line => (
                <p class:list={[
                  line.style === 'bright' ? 'text-text-bright font-bold' :
                  line.style === 'accent' ? 'text-accent' :
                  line.style === 'dim' ? 'text-border-light/30' :
                  'text-muted'
                ]}>{line.text || '\u00A0'}</p>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
