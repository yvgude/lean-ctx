---
export interface ScrollyStep {
  number: string;
  title: string;
  description: string;
}

interface Props {
  kicker: string;
  title: string;
  titleHighlight: string;
  steps: ScrollyStep[];
}

const { kicker, title, titleHighlight, steps } = Astro.props;
---

<section class="section-y">
  <div class="content-grid-wide">
    <div class="scrolly" data-scrolly style="--p: 0;">
      <div class="scrolly-copy">
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">{kicker}</span>
        </div>
        <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(2rem, 1.5rem + 2vw, 4rem); max-width: 52rem;">
          {title} <span class="italic-accent">{titleHighlight}</span>
        </h2>

        <div class="scrolly-steps">
          {steps.map((s, i) => (
            <article class="scrolly-step" data-step={i}>
              <div class="scrolly-step-number">{s.number}</div>
              <div class="scrolly-step-body">
                <h3 class="font-display text-text-bright" style="font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem); font-weight: 600; letter-spacing: -0.02em; margin-bottom: 0.5rem;">
                  {s.title}
                </h3>
                <p class="text-muted" style="margin: 0; font-size: clamp(0.875rem, 0.82rem + 0.15vw, 1rem); line-height: 1.7;">
                  {s.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="scrolly-visual-wrap">
        <div class="scrolly-sticky">
          <div class="panel scrolly-visual">
            <div class="panel-inner scrolly-visual-inner">
              <div class="scrolly-stack" aria-hidden="true">
                {steps.slice(0, 4).map((s, i) => (
                  <div class="scrolly-card" data-i={i}>
                    <div class="scrolly-card-top">
                      <span class="pill-tag">{s.number}</span>
                      <span class="scrolly-card-title">{s.title}</span>
                    </div>
                    <div class="scrolly-card-bar"></div>
                    <div class="scrolly-card-lines">
                      <span></span><span></span><span></span>
                    </div>
                  </div>
                ))}
              </div>
              <div class="scrolly-hint text-muted">
                Scroll → explode
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var root = document.querySelector('[data-scrolly]');
  if (!root) return;
  var steps = Array.prototype.slice.call(root.querySelectorAll('.scrolly-step'));
  var ticking = false;

  function clamp01(x) { return Math.max(0, Math.min(1, x)); }

  function update() {
    ticking = false;
    var rect = root.getBoundingClientRect();
    var vh = window.innerHeight || 1;
    var scrollable = Math.max(1, rect.height - vh * 0.55);
    var p = clamp01((-rect.top + vh * 0.15) / scrollable);
    root.style.setProperty('--p', p.toFixed(4));

    var targetY = vh * 0.45;
    var active = 0;
    var best = Infinity;
    for (var i = 0; i < steps.length; i++) {
      var r = steps[i].getBoundingClientRect();
      var d = Math.abs((r.top + r.height / 2) - targetY);
      if (d < best) { best = d; active = i; }
    }
    root.setAttribute('data-active', String(active));
    for (var j = 0; j < steps.length; j++) {
      if (j === active) steps[j].setAttribute('data-active', 'true');
      else steps[j].removeAttribute('data-active');
    }
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
})();
</script>

