---
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

type Layer = {
  n: string;
  titleKey: string;
  descKey: string;
  statusKey: string;
  href: string;
  accent: "accent" | "accent-2" | "accent-3";
};

const layers: Layer[] = [
  {
    n: "L1",
    titleKey: "stack.l1Title",
    descKey: "stack.l1Desc",
    statusKey: "stack.status.live",
    href: "/docs/tools",
    accent: "accent",
  },
  {
    n: "L2",
    titleKey: "stack.l2Title",
    descKey: "stack.l2Desc",
    statusKey: "stack.status.live",
    href: "/docs/tools/workflow",
    accent: "accent-2",
  },
  {
    n: "L3",
    titleKey: "stack.l3Title",
    descKey: "stack.l3Desc",
    statusKey: "stack.status.live",
    href: "/docs/tools/memory",
    accent: "accent-3",
  },
  {
    n: "L4",
    titleKey: "stack.l4Title",
    descKey: "stack.l4Desc",
    statusKey: "stack.status.live",
    href: "/docs/security",
    accent: "accent",
  },
  {
    n: "L5",
    titleKey: "stack.l5Title",
    descKey: "stack.l5Desc",
    statusKey: "stack.status.live",
    href: "/docs/quick-reference#cookbook",
    accent: "accent-2",
  },
  {
    n: "L6",
    titleKey: "stack.l6Title",
    descKey: "stack.l6Desc",
    statusKey: "stack.status.live",
    href: "/docs/integrations",
    accent: "accent-3",
  },
];
---

<div class="stack-explorer" role="region" aria-label={t("stack.ariaLabel")}>
  <div class="stack-explorer-grid">
    {layers.map((l, i) => (
      <details class="stack-layer" open={i === 0}>
        <summary class="stack-layer-summary">
          <span class:list={["stack-layer-pill", `text-${l.accent}`]}>
            <span class="stack-layer-n">{l.n}</span>
            <span class="stack-layer-status">{t(l.statusKey)}</span>
          </span>
          <span class="stack-layer-title font-display">{t(l.titleKey)}</span>
          <span class="stack-layer-chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </span>
        </summary>
        <div class="stack-layer-body">
          <p class="text-muted fluid-sm" style="margin: 0 0 1rem 0; max-width: 52rem;">
            {t(l.descKey)}
          </p>
          <a href={lp(l.href)} class:list={["stack-layer-link", `text-${l.accent}`]}>
            {t("common.learnMore")}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </details>
    ))}
  </div>
</div>

