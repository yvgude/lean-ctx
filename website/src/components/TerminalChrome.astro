---
interface Props {
  title: string;
  chromeClass?: string;
  headerClass?: string;
  bodyClass?: string;
  bodyStyle?: string;
  dataParallax?: string;
}

const { title, chromeClass, headerClass, bodyClass, bodyStyle, dataParallax } = Astro.props;
const finalBodyClass = bodyClass ?? 'space-y-3';
---

<div class={`terminal-chrome ${chromeClass ?? ''}`.trim()} data-parallax={dataParallax}>
  <div class={`terminal-header flex items-center gap-2 ${headerClass ?? ''}`.trim()} style="padding: clamp(0.5rem, 0.375rem + 0.3vw, 0.75rem) clamp(0.75rem, 0.625rem + 0.4vw, 1.25rem);">
    <span class="font-mono text-[10px] text-[#ff5f57]">[x]</span>
    <span class="font-mono text-[10px] text-[#febc2e]">[-]</span>
    <span class="font-mono text-[10px] text-[#28c840]">[o]</span>
    <span class="ml-3 text-xs text-muted font-mono">{title}</span>
    <slot name="headerRight" />
  </div>
  <div class={`terminal-body font-mono ${finalBodyClass}`.trim()} style={`padding: clamp(0.875rem, 0.75rem + 0.5vw, 1.5rem) clamp(0.75rem, 0.625rem + 0.4vw, 1.5rem); ${bodyStyle ?? ''}`}>
    <slot />
  </div>
</div>

