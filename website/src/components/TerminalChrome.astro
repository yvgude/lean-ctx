---
interface Props {
  title: string;
  chromeClass?: string;
  headerClass?: string;
  bodyClass?: string;
  bodyStyle?: string;
  dataParallax?: string;
}

const { title, chromeClass, headerClass, bodyClass, bodyStyle, dataParallax } = Astro.props;
const finalBodyClass = bodyClass ?? 'space-y-3';
---

<div class={`terminal-chrome ${chromeClass ?? ''}`.trim()} data-parallax={dataParallax}>
  <div class={`terminal-header flex items-center gap-2 px-5 py-3 ${headerClass ?? ''}`.trim()}>
    <span class="terminal-dot bg-[#ff5f57]"></span>
    <span class="terminal-dot bg-[#febc2e]"></span>
    <span class="terminal-dot bg-[#28c840]"></span>
    <span class="ml-3 text-xs text-muted font-mono">{title}</span>
    <slot name="headerRight" />
  </div>
  <div class={`terminal-body px-6 py-6 font-mono ${finalBodyClass}`.trim()} style={bodyStyle}>
    <slot />
  </div>
</div>

