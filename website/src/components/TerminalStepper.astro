---
export interface StepperStep {
  number: string;
  title: string;
  description: string;
  terminalTitle: string;
  terminalLines: string[];
}

interface Props {
  kicker: string;
  title: string;
  titleHighlight: string;
  steps: StepperStep[];
  autoMs?: number;
}

import TerminalChrome from './TerminalChrome.astro';

const { kicker, title, titleHighlight, steps, autoMs = 4200 } = Astro.props;
const stepperId = `stepper-${Math.random().toString(36).slice(2)}`;
---

<section class="section-y">
  <div class="content-grid-wide">
    <div class="stepper" data-stepper id={stepperId} style={`--step: 0; --autoMs: ${autoMs};`}>
      <div class="stepper-copy">
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">{kicker}</span>
        </div>
        <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(2rem, 1.5rem + 2vw, 4rem); max-width: 56rem;">
          {title} <span class="italic-accent">{titleHighlight}</span>
        </h2>

        <div class="stepper-steps">
          {steps.map((s, i) => (
            <button class="stepper-step" type="button" data-step-btn={i} data-active={i === 0 ? 'true' : undefined} aria-controls={`${stepperId}-panel-${i}`}>
              <span class="stepper-step-number">{s.number}</span>
              <span class="stepper-step-body">
                <span class="stepper-step-title">{s.title}</span>
                <span class="stepper-step-desc">{s.description}</span>
              </span>
            </button>
          ))}
        </div>

        <div class="stepper-controls">
          <button class="stepper-control" type="button" data-prev aria-label="Previous step">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <div class="stepper-dots" aria-hidden="true">
            {steps.map((_, i) => (<span class="stepper-dot" data-dot={i} data-active={i === 0 ? 'true' : undefined}></span>))}
          </div>
          <button class="stepper-control" type="button" data-next aria-label="Next step">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div class="stepper-counter text-muted font-mono" data-counter>step 01</div>
        </div>
      </div>

      <div class="stepper-visual-wrap">
        <div class="stepper-visual glass">
          <div class="stepper-visual-top">
            <span class="pill-tag">workflow</span>
            <span class="stepper-visual-title font-mono text-muted" data-stepper-title>{`1/${steps.length}`}</span>
          </div>
          <div class="stepper-panels" aria-live="polite">
            {steps.map((s, i) => (
              <div class="stepper-panel" id={`${stepperId}-panel-${i}`} data-panel={i} data-active={i === 0 ? 'true' : undefined}>
                <TerminalChrome
                  title={s.terminalTitle}
                  bodyClass="space-y-1"
                  bodyStyle="font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem); line-height: 1.75;"
                >
                  {s.terminalLines.map((line) => (
                    <div class="stepper-terminal-line">{line}</div>
                  ))}
                </TerminalChrome>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var root = document.getElementById({JSON.stringify(stepperId)});
  if (!root) return;

  var btns = Array.prototype.slice.call(root.querySelectorAll('[data-step-btn]'));
  var panels = Array.prototype.slice.call(root.querySelectorAll('[data-panel]'));
  var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
  var titleEl = root.querySelector('[data-stepper-title]');
  var counterEl = root.querySelector('[data-counter]');
  var prevBtn = root.querySelector('[data-prev]');
  var nextBtn = root.querySelector('[data-next]');

  var idx = 0;
  var timer = null;
  var autoMs = Number((root.style.getPropertyValue('--autoMs') || '4200').trim()) || 4200;
  var pausedUntil = 0;

  function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
  function setActive(n, reason) {
    idx = clamp(n, 0, panels.length - 1);
    root.style.setProperty('--step', String(idx));
    for (var i = 0; i < btns.length; i++) {
      if (i === idx) btns[i].setAttribute('data-active', 'true');
      else btns[i].removeAttribute('data-active');
    }
    for (var j = 0; j < panels.length; j++) {
      if (j === idx) panels[j].setAttribute('data-active', 'true');
      else panels[j].removeAttribute('data-active');
    }
    for (var k = 0; k < dots.length; k++) {
      if (k === idx) dots[k].setAttribute('data-active', 'true');
      else dots[k].removeAttribute('data-active');
    }
    if (titleEl) titleEl.textContent = (idx + 1) + '/' + panels.length;
    if (counterEl) counterEl.textContent = 'step ' + String(idx + 1).padStart(2, '0');
    if (reason === 'user') pausedUntil = Date.now() + 6000;
  }

  function next(reason) { setActive((idx + 1) % panels.length, reason); }
  function prev(reason) { setActive((idx - 1 + panels.length) % panels.length, reason); }

  function start() {
    stop();
    timer = window.setInterval(function() {
      if (Date.now() < pausedUntil) return;
      next('auto');
    }, autoMs);
  }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }

  btns.forEach(function(b) {
    b.addEventListener('click', function() {
      var n = Number(b.getAttribute('data-step-btn') || '0');
      setActive(n, 'user');
    });
  });
  if (nextBtn) nextBtn.addEventListener('click', function() { next('user'); });
  if (prevBtn) prevBtn.addEventListener('click', function() { prev('user'); });

  root.addEventListener('pointerenter', function() { pausedUntil = Date.now() + 9999999; });
  root.addEventListener('pointerleave', function() { pausedUntil = Date.now() + 400; });

  setActive(0, 'init');
  start();
})();
</script>

