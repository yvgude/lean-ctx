---
interface UseCase {
  title: string;
  desc: string;
  proof: string;
  iconPath: string;
}

const cases: UseCase[] = [
  {
    title: "Understand a new codebase",
    desc: "Drop into an unfamiliar repo and get its structure, call graphs, and the files that actually matter — without reading everything line by line.",
    proof: "ctx_read -m map · 18 languages",
    iconPath:
      "M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5",
  },
  {
    title: "Cut your API bill",
    desc: "Every file read, shell output, and search result shrinks 60–90% before it reaches the model. Fewer input tokens, lower cost — same answer.",
    proof: "60–90% fewer input tokens",
    iconPath:
      "M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Never re-explain context",
    desc: "Findings, decisions, and touched files persist across sessions and auto-restore — your agent picks up exactly where it left off.",
    proof: "session restored · 0 tokens re-read",
    iconPath:
      "M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25",
  },
  {
    title: "Coordinate multiple agents",
    desc: "Hand off context between agents through shared memory, with a governance layer for roles and token budgets — no duplicated work.",
    proof: "ctx_handoff · shared memory",
    iconPath:
      "M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z",
  },
];
---

<div class="uc-grid">
  {
    cases.map((c, i) => (
      <div class="uc-card animate-entrance" style={`--i:${i}`}>
        <div class="uc-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={c.iconPath} />
          </svg>
        </div>
        <h3 class="uc-title font-display">{c.title}</h3>
        <p class="uc-desc">{c.desc}</p>
        <code class="uc-proof font-mono">{c.proof}</code>
      </div>
    ))
  }
</div>

<style>
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 0.6rem + 1.5vw, 1.75rem);
  }

  .uc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.75rem, 0.6rem + 0.4vw, 1.1rem);
    padding: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg);
    background: var(--overlay-faint);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .uc-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-3px);
  }

  .uc-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.5rem, 2rem + 1vw, 3.25rem);
    height: clamp(2.5rem, 2rem + 1vw, 3.25rem);
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--overlay-medium);
    color: var(--color-accent);
  }

  .uc-icon svg {
    width: 55%;
    height: 55%;
  }

  .uc-title {
    font-size: clamp(1.125rem, 0.95rem + 0.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-bright);
    margin: 0;
  }

  .uc-desc {
    font-size: clamp(0.875rem, 0.82rem + 0.15vw, 1rem);
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0;
  }

  .uc-proof {
    margin-top: auto;
    font-size: clamp(0.7rem, 0.66rem + 0.1vw, 0.8125rem);
    color: var(--color-text);
    background: var(--overlay-medium);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
  }

  @media (max-width: 860px) {
    .uc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
