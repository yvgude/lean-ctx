---
/**
 * Eyebrow — mono, uppercase, muted section label with an optional emerald tick.
 * The editorial signature used above every major headline (see design/STYLEGUIDE.md §3.2).
 */
interface Props {
  tick?: boolean;
  class?: string;
}

const { tick = true, class: className = '' } = Astro.props;
---

<span class={`lc-eyebrow ${className}`}>
  {tick && <span class="lc-eyebrow__tick" aria-hidden="true"></span>}
  <slot />
</span>

<style>
  .lc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    line-height: 1;
  }

  .lc-eyebrow__tick {
    width: 1.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
  }
</style>
