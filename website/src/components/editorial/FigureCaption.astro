---
/**
 * FigureCaption — mono caption beneath a figure: "Fig. 00x — takeaway".
 * Always state the takeaway, not just a label (see design/UX-AND-TONE-OF-VOICE.md §9).
 */
interface Props {
  n?: string | number;
  class?: string;
}

const { n, class: className = '' } = Astro.props;
const label = n != null ? `Fig. ${n}` : 'Fig.';
---

<figcaption class={`lc-figcaption ${className}`}>
  <span class="lc-figcaption__tick" aria-hidden="true"></span>
  <span class="lc-figcaption__label">{label}</span>
  <span class="lc-figcaption__sep" aria-hidden="true">—</span>
  <span class="lc-figcaption__text"><slot /></span>
</figcaption>

<style>
  .lc-figcaption {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .lc-figcaption__tick {
    align-self: center;
    width: 1.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    flex: none;
  }

  .lc-figcaption__label {
    color: var(--color-text);
    font-weight: 500;
  }

  .lc-figcaption__sep {
    opacity: 0.6;
  }
</style>
