---
/**
 * NumberedSection — the editorial section primitive (see design/STYLEGUIDE.md §7).
 * Layout: large mono ordinal (001…) + eyebrow + display headline + one lead line,
 * then a slot for the section body (one figure / proof).
 */
import Eyebrow from './Eyebrow.astro';

interface Props {
  n: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { n, eyebrow, title, lead, id, align = 'left', class: className = '' } = Astro.props;
---

<section id={id} class={`lc-section ${align === 'center' ? 'lc-section--center' : ''} ${className}`}>
  <div class="lc-section__inner">
    <header class="lc-section__head animate-entrance">
      <span class="lc-section__ordinal" aria-hidden="true">{n}</span>
      {eyebrow && (
        <div class="lc-section__eyebrow">
          <Eyebrow>{eyebrow}</Eyebrow>
        </div>
      )}
      <h2 class="lc-section__title font-display">{title}</h2>
      {lead && <p class="lc-section__lead">{lead}</p>}
    </header>
    <div class="lc-section__body animate-entrance stagger-1">
      <slot />
    </div>
  </div>
</section>

<style>
  .lc-section {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .lc-section__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  .lc-section__head {
    max-width: 56rem;
  }

  .lc-section--center .lc-section__head {
    margin-inline: auto;
    text-align: center;
  }

  .lc-section__ordinal {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    opacity: 0.5;
    margin-bottom: 0.75rem;
  }

  .lc-section__eyebrow {
    margin-bottom: 1rem;
  }

  .lc-section--center .lc-section__eyebrow {
    display: flex;
    justify-content: center;
  }

  .lc-section__title {
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-text-bright);
  }

  .lc-section__lead {
    margin-top: 1.25rem;
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-text);
    max-width: 48rem;
  }

  .lc-section--center .lc-section__lead {
    margin-inline: auto;
  }

  .lc-section__body {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
</style>
