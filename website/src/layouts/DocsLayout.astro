---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import PageHero from '../components/PageHero.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getDocsPager } from '../lib/docsNav';

interface SidebarItem {
  label: string;
  href: string;
}

interface SidebarSection {
  title: string;
  compact?: boolean;
  items: SidebarItem[];
}

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  sidebar?: SidebarSection[];
  hideHero?: boolean;
}

const { title, description, keywords, sidebar, hideHero } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const breadcrumbs = [
  { name: t('docs.home'), url: lp('/') },
  { name: t('docs.documentation'), url: lp('/docs/getting-started') },
  { name: title, url: Astro.url.pathname },
];

const { prev, next } = getDocsPager(Astro.url.pathname);
---

<BaseLayout
  title={`${title} — LeanCTX Docs`}
  description={description}
  keywords={keywords || `lean-ctx ${title.toLowerCase()}, LLM token reduction, MCP tools, AI coding documentation`}
  breadcrumbs={breadcrumbs}
  hideAscii={true}
>
  {!hideHero && (
    <PageHero
      label={t('docs.documentation')}
      title={title}
      description={description}
      kickerTone="accent"
      container="wide"
      sectionClass="section-y-xs"
      titleMaxWidth="56rem"
      descMaxWidth="56rem"
      breakHighlight={false}
    />
  )}

  <div class="content-grid-wide" style={`padding-bottom: clamp(3rem, 2rem + 2vw, 5rem);${hideHero ? ' padding-top: clamp(2rem, 1.5rem + 1.5vw, 3.5rem);' : ''}`}>
    <div class="docs-shell">
      <DocsSidebar sections={sidebar} />
      <article class="min-w-0 docs-prose">
        <slot />
        {(prev || next) && (
          <nav class="docs-pager not-prose" aria-label="Documentation pages">
            {prev ? (
              <a class="docs-pager__link docs-pager__prev" href={lp(prev.href)} rel="prev">
                <span class="docs-pager__dir">← Previous</span>
                <span class="docs-pager__title">{prev.label}</span>
              </a>
            ) : (
              <span class="docs-pager__spacer" aria-hidden="true"></span>
            )}
            {next ? (
              <a class="docs-pager__link docs-pager__next" href={lp(next.href)} rel="next">
                <span class="docs-pager__dir">Next →</span>
                <span class="docs-pager__title">{next.label}</span>
              </a>
            ) : (
              <span class="docs-pager__spacer" aria-hidden="true"></span>
            )}
          </nav>
        )}
      </article>
      <aside class="docs-toc" aria-label="On this page">
        <div class="docs-toc__inner">
          <p class="docs-toc__label">On this page</p>
          <nav class="docs-toc__nav" id="docs-toc-nav"></nav>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .heading-anchor {
    color: var(--color-accent);
    text-decoration: none;
    opacity: 0;
    font-weight: 400;
    margin-inline-start: 0.4em;
    font-size: 0.75em;
    transition: opacity 0.2s ease;
    vertical-align: middle;
  }
  h2:hover .heading-anchor,
  h3:hover .heading-anchor,
  h4:hover .heading-anchor,
  .heading-anchor:focus {
    opacity: 0.5;
  }
  .heading-anchor:hover {
    opacity: 1 !important;
  }

  /* Prev / next pager */
  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 2rem + 2vw, 4.5rem);
    padding-top: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    border-top: 1px solid var(--color-border);
  }
  .docs-pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg, 12px);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .docs-pager__next { text-align: end; align-items: flex-end; }
  .docs-pager__link:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-surface));
    transform: translateY(-2px);
  }
  .docs-pager__dir {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .docs-pager__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem);
    color: var(--color-text-bright);
  }
  .docs-pager__link:hover .docs-pager__title { color: var(--color-accent); }
  .docs-pager__spacer { display: block; }
  @media (max-width: 640px) {
    .docs-pager { grid-template-columns: 1fr; }
    .docs-pager__next { text-align: start; align-items: flex-start; }
    .docs-pager__spacer { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-pager__link { transition: border-color 0.2s ease; }
    .docs-pager__link:hover { transform: none; }
  }

  /* Docs shell: sidebar | content | on-this-page */
  .docs-shell { display: block; }
  @media (min-width: 1024px) {
    .docs-shell {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 3rem;
    }
  }
  @media (min-width: 1280px) {
    .docs-shell { grid-template-columns: 240px minmax(0, 1fr) 220px; }
  }

  .docs-toc { display: none; }
  @media (min-width: 1280px) {
    .docs-toc { display: block; }
  }
  .docs-toc__inner {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--color-border);
  }
  .docs-toc__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
  }
  .docs-toc__nav { display: flex; flex-direction: column; }
  .docs-toc__nav a {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.3rem 0 0.3rem 1rem;
    margin-inline-start: -1rem;
    border-inline-start: 2px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .docs-toc__nav a:hover { color: var(--color-text-bright); }
  .docs-toc__nav a.lvl-3 { padding-inline-start: 1.875rem; font-size: 0.78125rem; }
  .docs-toc__nav a.is-active {
    color: var(--color-accent);
    border-inline-start-color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-toc__nav a { transition: none; }
  }
</style>

<script>
  function slugify(text: string): string {
    return text
      .toLowerCase()
      .replace(/[^a-z0-9_\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  const article = document.querySelector('article');
  if (article) {
    const headings = article.querySelectorAll('h2, h3, h4');
    const usedSlugs = new Set<string>();

    headings.forEach((heading) => {
      const existingId = heading.getAttribute('id');
      let slug: string;

      if (existingId) {
        slug = existingId;
      } else {
        const text = heading.textContent?.replace(/#/g, '').trim() || '';
        slug = slugify(text);
        if (usedSlugs.has(slug)) {
          let i = 2;
          while (usedSlugs.has(`${slug}-${i}`)) i++;
          slug = `${slug}-${i}`;
        }
        heading.id = slug;
      }
      usedSlugs.add(slug);

      const anchor = document.createElement('a');
      anchor.href = `#${slug}`;
      anchor.className = 'heading-anchor';
      anchor.setAttribute('aria-label', `Link to ${heading.textContent?.replace(/#/g, '').trim()}`);
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });

    // Build "On this page" TOC from h2/h3 + scroll-spy
    const tocNav = document.getElementById('docs-toc-nav');
    if (tocNav) {
      const tocHeadings = Array.from(article.querySelectorAll('h2, h3')).filter(
        (h) => h.getAttribute('id'),
      );
      const links: HTMLAnchorElement[] = [];
      tocHeadings.forEach((h) => {
        const id = h.getAttribute('id')!;
        const a = document.createElement('a');
        a.href = `#${id}`;
        a.textContent = h.textContent?.replace(/#/g, '').trim() || '';
        a.className = h.tagName === 'H3' ? 'lvl-3' : 'lvl-2';
        a.dataset.target = id;
        tocNav.appendChild(a);
        links.push(a);
      });

      if (links.length < 2) {
        const aside = tocNav.closest('.docs-toc');
        if (aside) (aside as HTMLElement).style.display = 'none';
      } else {
        const byId = new Map<string, HTMLAnchorElement>();
        links.forEach((a) => byId.set(a.dataset.target!, a));
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const id = entry.target.getAttribute('id');
              if (!id || !entry.isIntersecting) return;
              links.forEach((l) => l.classList.remove('is-active'));
              byId.get(id)?.classList.add('is-active');
            });
          },
          { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
        );
        tocHeadings.forEach((h) => observer.observe(h));
      }
    }

    if (window.location.hash) {
      const target = document.getElementById(window.location.hash.slice(1));
      if (target) {
        requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth' }));
      }
    }

    article.querySelectorAll('table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrap')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrap';
      table.parentNode!.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  }
</script>
