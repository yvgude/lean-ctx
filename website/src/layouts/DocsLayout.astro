---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import { BRAND } from '../lib/positioning';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getDocsPager, getDocsJourney } from '../lib/docsTree';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  hideHero?: boolean;
  /** Let content fill the column (for hub/grid pages instead of the prose measure). */
  wide?: boolean;
}

const { title, description, keywords, hideHero, wide } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const breadcrumbs = [
  { name: t('docs.home'), url: lp('/') },
  { name: t('docs.documentation'), url: lp('/docs/') },
  { name: title, url: Astro.url.pathname },
];

const { prev, next } = getDocsPager(Astro.url.pathname);
const journeyLabel = getDocsJourney(Astro.url.pathname) ?? t('docs.documentation');
---

<BaseLayout
  title={`${title} — ${BRAND} Docs`}
  description={description}
  keywords={keywords || `lean-ctx ${title.toLowerCase()}, LLM token reduction, MCP tools, AI coding documentation`}
  breadcrumbs={breadcrumbs}
  hideAscii={true}
  docs={true}
>
  <div class="docs-page">
    <div class="docs-shell">
      <!-- Left rail: persistent global navigation -->
      <div class="docs-rail">
        <DocsSidebar />
      </div>

      <!-- Center: the page content -->
      <article class="docs-main min-w-0 docs-prose">
        <nav class="docs-breadcrumb not-prose" aria-label="Breadcrumb">
          <a href={lp('/docs/')}>{t('docs.documentation')}</a>
          <span class="docs-breadcrumb__sep">/</span>
          <span class="docs-breadcrumb__current">{journeyLabel}</span>
        </nav>

        {!hideHero && (
          <header class="docs-header not-prose">
            <p class="docs-header__eyebrow">{journeyLabel}</p>
            <h1 class="docs-header__title font-display">{title}</h1>
            {description && <p class="docs-header__lead">{description}</p>}
          </header>
        )}

        <div class:list={['docs-body', wide && 'docs-body--wide']}>
          <slot />
        </div>

        {(prev || next) && (
          <nav class="docs-pager not-prose" aria-label="Documentation pages">
            {prev ? (
              <a class="docs-pager__link docs-pager__prev" href={lp(prev.href)} rel="prev">
                <span class="docs-pager__dir">← Previous</span>
                <span class="docs-pager__title">{prev.label}</span>
              </a>
            ) : (
              <span class="docs-pager__spacer" aria-hidden="true"></span>
            )}
            {next ? (
              <a class="docs-pager__link docs-pager__next" href={lp(next.href)} rel="next">
                <span class="docs-pager__dir">Next →</span>
                <span class="docs-pager__title">{next.label}</span>
              </a>
            ) : (
              <span class="docs-pager__spacer" aria-hidden="true"></span>
            )}
          </nav>
        )}
      </article>
    </div>
  </div>
</BaseLayout>

<style is:global>
  :root {
    --docs-rail-w: 19rem;
    --docs-sticky-top: 4.25rem;
  }

  .heading-anchor {
    color: var(--color-accent);
    text-decoration: none;
    opacity: 0;
    font-weight: 400;
    margin-inline-start: 0.4em;
    font-size: 0.75em;
    transition: opacity 0.2s ease;
    vertical-align: middle;
  }
  h2:hover .heading-anchor,
  h3:hover .heading-anchor,
  h4:hover .heading-anchor,
  .heading-anchor:focus { opacity: 0.5; }
  .heading-anchor:hover { opacity: 1 !important; }

  /* ── Dedicated docs shell (nav | content) ────────────────────────────── */
  .docs-page {
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 0.5rem + 1.5vw, 2.5rem);
    padding-bottom: clamp(3rem, 2rem + 2vw, 5rem);
  }
  /* Below lg: single column. The rail renders the mobile nav disclosure
     (its desktop <aside> is hidden via its own lg: classes). */
  .docs-shell { display: block; }

  @media (min-width: 1024px) {
    .docs-shell {
      display: grid;
      grid-template-columns: var(--docs-rail-w) minmax(0, 1fr);
      gap: clamp(2.5rem, 1.5rem + 3vw, 5rem);
      align-items: start;
    }
    .docs-rail {
      display: block;
      position: sticky;
      top: var(--docs-sticky-top);
      max-height: calc(100vh - var(--docs-sticky-top));
      overflow-y: auto;
      padding-top: clamp(1.5rem, 1rem + 1vw, 2.25rem);
      padding-bottom: 2rem;
      padding-inline-end: 0.75rem;
      border-inline-end: 1px solid var(--color-border);
      scrollbar-width: thin;
      scrollbar-color: var(--overlay-heavy) transparent;
    }
    .docs-rail::-webkit-scrollbar { width: 4px; }
    .docs-rail::-webkit-scrollbar-thumb { background: var(--overlay-heavy); border-radius: 2px; }
  }

  .docs-main {
    padding-top: clamp(1.25rem, 0.75rem + 1.5vw, 2.25rem);
    min-width: 0;
  }
  /* Comfortable reading measure within the wide content column. */
  .docs-body, .docs-header { max-width: 50rem; }
  .docs-body--wide { max-width: none; }

  /* Breadcrumb (mobile + desktop) */
  .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .docs-breadcrumb a { color: var(--color-muted); text-decoration: none; }
  .docs-breadcrumb a:hover { color: var(--color-accent); }
  .docs-breadcrumb__sep { opacity: 0.4; }
  .docs-breadcrumb__current { color: var(--color-text-bright); }

  /* Compact in-column docs header */
  .docs-header {
    margin-bottom: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
    padding-bottom: clamp(1.25rem, 1rem + 0.75vw, 1.75rem);
    border-bottom: 1px solid var(--color-border);
  }
  .docs-header__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }
  .docs-header__title {
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.75rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--weight-semibold);
    color: var(--color-text-bright);
    margin: 0;
  }
  .docs-header__lead {
    margin: clamp(0.75rem, 0.5rem + 0.5vw, 1.1rem) 0 0;
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Prev / next pager */
  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: 48rem;
    margin-top: clamp(3rem, 2rem + 2vw, 4.5rem);
    padding-top: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    border-top: 1px solid var(--color-border);
  }
  .docs-pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg, 12px);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .docs-pager__next { text-align: end; align-items: flex-end; }
  .docs-pager__link:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-surface));
    transform: translateY(-2px);
  }
  .docs-pager__dir {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .docs-pager__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem);
    color: var(--color-text-bright);
  }
  .docs-pager__link:hover .docs-pager__title { color: var(--color-accent); }
  .docs-pager__spacer { display: block; }
  @media (max-width: 640px) {
    .docs-pager { grid-template-columns: 1fr; }
    .docs-pager__next { text-align: start; align-items: flex-start; }
    .docs-pager__spacer { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-pager__link { transition: border-color 0.2s ease; }
    .docs-pager__link:hover { transform: none; }
  }
</style>

<script>
  function slugify(text: string): string {
    return text
      .toLowerCase()
      .replace(/[^a-z0-9_\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  const article = document.querySelector('article.docs-main');
  if (article) {
    const headings = Array.from(article.querySelectorAll('h2, h3, h4')) as HTMLElement[];
    const usedSlugs = new Set<string>();

    headings.forEach((heading) => {
      const existingId = heading.getAttribute('id');
      const text = heading.textContent?.replace(/#/g, '').trim() || '';
      let slug: string;

      if (existingId) {
        slug = existingId;
      } else {
        slug = slugify(text);
        if (usedSlugs.has(slug)) {
          let i = 2;
          while (usedSlugs.has(`${slug}-${i}`)) i++;
          slug = `${slug}-${i}`;
        }
        heading.id = slug;
      }
      usedSlugs.add(slug);

      const anchor = document.createElement('a');
      anchor.href = `#${slug}`;
      anchor.className = 'heading-anchor';
      anchor.setAttribute('aria-label', `Link to ${text}`);
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });

    if (window.location.hash) {
      const target = document.getElementById(window.location.hash.slice(1));
      if (target) requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth' }));
    }

    article.querySelectorAll('table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrap')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrap';
      table.parentNode!.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  }
</script>
