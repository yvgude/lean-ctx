      var used = members.length;
      var seatsTxt = used + ' / ' + seats + ' seats in use';
      $('[data-seats]').textContent = seatsTxt;
      $('[data-seats-2]').textContent = seatsTxt;

      var list = $('[data-members]');
      if (!members.length) { list.innerHTML = '<p class="team-prose-sm">No tokens issued yet. Add a member or rotate the owner token to get started.</p>'; }
      else {
        list.innerHTML = members.map(function (m) {
          var isOwner = m.role === 'owner';
          var label = m.label || (isOwner ? 'Owner' : 'Member');
          var revoke = isOwner
            ? '<button type="button" class="team-revoke" disabled title="The owner token is rotated, not revoked">Owner</button>'
            : '<button type="button" class="team-revoke" data-revoke="' + esc(m.token_id) + '">Revoke</button>';
          return '<div class="team-member-row">'
            + '<div class="team-member-meta">'
            + '<span class="team-member-label">' + esc(label) + '</span>'
            + '<span class="team-role" data-owner="' + isOwner + '">' + esc(m.role) + '</span>'
            + '<span class="team-member-id">' + esc(m.token_id) + '</span>'
            + '</div>' + revoke + '</div>';
        }).join('');
        list.querySelectorAll('[data-revoke]').forEach(function (b) {
          b.addEventListener('click', function () { revokeMember(b.getAttribute('data-revoke'), b); });
        });
      }

      var atLimit = used >= seats;
      var addBtn = $('[data-add-btn]');
      if (addBtn) {
        if (current.seatPricing) {
          // Dynamic per-seat: adding when full auto-buys one more seat, so the
          // button only ever locks at the plan's hard tier ceiling.
          var capped = used >= current.seatsMax;
          addBtn.disabled = capped;
          addBtn.textContent = capped ? 'Tier limit reached (' + current.seatsMax + ')'
            : (atLimit ? 'Add member · +1 seat' : 'Add member');
        } else {
          addBtn.disabled = atLimit;
          addBtn.textContent = atLimit ? 'Seat limit reached' : 'Add member';
        }
      }
    }

    function fmtUsd(cents) {
      if (cents == null) return '';
      return '$' + (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    }

    // Render the dynamic seat controls. For a live per-seat plan this shows the
    // stepper + live per-seat / total price; otherwise it points at the portal.
    function renderSeats() {
      var bar = $('[data-seatbar]'); var portal = $('[data-seatbar-portal]');
      if (!bar || !portal) return;
      var used = current.members.length;
      if (current.seatPricing) {
        portal.hidden = true; bar.hidden = false;
        $('[data-seat-count]').textContent = current.seats;
        $('[data-seat-used]').textContent = used + ' of ' + current.seats + ' seat' + (current.seats === 1 ? '' : 's') + ' in use';
        var price = '';
        if (current.pricePerSeatCents != null) {
          var iv = current.interval === 'year' ? 'yr' : 'mo';
          price = fmtUsd(current.pricePerSeatCents) + '/seat · ' + fmtUsd(current.pricePerSeatCents * current.seats) + '/' + iv + ' total';
        }
        $('[data-seat-price]').textContent = price;
        var dec = $('[data-seat-dec]'); var inc = $('[data-seat-inc]');
        if (dec) dec.disabled = current.seats <= Math.max(used, 1);
        if (inc) inc.disabled = current.seats >= current.seatsMax;
      } else {
        bar.hidden = true; portal.hidden = false;
      }
    }

    async function setSeats(next) {
      clearBanner();
      var dec = $('[data-seat-dec]'); var inc = $('[data-seat-inc]');
      if (dec) dec.disabled = true; if (inc) inc.disabled = true;
      try {
        var r = await req('POST', '/api/account/team/seats', { seats: next });
        if (r.ok) {
          await load(true);
          showBanner('success', 'Seats updated to ' + ((r.data && r.data.seats) || next) + ' — prorated on your next invoice.');
        } else {
          showBanner('error', (r.data && (r.data.message || r.data.error)) || 'Could not update seats.');
          renderSeats();
        }
      } catch (err) {
        if (!(err && err.message === 'unauthorized')) showBanner('error', 'Could not reach the server. Please try again.');
        renderSeats();
      }
    }

    var current = { seats: 0, members: [], seatsUsed: 0, seatsMax: 25, pricePerSeatCents: null, interval: null, seatPricing: false };

    async function load(silent) {
      if (!silent) { $('[data-loading]').hidden = false; }
      try {
        var r = await req('GET', '/api/account/team');
        if (r.status === 503) { $('[data-loading]').hidden = true; showState('empty'); showBanner('info', 'Team hosting is being switched on — please try again shortly.'); return; }
        var d = r.data || {};

        var me = await req('GET', '/api/auth/me');
        var email = (me.data && me.data.email) || (function () { try { return localStorage.getItem(EMAIL_KEY); } catch (_) { return ''; } })();
        if (email) $('[data-email]').textContent = email;
        $('[data-id]').hidden = false;

        if (!d.provisioned && d.status === 'none') { showState('empty'); return; }
        if (!d.provisioned) { showState('pending'); return; }

        serverUrl = d.server_url || '';
        current.seats = d.seats || 0;
        current.members = d.members || [];
        current.seatsMax = d.seats_max || 25;
        current.pricePerSeatCents = (typeof d.price_per_seat_cents === 'number') ? d.price_per_seat_cents : null;
        current.interval = d.interval || null;
        current.seatPricing = !!d.seat_pricing;

        $('[data-server-url]').textContent = serverUrl;
        $('[data-status-badge]').textContent = d.status || 'active';
        $('[data-mcp-snippet]').textContent = mcpSnippet(serverUrl);
        $('[data-curl-snippet]').textContent = curlSnippet(serverUrl);
        $('[data-cli-snippet]').textContent = localConfigSnippet(serverUrl);
        renderMembers(current.members, current.seats);
        renderSeats();
        showState('live');
        window.__leanctxTeamLive = true;
        window.dispatchEvent(new CustomEvent('leanctx:team-live'));
        loadStorage();
        loadConnectors();
      } catch (err) {
        if (err && err.message === 'unauthorized') return;
        $('[data-loading]').hidden = true;
        showBanner('error', 'Could not load your team server. Please refresh or sign in again.');
      }
    }

    async function issueOwner(btn) {
      clearBanner();
      if (btn) { btn.disabled = true; var prev = btn.textContent; btn.textContent = 'Rotating…'; }
      try {
        var r = await req('POST', '/api/account/team/owner-token', {});
        if (r.ok && r.data && r.data.token) { revealToken('Owner token', r.data.token); await load(true); }
        else { showBanner('error', (r.data && (r.data.message || r.data.error)) || 'Could not issue the owner token.'); }
      } catch (err) { if (!(err && err.message === 'unauthorized')) showBanner('error', 'Could not reach the server. Please try again.'); }
      if (btn) { btn.disabled = false; btn.textContent = prev; }
    }

    async function addMember(ev) {
      ev.preventDefault();
      clearBanner();
      var label = ($('[data-add-label]').value || '').trim();
      var role = $('[data-add-role]').value || 'member';
      var btn = $('[data-add-btn]');
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
      try {
        var r = await req('POST', '/api/account/team/members', { role: role, label: label || null });
        if (r.ok && r.data && r.data.token) { $('[data-add-label]').value = ''; revealToken('Member token · ' + (label || role), r.data.token); await load(true); }
        else { showBanner('error', (r.data && (r.data.message || r.data.error)) || 'Could not add the member.'); if (btn) { btn.disabled = false; btn.textContent = 'Add member'; } }
      } catch (err) { if (!(err && err.message === 'unauthorized')) showBanner('error', 'Could not reach the server. Please try again.'); if (btn) { btn.disabled = false; btn.textContent = 'Add member'; } }
    }

    async function revokeMember(tokenId, btn) {
      if (!tokenId) return;
      clearBanner();
      if (btn) { btn.disabled = true; btn.textContent = 'Revoking…'; }
      try {
        var r = await req('DELETE', '/api/account/team/members/' + encodeURIComponent(tokenId));
        if (r.ok) { await load(true); }
        else { showBanner('error', (r.data && (r.data.message || r.data.error)) || 'Could not revoke the token.'); if (btn) { btn.disabled = false; btn.textContent = 'Revoke'; } }
      } catch (err) { if (!(err && err.message === 'unauthorized')) showBanner('error', 'Could not reach the server. Please try again.'); if (btn) { btn.disabled = false; btn.textContent = 'Revoke'; } }
    }

    // ── Hosted index storage (#282) ──────────────────────────────────────────
    async function loadStorage() {
      try {
        var r = await req('GET', '/api/account/team/storage');
        if (!r.ok || !r.data || !r.data.available || !r.data.storage) return;
        renderStorage(r.data.storage);
        $('[data-storage-card]').hidden = false;
      } catch (_) { /* storage is a convenience; never block the page */ }
    }

    function legendItem(label, bytes) {
      if (!bytes) return '';
      return '<span class="team-legend-item">' + esc(label) + ' <strong>' + esc(fmtBytes(bytes)) + '</strong></span>';
    }

    function renderStorage(s) {
      var used = Number(s.usedBytes) || 0;
      var quota = Number(s.quotaBytes) || 0;
      var pct = quota > 0 ? Math.min(100, Number(s.percent) || (used / quota) * 100) : 0;
      $('[data-storage-used]').textContent = fmtBytes(used);
      $('[data-storage-quota]').textContent = quota > 0
        ? 'of ' + fmtBytes(quota) + ' · ' + (Math.round(pct * 10) / 10) + '%'
        : 'used · unmetered';

      var meter = $('[data-storage-meter]');
      var fill = $('[data-storage-fill]');
      fill.style.width = (quota > 0 ? pct : 0) + '%';
      meter.setAttribute('aria-valuenow', String(Math.round(pct)));
      var st = s.overQuota ? 'over' : (pct >= 80 ? 'warn' : 'ok');
      meter.setAttribute('data-state', st);

      var oh = s.overhead || {};
      var wsTotal = (s.workspaces || []).reduce(function (a, w) { return a + (Number(w.usedBytes) || 0); }, 0);
      var legend = legendItem('Index', oh.indexBytes)
        + legendItem('Workspaces', wsTotal)
        + legendItem('Audit log', oh.auditBytes)
        + legendItem('Savings', oh.savingsBytes)
        + legendItem('Connectors', oh.connectorsBytes);
      var legendEl = $('[data-storage-legend]');
      if (legend) { legendEl.innerHTML = legend; legendEl.hidden = false; } else { legendEl.hidden = true; }

      var warn = $('[data-storage-warn]');
      if (s.overQuota) {
        warn.textContent = 'Quota reached — hosted connector sync is paused until usage drops. '
          + 'Existing data and search keep working. Upgrade for more headroom.';
        warn.hidden = false;
      } else if (pct >= 80) {
        warn.textContent = 'You are approaching your hosted index quota (' + (Math.round(pct)) + '%).';
        warn.hidden = false;
      } else { warn.hidden = true; }
    }

    // ── Managed connectors (#281) ────────────────────────────────────────────
    var RESOURCES = {
      gitlab: [
        { v: 'issues', t: 'Issues' },
        { v: 'merge_requests', t: 'Merge requests' },
        { v: 'pipelines', t: 'Pipelines' },
      ],
      github: [
        { v: 'issues', t: 'Issues' },
        { v: 'pull_requests', t: 'Pull requests' },
        { v: 'actions', t: 'Actions' },
      ],
    };
    var CONN_HINT = {
      gitlab: 'GitLab: a project or group access token with the <code>read_api</code> scope.',
      github: 'GitHub: a fine-grained PAT with read access to issues / pull requests / actions.',
    };

    function syncProviderUI() {
      var provider = $('[data-conn-provider]').value || 'gitlab';
      var resSel = $('[data-conn-resource]');
      resSel.innerHTML = (RESOURCES[provider] || []).map(function (r) {
        return '<option value="' + r.v + '">' + r.t + '</option>';
      }).join('');
      $('[data-conn-project-label]').textContent = provider === 'github'
        ? 'Repository (owner/repo)' : 'Project (group/repo)';
      $('[data-conn-project]').placeholder = provider === 'github' ? 'octocat/hello-world' : 'my-group/my-repo';
      $('[data-conn-secret]').placeholder = provider === 'github' ? 'github_pat_…' : 'glpat-…';
      $('[data-conn-help]').innerHTML = CONN_HINT[provider] || '';
    }

    function connStatus(c) {
      var s = c.status || {};
      var raw = s.lastStatus || (c.enabled ? 'pending' : 'paused');
      if (!c.enabled) return { key: 'pending', label: 'paused' };
      if (raw === 'ok') return { key: 'ok', label: 'ok' };
      if (raw === 'error') return { key: 'error', label: 'error' };
      return { key: 'pending', label: 'pending' };
    }

    function renderConnectors(d) {
      $('[data-conn-loading]').hidden = true;
      var list = $('[data-conn-list]');
      var conns = (d && d.connectors) || [];
      var max = (d && d.max) || 20;

      var items = 0, runs = 0;
      conns.forEach(function (c) {
        var s = c.status || {};
        items += Number(s.totalItems) || 0;
        runs += Number(s.totalRuns) || 0;
      });
      var activity = conns.length + ' / ' + max + ' connectors';
      if (runs > 0) activity += ' · ' + items.toLocaleString() + ' items ingested';
      $('[data-conn-activity]').textContent = activity;

      if (!conns.length) {
        list.innerHTML = '<p class="team-conn-empty">No connectors yet. Add one below to keep your '
          + 'team knowledge base in sync with GitLab or GitHub.</p>';
      } else {
        list.innerHTML = conns.map(function (c) {
          var st = connStatus(c);
          var s = c.status || {};
          var name = c.display_name || (c.project || c.id);
          var sub = (c.provider || '') + ' · ' + (c.resource || '') + (c.project ? ' · ' + c.project : '')
            + ' · ' + fmtInterval(c.interval_secs);
          var meta = '';
          if (s.lastItemCount != null) meta += s.lastItemCount + ' items · ';
          meta += 'last sync ' + relTime(s.lastRunAt);
          var errHtml = (st.key === 'error' && s.lastError)
            ? '<span class="team-conn-err">' + esc(s.lastError) + '</span>' : '';
          var toggleLabel = c.enabled ? 'Pause' : 'Resume';
          return '<div class="team-conn-row" data-conn-id="' + esc(c.id) + '">'
            + '<div class="team-conn-main">'
            + '<div class="team-conn-title-row">'
            + '<span class="team-conn-name">' + esc(name) + '</span>'
            + '<span class="team-conn-provider">' + esc(c.provider || '') + '</span>'
            + '<span class="team-conn-badge" data-st="' + st.key + '"><span class="team-conn-dot"></span>' + esc(st.label) + '</span>'
            + '</div>'
            + '<span class="team-conn-sub">' + esc(sub) + '</span>'
            + '<span class="team-conn-when">' + esc(meta) + '</span>'
            + errHtml
            + '</div>'
            + '<div class="team-conn-actions">'
            + '<button type="button" class="team-conn-btn" data-conn-toggle="' + esc(c.id) + '" data-enabled="' + c.enabled + '">' + toggleLabel + '</button>'
            + '<button type="button" class="team-conn-btn is-danger" data-conn-del="' + esc(c.id) + '">Remove</button>'
            + '</div>'
            + '</div>';
        }).join('');

        list.querySelectorAll('[data-conn-toggle]').forEach(function (b) {
          b.addEventListener('click', function () {
            toggleConnector(b.getAttribute('data-conn-toggle'), b.getAttribute('data-enabled') !== 'true', b);
          });
        });
        list.querySelectorAll('[data-conn-del]').forEach(function (b) {
          b.addEventListener('click', function () { deleteConnector(b.getAttribute('data-conn-del'), b); });
        });
      }

      var addBtn = $('[data-conn-add-btn]');
      var atLimit = conns.length >= max;
      if (addBtn) { addBtn.disabled = atLimit; addBtn.textContent = atLimit ? 'Connector limit reached' : 'Add connector'; }
    }

    async function loadConnectors() {
      try {
        var r = await req('GET', '/api/account/team/connectors');
        if (!r.ok) { $('[data-conn-loading]').hidden = true; return; }
        renderConnectors(r.data || {});
        $('[data-connectors-card]').hidden = false;
      } catch (err) {
        if (!(err && err.message === 'unauthorized')) $('[data-conn-loading]').hidden = true;
      }
    }

    async function createConnector(ev) {
      ev.preventDefault();
      clearBanner();
      var provider = $('[data-conn-provider]').value || 'gitlab';
      var resource = $('[data-conn-resource]').value || 'issues';
      var project = ($('[data-conn-project]').value || '').trim();
      var interval = parseInt($('[data-conn-interval]').value, 10) || 3600;
      var secret = ($('[data-conn-secret]').value || '').trim();
      var name = ($('[data-conn-name]').value || '').trim();
      if (!project) { showBanner('error', 'Project is required (e.g. ' + (provider === 'github' ? 'owner/repo' : 'group/repo') + ').'); return; }
      if (!secret) { showBanner('error', 'An access token is required to authorize the connector.'); return; }

      var btn = $('[data-conn-add-btn]');
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
      var body = { provider: provider, resource: resource, project: project, intervalSecs: interval, secret: secret, enabled: true };
      if (name) body.displayName = name;
      try {
        var r = await req('POST', '/api/account/team/connectors', body);
        if (r.ok) {
          $('[data-conn-project]').value = ''; $('[data-conn-secret]').value = ''; $('[data-conn-name]').value = '';
          var wrap = $('[data-conn-add-wrap]'); if (wrap) wrap.open = false;
          showBanner('success', 'Connector added — the first sync runs within a minute.');
          await loadConnectors();
        } else {
          showBanner('error', (r.data && (r.data.message || r.data.error)) || 'Could not add the connector.');
        }
      } catch (err) {
        if (!(err && err.message === 'unauthorized')) showBanner('error', 'Could not reach the server. Please try again.');
      }
      if (btn) { btn.disabled = false; btn.textContent = 'Add connector'; }
    }

    async function toggleConnector(id, enabled, btn) {
      if (!id) return;
      clearBanner();
      if (btn) { btn.disabled = true; btn.textContent = enabled ? 'Resuming…' : 'Pausing…'; }
      try {
        var r = await req('PATCH', '/api/account/team/connectors/' + encodeURIComponent(id), { enabled: enabled });
        if (r.ok) { await loadConnectors(); }
        else { showBanner('error', (r.data && (r.data.message || r.data.error)) || 'Could not update the connector.'); if (btn) btn.disabled = false; }
      } catch (err) { if (!(err && err.message === 'unauthorized')) showBanner('error', 'Could not reach the server. Please try again.'); if (btn) btn.disabled = false; }
    }

    async function deleteConnector(id, btn) {
      if (!id) return;
      clearBanner();
      if (btn) { btn.disabled = true; btn.textContent = 'Removing…'; }
      try {
        var r = await req('DELETE', '/api/account/team/connectors/' + encodeURIComponent(id));
        if (r.ok) { showBanner('info', 'Connector removed.'); await loadConnectors(); }
        else { showBanner('error', (r.data && (r.data.message || r.data.error)) || 'Could not remove the connector.'); if (btn) { btn.disabled = false; btn.textContent = 'Remove'; } }
      } catch (err) { if (!(err && err.message === 'unauthorized')) showBanner('error', 'Could not reach the server. Please try again.'); if (btn) { btn.disabled = false; btn.textContent = 'Remove'; } }
    }

    // Wiring
    var signout = $('[data-signout]');
    if (signout) signout.addEventListener('click', function () { clearSession(); window.location.assign('/login/'); });
    var refresh = $('[data-refresh]');
    if (refresh) refresh.addEventListener('click', function () { load(false); });
    $('[data-owner-btn]').addEventListener('click', function (e) { issueOwner(e.currentTarget); });
    $('[data-add-form]').addEventListener('submit', addMember);
    var seatDec = $('[data-seat-dec]'); var seatInc = $('[data-seat-inc]');
    if (seatDec) seatDec.addEventListener('click', function () { if (current.seats > 1) setSeats(current.seats - 1); });
    if (seatInc) seatInc.addEventListener('click', function () { if (current.seats < current.seatsMax) setSeats(current.seats + 1); });
    $('[data-copy-url]').addEventListener('click', function (e) { copyText(serverUrl, e.currentTarget); });
    $('[data-copy-mcp]').addEventListener('click', function (e) { copyText(mcpSnippet(serverUrl), e.currentTarget); });
    $('[data-copy-curl]').addEventListener('click', function (e) { copyText(curlSnippet(serverUrl), e.currentTarget); });
    var copyCli = $('[data-copy-cli]');
    if (copyCli) copyCli.addEventListener('click', function (e) { copyText(localConfigSnippet(serverUrl), e.currentTarget); });
    $('[data-copy-token]').addEventListener('click', function (e) { copyText($('[data-reveal-token]').textContent, e.currentTarget); });
    $('[data-reveal-close]').addEventListener('click', function () { $('[data-reveal]').hidden = true; });

    var connProvider = $('[data-conn-provider]');
    if (connProvider) connProvider.addEventListener('change', syncProviderUI);
    var connForm = $('[data-conn-form]');
    if (connForm) connForm.addEventListener('submit', createConnector);
    syncProviderUI();

    load(false);
  })();
</script>

<script>
  import {
    fmtCompact, fmtInt, fmtUsd, fmtDay,
    windowTrend, fmtPct, sliceSeries, chartGeometry, proportion, toCsv,
  } from '../lib/roi';

  (function () {
    var API = 'https://api.leanctx.com';
    var TOKEN_KEY = 'leanctx-api-token';

    function $(s) { return document.querySelector(s); }
    function token() { try { return localStorage.getItem(TOKEN_KEY); } catch (_) { return null; } }
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }

    var state = { summary: null, metric: 'net_saved_tokens', range: 90 };
    var started = false;
    var controlsWired = false;

    var METRICS = {
      net_saved_tokens: { label: 'tokens', fmt: function (v) { return fmtCompact(v) + ' tokens'; }, axis: fmtCompact },
      saved_usd: { label: 'USD', fmt: fmtUsd, axis: fmtUsd },
      total_events: { label: 'actions', fmt: function (v) { return fmtCompact(v) + ' actions'; }, axis: fmtCompact },
    };

    async function fetchSavings() {
      var t = token();
      if (!t) return null;
      try {
        var res = await fetch(API + '/api/account/team/savings', {
          headers: { Authorization: 'Bearer ' + t, Accept: 'application/json' },
        });
        if (!res.ok) return null;
        var text = await res.text();
        return text ? JSON.parse(text) : null;
      } catch (_) { return null; }
    }

    function show(sel, on) { var el = $(sel); if (el) el.hidden = !on; }

    async function loadRoi() {
      var data = await fetchSavings();
      show('[data-roi-loading]', false);

      var s = data && data.summary;
      var hasData = data && data.savings_available && s && s.totals &&
        (Number(s.totals.net_saved_tokens) > 0 || (s.series && s.series.length));
      if (!hasData) { show('[data-roi-empty]', true); return; }

      state.summary = s;
      renderKpis(s);
      renderBreakdowns(s);
      renderChart();
      wireControls();

      show('[data-roi-kpis]', true);
      show('[data-roi-chart-wrap]', !!(s.series && s.series.length));
      show('[data-roi-breakdowns]', true);
      var exp = $('[data-roi-export]'); if (exp) exp.hidden = false;
      var membersTag = $('[data-roi-members]');
      if (membersTag) membersTag.textContent = (s.member_count || (s.by_member || []).length) + ' reporting';
    }

    function setDelta(sel, trend) {
      var el = $(sel);
      if (!el) return;
      if (trend.pct === null) { el.hidden = true; return; }
      el.hidden = false;
      el.setAttribute('data-dir', trend.dir);
      el.textContent = fmtPct(trend.pct) + ' · 30d';
    }

    function renderKpis(s) {
      var t = s.totals || {};
      var series = s.series || [];
      $('[data-kpi-tokens]').textContent = fmtCompact(t.net_saved_tokens || 0);
      $('[data-kpi-usd]').textContent = fmtUsd(t.saved_usd || 0);
      $('[data-kpi-events]').textContent = fmtCompact(t.total_events || 0);
      $('[data-kpi-membercount]').textContent = fmtInt(s.member_count || (s.by_member || []).length);
      setDelta('[data-kpi-tokens-delta]', windowTrend(series, 'net_saved_tokens', 30));
      setDelta('[data-kpi-usd-delta]', windowTrend(series, 'saved_usd', 30));
      setDelta('[data-kpi-events-delta]', windowTrend(series, 'total_events', 30));
    }

    function rowsHtml(rows, nameKey, valFn, max) {
      if (!rows.length) return '<p class="roi-empty">No data yet.</p>';
      return rows.map(function (r) {
        var pct = Math.round(proportion(r.__bar, max) * 100);
        return '<div class="roi-row">'
          + '<div class="roi-row-top"><span class="roi-name">' + esc(r[nameKey] || '?')
          + '</span><span class="roi-val">' + valFn(r) + '</span></div>'
          + '<div class="roi-bar"><span class="roi-bar-fill" style="width:' + pct + '%"></span></div>'
          + '</div>';
      }).join('');
    }

    function renderBreakdowns(s) {
      var members = (s.by_member || []).map(function (m) { m.__bar = m.net_saved_tokens || 0; return m; });
      var mMax = members.reduce(function (a, m) { return Math.max(a, m.__bar); }, 0);
      $('[data-roi-members-rows]').innerHTML = rowsHtml(members, 'agent_id', function (m) {
        return fmtCompact(m.net_saved_tokens) + ' tok · ' + fmtUsd(m.saved_usd);
      }, mMax);

      var models = (s.by_model || []).map(function (m) { m.__bar = m.saved_tokens || 0; return m; });
      var gMax = models.reduce(function (a, m) { return Math.max(a, m.__bar); }, 0);
      $('[data-roi-models-rows]').innerHTML = rowsHtml(models, 'model', function (m) {
        return fmtCompact(m.saved_tokens) + ' tok';
      }, gMax);

      var tools = (s.by_tool || []).map(function (m) { m.__bar = m.saved_tokens || 0; return m; });
      var tMax = tools.reduce(function (a, m) { return Math.max(a, m.__bar); }, 0);
      $('[data-roi-tools-rows]').innerHTML = rowsHtml(tools, 'tool', function (m) {
        return fmtCompact(m.saved_tokens) + ' tok';
      }, tMax);
    }

    function renderChart() {
      var wrap = $('[data-roi-chart]');
      if (!wrap || !state.summary) return;
      var series = sliceSeries(state.summary.series || [], state.range);
      var m = METRICS[state.metric];
      var geo = chartGeometry(series, state.metric, 720, 220);
      var W = geo.width, H = geo.height;

      var grid = geo.ticks.map(function (tk) {
        return '<line class="roi-grid" x1="8" y1="' + tk.y + '" x2="' + (W - 8) + '" y2="' + tk.y + '"/>'
          + '<text class="roi-grid-label" x="' + (W - 6) + '" y="' + (tk.y - 3) + '" text-anchor="end">'
          + esc(m.axis(tk.value)) + '</text>';
      }).join('');

      var xlabels = '';
      if (series.length) {
        var idxs = [0, Math.floor((series.length - 1) / 2), series.length - 1];
        var seen = {};
        idxs.forEach(function (i) {
          if (seen[i]) return; seen[i] = 1;
          var pt = geo.points[i];
          var anchor = i === 0 ? 'start' : (i === series.length - 1 ? 'end' : 'middle');
          xlabels += '<text class="roi-x-label" x="' + pt.x + '" y="' + (H - 6) + '" text-anchor="' + anchor + '">'
            + esc(fmtDay(pt.date)) + '</text>';
        });
      }

      var aria = 'Cumulative ' + m.label + ' over the last ' + series.length + ' days';
      var svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + esc(aria) + '">'
        + '<defs><linearGradient id="roiFill" x1="0" y1="0" x2="0" y2="1">'
        + '<stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.28"/>'
        + '<stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0"/>'
        + '</linearGradient></defs>'
        + grid
        + (geo.area ? '<path class="roi-area" d="' + geo.area + '" fill="url(#roiFill)"/>' : '')
        + (geo.line ? '<path class="roi-line" d="' + geo.line + '"/>' : '')
        + '<line class="roi-cursor" data-cursor x1="0" y1="14" x2="0" y2="' + (H - 22) + '" style="display:none"/>'
        + '<circle class="roi-dot" data-dot r="3.5" cx="0" cy="0" style="display:none"/>'
        + xlabels
        + '</svg>';

      var table = '<table class="roi-visually-hidden"><caption>' + esc(aria) + '</caption><tbody>'
        + series.map(function (p) {
          return '<tr><th scope="row">' + esc(fmtDay(p.date)) + '</th><td>' + esc(m.fmt(p[state.metric])) + '</td></tr>';
        }).join('')
        + '</tbody></table>';
      var tip = '<figcaption class="team-chart-tip" data-tip aria-live="polite"></figcaption>';

      wrap.innerHTML = svg + table + tip;
      var last = series[series.length - 1];
      if (last) setTip(fmtDay(last.date), m.fmt(last[state.metric]));
      wireHover(wrap, geo, series, m);
    }

    function setTip(dateStr, valStr) {
      var tip = $('[data-tip]');
      if (tip) tip.innerHTML = '<strong>' + esc(valStr) + '</strong> · ' + esc(dateStr);
    }

    function wireHover(wrap, geo, series, m) {
      var svg = wrap.querySelector('svg');
      if (!svg || !series.length) return;
      var cursor = wrap.querySelector('[data-cursor]');
      var dot = wrap.querySelector('[data-dot]');
      function move(ev) {
        var rect = svg.getBoundingClientRect();
        var clientX = ev.touches && ev.touches[0] ? ev.touches[0].clientX : ev.clientX;
        var ratio = rect.width ? (clientX - rect.left) / rect.width : 0;
        var i = Math.max(0, Math.min(series.length - 1, Math.round(ratio * (series.length - 1))));
        var pt = geo.points[i];
        if (!pt) return;
        cursor.style.display = ''; cursor.setAttribute('x1', pt.x); cursor.setAttribute('x2', pt.x);
        dot.style.display = ''; dot.setAttribute('cx', pt.x); dot.setAttribute('cy', pt.y);
        setTip(fmtDay(series[i].date), m.fmt(series[i][state.metric]));
      }
      function leave() {
        cursor.style.display = 'none'; dot.style.display = 'none';
        var last = series[series.length - 1];
        if (last) setTip(fmtDay(last.date), m.fmt(last[state.metric]));
      }
      svg.addEventListener('mousemove', move);
      svg.addEventListener('touchmove', move, { passive: true });
      svg.addEventListener('mouseleave', leave);
    }

    function setOn(sel, active) {
      document.querySelectorAll(sel).forEach(function (b) { b.classList.toggle('is-on', b === active); });
    }

    function wireControls() {
      if (controlsWired) return; controlsWired = true;
      document.querySelectorAll('[data-metric]').forEach(function (b) {
        b.addEventListener('click', function () {
          state.metric = b.getAttribute('data-metric');
          setOn('[data-metric]', b);
          renderChart();
        });
      });
      document.querySelectorAll('[data-range]').forEach(function (b) {
        b.addEventListener('click', function () {
          state.range = parseInt(b.getAttribute('data-range'), 10) || 90;
          setOn('[data-range]', b);
          renderChart();
        });
      });
      var exp = $('[data-roi-export]');
      if (exp) exp.addEventListener('click', exportCsv);
    }

    function exportCsv() {
      if (!state.summary) return;
      var blob = new Blob([toCsv(state.summary)], { type: 'text/csv;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'leanctx-team-roi-' + new Date().toISOString().slice(0, 10) + '.csv';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    }

    function start() { if (started) return; started = true; loadRoi(); }
    if (window.__leanctxTeamLive) start();
    window.addEventListener('leanctx:team-live', start);
  })();
</script>
