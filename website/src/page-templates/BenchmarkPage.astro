    </div>
  </div>
</section>

</BaseLayout>

<style>
  /* ── Before / After ─────────────────────── */
  .bench-compare {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .bench-compare {
      grid-template-columns: 1fr auto 1fr;
      gap: clamp(1rem, 0.75rem + 0.75vw, 2rem);
    }
  }
  .bench-compare-col {
    min-width: 0;
  }
  .bench-compare-highlight {
    border-color: var(--color-accent) !important;
    box-shadow: 0 0 30px rgba(52, 211, 153, 0.08);
  }
  .bench-compare-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .bench-compare-badge-text {
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 0.8rem + 0.2vw, 1.125rem);
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .bench-compare-arrow {
    width: 24px;
    height: 24px;
    color: var(--color-accent);
  }
  @media (max-width: 767px) {
    .bench-compare-arrow {
      transform: rotate(90deg);
    }
  }

  /* ── Steps ──────────────────────────────── */
  .bench-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 768px) {
    .bench-steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bench-step {
    position: relative;
    padding: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .bench-step {
      border-top: none;
      border-left: 1px solid var(--color-border);
    }
    .bench-step:first-child {
      border-left: none;
    }
  }
  .bench-step-num {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .bench-step-line {
    display: none;
  }

  /* ── Mode Cards ─────────────────────────── */
  .bench-modes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);
  }
  @media (min-width: 640px) {
    .bench-modes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .bench-modes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bench-mode-card {
    padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
  }
  .bench-mode-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }
  .bench-mode-savings {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .bench-mode-bar-track {
    height: 4px;
    background: var(--color-surface-2);
    border-radius: 2px;
    margin-bottom: 0.875rem;
    overflow: hidden;
  }
  .bench-mode-bar-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Stat Rings ─────────────────────────── */
  .bench-stat-card {
    padding: clamp(1.5rem, 1rem + 1vw, 2rem);
    text-align: center;
  }
  .bench-stat-ring {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 0 auto clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
  }
  .bench-stat-ring svg {
    width: 100%;
    height: 100%;
  }
  .bench-stat-ring-val {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-bright);
    letter-spacing: -0.03em;
  }

  /* ── Real-World Grid ────────────────────── */
  .bench-realworld-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);
  }
  @media (min-width: 640px) {
    .bench-realworld-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .bench-realworld-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bench-realworld-card {
    padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
  }
  .bench-realworld-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }
  .bench-realworld-pct {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .bench-realworld-tokens {
    margin-bottom: 0.625rem;
  }
  .bench-realworld-bar-track {
    height: 4px;
    background: var(--color-surface-2);
    border-radius: 2px;
    overflow: hidden;
  }
  .bench-realworld-bar-fill {
    height: 100%;
    border-radius: 2px;
  }

  /* ── CTA Command ────────────────────────── */
  .bench-cta-cmd {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: clamp(0.875rem, 0.83rem + 0.15vw, 1rem);
    margin-bottom: 0.75rem;
  }
  .bench-cta-copy {
    color: var(--color-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 4px;
    transition: color 0.15s ease;
  }
  .bench-cta-copy:hover {
    color: var(--color-text-bright);
  }
</style>

<script>
  document.querySelectorAll('.bench-cta-copy').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy') || '';
      navigator.clipboard.writeText(text);
      btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
      setTimeout(() => {
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
      }, 2000);
    });
  });
</script>
