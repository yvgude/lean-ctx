          <p class="fluid-sm text-muted">{t('benchmark.costDesc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 8. REAL-WORLD RESULTS ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">{t('benchmark.realWorldLabel')}</p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      {t('benchmark.realWorldTitle')} <span class="gradient-text">{t('benchmark.realWorldTitleHighlight')}</span>
    </h2>
    <p class="fluid-body text-muted animate-entrance stagger-2" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem); max-width: 44rem;">{t('benchmark.realWorldDesc')}</p>

    <div class="bench-realworld-grid">
      {realWorldExamples.map((ex) => (
        <div class="card bench-realworld-card animate-entrance">
          <div class="bench-realworld-top">
            <span class="font-display font-semibold text-text-bright">{ex.file}</span>
            <span class="bench-realworld-pct" style={`color: ${ex.textColor}`}>{ex.savings}</span>
          </div>
          <p class="text-[12px] text-muted" style="margin-bottom: 0.75rem;">{ex.detail}</p>
          <div class="bench-realworld-tokens">
            <code class="text-[12px] font-mono text-muted">{ex.tokens}</code>
          </div>
          <div class="bench-realworld-bar-track">
            <div class="bench-realworld-bar-fill" style={`width: ${ex.savings}; background: ${ex.barColor}`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 9. CTA ═══════ -->
<section class="relative section-y">
  <div class="content-grid" style="text-align: center;">
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('benchmark.ctaTitle')} <span class="gradient-text">{t('benchmark.ctaTitleHighlight')}</span>
    </h2>
    <p class="fluid-body text-muted animate-entrance stagger-1" style="margin-bottom: clamp(2rem, 1.5rem + 1vw, 3rem); max-width: 44rem; margin-inline: auto;" set:html={t('benchmark.ctaDesc')} />

