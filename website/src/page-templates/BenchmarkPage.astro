---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const readModes = [
  { mode: 'full',       color: 'text-muted',   barColor: 'var(--color-muted)',    barPct: 0,  savings: t('benchmark.modeFullSavings'),       useCase: t('benchmark.modeFullUseCase'),       preserves: t('benchmark.modeFullPreserves') },
  { mode: 'map',        color: 'text-accent',   barColor: 'var(--color-accent)',   barPct: 82, savings: t('benchmark.modeMapSavings'),        useCase: t('benchmark.modeMapUseCase'),        preserves: t('benchmark.modeMapPreserves') },
  { mode: 'signatures', color: 'text-accent',   barColor: 'var(--color-accent)',   barPct: 78, savings: t('benchmark.modeSignaturesSavings'), useCase: t('benchmark.modeSignaturesUseCase'), preserves: t('benchmark.modeSignaturesPreserves') },
  { mode: 'diff',       color: 'text-accent-2', barColor: 'var(--color-accent-2)', barPct: 90, savings: t('benchmark.modeDiffSavings'),       useCase: t('benchmark.modeDiffUseCase'),       preserves: t('benchmark.modeDiffPreserves') },
  { mode: 'aggressive', color: 'text-accent',   barColor: 'var(--color-accent)',   barPct: 85, savings: t('benchmark.modeAggressiveSavings'), useCase: t('benchmark.modeAggressiveUseCase'), preserves: t('benchmark.modeAggressivePreserves') },
  { mode: 'entropy',    color: 'text-accent',   barColor: 'var(--color-accent)',   barPct: 78, savings: t('benchmark.modeEntropySavings'),    useCase: t('benchmark.modeEntropyUseCase'),    preserves: t('benchmark.modeEntropyPreserves') },
  { mode: 'task',       color: 'text-accent-3', barColor: 'var(--color-accent-3)', barPct: 77, savings: t('benchmark.modeTaskSavings'),       useCase: t('benchmark.modeTaskUseCase'),       preserves: t('benchmark.modeTaskPreserves') },
];

const realWorldExamples = [
  { file: t('benchmark.realWorld1File'), detail: t('benchmark.realWorld1Detail'), tokens: t('benchmark.realWorld1Tokens'), savings: t('benchmark.realWorld1Savings'), barColor: 'var(--color-accent)',   textColor: 'var(--color-accent)' },
  { file: t('benchmark.realWorld2File'), detail: t('benchmark.realWorld2Detail'), tokens: t('benchmark.realWorld2Tokens'), savings: t('benchmark.realWorld2Savings'), barColor: 'var(--color-accent-2)', textColor: 'var(--color-accent-2)' },
  { file: t('benchmark.realWorld3File'), detail: t('benchmark.realWorld3Detail'), tokens: t('benchmark.realWorld3Tokens'), savings: t('benchmark.realWorld3Savings'), barColor: 'var(--color-accent)',   textColor: 'var(--color-accent)' },
  { file: t('benchmark.realWorld4File'), detail: t('benchmark.realWorld4Detail'), tokens: t('benchmark.realWorld4Tokens'), savings: t('benchmark.realWorld4Savings'), barColor: 'var(--color-accent-3)', textColor: 'var(--color-accent-3)' },
  { file: t('benchmark.realWorld5File'), detail: t('benchmark.realWorld5Detail'), tokens: t('benchmark.realWorld5Tokens'), savings: t('benchmark.realWorld5Savings'), barColor: 'var(--color-accent-2)', textColor: 'var(--color-accent-2)' },
];
---

<BaseLayout title={t('benchmark.metaTitle')} description={t('benchmark.metaDescription')} breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: t('benchmark.breadcrumb'), url: lp('/benchmark/') }]}>

<!-- ═══════ 1. HERO ═══════ -->
<section class="section-hero">
  <div class="content-grid">
    <div class="animate-entrance">
      <p class="fluid-label text-accent" style="margin-bottom: clamp(1.25rem, 1rem + 1vw, 2.5rem);">{t('benchmark.heroLabel')}</p>
    </div>

    <h1 class="font-display fluid-display font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem);">
      {t('benchmark.heroTitle')}<br/>
      <span class="gradient-text">{t('benchmark.heroTitleHighlight')}</span>
    </h1>

    <p class="fluid-body text-muted animate-entrance stagger-2" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3.5rem); max-width: 44rem;" set:html={t('benchmark.heroDesc')} />

    <div class="flex flex-wrap items-center animate-entrance stagger-3" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center gap-2 font-bold rounded-lg text-bg" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        {t('benchmark.ctaGetStarted')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        {t('benchmark.ctaStarGithub')}
      </a>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 2. BEFORE / AFTER ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">{t('benchmark.beforeAfterLabel')}</p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      {t('benchmark.beforeAfterTitle')} <span class="gradient-text">{t('benchmark.beforeAfterTitleHighlight')}</span>
    </h2>
    <p class="fluid-body text-muted animate-entrance stagger-2" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem); max-width: 44rem;">{t('benchmark.beforeAfterDesc')}</p>

    <div class="bench-compare animate-entrance stagger-3">
      <div class="bench-compare-col">
        <div class="terminal-chrome">
          <div class="terminal-header px-4 py-3 flex items-center gap-2">
            <span class="terminal-dot bg-[#ff5f57]"></span>
            <span class="terminal-dot bg-[#febc2e]"></span>
            <span class="terminal-dot bg-[#28c840]"></span>
            <span class="text-xs text-muted font-mono ml-2">{t('benchmark.beforeTitle')}</span>
          </div>
          <div class="terminal-body px-4 py-4 font-mono text-[11px] leading-[1.7]">
            <p class="text-muted">// src/auth.ts — full file read</p>
            <p class="text-text-bright">import {'{'} jwt, verify, sign {'}'} from 'jsonwebtoken';</p>
            <p class="text-text-bright">import {'{'} bcrypt {'}'} from 'bcryptjs';</p>
            <p class="text-text-bright">import {'{'} db {'}'} from '../database/connection';</p>
            <p class="text-text-bright">import {'{'} Redis {'}'} from 'ioredis';</p>
            <p class="text-text-bright">import {'{'} logger {'}'} from '../utils/logger';</p>
            <p class="text-muted">// ... 117 more lines of imports, JSDoc,</p>
            <p class="text-muted">// boilerplate, error classes, type guards,</p>
            <p class="text-muted">// redundant comments, unused exports ...</p>
            <p class="text-border-light/40 mt-2">────────────────────────</p>
            <p class="text-danger font-bold">{t('benchmark.beforeTokens')}</p>
          </div>
        </div>
      </div>

      <div class="bench-compare-badge">
        <span class="bench-compare-badge-text">{t('benchmark.savingsBadge')}</span>
        <svg class="bench-compare-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </div>

      <div class="bench-compare-col">
        <div class="terminal-chrome bench-compare-highlight">
          <div class="terminal-header px-4 py-3 flex items-center gap-2">
            <span class="terminal-dot bg-[#ff5f57]"></span>
            <span class="terminal-dot bg-[#febc2e]"></span>
            <span class="terminal-dot bg-[#28c840]"></span>
            <span class="text-xs text-accent font-mono ml-2">{t('benchmark.afterTitle')}</span>
          </div>
          <div class="terminal-body px-4 py-4 font-mono text-[11px] leading-[1.7]">
            <p class="text-muted">// src/auth.ts — map mode</p>
            <p class="text-accent">exports: AuthService, validateToken,</p>
            <p class="text-accent">         refreshSession, revokeToken</p>
            <p class="text-accent">deps: jsonwebtoken, bcryptjs, ioredis</p>
            <p class="text-accent">types: AuthPayload, SessionConfig,</p>
            <p class="text-accent">       TokenPair, RefreshResult</p>
            <p class="text-accent">fns: 4 public, 2 private</p>
            <p class="text-muted"></p>
            <p class="text-muted"></p>
            <p class="text-border-light/40 mt-2">────────────────────────</p>
            <p class="text-accent font-bold">{t('benchmark.afterTokens')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 3. HOW IT WORKS ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">{t('benchmark.stepsLabel')}</p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);">
      {t('benchmark.stepsTitle')} <span class="gradient-text">{t('benchmark.stepsTitleHighlight')}</span>
    </h2>

    <div class="bench-steps">
      <div class="bench-step animate-entrance">
        <div class="bench-step-num">
          <span class="text-xl font-bold text-accent font-display">1</span>
        </div>
        <div class="bench-step-line"></div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright" style="margin-bottom: 0.5rem;">{t('benchmark.step1Title')}</h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 0.75rem;">{t('benchmark.step1Desc')}</p>
        <code class="block text-[11px] font-mono text-accent/70">lean-ctx benchmark run src/</code>
      </div>

      <div class="bench-step animate-entrance stagger-1">
        <div class="bench-step-num">
          <span class="text-xl font-bold text-accent-2 font-display">2</span>
        </div>
        <div class="bench-step-line"></div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright" style="margin-bottom: 0.5rem;">{t('benchmark.step2Title')}</h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 0.75rem;">{t('benchmark.step2Desc')}</p>
        <code class="block text-[11px] font-mono text-accent-2/70">tiktoken o200k_base</code>
      </div>

      <div class="bench-step animate-entrance stagger-2">
        <div class="bench-step-num">
          <span class="text-xl font-bold text-accent-3 font-display">3</span>
        </div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright" style="margin-bottom: 0.5rem;">{t('benchmark.step3Title')}</h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 0.75rem;">{t('benchmark.step3Desc')}</p>
        <code class="block text-[11px] font-mono text-accent-3/70">7 modes compared</code>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 4. TERMINAL DEMO ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <div class="grid lg:grid-cols-[1fr_1.4fr] items-center" style="gap: clamp(1.75rem, 1.25rem + 1.5vw, 3.5rem);">
      <div>
        <p class="fluid-label text-muted" style="margin-bottom: clamp(0.5rem, 0.35rem + 0.35vw, 0.875rem);">{t('benchmark.demoLabel')}</p>
        <h2 class="font-display fluid-h2 font-bold text-text-bright" style="margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
          {t('benchmark.demoTitle')} <span class="gradient-text">{t('benchmark.demoTitleHighlight')}</span>
        </h2>
        <p class="fluid-body text-muted" style="margin-bottom: clamp(1rem, 0.75rem + 0.75vw, 1.75rem);">{t('benchmark.demoDesc')}</p>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <p class="fluid-sm text-muted"><span class="text-text-bright font-medium">{t('benchmark.demoBreakdown')}</span> {t('benchmark.demoBreakdownDesc')}</p>
          <p class="fluid-sm text-muted"><span class="text-text-bright font-medium">{t('benchmark.demoQuality')}</span> {t('benchmark.demoQualityDesc')}</p>
          <p class="fluid-sm text-muted"><span class="text-text-bright font-medium">{t('benchmark.demoTotals')}</span> {t('benchmark.demoTotalsDesc')}</p>
        </div>
      </div>

      <div class="terminal-chrome animate-entrance">
        <div class="terminal-header px-4 py-3 flex items-center gap-2">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="text-xs text-muted font-mono ml-2">lean-ctx benchmark run</span>
        </div>
        <div class="terminal-body px-4 py-4 font-mono text-[11px] sm:text-[12px] leading-[1.8]">
          <p class="text-muted">$ lean-ctx benchmark run src/auth.ts</p>
          <p><span class="text-text-bright font-bold">◆ lean-ctx</span> <span class="text-muted">Benchmark</span></p>
          <p class="text-border-light/40">────────────────────────────────────────</p>
          <p class="text-text-bright mt-1">src/auth.ts <span class="text-muted">(123 lines, 3,517 tokens)</span></p>
          <p class="text-border-light/40">────────────────────────────────────────</p>
          <p class="mt-1"><span class="text-muted">Mode         Tokens   Saved   Rate</span></p>
          <p><span class="text-text-bright">full         </span><span class="text-muted">3,517   </span><span class="text-muted">    0   </span><span class="text-muted"> 0%</span></p>
          <p><span class="text-accent">map          </span><span class="text-accent">  412   </span><span class="text-accent">3,105   </span><span class="text-accent font-bold">88%</span></p>
          <p><span class="text-accent">signatures   </span><span class="text-accent">  252   </span><span class="text-accent">3,265   </span><span class="text-accent font-bold">93%</span></p>
          <p><span class="text-accent-2">diff         </span><span class="text-accent-2">  187   </span><span class="text-accent-2">3,330   </span><span class="text-accent-2 font-bold">95%</span></p>
          <p><span class="text-accent">aggressive   </span><span class="text-accent">  298   </span><span class="text-accent">3,219   </span><span class="text-accent font-bold">92%</span></p>
          <p><span class="text-accent">entropy      </span><span class="text-accent">  312   </span><span class="text-accent">3,205   </span><span class="text-accent font-bold">91%</span></p>
          <p class="text-border-light/40 mt-2">────────────────────────────────────────</p>
          <p class="text-muted">Quality: <span class="text-accent">AST 98%</span> | <span class="text-accent">Idents 97%</span> | <span class="text-accent">Lines 96%</span></p>
          <p class="text-muted text-[10px]">Encoding: tiktoken o200k_base | Time: 12ms</p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 5. READ MODES CARDS ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">{t('benchmark.modesLabel')}</p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);">
      {t('benchmark.modesTitle')} <span class="gradient-text">{t('benchmark.modesTitleHighlight')}</span>
    </h2>

    <div class="bench-modes-grid">
      {readModes.map((m) => (
        <div class="card bench-mode-card animate-entrance">
          <div class="bench-mode-head">
            <code class={`text-sm font-mono font-bold ${m.color}`}>{m.mode}</code>
            <span class={`bench-mode-savings ${m.color}`}>{m.savings}</span>
          </div>
          <div class="bench-mode-bar-track">
            <div class="bench-mode-bar-fill" style={`width: ${m.barPct}%; background: ${m.barColor}`}></div>
          </div>
          <p class="fluid-sm text-text-bright" style="margin-bottom: 0.25rem;">{m.useCase}</p>
          <p class="text-[12px] text-muted">{m.preserves}</p>
        </div>
      ))}
    </div>

    <p class="fluid-sm text-muted mt-6 animate-entrance" set:html={t('benchmark.modesSmartRead')} />
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 6. COMPRESSION QUALITY ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">{t('benchmark.qualityLabel')}</p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);">
      {t('benchmark.qualityTitle')} <span class="gradient-text">{t('benchmark.qualityTitleHighlight')}</span>
    </h2>

    <div class="grid md:grid-cols-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      <div class="card bench-stat-card animate-entrance">
        <div class="bench-stat-ring bench-stat-ring-1">
          <svg viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-border)" stroke-width="8"/>
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-accent)" stroke-width="8" stroke-linecap="round" stroke-dasharray="326.73" stroke-dashoffset="6.53" transform="rotate(-90 60 60)"/>
          </svg>
          <span class="bench-stat-ring-val font-display">98%</span>
        </div>
        <p class="fluid-label text-muted" style="margin-bottom: 0.5rem;">{t('benchmark.stat1Label')}</p>
        <p class="fluid-sm text-muted">{t('benchmark.stat1Desc')}</p>
      </div>

      <div class="card bench-stat-card animate-entrance stagger-1">
        <div class="bench-stat-ring bench-stat-ring-2">
          <svg viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-border)" stroke-width="8"/>
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-accent-2)" stroke-width="8" stroke-linecap="round" stroke-dasharray="326.73" stroke-dashoffset="9.80" transform="rotate(-90 60 60)"/>
          </svg>
          <span class="bench-stat-ring-val font-display">97%</span>
        </div>
        <p class="fluid-label text-muted" style="margin-bottom: 0.5rem;">{t('benchmark.stat2Label')}</p>
        <p class="fluid-sm text-muted">{t('benchmark.stat2Desc')}</p>
      </div>

      <div class="card bench-stat-card animate-entrance stagger-2">
        <div class="bench-stat-ring bench-stat-ring-3">
          <svg viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-border)" stroke-width="8"/>
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-accent-3)" stroke-width="8" stroke-linecap="round" stroke-dasharray="326.73" stroke-dashoffset="13.07" transform="rotate(-90 60 60)"/>
          </svg>
          <span class="bench-stat-ring-val font-display">96%</span>
        </div>
        <p class="fluid-label text-muted" style="margin-bottom: 0.5rem;">{t('benchmark.stat3Label')}</p>
        <p class="fluid-sm text-muted">{t('benchmark.stat3Desc')}</p>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- ═══════ 7. WHY FEWER TOKENS ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <div class="grid lg:grid-cols-2 items-start" style="gap: clamp(2rem, 1.5rem + 2vw, 3rem);">
      <div>
        <p class="fluid-label text-muted" style="margin-bottom: clamp(0.5rem, 0.35rem + 0.35vw, 0.875rem);">{t('benchmark.whyLabel')}</p>
        <h2 class="font-display fluid-h2 font-bold text-text-bright" style="margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
          {t('benchmark.whyTitle')} <span class="gradient-text">{t('benchmark.whyTitleHighlight')}</span>
        </h2>
        <p class="fluid-body text-muted" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">{t('benchmark.whyDesc1')}</p>
        <p class="fluid-body text-muted">{t('benchmark.whyDesc2')}</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div class="card p-6 animate-entrance">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center">
