---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getMcpManifest } from '../lib/mcpManifest';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is context engineering?', acceptedAnswer: { '@type': 'Answer', text: 'Context engineering is the discipline of managing what information an AI agent sees, remembers, and acts on. It replaces ad-hoc prompt engineering with a systematic runtime that compresses, caches, verifies, and governs AI context.' } },
    { '@type': 'Question', name: 'Why does context engineering matter for AI coding?', acceptedAnswer: { '@type': 'Answer', text: 'AI coding agents waste thousands of tokens rereading files, parsing noisy shell output, and losing context between sessions. Context engineering reduces this waste by up to 99%, making agents faster, cheaper, and more reliable.' } },
    { '@type': 'Question', name: 'How is context engineering different from prompt engineering?', acceptedAnswer: { '@type': 'Answer', text: 'Prompt engineering focuses on crafting individual prompts. Context engineering manages the entire information lifecycle — what the agent reads, how it is compressed, what is cached, what is remembered across sessions, and what is verified before delivery.' } },
  ],
});
---

<BaseLayout
  title={t('ce.title')}
  description={t('ce.metaDesc')}
  extraJsonLd={faqJsonLd}
  breadcrumbs={[{ name: t('ce.breadcrumbHome'), url: lp('/') }, { name: t('ce.breadcrumbTitle'), url: lp('/what-is-context-engineering/') }]}>

<!-- ═══════ HERO ═══════ -->
<PageHero
  label={t('ce.heroLabel')}
  title={t('ce.heroTitle')}
  highlight={t('ce.heroHighlight')}
  description={t('ce.heroDesc')}
  highlightStyle="italic"
/>


<div class="section-divider content-grid"></div>


<!-- ═══════ THE PROBLEM ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t('ce.problemLabel')}
      title={t('ce.problemTitle')}
      highlight={t('ce.problemHighlight')}
      description={t('ce.problemDesc')}
      variant="full"
      breakHighlight={false}
      descMaxWidth="48rem"
      descMb="clamp(3rem, 2rem + 3vw, 6rem)"
    />

    <div class="prose-section animate-entrance">
      <p>{t('ce.problemP1')}</p>
      <p>{t('ce.problemP2')}</p>
      <p>{t('ce.problemP3')}</p>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ THE THREE SHIFTS ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t('ce.frameworkLabel')}
      title={t('ce.frameworkTitle')}
      highlight={t('ce.frameworkHighlight')}
      description={t('ce.frameworkDesc')}
      variant="full"
      breakHighlight={false}
      descMaxWidth="48rem"
      descMb="clamp(3rem, 2rem + 3vw, 6rem)"
    />

    <div class="grid sm:grid-cols-3 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      <div class="shift-card card" style="padding: 1.5rem;">
        <div class="shift-number font-display text-accent">01</div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.shift1Title')}</h3>
        <p class="fluid-sm text-muted">{t('ce.shift1Desc')}</p>
      </div>
      <div class="shift-card card" style="padding: 1.5rem;">
        <div class="shift-number font-display text-accent-2">02</div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.shift2Title')}</h3>
        <p class="fluid-sm text-muted">{t('ce.shift2Desc')}</p>
      </div>
      <div class="shift-card card" style="padding: 1.5rem;">
        <div class="shift-number font-display text-accent-3">03</div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.shift3Title')}</h3>
        <p class="fluid-sm text-muted">{t('ce.shift3Desc')}</p>
      </div>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ WHAT IT INCLUDES ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t('ce.disciplineLabel')}
      title={t('ce.disciplineTitle')}
      highlight={t('ce.disciplineHighlight')}
      description={t('ce.disciplineDesc')}
      variant="full"
      breakHighlight={false}
      descMaxWidth="48rem"
      descMb="clamp(3rem, 2rem + 3vw, 6rem)"
    />

    <div class="grid sm:grid-cols-2 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      <div class="card" style="padding: 1.5rem;">
        <div class="domain-label text-accent">{t('ce.domain1Label')}</div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.domain1Title')}</h3>
        <p class="fluid-sm text-muted">{t('ce.domain1Desc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <div class="domain-label text-accent-2">{t('ce.domain2Label')}</div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.domain2Title')}</h3>
        <p class="fluid-sm text-muted">{t('ce.domain2Desc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <div class="domain-label text-accent-3">{t('ce.domain3Label')}</div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.domain3Title')}</h3>
        <p class="fluid-sm text-muted">{t('ce.domain3Desc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <div class="domain-label text-accent">{t('ce.domain4Label')}</div>
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.domain4Title')}</h3>
        <p class="fluid-sm text-muted">{t('ce.domain4Desc')}</p>
      </div>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ HOW LEANCTX IMPLEMENTS IT ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t('ce.implLabel')}
      title={t('ce.implTitle')}
      highlight={t('ce.implHighlight')}
      description={t('ce.implDesc')}
      variant="full"
      breakHighlight={false}
      descMaxWidth="48rem"
      descMb="clamp(3rem, 2rem + 3vw, 6rem)"
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{manifest.counts.granular}{t('ce.implToolsSuffix')}</h3>
        <p class="fluid-sm text-muted">{t('ce.implToolsDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.implReadModesTitle')}</h3>
        <p class="fluid-sm text-muted">{t('ce.implReadModesDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.implShellTitle')}</h3>
        <p class="fluid-sm text-muted">{t('ce.implShellDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('ce.implLocalTitle')}</h3>
        <p class="fluid-sm text-muted">{t('ce.implLocalDesc')}</p>
      </div>
    </div>

    <div class="animate-entrance stagger-4" style="margin-top: clamp(2rem, 1.5rem + 1vw, 3rem);">
      <a href={lp('/context-os')} class="fluid-sm text-accent hover:underline inline-flex items-center gap-1.5 font-medium">
        {t('ce.implCta')}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ CTA ═══════ -->
<section class="section-y">
  <div class="content-grid">
    <SectionHeading
      label={t('ce.ctaLabel')}
      title={t('ce.ctaTitle')}
      highlight={t('ce.ctaHighlight')}
      description={t('ce.ctaDesc')}
      variant="full"
      breakHighlight={false}
      descMaxWidth="44rem"
      descMb="clamp(2.5rem, 2rem + 2vw, 5rem)"
    />
    <div class="flex flex-wrap items-center animate-entrance stagger-3" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center font-bold rounded-lg text-bg" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        {t('ce.ctaGetStarted')}
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href={lp('/context-os')} class="btn-outline inline-flex items-center font-medium rounded-lg text-text" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        {t('ce.ctaContextOs')}
      </a>
    </div>
  </div>
</section>


<style>
  .prose-section { max-width: 48rem; }
  .prose-section p { font-size: clamp(0.875rem, 0.825rem + 0.2vw, 1.0625rem); line-height: 1.75; color: var(--color-muted); margin-bottom: 1.25rem; }
  .prose-section p:last-child { margin-bottom: 0; }
  .shift-number { font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1; margin-bottom: 1rem; opacity: 0.6; }
  .domain-label { font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem; }
</style>

</BaseLayout>
