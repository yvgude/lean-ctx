---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TerminalChrome from '../components/TerminalChrome.astro';
import ProofArtifacts from '../components/ProofArtifacts.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { pillars } from '../lib/contextOsPillars';
import { getMcpManifest } from '../lib/mcpManifest';
import '../styles/index.css';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();

const pipelineSteps = [
  { n: '01', tone: 'accent',   label: t('contextOs.pipeInput'),     desc: t('contextOs.pipeInputDesc') },
  { n: '02', tone: 'accent-2', label: t('contextOs.pipeIntent'),    desc: t('contextOs.pipeIntentDesc') },
  { n: '03', tone: 'accent',   label: t('contextOs.pipeRelevance'), desc: t('contextOs.pipeRelevanceDesc') },
  { n: '04', tone: 'accent-3', label: t('contextOs.pipeCompress'),  desc: t('contextOs.pipeCompressDesc') },
  { n: '05', tone: 'accent-2', label: t('contextOs.pipeVerify'),    desc: t('contextOs.pipeVerifyDesc') },
  { n: '06', tone: 'accent',   label: t('contextOs.pipeDeliver'),   desc: t('contextOs.pipeDeliverDesc') },
];

const stats = [
  { value: String(manifest.counts.granular), label: t('contextOs.statMcpTools'),     tone: 'accent' },
  { value: '95+',                            label: t('contextOs.statShellPatterns'), tone: 'accent-2' },
  { value: '24+',                            label: t('contextOs.statIntegrations'),  tone: 'accent-3' },
  { value: '3',                              label: t('contextOs.statModes'),         tone: 'accent-2' },
  { value: '99%',                            label: t('contextOs.statTokenSavings'),  tone: 'accent' },
];
---

<BaseLayout
  title={t('contextOs.headline') + ' | LeanCTX'}
  description={t('contextOs.subline')}
  breadcrumbs={[
    { name: t('common.home'), url: lp('/') },
    { name: 'Context OS', url: lp('/context-os/') },
  ]}
>

<!-- 1. HERO -->
<PageHero
  label="Context OS"
  title="The Context OS for"
  highlight="AI Development"
  descriptionHtml={t('contextOs.subline')}
  kickerTone="accent"
  titleVariant="display"
  highlightStyle="italic"
  descMaxWidth="44rem"
>
  <Fragment slot="actions">
    <a
      href={lp('/docs/getting-started')}
      class="btn-primary inline-flex items-center gap-2 font-bold rounded-lg text-bg"
      style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
    >
      {t('nav.getStarted')}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
    <a
      href={lp('/context-os/benchmark')}
      class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text"
      style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
    >
      {t('nav.product.benchmark')}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
  </Fragment>
</PageHero>

<div class="section-divider content-grid"></div>

<!-- 2. PROBLEM / SOLUTION SPLIT with Compare Cards -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">{t('contextOs.problemLabel')}</span>
        </div>
        <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('contextOs.problemTitle')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin: 0; max-width: 52rem;">
          {t('contextOs.problemDesc')}
        </p>
      </div>

      <div class="animate-entrance stagger-3">
        <div class="compare-grid is-stacked">
          <div class="compare-card">
            <div class="compare-header compare-header--bad">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
              {t('contextOs.withoutLabel')}
            </div>
            <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
              <div class="compare-line"><span class="text-danger">{t('contextOs.without1')}</span></div>
              <div class="compare-line"><span class="text-danger">{t('contextOs.without2')}</span></div>
              <div class="compare-line"><span class="text-muted">{t('contextOs.without3')}</span></div>
              <div class="compare-line"><span class="text-danger">{t('contextOs.without4')}</span></div>
            </div>
          </div>
          <div class="compare-card">
            <div class="compare-header compare-header--good">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              {t('contextOs.withLabel')}
            </div>
            <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
              <div class="compare-line"><span class="text-accent">{t('contextOs.with1')}</span></div>
              <div class="compare-line"><span class="text-accent">{t('contextOs.with2')}</span></div>
              <div class="compare-line"><span class="text-muted">{t('contextOs.with3')}</span></div>
              <div class="compare-line"><span class="text-accent">{t('contextOs.with4')}</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 3. WHAT IS A CONTEXT OS - Split with Architecture -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">Context OS</span>
        </div>
        <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('contextOs.whatIs')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin: 0; max-width: 48rem;">
          {t('contextOs.whatIsDesc')}
        </p>
      </div>

      <div class="animate-entrance stagger-3">
        <div class="grid" style="gap: clamp(0.5rem, 0.375rem + 0.25vw, 0.75rem);">
          <div class="card" style="padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); text-align: center; border-color: var(--color-border);">
            <div class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/></svg>
              <span class="font-display font-semibold text-text-bright fluid-sm">{t('contextOs.diagramAgent')}</span>
            </div>
          </div>
          <div class="flex justify-center"><svg class="w-4 h-4 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg></div>
          <div class="card" style="padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); text-align: center; border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));">
            <div class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008V18m-3 0h.008v.008h-.008V18m-3 0h.008v.008h-.008V18"/></svg>
              <span class="font-display font-semibold text-accent fluid-sm">{t('contextOs.diagramLeanctx')}</span>
            </div>
            <div class="flex flex-wrap justify-center gap-1 mt-2" style="font-size: 0.6875rem;">
              <span class="px-2 py-0.5 rounded bg-accent/10 text-accent font-mono">I/O</span>
              <span class="px-2 py-0.5 rounded bg-accent-2/10 text-accent-2 font-mono">Intelligence</span>
              <span class="px-2 py-0.5 rounded bg-accent-3/10 text-accent-3 font-mono">Memory</span>
              <span class="px-2 py-0.5 rounded bg-accent/10 text-accent font-mono">Verify</span>
            </div>
          </div>
          <div class="flex justify-center"><svg class="w-4 h-4 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg></div>
          <div class="card" style="padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); text-align: center; border-color: var(--color-border);">
            <div class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
              <span class="font-display font-semibold text-text-bright fluid-sm">{t('contextOs.diagramRepo')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4. PIPELINE - Dimensions Grid -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">Pipeline</span>
    </div>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('contextOs.howItWorks')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('contextOs.howItWorksDesc')}
    </p>

    <div class="pipeline-stepper animate-entrance stagger-3" data-pipeline-stepper>
      <div class="pipeline-tabs" role="tablist">
        {pipelineSteps.map((s, i) => (
          <button
            role="tab"
            class={`pipeline-tab ${i === 0 ? 'is-active' : ''}`}
            data-pipeline-tab={String(i)}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class={`pipeline-tab-number ${
              s.tone === 'accent-2' ? 'text-accent-2' : s.tone === 'accent-3' ? 'text-accent-3' : 'text-accent'
            }`}>{s.n}</span>
            <span class="pipeline-tab-label">{s.label}</span>
          </button>
        ))}
      </div>
      <div class="pipeline-panels">
        {pipelineSteps.map((s, i) => (
          <div
            role="tabpanel"
            class={`pipeline-panel ${i === 0 ? 'is-active' : ''}`}
            data-pipeline-panel={String(i)}
          >
            <div class="pipeline-panel-inner">
              <span class={`pipeline-panel-number font-display ${
                s.tone === 'accent-2' ? 'text-accent-2' : s.tone === 'accent-3' ? 'text-accent-3' : 'text-accent'
              }`}>{s.n}</span>
              <h3 class="font-display fluid-h2 font-semibold text-text-bright" style="margin-bottom: 0.75rem;">{s.label}</h3>
              <p class="fluid-body text-muted leading-relaxed" style="max-width: 40rem;">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4b. INTEGRATION MODES -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">{t('contextOs.modesLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('contextOs.modesTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      {t('contextOs.modesDesc')}
    </p>

    <div class="grid md:grid-cols-3" style="gap: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      <div class="compare-card animate-entrance stagger-3">
        <div class="compare-header compare-header--good">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>
          {t('contextOs.modeCliTitle')}
        </div>
        <div class="compare-body" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-accent font-semibold">{t('contextOs.modeCliTag')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('contextOs.modeCliDesc')}</span></div>
          <div class="compare-line" style="margin-top: 0.5rem;">
            <code class="font-mono text-text-bright" style="font-size: 0.6875rem;">lean-ctx read src/auth.ts -m map</code>
          </div>
        </div>
      </div>

      <div class="compare-card animate-entrance stagger-4">
        <div class="compare-header" style="background: color-mix(in srgb, var(--color-accent-2) 12%, var(--color-surface)); border-color: var(--color-accent-2);">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/></svg>
          {t('contextOs.modeHybridTitle')}
        </div>
        <div class="compare-body" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-accent-2 font-semibold">{t('contextOs.modeHybridTag')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('contextOs.modeHybridDesc')}</span></div>
          <div class="compare-line" style="margin-top: 0.5rem;">
            <code class="font-mono text-text-bright" style="font-size: 0.6875rem;">MCP cache + CLI shell/search</code>
          </div>
        </div>
      </div>

      <div class="compare-card animate-entrance stagger-5">
        <div class="compare-header" style="background: color-mix(in srgb, var(--color-accent-3) 12%, var(--color-surface)); border-color: var(--color-accent-3);">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008V18m-3 0h.008v.008h-.008V18m-3 0h.008v.008h-.008V18"/></svg>
          {t('contextOs.modeMcpTitle')}
        </div>
        <div class="compare-body" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-accent-3 font-semibold">{t('contextOs.modeMcpTag')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('contextOs.modeMcpDesc')}</span></div>
          <div class="compare-line" style="margin-top: 0.5rem;">
            <code class="font-mono text-text-bright" style="font-size: 0.6875rem;">56 tools via MCP + lazy tool set</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4c. DAEMON + SMART SETUP -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">{t('contextOs.daemonLabel')}</span>
        </div>
        <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('contextOs.daemonTitle')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin: 0; max-width: 48rem;">
          {t('contextOs.daemonDesc')}
        </p>
      </div>

      <TerminalChrome
        title="lean-ctx serve --status"
        chromeClass="animate-entrance stagger-3"
        bodyStyle="font-size: clamp(0.72rem, 0.68rem + 0.1vw, 0.8125rem); line-height: 1.75;"
      >
        <div>
          <span class="text-accent">$</span>{' '}
          <span class="text-text-bright">lean-ctx serve --status</span>
        </div>
        <div class="term-divider"></div>
        <div><span class="text-muted">daemon</span>  <span class="text-accent font-semibold">running</span> <span class="text-muted">(PID 4139)</span></div>
        <div><span class="text-muted">socket</span>  <span class="text-text-bright">/tmp/lean-ctx.sock</span></div>
        <div><span class="text-muted">uptime</span>  <span class="text-text">2h 14m</span></div>
        <div><span class="text-muted">sessions</span> <span class="text-text-bright">3 active</span></div>
        <div class="term-divider"></div>
        <div><span class="text-muted">cache</span>   <span class="text-accent">247 entries</span> <span class="text-muted">(hit rate 94.2%)</span></div>
        <div><span class="text-muted">memory</span>  <span class="text-text">12.4 MB</span></div>
      </TerminalChrome>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4d. AGENT MATRIX -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">{t('contextOs.agentMatrixLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('contextOs.agentMatrixTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      {t('contextOs.agentMatrixDesc')}
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 animate-entrance stagger-3" style="gap: clamp(0.5rem, 0.375rem + 0.25vw, 0.75rem);">
      {[
        { name: 'Cursor', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'Claude Code', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'Codex', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'OpenCode', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'Gemini CLI', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'Windsurf', mode: 'Hybrid', tone: 'accent-2' },
        { name: 'Amp', mode: 'Hybrid', tone: 'accent-2' },
        { name: 'Antigravity', mode: 'Hybrid', tone: 'accent-2' },
        { name: 'Hermes', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'Kiro', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'JetBrains', mode: 'MCP', tone: 'accent-3' },
        { name: 'Copilot', mode: 'MCP', tone: 'accent-3' },
        { name: 'Cline', mode: 'MCP', tone: 'accent-3' },
        { name: 'Roo Code', mode: 'MCP', tone: 'accent-3' },
        { name: 'VS Code', mode: 'MCP', tone: 'accent-3' },
        { name: 'Zed', mode: 'MCP', tone: 'accent-3' },
        { name: 'CRUSH', mode: 'CLI-Redirect', tone: 'accent' },
        { name: 'Aider', mode: 'MCP', tone: 'accent-3' },
        { name: 'Continue', mode: 'MCP', tone: 'accent-3' },
        { name: 'Trae', mode: 'MCP', tone: 'accent-3' },
      ].map((agent) => (
        <div class="card" style="padding: clamp(0.625rem, 0.5rem + 0.25vw, 0.875rem); text-align: center;">
