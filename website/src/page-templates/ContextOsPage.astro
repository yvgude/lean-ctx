<style>
  .pipeline-stepper {
    display: grid;
    gap: clamp(1.5rem, 1rem + 1vw, 2.5rem);
  }
  .pipeline-tabs {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .pipeline-tabs::-webkit-scrollbar { display: none; }
  .pipeline-tab {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.25s ease;
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem);
    white-space: nowrap;
  }
  .pipeline-tab:hover {
    border-color: var(--color-border-light);
    background: var(--overlay-hover);
  }
  .pipeline-tab.is-active {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    color: var(--color-text-bright);
  }
  .pipeline-tab-number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
  }
  .pipeline-tab-label { font-weight: 600; }
  .pipeline-panel { display: none; }
  .pipeline-panel.is-active { display: block; }
  .pipeline-panel-inner {
    padding: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }
  .pipeline-panel-number {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3.5rem);
    font-weight: 800;
    opacity: 0.2;
    display: block;
    margin-bottom: 0.5rem;
  }
</style>

<script>
  document.querySelectorAll('[data-pipeline-stepper]').forEach((stepper) => {
    const tabs = stepper.querySelectorAll('[data-pipeline-tab]');
    const panels = stepper.querySelectorAll('[data-pipeline-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.getAttribute('data-pipeline-tab');
        tabs.forEach((t) => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
        panels.forEach((p) => p.classList.remove('is-active'));
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        stepper.querySelector(`[data-pipeline-panel="${idx}"]`)?.classList.add('is-active');
      });
    });
  });
</script>

