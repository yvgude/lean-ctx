---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sdkSnippet = `import { LeanCtxClient } from "@leanctx/sdk";

const client = new LeanCtxClient({
  baseUrl: "http://127.0.0.1:8080",
  workspaceId: "acme",
  channelId: "build-123",
});

// Tool calls are recorded into the shared session and published to /v1/events.
await client.callToolText("ctx_tree", { path: ".", depth: 2 });

// Subscribe to live + replayed events.
for await (const ev of client.subscribeEvents({ since: 0, limit: 200 })) {
  console.log(ev.kind, ev.payload);
}
`;
---

<BaseLayout
  title={t('contextOs.title')}
  description={t('contextOs.metaDescription')}
  breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: t('contextOs.heroLabel'), url: lp('/context-os/') }]}
>
  <PageHero
    label={t('contextOs.heroLabel')}
    title={t('contextOs.heroTitle')}
    highlight={t('contextOs.heroTitleHighlight')}
    description={t('contextOs.heroDesc')}
    highlightStyle="italic"
  >
    <Fragment slot="actions">
      <span class="mcp-hero-stat">
        <span class="text-accent font-bold">Shared</span> Sessions
      </span>
      <span class="mcp-hero-stat">
        <span class="text-accent font-bold">SSE</span> Event Stream
      </span>
      <span class="mcp-hero-stat">
        <span class="text-accent font-bold">SDK</span> Integration
      </span>
    </Fragment>
  </PageHero>

  <div class="section-divider content-grid"></div>

  <section class="relative section-y">
    <div class="content-grid">
      <SectionHeading
        label={t('contextOs.section1Label')}
        title={t('contextOs.section1Title')}
        highlight={t('contextOs.section1TitleHighlight')}
        description={t('contextOs.section1Desc')}
        variant="full"
        breakHighlight={false}
        descMaxWidth="52rem"
        descMb="clamp(2.5rem, 2rem + 2vw, 4rem)"
      />

      <div class="grid sm:grid-cols-3 gap-4">
        <div class="card animate-entrance" style="padding: 1.25rem;">
          <div class="text-accent font-mono text-[11px] mb-2">workspaceId + channelId</div>
          <h3 class="fluid-h3 font-display font-semibold text-text-bright mb-2">{t('contextOs.cardSharedSessionsTitle')}</h3>
          <p class="fluid-sm text-muted">{t('contextOs.cardSharedSessionsDesc')}</p>
        </div>
        <div class="card animate-entrance" style="padding: 1.25rem;">
          <div class="text-accent font-mono text-[11px] mb-2">GET /v1/events</div>
          <h3 class="fluid-h3 font-display font-semibold text-text-bright mb-2">{t('contextOs.cardEventStreamTitle')}</h3>
          <p class="fluid-sm text-muted">{t('contextOs.cardEventStreamDesc')}</p>
        </div>
        <div class="card animate-entrance" style="padding: 1.25rem;">
          <div class="text-accent font-mono text-[11px] mb-2">POST /v1/tools/call</div>
          <h3 class="fluid-h3 font-display font-semibold text-text-bright mb-2">{t('contextOs.cardToolGatewayTitle')}</h3>
          <p class="fluid-sm text-muted">{t('contextOs.cardToolGatewayDesc')}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <section class="relative section-y">
    <div class="content-grid">
      <SectionHeading
        label={t('contextOs.section2Label')}
        title={t('contextOs.section2Title')}
        highlight={t('contextOs.section2TitleHighlight')}
        description={t('contextOs.section2Desc')}
        variant="full"
        breakHighlight={false}
        descMaxWidth="52rem"
        descMb="clamp(2.5rem, 2rem + 2vw, 4rem)"
      />

      <div class="grid lg:grid-cols-2 gap-4">
        <div class="card" style="padding: 1.25rem;">
          <div class="text-[11px] text-muted font-mono mb-3">{t('contextOs.snippetTitle')}</div>
          <pre class="m-0 overflow-auto rounded-xl border border-white/10 bg-black/50 p-4 text-[12px] leading-relaxed"><code>{sdkSnippet}</code></pre>
        </div>

        <div class="card" style="padding: 1.25rem;">
          <h3 class="fluid-h3 font-display font-semibold text-text-bright mb-3">{t('contextOs.nextStepsTitle')}</h3>
          <ul class="fluid-sm text-muted leading-relaxed" style="margin: 0; padding-left: 1.2rem;">
            <li class="mb-2">
              <a class="text-accent hover:underline" href={lp('/docs/team-server')}>{t('contextOs.nextStepsTeamServer')}</a>
            </li>
            <li class="mb-2">
              <a class="text-accent hover:underline" href={lp('/docs/http-mcp')}>{t('contextOs.nextStepsHttpMcp')}</a>
            </li>
            <li class="mb-2">
              <a class="text-accent hover:underline" href={lp('/docs/context-io')}>{t('contextOs.nextStepsPillars')}</a>
            </li>
            <li>
              <a class="text-accent hover:underline" href={lp('/docs/tools')}>{t('contextOs.nextStepsTools')}</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

