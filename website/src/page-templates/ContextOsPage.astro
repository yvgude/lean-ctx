<style>
  .pipeline-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .pipeline-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    min-height: 0;
  }
  .pipeline-step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  .pipeline-step-dot {
    width: clamp(2.5rem, 2rem + 1vw, 3.25rem);
    height: clamp(2.5rem, 2rem + 1vw, 3.25rem);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    border: 2px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
  }
  .pipeline-step-dot.dot-accent-2 {
    border-color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 12%, var(--color-bg));
  }
  .pipeline-step-dot.dot-accent-3 {
    border-color: var(--color-accent-3);
    background: color-mix(in srgb, var(--color-accent-3) 12%, var(--color-bg));
  }
  .pipeline-step-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(0.75rem, 0.65rem + 0.25vw, 0.9375rem);
    color: var(--color-text-bright);
  }
  .pipeline-step-line {
    width: 2px;
    flex: 1;
    min-height: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    background: linear-gradient(to bottom, var(--color-border-light), var(--color-border));
  }
  .pipeline-step-content {
    padding: clamp(0.25rem, 0.125rem + 0.25vw, 0.5rem) 0 clamp(2rem, 1.5rem + 1vw, 3rem) 0;
  }

  /* Agent Matrix */
  .agent-matrix {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .matrix-th {
    padding: 0.625rem 0.75rem;
    font-weight: 600;
    color: var(--color-text-bright);
    background: color-mix(in srgb, var(--color-surface) 60%, var(--color-bg));
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }
  .matrix-th-agent {
    text-align: left;
    min-width: 8rem;
  }
  .matrix-th-mode {
    text-align: center;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
  }
  .matrix-th-setup {
    text-align: left;
    font-size: 0.6875rem;
  }
  .matrix-mode-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    margin-right: 0.375rem;
    vertical-align: middle;
  }
  .matrix-mode-dot.dot-cli { background: var(--color-accent); }
  .matrix-mode-dot.dot-hybrid { background: var(--color-accent-2); }
  .matrix-mode-dot.dot-mcp { background: var(--color-accent-3); }

  .matrix-row {
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 30%, transparent);
    transition: background 0.15s ease;
  }
  .matrix-row:hover {
    background: color-mix(in srgb, var(--color-surface) 40%, transparent);
  }
  .matrix-row:last-child {
    border-bottom: none;
  }
  .matrix-td {
    padding: 0.4rem 0.75rem;
  }
  .matrix-td-agent {
    color: var(--color-text-bright);
    font-weight: 500;
  }
  .matrix-td-check {
    text-align: center;
    font-size: 0.875rem;
  }
  .matrix-td-setup code {
    font-size: 0.625rem;
    opacity: 0.55;
    letter-spacing: -0.01em;
  }
  .matrix-dot {
    font-size: 1rem;
    line-height: 1;
  }
  .matrix-dot-cli { color: var(--color-accent); }
  .matrix-dot-hybrid { color: var(--color-accent-2); }
  .matrix-dot-mcp { color: var(--color-accent-3); }
  .matrix-empty {
    color: var(--color-border);
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .matrix-th-setup, .matrix-td-setup { display: none; }
    .matrix-th-mode { font-size: 0.5625rem; padding: 0.5rem 0.375rem; }
    .matrix-td-check { padding: 0.4rem 0.375rem; }
  }
</style>

