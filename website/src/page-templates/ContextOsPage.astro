---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TerminalChrome from '../components/TerminalChrome.astro';
import ProofArtifacts from '../components/ProofArtifacts.astro';
import CtaSection from '../components/CtaSection.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { pillars } from '../lib/contextOsPillars';
import { getMcpManifest } from '../lib/mcpManifest';
import '../styles/index.css';

const pillarDocsLinks: Record<string, string> = {
  'smart-io': '/docs/concepts/read-modes',
  'intelligence': '/docs/tools/intelligence',
  'memory': '/docs/concepts/caching',
  'governance': '/docs/configuration',
  'verification': '/docs/security',
  'integrations': '/compatibility',
  'shared-sessions': '/docs/concepts/multi-agent',
  'context-bus': '/docs/api-reference',
  'sdk': '/docs/api-reference',
};

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();

const pipelineSteps = [
  { n: '01', label: t('contextOs.pipeInput'),     desc: t('contextOs.pipeInputDesc') },
  { n: '02', label: t('contextOs.pipeIntent'),    desc: t('contextOs.pipeIntentDesc') },
  { n: '03', label: t('contextOs.pipeRelevance'), desc: t('contextOs.pipeRelevanceDesc') },
  { n: '04', label: t('contextOs.pipeCompress'),  desc: t('contextOs.pipeCompressDesc') },
  { n: '05', label: t('contextOs.pipeVerify'),    desc: t('contextOs.pipeVerifyDesc') },
  { n: '06', label: t('contextOs.pipeDeliver'),   desc: t('contextOs.pipeDeliverDesc') },
];

---

<BaseLayout
  title={t('contextOs.metaTitle')}
  description={t('contextOs.metaDesc')}
  breadcrumbs={[
    { name: t('common.home'), url: lp('/') },
    { name: t('nav.contextOs'), url: lp('/context-os/') },
  ]}
>

<!-- 1. HERO -->
<PageHero
  label={t('contextOs.heroLabel')}
  title={t('contextOs.heroTitle')}
  highlight={t('contextOs.heroHighlight')}
  descriptionHtml={`<span style="display:block;margin-bottom:0.75rem;font-size:clamp(1rem,0.9rem+0.4vw,1.25rem);color:var(--color-accent);font-weight:600;">${t('contextOs.heroSubtitle')}</span>${t('contextOs.subline')}`}
  kickerTone="accent"
  titleVariant="display"
  highlightStyle="italic"
  descMaxWidth="44rem"
>
  <Fragment slot="actions">
    <a
      href={lp('/docs/getting-started')}
      class="btn-primary inline-flex items-center gap-2 font-bold rounded-lg text-bg"
      style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
    >
      {t('nav.getStarted')}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
    <a
      href={lp('/context-os/benchmark')}
      class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text"
      style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
    >
      {t('nav.product.benchmark')}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
  </Fragment>
</PageHero>

<div class="section-divider content-grid"></div>

<!-- 3. WHAT IS A CONTEXT OS - Split with Architecture -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">{t('contextOs.heroLabel')}</span>
        </div>
        <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('contextOs.whatIs')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin: 0; max-width: 48rem;">
          {t('contextOs.whatIsDesc')}
        </p>
      </div>

      <div class="animate-entrance stagger-3">
        <div class="grid" style="gap: clamp(0.5rem, 0.375rem + 0.25vw, 0.75rem);">
          <div class="card" style="padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); text-align: center; border-color: var(--color-border);">
            <div class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/></svg>
              <span class="font-display font-semibold text-text-bright fluid-sm">{t('contextOs.diagramAgent')}</span>
            </div>
          </div>
          <div class="flex justify-center"><svg class="w-4 h-4 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg></div>
          <div class="card" style="padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); text-align: center; border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));">
            <div class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008V18m-3 0h.008v.008h-.008V18m-3 0h.008v.008h-.008V18"/></svg>
              <span class="font-display font-semibold text-accent fluid-sm">{t('contextOs.diagramLeanctx')}</span>
            </div>
            <div class="flex flex-wrap justify-center gap-1 mt-2" style="font-size: 0.6875rem;">
              <span class="px-2 py-0.5 rounded bg-accent/10 text-accent font-mono">I/O</span>
              <span class="px-2 py-0.5 rounded bg-accent/10 text-accent font-mono">Intelligence</span>
              <span class="px-2 py-0.5 rounded bg-accent/10 text-accent font-mono">Memory</span>
              <span class="px-2 py-0.5 rounded bg-accent/10 text-accent font-mono">Verify</span>
            </div>
          </div>
          <div class="flex justify-center"><svg class="w-4 h-4 text-muted/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg></div>
          <div class="card" style="padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); text-align: center; border-color: var(--color-border);">
            <div class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
              <span class="font-display font-semibold text-text-bright fluid-sm">{t('contextOs.diagramRepo')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4. PIPELINE - Dimensions Grid -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">{t('contextOs.pipelineLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('contextOs.howItWorks')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('contextOs.howItWorksDesc')}
    </p>

    <div class="pipeline-flow animate-entrance stagger-3">
      {pipelineSteps.map((s, i) => (
        <div class="pipeline-step">
          <div class="pipeline-step-indicator">
            <span class="pipeline-step-dot">
              <span class="pipeline-step-num">{s.n}</span>
            </span>
            {i < pipelineSteps.length - 1 && <div class="pipeline-step-line" />}
          </div>
          <div class="pipeline-step-content">
            <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 0 0 0.5rem 0;">{s.label}</h3>
            <p class="fluid-body text-muted leading-relaxed" style="margin: 0; max-width: 40rem;">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4b. INTEGRATION MODES -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">{t('contextOs.modesLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('contextOs.modesTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      {t('contextOs.modesDesc')}
    </p>

    <div class="grid md:grid-cols-2" style="gap: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); max-width: 48rem; margin: 0 auto;">
      <div class="compare-card animate-entrance stagger-3">
        <div class="compare-header compare-header--good">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/></svg>
          {t('contextOs.modeHybridTitle')}
        </div>
        <div class="compare-body" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-accent font-semibold">{t('contextOs.modeHybridTag')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('contextOs.modeHybridDesc')}</span></div>
          <div class="compare-line" style="margin-top: 0.5rem;">
            <code class="font-mono text-text-bright" style="font-size: 0.6875rem;">MCP cache + CLI shell/search</code>
          </div>
        </div>
      </div>

      <div class="compare-card animate-entrance stagger-5">
        <div class="compare-header" style="background: var(--color-surface-2); border-color: var(--color-border);">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008V18m-3 0h.008v.008h-.008V18m-3 0h.008v.008h-.008V18"/></svg>
          {t('contextOs.modeMcpTitle')}
        </div>
        <div class="compare-body" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-text-bright font-semibold">{t('contextOs.modeMcpTag')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('contextOs.modeMcpDesc')}</span></div>
          <div class="compare-line" style="margin-top: 0.5rem;">
            <code class="font-mono text-text-bright" style="font-size: 0.6875rem;">{manifest.counts.granular} tools via MCP + lazy tool set</code>
          </div>
        </div>
      </div>
    </div>

    <p class="text-muted animate-entrance stagger-6" style="margin-top: clamp(2rem, 1.5rem + 1vw, 3rem); text-align: center; font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
      {t('contextOs.modesFootnote')}{' '}
      <a href={lp('/compatibility')} class="text-accent hover:underline inline-flex items-center gap-1 font-medium">
        {t('contextOs.modesFootnoteLink')}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </p>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4c. DAEMON + SMART SETUP -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">{t('contextOs.daemonLabel')}</span>
        </div>
        <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('contextOs.daemonTitle')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin: 0; max-width: 48rem;">
          {t('contextOs.daemonDesc')}
        </p>
      </div>

      <TerminalChrome
        title="lean-ctx serve --status"
        chromeClass="animate-entrance stagger-3"
        bodyStyle="font-size: clamp(0.72rem, 0.68rem + 0.1vw, 0.8125rem); line-height: 1.75;"
      >
        <div>
          <span class="text-accent">$</span>{' '}
          <span class="text-text-bright">lean-ctx serve --status</span>
        </div>
        <div class="term-divider"></div>
        <div><span class="text-muted">daemon</span>  <span class="text-accent font-semibold">running</span> <span class="text-muted">(PID 4139)</span></div>
        <div><span class="text-muted">socket</span>  <span class="text-text-bright">/tmp/lean-ctx.sock</span></div>
        <div><span class="text-muted">uptime</span>  <span class="text-text">2h 14m</span></div>
        <div><span class="text-muted">sessions</span> <span class="text-text-bright">3 active</span></div>
        <div class="term-divider"></div>
        <div><span class="text-muted">cache</span>   <span class="text-accent">247 entries</span> <span class="text-muted">(hit rate 94.2%)</span></div>
        <div><span class="text-muted">memory</span>  <span class="text-text">12.4 MB</span></div>
      </TerminalChrome>
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 5. SIX PILLARS -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">{t('contextOs.pillarsLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('index.sixPillarsTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('index.sixPillarsSubline')}
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      {pillars.map((p, i) => (
        <a
          href={lp(pillarDocsLinks[p.slug] || '/context-os')}
          class={`card group animate-entrance stagger-${1 + i}`}
          style="padding: clamp(1.25rem, 1rem + 0.75vw, 1.75rem); text-decoration: none; transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;"
        >
          <div class="flex items-center gap-3" style="margin-bottom: 0.75rem;">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center bg-accent/10" style="border: 1px solid var(--color-border);">
              <span class="text-accent" set:html={p.icon} />
            </div>
            <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 0;">
              {t(p.titleKey)}
            </h3>
          </div>
          <p class="fluid-sm text-muted leading-relaxed" style="margin: 0 0 0.75rem 0;">
            {t(p.navDescKey)}
          </p>
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-2 text-accent font-medium fluid-label">
              {p.tools.length} {t('contextOs.toolsLabel')}
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </span>
            <span class="fluid-label text-muted">{p.features.length} {t('contextOs.featuresLabel')}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 8. PROOF ARTIFACTS -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">{t('contextOs.proofLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: 1.25rem; max-width: 58rem;">
      {t('contextOs.proofTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem); max-width: 56rem;">
      {t('contextOs.proofDesc')}
    </p>
    <div class="animate-entrance stagger-3">
      <ProofArtifacts />
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 9. CTA -->
<CtaSection
  title={t('index.ctaTitle')}
  description={t('contextOs.subline')}
  actions={[
    { label: t('nav.getStarted'), href: lp('/docs/getting-started/'), variant: 'primary', icon: 'arrow' },
    { label: 'GitHub', href: 'https://github.com/yvgude/lean-ctx', variant: 'outline', icon: 'github', external: true },
  ]}
/>

<style>
  .pipeline-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .pipeline-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    min-height: 0;
  }
  .pipeline-step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  .pipeline-step-dot {
    width: clamp(2.5rem, 2rem + 1vw, 3.25rem);
    height: clamp(2.5rem, 2rem + 1vw, 3.25rem);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    border: 2px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
  }
  .pipeline-step-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(0.75rem, 0.65rem + 0.25vw, 0.9375rem);
    color: var(--color-text-bright);
  }
  .pipeline-step-line {
    width: 2px;
    flex: 1;
    min-height: clamp(1.5rem, 1rem + 1vw, 2.5rem);
    background: linear-gradient(to bottom, var(--color-border-light), var(--color-border));
  }
  .pipeline-step-content {
    padding: clamp(0.25rem, 0.125rem + 0.25vw, 0.5rem) 0 clamp(2rem, 1.5rem + 1vw, 3rem) 0;
  }

</style>

</BaseLayout>
