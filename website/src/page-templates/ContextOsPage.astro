---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { pillars } from '../lib/contextOsPillars';
import { getMcpManifest } from '../lib/mcpManifest';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();
---

<BaseLayout title={t('contextOs.headline') + ' — LeanCTX'} description={t('contextOs.subline')}>
  <!-- Hero -->
  <section class="cos-hero content-grid">
    <div class="cos-hero-inner">
      <span class="cos-hero-label">Context OS</span>
      <h1 class="cos-hero-title">{t('contextOs.headline')}</h1>
      <p class="cos-hero-sub">{t('contextOs.subline')}</p>
    </div>
  </section>

  <!-- What is a Context OS -->
  <section class="cos-what content-grid">
    <div class="cos-what-inner">
      <h2 class="cos-what-title">{t('contextOs.whatIs')}</h2>
      <p class="cos-what-desc">{t('contextOs.whatIsDesc')}</p>
      <div class="cos-diagram">
        <div class="cos-diagram-node cos-diagram-agent">{t('contextOs.diagramAgent')}</div>
        <div class="cos-diagram-arrow">→</div>
        <div class="cos-diagram-node cos-diagram-leanctx">{t('contextOs.diagramLeanctx')}</div>
        <div class="cos-diagram-arrow">→</div>
        <div class="cos-diagram-node cos-diagram-repo">{t('contextOs.diagramRepo')}</div>
      </div>
    </div>
  </section>

  <!-- 6 Pillars Grid -->
  <section class="cos-pillars content-grid">
    <SectionHeading title={t('index.sixPillarsTitle')} subtitle={t('index.sixPillarsSubline')} />
    <div class="cos-pillars-grid">
      {pillars.map(p => (
        <a href={lp(`/context-os/${p.slug}`)} class="cos-pillar-card">
          <span class="cos-pillar-icon" set:html={p.icon} />
          <h3 class="cos-pillar-name">{t(p.titleKey)}</h3>
          <p class="cos-pillar-desc">{t(p.navDescKey)}</p>
          <span class="cos-pillar-tools">{p.tools.length} {t('contextOs.toolsLabel')}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="cos-how content-grid">
    <div class="cos-how-inner">
      <h2 class="cos-how-title">{t('contextOs.howItWorks')}</h2>
      <p class="cos-how-desc">{t('contextOs.howItWorksDesc')}</p>
      <div class="cos-pipeline">
        <div class="cos-pipeline-step">{t('contextOs.pipeInput')}</div>
        <div class="cos-pipeline-arrow">→</div>
        <div class="cos-pipeline-step">{t('contextOs.pipeIntent')}</div>
        <div class="cos-pipeline-arrow">→</div>
        <div class="cos-pipeline-step">{t('contextOs.pipeRelevance')}</div>
        <div class="cos-pipeline-arrow">→</div>
        <div class="cos-pipeline-step">{t('contextOs.pipeCompress')}</div>
        <div class="cos-pipeline-arrow">→</div>
        <div class="cos-pipeline-step">{t('contextOs.pipeVerify')}</div>
        <div class="cos-pipeline-arrow">→</div>
        <div class="cos-pipeline-step">{t('contextOs.pipeDeliver')}</div>
      </div>
    </div>
  </section>

  <!-- Proof numbers -->
  <section class="cos-stats content-grid">
    <div class="cos-stats-grid">
      <div class="cos-stat">
        <span class="cos-stat-num">{manifest.counts.granular}</span>
        <span class="cos-stat-label">{t('contextOs.statMcpTools')}</span>
      </div>
      <div class="cos-stat">
        <span class="cos-stat-num">90+</span>
        <span class="cos-stat-label">{t('contextOs.statShellPatterns')}</span>
      </div>
      <div class="cos-stat">
        <span class="cos-stat-num">24+</span>
        <span class="cos-stat-label">{t('contextOs.statIntegrations')}</span>
      </div>
      <div class="cos-stat">
        <span class="cos-stat-num">99%</span>
        <span class="cos-stat-label">{t('contextOs.statTokenSavings')}</span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cos-cta content-grid">
    <div class="cos-cta-inner">
      <h2 class="cos-cta-title">{t('index.heroCta')}</h2>
      <div class="cos-cta-actions">
        <a href={lp('/docs/getting-started')} class="cos-cta-primary">{t('nav.getStarted')}</a>
        <a href={lp('/benchmark')} class="cos-cta-secondary">{t('nav.product.benchmark')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cos-hero {
    padding-block: clamp(5rem, 4rem + 4vw, 10rem) clamp(2rem, 1.5rem + 2vw, 4rem);
  }
  .cos-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .cos-hero-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    padding: 0.375rem 1rem;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    margin-bottom: 1.5rem;
  }
  .cos-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--color-text-bright);
    margin-bottom: 1.25rem;
  }
  .cos-hero-sub {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .cos-what {
    padding-block: clamp(3rem, 2rem + 2vw, 5rem);
  }
  .cos-what-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .cos-what-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text-bright);
    margin-bottom: 1rem;
  }
  .cos-what-desc {
    font-size: clamp(0.9375rem, 0.875rem + 0.25vw, 1.0625rem);
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .cos-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 0.25rem + 0.5vw, 1rem);
    flex-wrap: wrap;
  }
  .cos-diagram-node {
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-bright);
    white-space: nowrap;
  }
  .cos-diagram-leanctx {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }
  .cos-diagram-arrow {
    color: var(--color-muted);
    font-size: 1.25rem;
  }

  .cos-pillars {
    padding-block: clamp(3rem, 2rem + 2vw, 5rem);
  }
  .cos-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);
    margin-top: 2rem;
  }
  .cos-pillar-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.25rem + 0.5vw, 2rem);
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .cos-pillar-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  .cos-pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--overlay-light);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .cos-pillar-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-bright);
    margin-bottom: 0.5rem;
  }
  .cos-pillar-desc {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.5;
    flex: 1;
  }
  .cos-pillar-tools {
    margin-top: 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .cos-how {
    padding-block: clamp(3rem, 2rem + 2vw, 5rem);
  }
  .cos-how-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .cos-how-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text-bright);
    margin-bottom: 0.75rem;
  }
  .cos-how-desc {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .cos-pipeline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .cos-pipeline-step {
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-bright);
  }
  .cos-pipeline-arrow {
    color: var(--color-accent);
    font-weight: 700;
  }

  .cos-stats {
    padding-block: clamp(2rem, 1.5rem + 1vw, 3rem);
  }
  .cos-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  @media (max-width: 640px) {
    .cos-stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .cos-stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    font-weight: 750;
    color: var(--color-accent);
    letter-spacing: -0.03em;
  }
  .cos-stat-label {
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .cos-cta {
    padding-block: clamp(4rem, 3rem + 2vw, 6rem);
    text-align: center;
  }
  .cos-cta-inner {
    max-width: 500px;
    margin: 0 auto;
  }
  .cos-cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 0.5vw, 2rem);
    font-weight: 700;
    color: var(--color-text-bright);
    margin-bottom: 1.5rem;
  }
  .cos-cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cos-cta-primary {
    padding: 0.75rem 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 12px;
    background: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cos-cta-primary:hover {
    opacity: 0.9;
    box-shadow: 0 0 24px rgba(52, 211, 153, 0.15);
  }
  .cos-cta-secondary {
    padding: 0.75rem 2rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cos-cta-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
