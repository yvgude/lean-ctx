---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: t('docsHarness.sidebarHarness'),
    items: [
      { label: t('docsHarness.sidebarOverview'), href: lp('/docs/agent-harness') },
      { label: t('docsHarness.sidebarRoles'), href: lp('/docs/agent-harness') + '#roles' },
      { label: t('docsHarness.sidebarBudgets'), href: lp('/docs/agent-harness') + '#budgets' },
      { label: t('docsHarness.sidebarPolicies'), href: lp('/docs/agent-harness') + '#policies' },
      { label: t('docsHarness.sidebarEvents'), href: lp('/docs/agent-harness') + '#events' },
      { label: t('docsHarness.sidebarCustom'), href: lp('/docs/agent-harness') + '#custom-roles' },
    ],
  },
  {
    title: t('docsHarness.sidebarRelated'),
    items: [
      { label: t('docsHarness.sidebarProfiles'), href: lp('/docs/profiles') },
      { label: t('docsHarness.sidebarTools'), href: lp('/docs/tools') },
      { label: t('docsHarness.sidebarConfiguration'), href: lp('/docs/configuration') },
    ],
  },
];
---

<DocsLayout title={t('docsHarness.title')} description={t('docsHarness.description')} sidebar={sidebar}>

  <p set:html={t('docsHarness.intro')} />

  <hr />

  <h2 set:html={t('docsHarness.whatTitle')} />
  <p set:html={t('docsHarness.whatDesc')} />

  <hr />

  <h2 id="roles" set:html={t('docsHarness.rolesTitle')} />
  <p set:html={t('docsHarness.rolesDesc')} />

  <div class="profiles-grid">
    <div class="profile-card">
      <h3>coder</h3>
      <p set:html={t('docsHarness.coderDesc')} />
    </div>
    <div class="profile-card">
      <h3>reviewer</h3>
      <p set:html={t('docsHarness.reviewerDesc')} />
    </div>
    <div class="profile-card">
      <h3>debugger</h3>
      <p set:html={t('docsHarness.debuggerDesc')} />
    </div>
    <div class="profile-card">
      <h3>ops</h3>
      <p set:html={t('docsHarness.opsDesc')} />
    </div>
    <div class="profile-card">
      <h3>admin</h3>
      <p set:html={t('docsHarness.adminDesc')} />
    </div>
  </div>

  <hr />

  <h2 id="budgets" set:html={t('docsHarness.budgetsTitle')} />
  <p set:html={t('docsHarness.budgetsDesc')} />

  <div class="code-block">
    <pre><code>Budget[coder]: tokens 50000/200000 (25%) | shell 5/100 (5%) | cost $0.50/$5.00 (10%) → OK</code></pre>
  </div>

  <h3 set:html={t('docsHarness.budgetDimTitle')} />
  <ul>
    <li set:html={t('docsHarness.budgetTokens')} />
    <li set:html={t('docsHarness.budgetShell')} />
    <li set:html={t('docsHarness.budgetCost')} />
  </ul>

  <h3 set:html={t('docsHarness.signalsTitle')} />
  <p set:html={t('docsHarness.signalsDesc')} />
  <ul>
    <li set:html={t('docsHarness.signalOk')} />
    <li set:html={t('docsHarness.signalWarning')} />
    <li set:html={t('docsHarness.signalExhausted')} />
  </ul>

  <hr />

  <h2 id="policies" set:html={t('docsHarness.policiesTitle')} />
  <p set:html={t('docsHarness.policiesDesc')} />

  <div class="code-block">
    <pre><code>[tools]
allowed = ["ctx_read", "ctx_search", "ctx_tree", "ctx_session"]
denied = ["ctx_edit", "ctx_shell"]</code></pre>
  </div>

  <h3 set:html={t('docsHarness.shellPolicyTitle')} />
  <ul>
    <li set:html={t('docsHarness.shellTrack')} />
    <li set:html={t('docsHarness.shellCompress')} />
    <li set:html={t('docsHarness.shellDeny')} />
  </ul>

  <hr />

  <h2 id="events" set:html={t('docsHarness.eventsTitle')} />
  <p set:html={t('docsHarness.eventsDesc')} />
  <ul>
    <li set:html={t('docsHarness.eventBudgetWarning')} />
    <li set:html={t('docsHarness.eventBudgetExhausted')} />
    <li set:html={t('docsHarness.eventPolicyViolation')} />
    <li set:html={t('docsHarness.eventRoleChanged')} />
  </ul>

  <hr />

  <h2 id="custom-roles" set:html={t('docsHarness.customTitle')} />
  <p set:html={t('docsHarness.customDesc')} />

  <div class="code-block">
    <pre><code>[role]
name = "security-auditor"
inherits = "reviewer"
description = "Security-focused code review"
shell_policy = "deny"

[tools]
allowed = ["ctx_read", "ctx_search", "ctx_tree", "ctx_review", "ctx_session"]
denied = ["ctx_edit", "ctx_shell", "ctx_execute"]

[limits]
max_context_tokens = 100000
max_shell_invocations = 0
max_cost_usd = 2.0</code></pre>
  </div>

  <p set:html={t('docsHarness.customCli')} />

  <hr />

  <h2 set:html={t('docsHarness.activateTitle')} />
  <p set:html={t('docsHarness.activateEnv')} />
  <div class="code-block">
    <pre><code>export LEAN_CTX_ROLE=reviewer</code></pre>
  </div>
  <p set:html={t('docsHarness.activateMcp')} />
  <div class="code-block">
    <pre><code>ctx_session action=role value=debugger</code></pre>
  </div>
  <p set:html={t('docsHarness.activateBudget')} />
  <div class="code-block">
    <pre><code>ctx_session action=budget</code></pre>
  </div>

</DocsLayout>

<style>
  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .profile-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
  }
  .profile-card h3 {
    color: #34d399;
    font-family: monospace;
    margin-top: 0;
  }
  .code-block {
    background: rgba(0, 0, 0, 0.3);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .code-block code {
    color: #e2e8f0;
    font-size: 0.9em;
  }
</style>
