const sidebar = [
  {
    title: 'Versions',
    items: [
      { label: '3.4.2 (Current)', href: lp('/docs/changelog') + '#v3.4.2' },
      { label: '3.4.1', href: lp('/docs/changelog') + '#v3.4.1' },
      { label: '3.4.0', href: lp('/docs/changelog') + '#v3.4.0' },
      { label: '3.3.3', href: lp('/docs/changelog') + '#v3.3.3' },
      { label: '3.3.2', href: lp('/docs/changelog') + '#v3.3.2' },
      { label: '3.3.1', href: lp('/docs/changelog') + '#v3.3.1' },
      { label: '3.3.0', href: lp('/docs/changelog') + '#v3.3.0' },
      { label: '3.2.9', href: lp('/docs/changelog') + '#v3.2.9' },
      { label: '3.2.8', href: lp('/docs/changelog') + '#v3.2.8' },
      { label: '3.2.6', href: lp('/docs/changelog') + '#v3.2.6' },
      { label: '3.2.0', href: lp('/docs/changelog') + '#v3.2.0' },
      { label: '3.0.1', href: lp('/docs/changelog') + '#v3.0.1' },
    ],
  },
  {
    title: 'Related',
    items: [
      { label: 'Getting Started', href: lp('/docs/getting-started') },
