---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: t('docs.cliReference.sidebarTitle'),
    items: [
      { label: t('docs.common.overview'), href: lp('/docs/cli-reference') },
      { label: t('docs.cliReference.sidebarShellCompression'), href: lp('/docs/cli-reference#shell-compression') },
      { label: t('docs.cliReference.sidebarRawMode'), href: lp('/docs/cli-reference#raw-mode') },
      { label: t('docs.cliReference.sidebarFileOps'), href: lp('/docs/cli-reference#file-operations') },
      { label: t('docs.cliReference.sidebarReadModes'), href: lp('/docs/cli-reference#read-modes') },
      { label: t('docs.cliReference.sidebarSetupConfig'), href: lp('/docs/cli-reference#setup-config') },
      { label: t('docs.cliReference.sidebarAnalytics'), href: lp('/docs/cli-reference#analytics') },
      { label: t('docs.cliReference.sidebarSessions'), href: lp('/docs/cli-reference#sessions') },
      { label: t('docs.cliReference.sidebarBenchmarking'), href: lp('/docs/cli-reference#benchmarking') },
      { label: t('docs.cliReference.sidebarTeeFilters'), href: lp('/docs/cli-reference#tee-filters') },
      { label: t('docs.cliReference.sidebarUtilities'), href: lp('/docs/cli-reference#utilities') },
      { label: t('docs.cliReference.sidebarProjectGraph'), href: lp('/docs/cli-reference#project-graph') },
      { label: t('docs.cliReference.sidebarHeatmap'), href: lp('/docs/cli-reference#heatmap') },
      { label: t('docs.cliReference.sidebarSafetyLevels'), href: lp('/docs/cli-reference#safety-levels') },
      { label: 'Audit', href: lp('/docs/cli-reference#audit') },
      { label: 'Shell Allowlist', href: lp('/docs/cli-reference#shell-allowlist') },
      { label: t('docs.cliReference.sidebarBypass'), href: lp('/docs/cli-reference#bypass') },
      { label: 'Cloud Auth', href: lp('/docs/cli-reference#login') },
      { label: t('docs.cliReference.sidebarShellAliases'), href: lp('/docs/cli-reference#shell-aliases') },
      { label: 'Server & Services', href: lp('/docs/cli-reference#server-services') },
      { label: 'Terse Agent', href: lp('/docs/cli-reference#terse-agent') },
      { label: 'Token Reports', href: lp('/docs/cli-reference#token-reports') },
      { label: 'Cache Management', href: lp('/docs/cli-reference#cache-management') },
      { label: 'Gotchas', href: lp('/docs/cli-reference#gotchas') },
      { label: 'Buddy', href: lp('/docs/cli-reference#buddy') },
      { label: 'Instructions', href: lp('/docs/cli-reference#instructions') },
      { label: t('docs.cliReference.sidebarPack'), href: lp('/docs/cli-reference#context-packages') },
    ],
  },
  {
    title: t('docs.common.related'),
    items: [
      { label: t('docs.cliReference.sidebarQuickRef'), href: lp('/docs/quick-reference') },
      { label: t('docs.cliReference.sidebarConfiguration'), href: lp('/docs/configuration') },
      { label: t('docs.cliReference.sidebarGettingStarted'), href: lp('/docs/getting-started') },
    ],
  },
];
---

<DocsLayout title={t('docs.cliReference.title')} description={t('docs.cliReference.description')} sidebar={sidebar}>

  <p><Fragment set:html={t('docs.cliReference.intro', { quickRefPath: lp('/docs/quick-reference'), analyticsPath: lp('/docs/tools/analysis') })} /></p>

  <hr />

  <h2 id="shell-compression">{t('docs.cliReference.shellCompressionTitle')}</h2>

  <p><Fragment set:html={t('docs.cliReference.shellCompressionDesc')} /></p>

  <h3 id="exec"><code>lean-ctx -c "&lt;command&gt;"</code></h3>
  <p><Fragment set:html={t('docs.cliReference.execDesc')} /></p>
  <pre><code>lean-ctx -c "git status"
lean-ctx -c "kubectl get pods -A"
lean-ctx -c "cargo build 2>&amp;1"
lean-ctx exec "docker ps"</code></pre>
  <p><Fragment set:html={t('docs.cliReference.execNote')} /></p>

  <h3 id="shell"><code>lean-ctx shell</code></h3>
  <p><Fragment set:html={t('docs.cliReference.shellDesc')} /></p>
  <pre><code>lean-ctx shell
# Now every command output is compressed automatically
git log --oneline -20
docker compose logs
# Exit with Ctrl+D or 'exit'</code></pre>

  <hr />

  <h2 id="raw-mode">{t('docs.cliReference.rawModeTitle')}</h2>

  <p>{t('docs.cliReference.rawModeDesc')}</p>

  <pre><code># CLI flag
lean-ctx -c --raw git log --stat

# Shell function (after lean-ctx init --global)
lean-ctx-raw kubectl get pods -o yaml

# MCP parameter
ctx_shell(command="cat package.json", raw=true)

# Environment variable
LEAN_CTX_RAW=1 lean-ctx -c npm list

# Bypass command - guaranteed zero compression
lean-ctx bypass "git diff HEAD~1"

# Kill-switch: disable ALL compression
LEAN_CTX_DISABLED=1 lean-ctx -c git status</code></pre>

  <h3 id="bypass"><code>lean-ctx bypass "&lt;command&gt;"</code></h3>
  <p>{t('docs.cliReference.bypassDesc')}</p>
  <pre><code>lean-ctx bypass "git diff HEAD~1"     # guaranteed unmodified output
lean-ctx bypass "docker logs myapp"   # no compression, no truncation
lean-ctx bypass "npm audit"           # raw vulnerability report</code></pre>
  <p><Fragment set:html={t('docs.cliReference.bypassNote')} /></p>

  <hr />

  <h2 id="file-operations">{t('docs.cliReference.fileOpsTitle')}</h2>

  <p>{t('docs.cliReference.fileOpsDesc')}</p>

  <h3 id="read"><code>lean-ctx read &lt;file&gt; [-m &lt;mode&gt;]</code></h3>
  <p><Fragment set:html={t('docs.cliReference.readDesc')} /></p>
  <pre><code>lean-ctx read src/main.rs                    # auto-selects best mode
lean-ctx read src/main.rs -m full            # full content (cached)
lean-ctx read src/main.rs -m map             # dependency graph + exports
lean-ctx read src/main.rs -m signatures      # tree-sitter AST extraction
lean-ctx read src/main.rs -m aggressive      # syntax-stripped
lean-ctx read src/main.rs -m entropy         # Shannon entropy filtered
lean-ctx read src/main.rs -m diff            # changed lines only
lean-ctx read src/main.rs -m task            # IB-filtered for current task
lean-ctx read src/main.rs -m reference       # cross-reference context
lean-ctx read src/main.rs -m lines:10-50     # specific line range
lean-ctx read src/main.rs -m lines:10-50,80  # multiple ranges</code></pre>

  <h3 id="diff"><code>lean-ctx diff &lt;file1&gt; &lt;file2&gt;</code></h3>
  <p>{t('docs.cliReference.diffDesc')}</p>
  <pre><code>lean-ctx diff old.rs new.rs</code></pre>

  <h3 id="grep"><code>lean-ctx grep &lt;pattern&gt; [path]</code></h3>
  <p>{t('docs.cliReference.grepDesc')}</p>
  <pre><code>lean-ctx grep "pub fn" src/
lean-ctx grep "TODO" .
lean-ctx grep "async fn.*Result" rust/src/</code></pre>

  <h3 id="find"><code>lean-ctx find &lt;pattern&gt; [path]</code></h3>
  <p><Fragment set:html={t('docs.cliReference.findDesc')} /></p>
  <pre><code>lean-ctx find "*.rs" src/
lean-ctx find "test_*" .</code></pre>

  <h3 id="ls"><code>lean-ctx ls [path] [--all|-a] [--depth N] [--no-gitignore]</code></h3>
  <p>{t('docs.cliReference.lsDesc')}</p>
  <table>
    <thead><tr><th>{t('docs.cliReference.thFlag')}</th><th>{t('docs.cliReference.thDescription')}</th></tr></thead>
    <tbody>
      <tr><td><code>--all</code> / <code>-a</code></td><td set:html={t('docs.cliReference.lsAllDesc')} /></tr>
      <tr><td><code>--depth N</code></td><td set:html={t('docs.cliReference.lsDepthDesc')} /></tr>
      <tr><td><code>--no-gitignore</code></td><td set:html={t('docs.cliReference.lsNoGitignoreDesc')} /></tr>
    </tbody>
  </table>
  <pre><code>lean-ctx ls
lean-ctx ls src/components/
lean-ctx ls --all .
lean-ctx ls --depth 5 src/
lean-ctx ls --no-gitignore build/</code></pre>
  <p class="text-sm text-muted" set:html={t('docs.cliReference.lsNote')} />

  <h3 id="deps"><code>lean-ctx deps [path]</code></h3>
  <p>{t('docs.cliReference.depsDesc')}</p>
  <pre><code>lean-ctx deps .
lean-ctx deps frontend/</code></pre>

  <hr />

  <h2 id="read-modes">{t('docs.cliReference.readModesTitle')}</h2>

  <p><Fragment set:html={t('docs.cliReference.readModesDesc')} /></p>

  <table>
    <thead>
      <tr><th>{t('docs.cliReference.thMode')}</th><th>{t('docs.cliReference.thOutput')}</th><th>{t('docs.cliReference.thUseCase')}</th><th>{t('docs.cliReference.thSavings')}</th></tr>
    </thead>
    <tbody>
      <tr><td><code>auto</code></td><td>{t('docs.cliReference.modeAutoOutput')}</td><td>{t('docs.cliReference.modeAutoUse')}</td><td>60–95%</td></tr>
      <tr><td><code>full</code></td><td>{t('docs.cliReference.modeFull')}</td><td>{t('docs.cliReference.modeFullUse')}</td><td>{t('docs.cliReference.modeFullSavings')}</td></tr>
      <tr><td><code>map</code></td><td>{t('docs.cliReference.modeMap')}</td><td>{t('docs.cliReference.modeMapUse')}</td><td>{t('docs.cliReference.modeMapSavings')}</td></tr>
      <tr><td><code>signatures</code></td><td>{t('docs.cliReference.modeSignatures')}</td><td>{t('docs.cliReference.modeSignaturesUse')}</td><td>{t('docs.cliReference.modeSignaturesSavings')}</td></tr>
      <tr><td><code>aggressive</code></td><td>{t('docs.cliReference.modeAggressive')}</td><td>{t('docs.cliReference.modeAggressiveUse')}</td><td>{t('docs.cliReference.modeAggressiveSavings')}</td></tr>
      <tr><td><code>entropy</code></td><td>{t('docs.cliReference.modeEntropy')}</td><td>{t('docs.cliReference.modeEntropyUse')}</td><td>{t('docs.cliReference.modeEntropySavings')}</td></tr>
      <tr><td><code>diff</code></td><td>{t('docs.cliReference.modeDiff')}</td><td>{t('docs.cliReference.modeDiffUse')}</td><td>{t('docs.cliReference.modeDiffSavings')}</td></tr>
      <tr><td><code>task</code></td><td>{t('docs.cliReference.modeTaskOutput')}</td><td>{t('docs.cliReference.modeTaskUse')}</td><td>70–90%</td></tr>
      <tr><td><code>reference</code></td><td>{t('docs.cliReference.modeReferenceOutput')}</td><td>{t('docs.cliReference.modeReferenceUse')}</td><td>60–85%</td></tr>
      <tr><td><code>lines:N-M</code></td><td>{t('docs.cliReference.modeLines')}</td><td><Fragment set:html={t('docs.cliReference.modeLinesUse')} /></td><td>{t('docs.cliReference.modeLinesSavings')}</td></tr>
    </tbody>
  </table>

  <p><Fragment set:html={t('docs.cliReference.modesSupportedLangs')} /></p>

  <hr />

  <h2 id="setup-config">{t('docs.cliReference.setupConfigTitle')}</h2>

  <h3 id="setup"><code>lean-ctx setup</code></h3>
  <p>{t('docs.cliReference.setupDesc')}</p>
  <pre><code>lean-ctx setup</code></pre>
  <p>{t('docs.cliReference.setupStepsIntro')}</p>
  <ol>
    <li><Fragment set:html={t('docs.cliReference.setupStep1')} /></li>
    <li>{t('docs.cliReference.setupStep2')}</li>
    <li><Fragment set:html={t('docs.cliReference.setupStep3')} /></li>
  </ol>
  <p set:html={t('docs.cliReference.setupPremiumNote')} />
  <p set:html={t('docs.cliReference.setupShellActivationNote')} />

  <h3 id="init"><code>lean-ctx init [--global | &lt;shell&gt;] [--style=auto|inline|dropin]</code></h3>
  <p>{t('docs.cliReference.initDesc')}</p>
  <pre><code># File-based: writes aliases directly into your shell profile
lean-ctx init           # install for current shell
lean-ctx init --global  # same, explicit flag

# Install style (v3.5.19+)
lean-ctx init --global --style=dropin   # drop-in file in ~/.zshenv.d/
lean-ctx init --global --style=inline   # fenced block in ~/.zshenv (default)
lean-ctx init --global --style=auto     # auto-detect (default)

# Eval-based: prints hook code to stdout (like starship, zoxide, atuin)
eval "$(lean-ctx init bash)"        # bash: add to ~/.bashrc
eval "$(lean-ctx init zsh)"         # zsh: add to ~/.zshrc
lean-ctx init fish | source         # fish: add to config.fish
lean-ctx init powershell | Invoke-Expression  # PowerShell: add to $PROFILE</code></pre>
  <p><Fragment set:html={t('docs.cliReference.initNote')} /></p>
  <p><Fragment set:html={t('docs.cliReference.initEvalNote')} /></p>

  <h4 id="init-style">{t('docs.cliReference.initStyleTitle')}</h4>
  <p><Fragment set:html={t('docs.cliReference.initStyleDesc')} /></p>
  <table>
    <thead><tr><th>{t('docs.cliReference.thStyle')}</th><th>{t('docs.cliReference.thBehavior')}</th></tr></thead>
    <tbody>
      <tr><td><code>auto</code></td><td>{t('docs.cliReference.initStyleAuto')}</td></tr>
      <tr><td><code>inline</code></td><td>{t('docs.cliReference.initStyleInline')}</td></tr>
      <tr><td><code>dropin</code></td><td>{t('docs.cliReference.initStyleDropin')}</td></tr>
    </tbody>
  </table>

  <h3 id="init-agent"><code>lean-ctx init --agent &lt;name&gt;</code></h3>
  <p>{t('docs.cliReference.initAgentDesc')}</p>
  <table>
    <thead><tr><th>{t('docs.cliReference.thAgent')}</th><th>{t('docs.cliReference.thNotes')}</th></tr></thead>
    <tbody>
      <tr><td><code>cursor</code></td><td>Cursor IDE (default MCP setup)</td></tr>
      <tr><td><code>claude</code></td><td>Claude Code / Claude Desktop</td></tr>
      <tr><td><code>codex</code></td><td>OpenAI Codex CLI</td></tr>
      <tr><td><code>gemini</code></td><td>Google Gemini CLI</td></tr>
      <tr><td><code>antigravity</code></td><td>Antigravity IDE (<code>~/.gemini/antigravity/</code>)</td></tr>
      <tr><td><code>antigravity-cli</code></td><td>Antigravity CLI 2.0 (<code>~/.gemini/antigravity-cli/</code>)</td></tr>
      <tr><td><code>openclaw</code></td><td>OpenClaw (<code>~/.openclaw/openclaw.json</code>)</td></tr>
      <tr><td><code>augment</code></td><td>Augment Code</td></tr>
      <tr><td><code>windsurf</code></td><td>Windsurf IDE</td></tr>
      <tr><td><code>copilot</code></td><td>GitHub Copilot</td></tr>
      <tr><td><code>cline</code></td><td>Cline (VS Code extension)</td></tr>
      <tr><td><code>roo</code></td><td>Roo Code</td></tr>
      <tr><td><code>aider</code></td><td>Aider CLI</td></tr>
      <tr><td><code>continue</code></td><td>Continue.dev</td></tr>
      <tr><td><code>zed</code></td><td>Zed Editor</td></tr>
      <tr><td><code>void</code></td><td>Void Editor</td></tr>
      <tr><td><code>amp</code></td><td>Amp (Sourcegraph)</td></tr>
      <tr><td><code>trae</code></td><td>Trae IDE</td></tr>
      <tr><td><code>kilo</code></td><td>Kilo Code</td></tr>
      <tr><td><code>opencode</code></td><td>OpenCode CLI</td></tr>
      <tr><td><code>pi</code></td><td>Installs <code>pi-lean-ctx</code> npm package</td></tr>
      <tr><td><code>custom</code></td><td>Generic MCP config - prompts for path</td></tr>
    </tbody>
  </table>

  <pre><code>lean-ctx init --agent cursor
lean-ctx init --agent claude
lean-ctx init --agent codex
lean-ctx init --agent gemini
lean-ctx init --agent antigravity      # Antigravity IDE
lean-ctx init --agent antigravity-cli  # Antigravity CLI 2.0
lean-ctx init --agent openclaw
lean-ctx init --agent augment
lean-ctx init --agent windsurf
lean-ctx init --agent copilot
lean-ctx init --agent cline
lean-ctx init --agent roo
lean-ctx init --agent aider
lean-ctx init --agent continue
lean-ctx init --agent zed
lean-ctx init --agent void
lean-ctx init --agent amp
lean-ctx init --agent trae
lean-ctx init --agent kilo
lean-ctx init --agent opencode
lean-ctx init --agent pi           # installs pi-lean-ctx npm package
lean-ctx init --agent custom       # generic MCP config</code></pre>

  <h3 id="config"><code>lean-ctx config [set &lt;key&gt; &lt;value&gt;]</code></h3>
  <p><Fragment set:html={t('docs.cliReference.configDesc')} /></p>
  <pre><code>lean-ctx config                        # show current config
lean-ctx config set ultra_compact true # enable ultra-compact mode
lean-ctx config set tee_on_error true  # log errors to ~/.lean-ctx/tee/
lean-ctx config set checkpoint_interval 20</code></pre>

  <h4>{t('docs.cliReference.settableConfigKeysTitle')}</h4>
  <p class="text-sm text-muted" set:html={t('docs.cliReference.settableConfigKeysIntro')} />
  <table>
    <thead><tr><th>{t('docs.cliReference.thKey')}</th><th>{t('docs.cliReference.thType')}</th><th>{t('docs.cliReference.thDefault')}</th><th>{t('docs.cliReference.thDescription')}</th></tr></thead>
    <tbody>
      <tr><td><code>ultra_compact</code></td><td>bool</td><td><code>false</code></td><td set:html={t('docs.cliReference.cfgUltraCompactDesc')} /></tr>
      <tr><td><code>tee_mode</code></td><td>string</td><td><code>"off"</code></td><td set:html={t('docs.cliReference.cfgTeeModeDesc')} /></tr>
      <tr><td><code>checkpoint_interval</code></td><td>int</td><td><code>15</code></td><td set:html={t('docs.cliReference.cfgCheckpointIntervalDesc')} /></tr>
      <tr><td><code>theme</code></td><td>string</td><td><code>"default"</code></td><td set:html={t('docs.cliReference.cfgThemeDesc')} /></tr>
      <tr><td><code>compression_level</code></td><td>enum</td><td><code>"standard"</code></td><td set:html={t('docs.cliReference.cfgCompressionLevelDesc')} /></tr>
      <tr><td><code>profile</code></td><td>string</td><td><code>"coder"</code></td><td set:html={t('docs.cliReference.cfgProfileDesc')} /></tr>
      <tr><td><code>slow_command_threshold_ms</code></td><td>int</td><td><code>5000</code></td><td set:html={t('docs.cliReference.cfgSlowCmdThresholdDesc')} /></tr>
      <tr><td><code>passthrough_urls</code></td><td>string[]</td><td><code>[]</code></td><td set:html={t('docs.cliReference.cfgPassthroughUrlsDesc')} /></tr>
      <tr><td><code>rules_scope</code></td><td>string</td><td><code>"project"</code></td><td set:html={t('docs.cliReference.cfgRulesScopeDesc')} /></tr>
    </tbody>
  </table>

  <pre><code>lean-ctx config set theme neon
lean-ctx config set slow_command_threshold_ms 3000
lean-ctx config set passthrough_urls "localhost:3000,api.example.com"
lean-ctx config set rules_scope both</code></pre>

  <h3 id="config-schema"><code>lean-ctx config schema</code> <span class="text-xs font-normal text-muted ml-2">v3.5.21</span></h3>
  <p set:html={t('docs.cliReference.configSchemaDesc')} />
  <pre><code>lean-ctx config schema                     # print full JSON schema to stdout
lean-ctx config schema > config-schema.json  # save for editor integration</code></pre>

  <h3 id="config-validate"><code>lean-ctx config validate</code> <span class="text-xs font-normal text-muted ml-2">v3.5.21</span></h3>
  <p set:html={t('docs.cliReference.configValidateDesc')} />
  <pre><code>lean-ctx config validate                   # validate ~/.lean-ctx/config.toml
lean-ctx config validate && echo "OK"      # CI gate - fails on invalid config</code></pre>

  <h3 id="config-show"><code>lean-ctx config show</code> <span class="text-xs font-normal text-muted ml-2">v3.6.18</span></h3>
  <p set:html={t('docs.cliReference.configShowDesc')} />
  <pre><code>lean-ctx config show                       # show effective values with sources
lean-ctx config effective                  # alias for 'show'</code></pre>

  <h3 id="doctor"><code>lean-ctx doctor</code></h3>
  <p>{t('docs.cliReference.doctorDesc')}</p>
  <ul>
    <li>{t('docs.cliReference.doctorCheck1')}</li>
    <li>{t('docs.cliReference.doctorCheck2')}</li>
    <li>{t('docs.cliReference.doctorCheck3')}</li>
    <li>{t('docs.cliReference.doctorCheck4')}</li>
    <li>{t('docs.cliReference.doctorCheck5')}</li>
    <li>{t('docs.cliReference.doctorCheck6')}</li>
    <li>{t('docs.cliReference.doctorCheck7')}</li>
    <li>{t('docs.cliReference.doctorCheck8')}</li>
    <li>{t('docs.cliReference.doctorCheck9')}</li>
    <li>{t('docs.cliReference.doctorCheck10')}</li>
    <li>{t('docs.cliReference.doctorCheck11')}</li>
    <li set:html={t('docs.cliReference.doctorCheckLinux')} />
    <li set:html={t('docs.cliReference.doctorCheckCrashLoop')} />
  </ul>
  <pre><code>lean-ctx doctor
lean-ctx doctor integrations   # premium integration checks
lean-ctx doctor --fix --json   # repair + machine-readable report</code></pre>

  <h3 id="update"><code>lean-ctx update [--check]</code></h3>
  <p>{t('docs.cliReference.updateDesc')}</p>
  <pre><code>lean-ctx update         # download and install latest version
lean-ctx update --check # check if a newer version is available (no install)</code></pre>

  <h3 id="login"><code>lean-ctx login &lt;email&gt; [--password &lt;pw&gt;]</code> <span class="text-xs font-normal text-muted ml-2">v3.3.3</span></h3>
  <p set:html={t('docs.cliReference.loginDesc')} />
  <pre><code>lean-ctx login user@example.com
lean-ctx login user@example.com --password mypassword</code></pre>
  <p set:html={t('docs.cliReference.loginSuccessNote')} />

  <h3 id="register"><code>lean-ctx register &lt;email&gt; [--password &lt;pw&gt;]</code> <span class="text-xs font-normal text-muted ml-2">v3.3.3</span></h3>
  <p set:html={t('docs.cliReference.registerDesc')} />
  <pre><code>lean-ctx register user@example.com
lean-ctx register user@example.com --password mypassword</code></pre>

  <h3 id="forgot-password"><code>lean-ctx forgot-password &lt;email&gt;</code></h3>
  <p set:html={t('docs.cliReference.forgotPasswordDesc')} />
  <pre><code>lean-ctx forgot-password user@example.com</code></pre>

  <h3 id="provider"><code>lean-ctx provider &lt;auth|list|logout&gt;</code> <span class="text-xs font-normal text-muted ml-2">v3.6.25</span></h3>
  <p set:html={t('docs.cliReference.providerDesc')} />
  <pre><code>lean-ctx provider auth jira      # run the interactive OAuth flow for Jira
lean-ctx provider list           # show configured providers and credential status
lean-ctx provider logout jira    # remove stored Jira OAuth credentials</code></pre>
  <p set:html={t('docs.cliReference.providerAuthNote')} />
  <p set:html={t('docs.cliReference.providerAuthNote2')} />

  <h3 id="uninstall"><code>lean-ctx uninstall [--keep-config]</code></h3>
  <p><Fragment set:html={t('docs.cliReference.uninstallDesc')} /></p>
  <p set:html={t('docs.cliReference.uninstallRemoves')} />
  <p set:html={t('docs.cliReference.uninstallKeepConfig')} />
