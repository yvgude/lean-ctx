---
import DocsLayout from '../layouts/DocsLayout.astro';
import DocsCallout from '../components/DocsCallout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

---

<DocsLayout title={t('docsConfiguration.title')} description={t('docsConfiguration.description')}>

  <p set:html={t('docsConfiguration.intro')} />

  <DocsCallout variant="note" title={t('docs.configuration.calloutNoChangeTitle')}>
    <p set:html={t('docs.configuration.calloutNoChangeBody')} />
  </DocsCallout>

  <hr />

  <h2 id="config-file" set:html={t('docsConfiguration.configFileTitle')} />

  <p set:html={t('docsConfiguration.configFileDesc')} />

  <h3 set:html={t('docsConfiguration.createDefaultConfig')} />
  <pre><code>lean-ctx config init</code></pre>

  <h3 set:html={t('docsConfiguration.viewCurrentConfig')} />
  <pre><code>lean-ctx config</code></pre>

  <h3 set:html={t('docsConfiguration.setIndividualValues')} />
  <pre><code>lean-ctx config set ultra_compact true
lean-ctx config set checkpoint_interval 15
lean-ctx config set tee_mode always
lean-ctx config set passthrough_urls localhost:3000,api.internal</code></pre>

  <h3 set:html={t('docsConfiguration.validateTitle')} />
  <pre><code># Check for typos, unknown keys, and wrong field names
lean-ctx config validate

# View the full config schema (all keys, types, defaults)
lean-ctx config schema</code></pre>

  <hr />

  <h2 id="config-priority" set:html={t('docsConfiguration.configPriorityTitle')} />
  <p set:html={t('docsConfiguration.configPriorityDesc')} />
  <table>
    <thead>
      <tr><th>{t('docs.configuration.thPriority')}</th><th>{t('docs.configuration.thSource')}</th><th>{t('docs.configuration.thExample')}</th></tr>
    </thead>
    <tbody>
      <tr><td><strong>1 (highest)</strong></td><td set:html={t('docsConfiguration.configPriorityP1')} /><td><code>LEAN_CTX_COMPRESSION=max</code></td></tr>
      <tr><td><strong>2</strong></td><td set:html={t('docsConfiguration.configPriorityP2')} /><td><code>.lean-ctx.toml</code></td></tr>
      <tr><td><strong>3 (lowest)</strong></td><td set:html={t('docsConfiguration.configPriorityP3')} /><td><code>~/.lean-ctx/config.toml</code></td></tr>
    </tbody>
  </table>
  <p set:html={t('docsConfiguration.configPriorityTomlNote')} />

  <hr />

  <h2 id="common-confusion" set:html={t('docsConfiguration.commonConfusionTitle')} />
  <p set:html={t('docsConfiguration.commonConfusionDesc')} />
  <table>
    <thead>
      <tr><th>{t('docs.configuration.thParameter')}</th><th>{t('docs.configuration.thWhatItControls')}</th><th>{t('docs.configuration.thDefault')}</th><th>{t('docs.configuration.thSection')}</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>graph_index_max_files</code></td>
        <td set:html={t('docsConfiguration.confusionGraphIndexDesc')} />
        <td><code>0</code> (unlimited)</td>
        <td>root</td>
      </tr>
      <tr>
        <td><code>memory.knowledge.max_facts</code></td>
        <td set:html={t('docsConfiguration.confusionKnowledgeDesc')} />
        <td><code>200</code></td>
        <td><code>[memory.knowledge]</code></td>
      </tr>
      <tr>
        <td><code>memory.embeddings.max_facts</code></td>
        <td set:html={t('docsConfiguration.confusionEmbeddingsDesc')} />
        <td><code>2000</code></td>
        <td><code>[memory.embeddings]</code></td>
      </tr>
      <tr>
        <td><code>archive.max_disk_mb</code></td>
        <td set:html={t('docsConfiguration.confusionArchiveDiskDesc')} />
        <td><code>500</code></td>
        <td><code>[archive]</code></td>
      </tr>
      <tr>
        <td><code>archive.max_age_hours</code></td>
        <td set:html={t('docsConfiguration.confusionArchiveAgeDesc')} />
        <td><code>48</code></td>
        <td><code>[archive]</code></td>
      </tr>
      <tr>
        <td><code>memory.lifecycle.stale_days</code></td>
        <td set:html={t('docsConfiguration.confusionStaleDaysDesc')} />
        <td><code>30</code></td>
        <td><code>[memory.lifecycle]</code></td>
      </tr>
    </tbody>
  </table>

  <DocsCallout variant="warn">
    <span set:html={t('docsConfiguration.confusionCallout')} />
  </DocsCallout>

  <hr />

  <h2 id="config-options" set:html={t('docsConfiguration.configOptionsTitle')} />

  <table>
    <thead>
      <tr><th>{t('docsConfiguration.tableKey')}</th><th>{t('docsConfiguration.tableType')}</th><th>{t('docsConfiguration.tableDefault')}</th><th>{t('docsConfiguration.tableDescription')}</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>ultra_compact</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docsConfiguration.ultraCompactDesc')} />
      </tr>
      <tr>
        <td><code>compression_level</code></td>
        <td>string</td>
        <td><code>"lite"</code></td>
        <td set:html={t('docs.configuration.optCompressionLevelDesc')} />
      </tr>
      <tr>
        <td><code>minimal_overhead</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docs.configuration.optMinimalOverheadDesc')} />
      </tr>
      <tr>
        <td><code>output_density</code></td>
        <td>string</td>
        <td><code>"normal"</code></td>
        <td set:html={t('docs.configuration.optOutputDensityDesc')} />
      </tr>
      <tr>
        <td><code>tee_mode</code></td>
        <td>string</td>
        <td><code>"failures"</code></td>
        <td set:html={t('docsConfiguration.teeModeDesc')} />
      </tr>
      <tr>
        <td><code>passthrough_urls</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docsConfiguration.passthroughUrlsDesc')} />
      </tr>
      <tr>
        <td><code>checkpoint_interval</code></td>
        <td>u32</td>
        <td><code>15</code></td>
        <td set:html={t('docsConfiguration.checkpointIntervalDesc')} />
      </tr>
      <tr>
        <td><code>excluded_commands</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docsConfiguration.excludedCommandsDesc')} />
      </tr>
      <tr>
        <td><code>custom_aliases</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docs.configuration.optCustomAliasesTableDesc')} />
      </tr>
      <tr>
        <td><code>path_jail</code></td>
        <td>bool</td>
        <td><code>true</code></td>
        <td set:html={t('docs.configuration.optPathJailTableDesc')} />
      </tr>
      <tr>
        <td><code>redirect_exclude</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docs.configuration.optRedirectExcludeDesc')} />
      </tr>
      <tr>
        <td><code>content_defined_chunking</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docs.configuration.optContentDefinedChunkingDesc')} />
      </tr>
      <tr>
        <td><code>disabled_tools</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docs.configuration.optDisabledToolsDesc')} />
      </tr>
      <tr>
        <td><code>terse_agent</code></td>
        <td>string</td>
        <td><code>"off"</code></td>
        <td set:html={t('docs.configuration.optTerseAgentDesc')} />
      </tr>
      <tr>
        <td><code>rules_scope</code></td>
        <td>string</td>
        <td><code>"both"</code></td>
        <td set:html={t('docs.configuration.optRulesScopeDesc')} />
      </tr>
      <tr>
        <td><code>slow_command_threshold_ms</code></td>
        <td>u64</td>
        <td><code>5000</code></td>
        <td set:html={t('docs.configuration.optSlowCommandThresholdDesc')} />
      </tr>
      <tr>
        <td><code>buddy_enabled</code></td>
        <td>bool</td>
        <td><code>true</code></td>
        <td set:html={t('docs.configuration.optBuddyEnabledDesc')} />
      </tr>
      <tr>
        <td><code>extra_ignore_patterns</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docs.configuration.optExtraIgnorePatternsDesc')} />
      </tr>
      <tr>
        <td><code>profile</code></td>
        <td>string</td>
        <td><code>"coder"</code></td>
        <td set:html={t('docs.configuration.optProfileDesc')} />
      </tr>
      <tr>
        <td><code>theme</code></td>
        <td>string</td>
        <td><code>"default"</code></td>
        <td set:html={t('docs.configuration.optThemeDesc')} />
      </tr>
      <tr>
        <td><code>memory_profile</code></td>
        <td>string</td>
        <td><code>"balanced"</code></td>
        <td set:html={t('docs.configuration.optMemoryProfileDesc')} />
      </tr>
      <tr>
        <td><code>bm25_max_cache_mb</code></td>
        <td>u64</td>
        <td><code>128</code></td>
        <td set:html={t('docs.configuration.optBm25MaxCacheMbDesc')} />
      </tr>
      <tr>
        <td><code>allow_paths</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docs.configuration.optAllowPathsDesc')} />
      </tr>
      <tr>
        <td><code>shadow_mode</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td>Transparently intercept native Read/Grep/Shell calls via hooks and route through lean-ctx. Logs to <code>~/.lean-ctx/shadow.log</code></td>
      </tr>
      <tr>
        <td><code>shell_hook_disabled</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docs.configuration.optShellHookDisabledDesc')} />
      </tr>
      <tr>
        <td><code>update_check_disabled</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docs.configuration.optUpdateCheckDisabledDesc')} />
      </tr>
      <tr>
        <td><code>graph_index_max_files</code></td>
        <td>u64</td>
        <td><code>0</code> (unlimited)</td>
        <td set:html={t('docs.configuration.optGraphIndexMaxFilesDesc')} />
      </tr>
      <tr>
        <td><code>sandbox_level</code></td>
        <td>u8</td>
        <td><code>0</code></td>
        <td set:html={t('docs.configuration.optSandboxLevelDesc')} />
      </tr>
      <tr>
        <td><code>shell_allowlist</code></td>
        <td>list</td>
        <td><code>[]</code></td>
        <td set:html={t('docs.configuration.optShellAllowlistDesc')} />
      </tr>
      <tr>
        <td><code>no_degrade</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docs.configuration.optNoDegradeDesc')} />
      </tr>
      <tr>
        <td><code>allow_auto_reroot</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docs.configuration.optAllowAutoRerootDesc')} />
      </tr>
      <tr>
        <td><code>agent_token_budget</code></td>
        <td>usize</td>
        <td><code>0</code></td>
        <td set:html={t('docs.configuration.optAgentTokenBudgetDesc')} />
      </tr>
      <tr>
        <td><code>reference_results</code></td>
        <td>bool</td>
        <td><code>false</code></td>
        <td set:html={t('docs.configuration.optReferenceResultsDesc')} />
      </tr>
      <tr>
        <td><code>[archive]</code></td>
        <td>table</td>
        <td>-</td>
        <td set:html={t('docs.configuration.optArchiveTableDesc')} />
      </tr>
      <tr>
        <td><code>[cloud]</code></td>
        <td>table</td>
        <td>-</td>
        <td set:html={t('docs.configuration.optCloudTableDesc')} />
      </tr>
      <tr>
        <td><code>[proxy]</code></td>
        <td>table</td>
        <td>-</td>
        <td set:html={t('docs.configuration.optProxyTableDesc')} />
      </tr>
      <tr>
        <td><code>[memory]</code></td>
        <td>table</td>
        <td>-</td>
        <td set:html={t('docs.configuration.optMemoryTableDesc')} />
      </tr>
      <tr>
        <td><code>[secret_detection]</code></td>
        <td>table</td>
        <td>-</td>
        <td set:html={t('docs.configuration.optSecretDetectionTableDesc')} />
      </tr>
      <tr>
        <td><code>[boundary_policy]</code></td>
        <td>table</td>
        <td>-</td>
        <td set:html={t('docs.configuration.optBoundaryPolicyTableDesc')} />
      </tr>
      <tr>
        <td><code>bypass_hints</code></td>
        <td>string</td>
        <td><code>"gentle"</code></td>
        <td set:html={t('docs.configuration.optBypassHintsDesc')} />
      </tr>
      <tr>
        <td><code>[loop_detection]</code></td>
        <td>table</td>
        <td>-</td>
        <td set:html={t('docs.configuration.optLoopDetectionTableDesc')} />
      </tr>
      <tr>
        <td><code>memory_cleanup</code></td>
        <td>string</td>
        <td><code>"aggressive"</code></td>
        <td set:html={t('docs.configuration.optMemoryCleanupDesc')} />
      </tr>
      <tr>
        <td><code>shell_activation</code></td>
        <td>string</td>
        <td><code>"always"</code></td>
        <td set:html={t('docs.configuration.optShellActivationDesc')} />
      </tr>
      <tr>
        <td><code>max_ram_percent</code></td>
        <td>u8</td>
        <td><code>5</code></td>
        <td set:html={t('docs.configuration.optMaxRamPercentDesc')} />
      </tr>
      <tr>
        <td><code>savings_footer</code></td>
        <td>string</td>
        <td><code>"auto"</code></td>
        <td set:html={t('docs.configuration.optSavingsFooterDesc')} />
      </tr>
      <tr>
        <td><code>rules_injection</code> <span class="text-xs text-muted">v3.7.4</span></td>
        <td>string</td>
        <td><code>"shared"</code></td>
        <td>How lean-ctx delivers its tool-mapping rules to shared-instruction-file agents (Claude Code, Codex, OpenCode, Gemini CLI). <code>"shared"</code> writes a marker-delimited block into <code>CLAUDE.md</code> / <code>AGENTS.md</code> / <code>GEMINI.md</code>. <code>"dedicated"</code> <strong>never edits those files</strong> — it uses each agent's own config-driven, fully-removable auto-load path plus a lean-ctx-owned rules file. Switching back, and <code>lean-ctx uninstall</code>, reverse every registration cleanly.</td>
      </tr>
      <tr>
        <td><code>permission_inheritance</code> <span class="text-xs text-muted">v3.7.4</span></td>
        <td>string</td>
        <td><code>"off"</code></td>
        <td>When <code>"on"</code>, lean-ctx mirrors the host IDE's permission rules onto its own tools so <code>ctx_shell</code>/<code>ctx_execute</code> honor your <code>bash</code> rules, <code>ctx_read</code> honors <code>read</code>, etc. (v1: OpenCode <code>opencode.json</code>, global + project merged). <code>deny</code> blocks, <code>ask</code> holds the call back with an actionable message, <code>allow</code> proceeds. Read-only and runtime-only — lean-ctx never writes your <code>permission</code> block; default <code>"off"</code> adds zero hot-path cost.</td>
      </tr>
    </tbody>
  </table>

  <hr />

  <h2 id="simplified-configuration">{t('docs.configuration.simplifiedConfigTitle')} <span class="text-xs font-normal text-muted ml-2">v3.6.18</span></h2>
  <p set:html={t('docs.configuration.simplifiedConfigDesc')} />

  <table>
    <thead>
      <tr><th>{t('docs.configuration.thSetting')}</th><th>{t('docs.configuration.thEffect')}</th><th>{t('docs.configuration.thScale')}</th></tr>
