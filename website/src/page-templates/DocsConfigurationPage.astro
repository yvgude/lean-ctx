      </tr>
      <tr>
        <td><code>memory_profile</code></td>
        <td set:html={t('docs.configuration.simplifiedMemoryProfileEffect')} />
        <td><code>low</code> (64MB) / <code>balanced</code> (128MB) / <code>performance</code> (512MB)</td>
      </tr>
    </tbody>
  </table>

  <p set:html={t('docs.configuration.simplifiedConfigShowNote')} />

  <pre><code># Example: 2GB disk budget → facts=800, patterns=200, episodes=2000, procedures=400
max_disk_mb = 2000
compression_level = "Standard"
max_staleness_days = 30</code></pre>

  <hr />

