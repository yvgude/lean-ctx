      </tr>
      <tr>
        <td><code>compression_level</code></td>
        <td set:html={t('docs.configuration.simplifiedCompressionEffect')} />
        <td><code>Off</code> / <code>Lite</code> / <code>Standard</code> / <code>Max</code></td>
      </tr>
      <tr>
        <td><code>max_ram_percent</code></td>
        <td set:html={t('docs.configuration.simplifiedMaxRamEffect')} />
