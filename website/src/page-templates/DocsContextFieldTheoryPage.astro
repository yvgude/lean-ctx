---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: t('cft.heroLabel'),
    items: [
      { label: t('docs.common.overview'), href: lp('/docs/context-field-theory') },
      { label: t('cft.phiSectionTitle'), href: lp('/docs/context-field-theory') + '#phi' },
      { label: t('cft.ledgerSectionTitle'), href: lp('/docs/context-field-theory') + '#ledger' },
      { label: t('cft.handlesSectionTitle'), href: lp('/docs/context-field-theory') + '#handles' },
      { label: t('cft.overlaysSectionTitle'), href: lp('/docs/context-field-theory') + '#overlays' },
      { label: t('cft.compilerSectionTitle'), href: lp('/docs/context-field-theory') + '#compiler' },
      { label: t('cft.policySectionTitle'), href: lp('/docs/context-field-theory') + '#policies' },
      { label: t('cft.cockpitSectionTitle'), href: lp('/docs/context-field-theory') + '#cockpit' },
      { label: t('cft.cliSectionTitle'), href: lp('/docs/context-field-theory') + '#cli' },
    ],
  },
  {
    title: t('docs.common.related'),
    items: [
      { label: t('pillar.intelligence.title'), href: lp('/context-os/intelligence') },
      { label: t('pillar.governance.title'), href: lp('/context-os/governance') },
      { label: t('nav.docs.configuration'), href: lp('/docs/configuration') },
    ],
  },
];
---

<DocsLayout title={t('cft.metaTitle')} description={t('cft.metaDesc')} sidebar={sidebar}>

  <p set:html={t('cft.heroDesc')} />

  <h2 id="phi">{t('cft.phiSectionTitle')}</h2>
  <p>{t('cft.phiSectionDesc')}</p>

  <div style="margin: 1.5rem 0; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.5rem; overflow-x: auto;">
    <code style="font-size: 0.875rem; color: var(--color-accent); white-space: nowrap;">
      Φ(i,t) = w_R · R(i,t) + w_S · S(i) + w_G · G(i,t) + w_H · H(i) − w_C · C(i,v) − w_D · D(i, selected)
    </code>
  </div>

  <table>
    <thead>
      <tr><th>Factor</th><th>Description</th></tr>
    </thead>
    <tbody>
      <tr><td><code>R(i,t)</code></td><td>{t('cft.phiDetailR')}</td></tr>
      <tr><td><code>S(i)</code></td><td>{t('cft.phiDetailS')}</td></tr>
      <tr><td><code>G(i,t)</code></td><td>{t('cft.phiDetailG')}</td></tr>
      <tr><td><code>H(i)</code></td><td>{t('cft.phiDetailH')}</td></tr>
      <tr><td><code>C(i,v)</code></td><td>{t('cft.phiDetailC')}</td></tr>
      <tr><td><code>D(i,S)</code></td><td>{t('cft.phiDetailD')}</td></tr>
    </tbody>
  </table>

  <h2 id="ledger">{t('cft.ledgerSectionTitle')}</h2>
  <p>{t('cft.ledgerSectionDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> {t('cft.ledgerExample')}
  </div>

  <h2 id="handles">{t('cft.handlesSectionTitle')}</h2>
  <p>{t('cft.handlesSectionDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> {t('cft.handlesExample')}
  </div>

  <h2 id="overlays">{t('cft.overlaysSectionTitle')}</h2>
  <p>{t('cft.overlaysSectionDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> {t('cft.overlaysExample')}
  </div>

  <h2 id="compiler">{t('cft.compilerSectionTitle')}</h2>
  <p>{t('cft.compilerSectionDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> {t('cft.compilerExample')}
  </div>

  <h2 id="policies">{t('cft.policySectionTitle')}</h2>
  <p>{t('cft.policySectionDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> {t('cft.policyExample')}
  </div>

  <h2 id="cockpit">{t('cft.cockpitSectionTitle')}</h2>
  <p>{t('cft.cockpitSectionDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> {t('cft.cockpitExample')}
  </div>

  <h2 id="cli">{t('cft.cliSectionTitle')}</h2>
  <p>{t('cft.cliSectionDesc')}</p>

  <table>
    <thead>
      <tr><th>Command</th><th>Description</th></tr>
    </thead>
    <tbody>
      <tr><td><code>{t('cft.cliCmd1')}</code></td><td>{t('cft.cliCmd1Desc')}</td></tr>
      <tr><td><code>{t('cft.cliCmd2')}</code></td><td>{t('cft.cliCmd2Desc')}</td></tr>
      <tr><td><code>{t('cft.cliCmd3')}</code></td><td>{t('cft.cliCmd3Desc')}</td></tr>
      <tr><td><code>{t('cft.cliCmd4')}</code></td><td>{t('cft.cliCmd4Desc')}</td></tr>
      <tr><td><code>{t('cft.cliCmd5')}</code></td><td>{t('cft.cliCmd5Desc')}</td></tr>
      <tr><td><code>{t('cft.cliCmd6')}</code></td><td>{t('cft.cliCmd6Desc')}</td></tr>
      <tr><td><code>{t('cft.cliCmd7')}</code></td><td>{t('cft.cliCmd7Desc')}</td></tr>
      <tr><td><code>{t('cft.cliCmd8')}</code></td><td>{t('cft.cliCmd8Desc')}</td></tr>
    </tbody>
  </table>

  <div style="margin-top: 2rem; padding: 1.5rem; background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface)); border: 1px solid var(--color-accent); border-radius: 0.5rem;">
    <h3 style="margin: 0 0 0.75rem 0; color: var(--color-text-bright);">{t('cft.ctaTitle')}</h3>
    <p style="margin: 0 0 1rem 0; color: var(--color-muted);">{t('cft.ctaDesc')}</p>
    <a href={lp('/docs/getting-started')} style="color: var(--color-accent); font-weight: 600; text-decoration: none;">
      {t('nav.getStarted')} →
    </a>
  </div>

</DocsLayout>
