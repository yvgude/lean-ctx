---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { contextOsPillars } from '../lib/contextOsIa';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const title = t('nav.product');
const description =
  'LeanCTX as a Context OS is organized into five pillars: I/O, Orchestration, Memory, Verification, and Delivery.';
---

<DocsLayout title={title} description={description}>
  <div class="docs-content">
    <section>
      <h2>Pillars</h2>
      <p class="lead">Start with the pillar that matches your current bottleneck, then expand from there.</p>
      <div class="grid md:grid-cols-2" style="gap: 1rem;">
        {contextOsPillars.map((p) => (
          <a href={lp(p.href)} class="card group" style="padding: 1.25rem; text-decoration: none;">
            <h3 class="font-display fluid-h3 font-semibold text-text-bright mb-2">{t(p.labelKey)}</h3>
            {p.descriptionKey && (
              <p class="fluid-sm text-muted leading-relaxed" style="margin: 0;">
                {t(p.descriptionKey)}
              </p>
            )}
            <div class="mt-4 inline-flex items-center gap-2 text-accent font-medium">
              {t('common.learnMore')}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</DocsLayout>

