---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { contextOsPillars } from '../lib/contextOsIa';

export interface Props {
  pillarHref: string;
}

const { pillarHref } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const pillar = contextOsPillars.find((p) => p.href === pillarHref);
if (!pillar) {
  throw new Error(`Unknown Context OS pillar href: ${pillarHref}`);
}

const title = t(pillar.labelKey);
const description = pillar.descriptionKey ? t(pillar.descriptionKey) : undefined;

type Link = { href: string; labelKey?: string; label?: string; descKey?: string; desc?: string };

const linksByPillar: Record<string, Link[]> = {
  '/docs/context-io': [
    { href: '/mcp-server', labelKey: 'nav.product.contextServer', descKey: 'nav.product.contextServerDesc' },
    { href: '/shell-hook', labelKey: 'nav.product.shellHook', descKey: 'nav.product.shellHookDesc' },
    { href: '/docs/concepts/read-modes', labelKey: 'docs.sidebarConceptReadModes' },
    { href: '/docs/concepts/caching', labelKey: 'docs.sidebarConceptCaching' },
    { href: '/docs/tools/core', label: 'Core Tools' },
    { href: '/docs/cli-reference', labelKey: 'docs.sidebarCliReference' },
    { href: '/docs/verification', labelKey: 'docs.sidebarVerification', descKey: 'nav.docs.verificationDesc' },
    { href: '/docs/replayability', labelKey: 'docs.sidebarReplayability', descKey: 'nav.docs.replayabilityDesc' },
  ],
  '/docs/context-orchestration': [
    { href: '/docs/profiles', labelKey: 'nav.docs.profiles', descKey: 'nav.docs.profilesDesc' },
    { href: '/docs/cep', label: 'CEP (Cognitive Efficiency Protocol)' },
    { href: '/docs/intelligence-layer', labelKey: 'docs.sidebarIntelligenceLayer' },
    { href: '/docs/tools/workflow', label: 'Workflow Tools' },
    { href: '/docs/observability', labelKey: 'nav.docs.observability', descKey: 'nav.docs.observabilityDesc' },
    { href: '/docs/verification', labelKey: 'docs.sidebarVerification', descKey: 'nav.docs.verificationDesc' },
    { href: '/docs/replayability', labelKey: 'docs.sidebarReplayability', descKey: 'nav.docs.replayabilityDesc' },
  ],
  '/docs/context-memory': [
    { href: '/docs/ccp', label: 'CCP (Context Continuity Protocol)' },
    { href: '/docs/tools/memory', label: 'Memory & Multi-Agent Tools' },
    { href: '/docs/graph', labelKey: 'nav.docs.graph', descKey: 'nav.docs.graphDesc' },
    { href: '/docs/team-server', labelKey: 'nav.docs.teamServer', descKey: 'nav.docs.teamServerDesc' },
    { href: '/docs/concepts/multi-agent', labelKey: 'docs.sidebarConceptMultiAgent' },
    { href: '/docs/replayability', labelKey: 'docs.sidebarReplayability', descKey: 'nav.docs.replayabilityDesc' },
    { href: '/trust', labelKey: 'nav.trust', descKey: 'trust.metaDescription' },
  ],
  '/docs/context-verification': [
    { href: '/trust', labelKey: 'nav.trust', descKey: 'trust.metaDescription' },
    { href: '/docs/verification', labelKey: 'docs.sidebarVerification', descKey: 'nav.docs.verificationDesc' },
    { href: '/docs/replayability', labelKey: 'docs.sidebarReplayability', descKey: 'nav.docs.replayabilityDesc' },
    { href: '/safety', labelKey: 'nav.product.safety', descKey: 'nav.product.safetyDesc' },
    { href: '/docs/observability', labelKey: 'nav.docs.observability', descKey: 'nav.docs.observabilityDesc' },
  ],
  '/docs/context-delivery': [
    { href: '/docs/ide-setup', labelKey: 'nav.docs.ideSetup', descKey: 'nav.docs.ideSetupDesc' },
    { href: '/docs/remote-setup', labelKey: 'nav.docs.remoteSetup', descKey: 'nav.docs.remoteSetupDesc' },
    { href: '/docs/cli-reference', labelKey: 'docs.sidebarCliReference' },
    { href: '/docs/http-mcp', label: 'HTTP MCP', desc: 'Contract for /v1/manifest, /v1/tools, /v1/tools/call + auth/limits.' },
    { href: '/docs/contracts', label: 'Contracts & Versioning', desc: 'Versioning policy + compatibility matrix for contracts and integrations.' },
    { href: '/docs/tools', labelKey: 'docs.sidebarToolApi' },
    { href: '/docs/team-server', labelKey: 'nav.docs.teamServer', descKey: 'nav.docs.teamServerDesc' },
    { href: '/docs/agent-harness', labelKey: 'nav.docs.agentHarness', descKey: 'nav.docs.agentHarnessDesc' },
    { href: '/docs/verification', labelKey: 'docs.sidebarVerification', descKey: 'nav.docs.verificationDesc' },
    { href: '/docs/quick-reference#cookbook', labelKey: 'artifacts.cookbookTitle', descKey: 'artifacts.cookbookDesc' },
  ],
};

const links = linksByPillar[pillarHref] ?? [];
---

<DocsLayout title={title} description={description}>
  <div class="docs-content">
    <section>
      <h2>Recommended next pages</h2>
      <p class="lead">
        These are the highest-signal entrypoints for this pillar. Each link is a real surface area you can adopt in
        production.
      </p>
      <div class="grid md:grid-cols-2" style="gap: 1rem;">
        {links.map((l) => (
          <a href={lp(l.href)} class="card group" style="padding: 1.25rem; text-decoration: none;">
            <h3 class="font-display fluid-h3 font-semibold text-text-bright mb-2">
              {l.labelKey ? t(l.labelKey) : l.label}
            </h3>
            {(l.descKey || l.desc) && (
              <p class="fluid-sm text-muted leading-relaxed" style="margin: 0;">
                {l.descKey ? t(l.descKey) : l.desc}
              </p>
            )}
            <div class="mt-4 inline-flex items-center gap-2 text-accent font-medium">
              {t('common.learnMore')}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</DocsLayout>

