---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: t('contextPkg.metaTitle').replace(' — LeanCTX', ''),
    items: [
      { label: t('docs.common.overview'), href: lp('/docs/context-packages') },
      { label: t('contextPkg.layersTitle'), href: lp('/docs/context-packages') + '#layers' },
      { label: t('contextPkg.cliTitle'), href: lp('/docs/context-packages') + '#cli' },
      { label: t('contextPkg.autoLoadTitle'), href: lp('/docs/context-packages') + '#auto-load' },
      { label: t('contextPkg.integrityTitle'), href: lp('/docs/context-packages') + '#integrity' },
      { label: t('contextPkg.integrationTitle'), href: lp('/docs/context-packages') + '#integration' },
    ],
  },
  {
    title: t('docs.common.related'),
    items: [
      { label: t('cft.heroLabel'), href: lp('/docs/context-field-theory') },
      { label: t('pillar.memory.title'), href: lp('/context-os/memory') },
      { label: t('docs.sidebarCliRef'), href: lp('/docs/cli-reference') },
    ],
  },
];

const layers = [
  { name: t('contextPkg.layerKnowledge'), desc: t('contextPkg.layerKnowledgeDesc'), tone: 'accent' },
  { name: t('contextPkg.layerGraph'),     desc: t('contextPkg.layerGraphDesc'),     tone: 'accent-2' },
  { name: t('contextPkg.layerSession'),   desc: t('contextPkg.layerSessionDesc'),   tone: 'accent-3' },
  { name: t('contextPkg.layerPatterns'),  desc: t('contextPkg.layerPatternsDesc'),  tone: 'accent' },
  { name: t('contextPkg.layerGotchas'),   desc: t('contextPkg.layerGotchasDesc'),   tone: 'accent-2' },
];

const commands = [
  { cmd: t('contextPkg.cliCreate'),   desc: t('contextPkg.cliCreateDesc') },
  { cmd: t('contextPkg.cliList'),     desc: t('contextPkg.cliListDesc') },
  { cmd: t('contextPkg.cliInfo'),     desc: t('contextPkg.cliInfoDesc') },
  { cmd: t('contextPkg.cliExport'),   desc: t('contextPkg.cliExportDesc') },
  { cmd: t('contextPkg.cliImport'),   desc: t('contextPkg.cliImportDesc') },
  { cmd: t('contextPkg.cliInstall'),  desc: t('contextPkg.cliInstallDesc') },
  { cmd: t('contextPkg.cliRemove'),   desc: t('contextPkg.cliRemoveDesc') },
  { cmd: t('contextPkg.cliAutoLoad'), desc: t('contextPkg.cliAutoLoadDesc') },
];
---

<DocsLayout title={t('contextPkg.metaTitle')} description={t('contextPkg.metaDesc')} sidebar={sidebar}>

  <p set:html={t('contextPkg.heroDesc')} />

  <h2 id="layers">{t('contextPkg.layersTitle')}</h2>
  <p>{t('contextPkg.layersDesc')}</p>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; margin: 1.5rem 0;">
    {layers.map(l => (
      <div style={`padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.5rem; border-left: 3px solid var(--color-${l.tone});`}>
        <h4 style="margin: 0 0 0.5rem 0; color: var(--color-text-bright); font-size: 0.9375rem;">{l.name}</h4>
        <p style="margin: 0; color: var(--color-muted); font-size: 0.8125rem; line-height: 1.6;">{l.desc}</p>
      </div>
    ))}
  </div>

  <h2 id="cli">{t('contextPkg.cliTitle')}</h2>
  <p>{t('contextPkg.cliDesc')}</p>

  <table>
    <thead>
      <tr><th>Command</th><th>Description</th></tr>
    </thead>
    <tbody>
      {commands.map(c => (
        <tr>
          <td><code style="font-size: 0.8125rem; white-space: nowrap;">{c.cmd}</code></td>
          <td>{c.desc}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h3>Quick Start</h3>
  <pre><code># Create a package with knowledge and graph layers
lean-ctx pack create --name my-project-ctx --layers knowledge,graph

# Export for sharing
lean-ctx pack export my-project-ctx -o my-project-ctx.lctxpkg

# Teammate imports and installs
lean-ctx pack import my-project-ctx.lctxpkg
lean-ctx pack install my-project-ctx

# Enable auto-load for future sessions
lean-ctx pack auto-load my-project-ctx on</code></pre>

  <h2 id="auto-load">{t('contextPkg.autoLoadTitle')}</h2>
  <p>{t('contextPkg.autoLoadDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> lean-ctx pack auto-load my-pkg on
  </div>

  <h2 id="integrity">{t('contextPkg.integrityTitle')}</h2>
  <p>{t('contextPkg.integrityDesc')}</p>

  <div style="margin: 1rem 0; padding: 0.75rem 1rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.375rem; font-family: var(--font-mono); font-size: 0.8125rem;">
    <span style="color: var(--color-accent);">$</span> lean-ctx pack info my-pkg
  </div>

  <h2 id="integration">{t('contextPkg.integrationTitle')}</h2>
  <p>{t('contextPkg.integrationDesc')}</p>

  <div style="margin-top: 2rem; padding: 1.5rem; background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface)); border: 1px solid var(--color-accent); border-radius: 0.5rem;">
    <h3 style="margin: 0 0 0.75rem 0; color: var(--color-text-bright);">{t('contextPkg.ctaTitle')}</h3>
    <p style="margin: 0 0 1rem 0; color: var(--color-muted);">{t('contextPkg.ctaDesc')}</p>
    <a href={lp('/docs/getting-started')} style="color: var(--color-accent); font-weight: 600; text-decoration: none;">
      {t('nav.getStarted')} →
    </a>
  </div>

</DocsLayout>
