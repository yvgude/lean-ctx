---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: 'Contracts',
    items: [
      { label: 'Versioning policy', href: lp('/docs/contracts') },
      { label: 'Compatibility matrix', href: lp('/docs/contracts') + '#compatibility' },
      { label: 'CI gates', href: lp('/docs/contracts') + '#ci-gates' },
      { label: 'Related contract docs', href: lp('/docs/contracts') + '#related' },
    ],
  },
  {
    title: 'Related',
    items: [
      { label: 'Compatibility', href: lp('/compatibility') },
      { label: 'HTTP MCP', href: lp('/docs/http-mcp') },
      { label: 'Team Server', href: lp('/docs/team-server') },
      { label: 'Verification', href: lp('/docs/verification') },
    ],
  },
];
---

<DocsLayout title="Contracts & Versioning" description="Contract versioning policy + compatibility matrix for LeanCTX integrations." sidebar={sidebar}>
  <div class="docs-content">
    <h1>Contracts &amp; Versioning Policy</h1>
    <p class="lead">
      LeanCTX is infrastructure. Contracts are stable promises across tool schemas, proof artifacts, and delivery APIs.
      When a breaking change happens, we bump the relevant contract version and ship migration notes.
    </p>

    <section>
      <h2>Rules</h2>
      <ul>
        <li><strong>Schema versions are integers</strong> (<code>schema_version</code> / <code>contract_version</code>).</li>
        <li><strong>Breaking change</strong> ⇒ bump version + add migration notes.</li>
        <li><strong>Non-breaking change</strong> ⇒ keep version (additive changes are documented).</li>
      </ul>
      <p class="text-sm text-muted">
        Current versions and the compatibility mapping are tracked in <code>CONTRACTS.md</code> in the repo.
      </p>
      <p>
        <a href="https://github.com/yvgude/lean-ctx/blob/main/CONTRACTS.md" target="_blank" rel="noopener">
          View `CONTRACTS.md` on GitHub
        </a>
      </p>
    </section>

    <section id="compatibility">
      <h2>Compatibility matrix</h2>
      <p>
        For external tools, compatibility is expressed in terms of <strong>LeanCTX contracts</strong> (not external tool versions).
        The public website view is on <a href={lp('/compatibility')}>Compatibility</a>.
      </p>
    </section>

    <section id="ci-gates">
      <h2>CI gates</h2>
      <ul>
        <li><code>contracts_md_up_to_date</code> ensures <code>CONTRACTS.md</code> stays in sync with runtime versions.</li>
        <li><code>manifest_drift_gate</code> ensures the tool manifest stays SSOT (runtime → generated docs).</li>
      </ul>
    </section>

    <section id="related">
      <h2>Related contract docs</h2>
      <ul>
        <li><a href={lp('/docs/http-mcp')}>HTTP MCP Contract v1</a></li>
        <li><a href={lp('/docs/team-server')}>Team Server Contract v1</a></li>
      </ul>
    </section>
  </div>
</DocsLayout>

