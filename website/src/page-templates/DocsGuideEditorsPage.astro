    ],
  },
  {
    title: 'Tier 1 — Full Setup',
    compact: true,
    items: [
      { label: 'Claude Code', href: lp('/docs/guides/editor-integrations') + '#claude-code' },
      { label: 'Cursor', href: lp('/docs/guides/editor-integrations') + '#cursor' },
      { label: 'Codex CLI', href: lp('/docs/guides/editor-integrations') + '#codex' },
      { label: 'Gemini CLI', href: lp('/docs/guides/editor-integrations') + '#gemini' },
      { label: 'GitHub Copilot', href: lp('/docs/guides/editor-integrations') + '#copilot' },
    ],
  },
  {
    title: 'Tier 2 — Quick Setup',
    compact: true,
    items: [
      { label: 'Windsurf', href: lp('/docs/guides/editor-integrations') + '#windsurf' },
      { label: 'Cline / Roo Code', href: lp('/docs/guides/editor-integrations') + '#cline-roo' },
      { label: 'Pi Coding Agent', href: lp('/docs/guides/editor-integrations') + '#pi' },
      { label: 'AWS Kiro', href: lp('/docs/guides/editor-integrations') + '#kiro' },
      { label: 'Zed', href: lp('/docs/guides/editor-integrations') + '#zed' },
    ],
  },
  {
    title: 'Tier 3 — Minimal Setup',
    compact: true,
    items: [
      { label: 'Hermes Agent', href: lp('/docs/guides/editor-integrations') + '#hermes' },
      { label: 'Amp', href: lp('/docs/guides/editor-integrations') + '#amp' },
      { label: 'JetBrains IDEs', href: lp('/docs/guides/editor-integrations') + '#jetbrains' },
      { label: 'OpenCode', href: lp('/docs/guides/editor-integrations') + '#opencode' },
