      { label: 'Dashboard Tabs', href: lp('/docs/guides/observatory') + '#tabs' },
      { label: 'Configuration', href: lp('/docs/guides/observatory') + '#configuration' },
      { label: 'Security', href: lp('/docs/guides/observatory') + '#security' },
    ],
  },
  {
    title: 'REST API',
    items: [
      { label: 'Stats & Analytics', href: lp('/docs/guides/observatory') + '#api-stats' },
      { label: 'Agents & Knowledge', href: lp('/docs/guides/observatory') + '#api-agents' },
      { label: 'Graphs & Heatmaps', href: lp('/docs/guides/observatory') + '#api-graphs' },
      { label: 'Search & Symbols', href: lp('/docs/guides/observatory') + '#api-search' },
      { label: 'Session & Pipeline', href: lp('/docs/guides/observatory') + '#api-session' },
      { label: 'System', href: lp('/docs/guides/observatory') + '#api-system' },
    ],
  },
  {
    title: 'Cloud Dashboard',
    items: [
      { label: 'Cloud Overview', href: lp('/docs/guides/observatory') + '#cloud' },
      { label: 'Local vs Cloud', href: lp('/docs/guides/observatory') + '#local-vs-cloud' },
    ],
  },
  {
    title: 'Related',
    items: [
      { label: 'Analytics & Dashboard', href: lp('/docs/analytics') },
