---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: t('docsObs.sidebarObservability'),
    items: [
      { label: t('docsObs.sidebarOverview'), href: lp('/docs/observability') },
      { label: t('docsObs.sidebarSlos'), href: lp('/docs/observability') + '#slos' },
      { label: t('docsObs.sidebarAnomaly'), href: lp('/docs/observability') + '#anomaly' },
      { label: t('docsObs.sidebarPrometheus'), href: lp('/docs/observability') + '#prometheus' },
      { label: t('docsObs.sidebarDiffing'), href: lp('/docs/observability') + '#diffing' },
    ],
  },
  {
    title: t('docsObs.sidebarRelated'),
    items: [
      { label: t('docsObs.sidebarHarness'), href: lp('/docs/agent-harness') },
      { label: t('docsObs.sidebarProfiles'), href: lp('/docs/profiles') },
      { label: t('docsObs.sidebarDashboard'), href: lp('/dashboard') },
    ],
  },
];
---

<DocsLayout title={t('docsObs.title')} sidebar={sidebar}>
  <div class="docs-content">
    <h1>{t('docsObs.heading')}</h1>
    <p class="lead">{t('docsObs.intro')}</p>

    <!-- SLOs -->
    <section id="slos">
      <h2>{t('docsObs.slosTitle')}</h2>
      <p>{t('docsObs.slosDesc')}</p>

      <h3>{t('docsObs.slosConfigTitle')}</h3>
      <p>{t('docsObs.slosConfigDesc')}</p>
      <pre><code class="language-toml">{`# .lean-ctx/slos.toml
[[slo]]
name = "context_budget"
metric = "session_context_tokens"
threshold = 50000
action = "warn"  # warn | throttle | block

[[slo]]
name = "cost_per_session"
metric = "session_cost_usd"
threshold = 1.00
action = "throttle"

[[slo]]
name = "compression_efficiency"
metric = "compression_ratio"
threshold = 0.3
direction = "min"
action = "warn"`}</code></pre>

      <h3>{t('docsObs.slosMetricsTitle')}</h3>
      <div class="metrics-grid">
        <div class="metric-card">
          <code>session_context_tokens</code>
          <p>{t('docsObs.metricTokens')}</p>
        </div>
        <div class="metric-card">
          <code>session_cost_usd</code>
          <p>{t('docsObs.metricCost')}</p>
        </div>
        <div class="metric-card">
          <code>compression_ratio</code>
          <p>{t('docsObs.metricCompression')}</p>
        </div>
        <div class="metric-card">
          <code>shell_invocations</code>
          <p>{t('docsObs.metricShell')}</p>
        </div>
        <div class="metric-card">
          <code>tool_calls_total</code>
          <p>{t('docsObs.metricToolCalls')}</p>
        </div>
      </div>

      <h3>{t('docsObs.slosActionsTitle')}</h3>
      <table class="actions-table">
        <thead><tr><th>{t('docsObs.actionCol')}</th><th>{t('docsObs.behaviorCol')}</th></tr></thead>
        <tbody>
          <tr><td><code>warn</code></td><td>{t('docsObs.actionWarn')}</td></tr>
          <tr><td><code>throttle</code></td><td>{t('docsObs.actionThrottle')}</td></tr>
          <tr><td><code>block</code></td><td>{t('docsObs.actionBlock')}</td></tr>
        </tbody>
      </table>

      <h3>{t('docsObs.slosMcpTitle')}</h3>
      <pre><code class="language-text">{`ctx_session slo              # Show current SLO status
ctx_session slo reload       # Reload SLOs from disk
ctx_session slo history      # Show violation history
ctx_session slo clear        # Clear violation log`}</code></pre>
    </section>

    <!-- Anomaly Detection -->
    <section id="anomaly">
      <h2>{t('docsObs.anomalyTitle')}</h2>
      <p>{t('docsObs.anomalyDesc')}</p>

      <h3>{t('docsObs.anomalyHowTitle')}</h3>
      <p>{t('docsObs.anomalyHow')}</p>
      <ul>
        <li>{t('docsObs.anomalyPoint1')}</li>
        <li>{t('docsObs.anomalyPoint2')}</li>
        <li>{t('docsObs.anomalyPoint3')}</li>
      </ul>

      <h3>{t('docsObs.anomalyMetricsTitle')}</h3>
      <p>{t('docsObs.anomalyMetrics')}</p>
    </section>

    <!-- Prometheus -->
    <section id="prometheus">
      <h2>{t('docsObs.promTitle')}</h2>
      <p>{t('docsObs.promDesc')}</p>

      <h3>{t('docsObs.promEndpointTitle')}</h3>
      <pre><code class="language-bash">{`# Start dashboard with metrics endpoint
lean-ctx dashboard

# Scrape metrics
curl http://localhost:3000/metrics`}</code></pre>

      <h3>{t('docsObs.promMetricsTitle')}</h3>
      <pre><code class="language-text">{`lean_ctx_tokens_saved_total
lean_ctx_compression_ratio
lean_ctx_session_cost_usd
lean_ctx_tool_calls_total
lean_ctx_slo_violations_total
lean_ctx_cache_hit_rate
lean_ctx_anomalies_total
lean_ctx_session_uptime_seconds`}</code></pre>

      <h3>{t('docsObs.promGrafanaTitle')}</h3>
      <p>{t('docsObs.promGrafana')}</p>

      <h3>{t('docsObs.promPrivacyTitle')}</h3>
      <p>{t('docsObs.promPrivacy')}</p>
    </section>

    <!-- Session Diffing -->
    <section id="diffing">
      <h2>{t('docsObs.diffTitle')}</h2>
      <p>{t('docsObs.diffDesc')}</p>

      <h3>{t('docsObs.diffUsageTitle')}</h3>
      <pre><code class="language-text">{`# Compare two sessions (MCP)
ctx_session diff <session_a> <session_b>
ctx_session diff <session_a> <session_b> json

# List available sessions
ctx_session list`}</code></pre>

      <h3>{t('docsObs.diffOutputTitle')}</h3>
      <p>{t('docsObs.diffOutput')}</p>
      <ul>
        <li>{t('docsObs.diffPoint1')}</li>
        <li>{t('docsObs.diffPoint2')}</li>
        <li>{t('docsObs.diffPoint3')}</li>
        <li>{t('docsObs.diffPoint4')}</li>
      </ul>
    </section>

    <!-- API -->
    <section id="api">
      <h2>{t('docsObs.apiTitle')}</h2>
      <table class="actions-table">
        <thead><tr><th>{t('docsObs.endpointCol')}</th><th>{t('docsObs.descCol')}</th></tr></thead>
        <tbody>
          <tr><td><code>/api/slos</code></td><td>{t('docsObs.apiSlos')}</td></tr>
          <tr><td><code>/api/anomaly</code></td><td>{t('docsObs.apiAnomaly')}</td></tr>
          <tr><td><code>/metrics</code></td><td>{t('docsObs.apiMetrics')}</td></tr>
          <tr><td><code>/api/events</code></td><td>{t('docsObs.apiEvents')}</td></tr>
        </tbody>
      </table>
    </section>
  </div>
</DocsLayout>

<style>
  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1rem 0 2rem;
  }
  .metric-card {
    background: var(--bg-card, #1a1a2e);
    border: 1px solid var(--border-color, #333);
    border-radius: 8px;
    padding: 1rem;
  }
  .metric-card code {
    color: var(--accent, #00d4ff);
    font-size: 0.9rem;
  }
  .metric-card p {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .actions-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .actions-table th,
  .actions-table td {
    border: 1px solid var(--border-color, #333);
    padding: 0.5rem 1rem;
    text-align: left;
  }
  .actions-table th {
    background: var(--bg-card, #1a1a2e);
  }
  section {
    margin-bottom: 3rem;
  }
  pre {
    background: var(--bg-code, #0d0d1a);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
</style>
