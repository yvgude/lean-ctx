---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: t('docsProfiles.sidebarProfiles'),
    items: [
      { label: t('docsProfiles.sidebarOverview'), href: lp('/docs/profiles') },
      { label: t('docsProfiles.sidebarBuiltin'), href: lp('/docs/profiles') + '#built-in' },
      { label: t('docsProfiles.sidebarActivation'), href: lp('/docs/profiles') + '#activation' },
      { label: t('docsProfiles.sidebarCustom'), href: lp('/docs/profiles') + '#custom' },
      { label: t('docsProfiles.sidebarInheritance'), href: lp('/docs/profiles') + '#inheritance' },
      { label: t('docsProfiles.sidebarSchema'), href: lp('/docs/profiles') + '#schema' },
      { label: t('docsProfiles.sidebarCli'), href: lp('/docs/profiles') + '#cli' },
      { label: t('docsProfiles.sidebarResolution'), href: lp('/docs/profiles') + '#resolution' },
    ],
  },
  {
    title: t('docsProfiles.sidebarRelated'),
    items: [
      { label: t('docsProfiles.sidebarConfiguration'), href: lp('/docs/configuration') },
      { label: t('docsProfiles.sidebarTools'), href: lp('/docs/tools') },
    ],
  },
];
---

<DocsLayout title={t('docsProfiles.title')} description={t('docsProfiles.description')} sidebar={sidebar}>

  <p set:html={t('docsProfiles.intro')} />

  <hr />

  <h2 set:html={t('docsProfiles.whatTitle')} />
  <p set:html={t('docsProfiles.whatDesc')} />

  <hr />

  <h2 id="built-in" set:html={t('docsProfiles.builtinTitle')} />
  <p set:html={t('docsProfiles.builtinDesc')} />

  <div class="profiles-grid">
    <div class="profile-card">
      <h3>{t('docsProfiles.explorationName')}</h3>
      <p set:html={t('docsProfiles.explorationDesc')} />
    </div>
    <div class="profile-card">
      <h3>{t('docsProfiles.bugfixName')}</h3>
      <p set:html={t('docsProfiles.bugfixDesc')} />
    </div>
    <div class="profile-card">
      <h3>{t('docsProfiles.hotfixName')}</h3>
      <p set:html={t('docsProfiles.hotfixDesc')} />
    </div>
    <div class="profile-card">
      <h3>{t('docsProfiles.ciDebugName')}</h3>
      <p set:html={t('docsProfiles.ciDebugDesc')} />
    </div>
    <div class="profile-card">
      <h3>{t('docsProfiles.reviewName')}</h3>
      <p set:html={t('docsProfiles.reviewDesc')} />
    </div>
  </div>

  <hr />

  <h2 id="activation" set:html={t('docsProfiles.activateTitle')} />
  <p set:html={t('docsProfiles.activateEnv')} />
  <pre><code>export LEAN_CTX_PROFILE=hotfix</code></pre>
  <p set:html={t('docsProfiles.activateCli')} />
  <pre><code>lean-ctx profile set hotfix</code></pre>
  <p set:html={t('docsProfiles.activateMcp')} />
  <pre><code>ctx_session action=profile value=hotfix</code></pre>

  <hr />

  <h2 id="custom" set:html={t('docsProfiles.customTitle')} />
  <p set:html={t('docsProfiles.customDesc')} />
  <pre><code>{`# .lean-ctx/profiles/my-team.toml
[profile]
name = "my-team"
inherits = "exploration"
description = "Team defaults with lower budget"

[read]
default_mode = "map"
max_tokens_per_file = 40000

[budget]
max_context_tokens = 120000
max_cost_usd = 2.0`}</code></pre>
  <p set:html={t('docsProfiles.customCli')} />
  <pre><code>lean-ctx profile create my-team --from exploration</code></pre>

  <hr />

  <h2 id="inheritance" set:html={t('docsProfiles.inheritTitle')} />
  <p set:html={t('docsProfiles.inheritDesc')} />
  <pre><code>{`# .lean-ctx/profiles/strict-review.toml
[profile]
name = "strict-review"
inherits = "review"

[budget]
max_context_tokens = 80000
max_cost_usd = 1.0`}</code></pre>

  <hr />

  <h2 id="schema" set:html={t('docsProfiles.schemaTitle')} />
  <p set:html={t('docsProfiles.schemaDesc')} />
  <ul>
    <li set:html={t('docsProfiles.schemaMeta')} />
    <li set:html={t('docsProfiles.schemaRead')} />
    <li set:html={t('docsProfiles.schemaCompression')} />
    <li set:html={t('docsProfiles.schemaBudget')} />
    <li set:html={t('docsProfiles.schemaPipeline')} />
    <li set:html={t('docsProfiles.schemaAutonomy')} />
  </ul>

  <hr />

  <h2 id="cli" set:html={t('docsProfiles.cliTitle')} />
  <ul>
    <li set:html={t('docsProfiles.cliList')} />
    <li set:html={t('docsProfiles.cliShow')} />
    <li set:html={t('docsProfiles.cliDiff')} />
    <li set:html={t('docsProfiles.cliCreate')} />
    <li set:html={t('docsProfiles.cliSet')} />
  </ul>

  <hr />

  <h2 id="resolution" set:html={t('docsProfiles.resolutionTitle')} />
  <p set:html={t('docsProfiles.resolutionDesc')} />
  <ol>
    <li set:html={t('docsProfiles.resolution1')} />
    <li set:html={t('docsProfiles.resolution2')} />
    <li set:html={t('docsProfiles.resolution3')} />
    <li set:html={t('docsProfiles.resolution4')} />
  </ol>

</DocsLayout>

<style>
  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .profile-card {
    border: 1px solid var(--border-color, #333);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--card-bg, rgba(255,255,255,0.03));
  }
  .profile-card h3 {
    margin: 0 0 0.5rem;
    font-family: monospace;
    color: var(--accent-color, #4fc3f7);
  }
  .profile-card p {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }
</style>
