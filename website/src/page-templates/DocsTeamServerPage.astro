---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const sidebar = [
  {
    title: t('docsTeam.sidebarTeam'),
    items: [
      { label: t('docsTeam.sidebarOverview'), href: lp('/docs/team-server') },
      { label: t('docsTeam.sidebarQuickstart'), href: lp('/docs/team-server') + '#quickstart' },
      { label: t('docsTeam.sidebarConfig'), href: lp('/docs/team-server') + '#configuration' },
      { label: t('docsTeam.sidebarTokens'), href: lp('/docs/team-server') + '#tokens' },
      { label: t('docsTeam.sidebarWorkspaces'), href: lp('/docs/team-server') + '#workspaces' },
      { label: t('docsTeam.sidebarAuth'), href: lp('/docs/team-server') + '#authentication' },
      { label: t('docsTeam.sidebarRateLimits'), href: lp('/docs/team-server') + '#rate-limits' },
      { label: t('docsTeam.sidebarAudit'), href: lp('/docs/team-server') + '#audit-log' },
      { label: t('docsTeam.sidebarSync'), href: lp('/docs/team-server') + '#sync' },
    ],
  },
  {
    title: t('docsTeam.sidebarRelated'),
    items: [
      { label: t('docsTeam.sidebarRemoteSetup'), href: lp('/docs/remote-setup') },
      { label: t('docsTeam.sidebarSafety'), href: lp('/safety') },
      { label: t('docsTeam.sidebarTools'), href: lp('/docs/tools') },
    ],
  },
];
---

<DocsLayout title={t('docsTeam.title')} sidebar={sidebar}>
  <div class="docs-content">
    <h1>{t('docsTeam.heading')}</h1>
    <p class="lead">{t('docsTeam.intro')}</p>

    <!-- Quick Start -->
    <section id="quickstart">
      <h2>{t('docsTeam.quickstartTitle')}</h2>
      <p>{t('docsTeam.quickstartDesc')}</p>

      <h3>{t('docsTeam.step1Title')}</h3>
      <pre><code class="language-json">{`{
  "host": "0.0.0.0",
  "port": 9877,
  "defaultWorkspaceId": "main",
  "auditLogPath": "/var/log/lean-ctx/audit.log",
  "workspaces": [
    {
      "id": "main",
      "label": "Main Project",
      "root": "/home/team/project"
    }
  ],
  "tokens": []
}`}</code></pre>

      <h3>{t('docsTeam.step2Title')}</h3>
      <pre><code class="language-bash">{`# Generate a token with specific scopes
TOKEN="$(lean-ctx team token create \\
  --config team.json \\
  --id dev-alice \\
  --scopes search,graph,artifacts,index
)"

# TOKEN is the Bearer token (printed once; config stores only sha256Hex).`}</code></pre>

      <h3>{t('docsTeam.step3Title')}</h3>
      <pre><code class="language-bash">{`lean-ctx team serve --config team.json

# Team Server - 0.0.0.0:9877
# Workspaces: 1 (main)
# Tokens: 1 active
# Tools: 56 available`}</code></pre>

      <h3>{t('docsTeam.step4Title')}</h3>
      <pre><code class="language-bash">{`# Health check
curl http://your-server:9877/health

# List available tools (requires token)
curl -H "Authorization: Bearer $TOKEN" \\
  http://your-server:9877/v1/manifest

# Call a tool (workspace defaults to defaultWorkspaceId)
curl -X POST -H "Authorization: Bearer $TOKEN" \\
  -H "Content-Type: application/json" \\
  -d '{"name":"ctx_tree","arguments":{"path":".","depth":2}}' \\
  http://your-server:9877/v1/tools/call

# Call a tool in a specific workspace (header overrides default)
curl -X POST -H "Authorization: Bearer $TOKEN" \\
  -H "x-leanctx-workspace: main" \\
  -H "Content-Type: application/json" \\
  -d '{"name":"ctx_read","arguments":{"path":"README.md","mode":"signatures"}}' \\
  http://your-server:9877/v1/tools/call`}</code></pre>
    </section>

    <!-- Configuration -->
    <section id="configuration">
      <h2>{t('docsTeam.configTitle')}</h2>
      <p>{t('docsTeam.configDesc')}</p>

      <table class="config-table">
        <thead><tr><th>{t('docsTeam.fieldCol')}</th><th>{t('docsTeam.typeCol')}</th><th>{t('docsTeam.descCol')}</th><th>{t('docsTeam.defaultCol')}</th></tr></thead>
        <tbody>
          <tr><td><code>host</code></td><td>string</td><td>{t('docsTeam.cfgHost')}</td><td><code>127.0.0.1</code></td></tr>
          <tr><td><code>port</code></td><td>u16</td><td>{t('docsTeam.cfgPort')}</td><td><code>9877</code></td></tr>
          <tr><td><code>defaultWorkspaceId</code></td><td>string</td><td>{t('docsTeam.cfgDefaultWs')}</td><td>-</td></tr>
          <tr><td><code>auditLogPath</code></td><td>path</td><td>{t('docsTeam.cfgAudit')}</td><td>-</td></tr>
          <tr><td><code>disableHostCheck</code></td><td>bool</td><td>{t('docsTeam.cfgHostCheck')}</td><td><code>false</code></td></tr>
          <tr><td><code>allowedHosts</code></td><td>string[]</td><td>{t('docsTeam.cfgAllowedHosts')}</td><td><code>[]</code></td></tr>
          <tr><td><code>maxBodyBytes</code></td><td>usize</td><td>{t('docsTeam.cfgMaxBody')}</td><td><code>2097152</code></td></tr>
          <tr><td><code>maxConcurrency</code></td><td>usize</td><td>{t('docsTeam.cfgConcurrency')}</td><td><code>32</code></td></tr>
          <tr><td><code>maxRps</code></td><td>u32</td><td>{t('docsTeam.cfgMaxRps')}</td><td><code>50</code></td></tr>
          <tr><td><code>rateBurst</code></td><td>u32</td><td>{t('docsTeam.cfgBurst')}</td><td><code>100</code></td></tr>
          <tr><td><code>requestTimeoutMs</code></td><td>u64</td><td>{t('docsTeam.cfgTimeout')}</td><td><code>30000</code></td></tr>
        </tbody>
      </table>
    </section>

    <!-- Tokens -->
    <section id="tokens">
      <h2>{t('docsTeam.tokensTitle')}</h2>
      <p>{t('docsTeam.tokensDesc')}</p>

      <h3>{t('docsTeam.scopesTitle')}</h3>
      <table class="config-table">
        <thead><tr><th>{t('docsTeam.scopeCol')}</th><th>{t('docsTeam.descCol')}</th></tr></thead>
        <tbody>
          <tr><td><code>Search</code></td><td>{t('docsTeam.scopeSearch')}</td></tr>
          <tr><td><code>Graph</code></td><td>{t('docsTeam.scopeGraph')}</td></tr>
          <tr><td><code>Artifacts</code></td><td>{t('docsTeam.scopeArtifacts')}</td></tr>
          <tr><td><code>Index</code></td><td>{t('docsTeam.scopeIndex')}</td></tr>
        </tbody>
      </table>

      <pre><code class="language-bash">{`# Create token with all scopes
lean-ctx team token create \\
  --config team.json \\
  --id ci-bot \\
  --scopes search,graph,artifacts,index

# Create read-only token (search + graph only)
lean-ctx team token create \\
  --config team.json \\
  --id reviewer \\
  --scopes search,graph`}</code></pre>
      <p>{t('docsTeam.tokensNote')}</p>
    </section>

    <!-- Workspaces -->
    <section id="workspaces">
      <h2>{t('docsTeam.workspacesTitle')}</h2>
      <p>{t('docsTeam.workspacesDesc')}</p>
      <pre><code class="language-json">{`{
  "workspaces": [
    { "id": "frontend", "label": "React Frontend", "root": "/srv/frontend" },
    { "id": "backend", "label": "Rust API", "root": "/srv/backend" },
    { "id": "infra", "label": "Infrastructure", "root": "/srv/infra" }
  ],
  "defaultWorkspaceId": "frontend"
}`}</code></pre>
      <p>{t('docsTeam.workspacesSwitch')}</p>
    </section>

    <!-- Authentication -->
    <section id="authentication">
      <h2>{t('docsTeam.authTitle')}</h2>
      <p>{t('docsTeam.authDesc')}</p>
      <pre><code class="language-text">{`Authorization: Bearer $TOKEN

# Without token → HTTP 401 + JSON {error_code:"unauthorized", ...}
# Invalid token → HTTP 401 + JSON {error_code:"unauthorized", ...}
# Valid token, wrong scope → HTTP 403 + JSON {error_code:"scope_denied", ...}`}</code></pre>
    </section>

    <!-- Rate Limits -->
    <section id="rate-limits">
      <h2>{t('docsTeam.rateLimitsTitle')}</h2>
      <p>{t('docsTeam.rateLimitsDesc')}</p>
      <pre><code class="language-json">{`{
  "maxRps": 50,
  "rateBurst": 100,
  "maxConcurrency": 32,
  "requestTimeoutMs": 30000,
  "maxBodyBytes": 2097152
}`}</code></pre>
    </section>

    <!-- Audit Log -->
    <section id="audit-log">
      <h2>{t('docsTeam.auditTitle')}</h2>
      <p>{t('docsTeam.auditDesc')}</p>
      <p class="text-sm text-muted">
        Audit log is <strong>JSONL</strong> (one JSON object per line). It never stores raw tool arguments — only
        <code>argumentsMd5</code> of a canonicalized JSON representation.
      </p>
      <pre><code class="language-bash">{`# Inspect the latest audit entry
tail -n 1 /var/log/lean-ctx/audit.log | jq .

# Keys per entry:
# ts, tokenId, workspaceId, tool, method, allowed, deniedReason, argumentsMd5`}</code></pre>
    </section>

    <!-- Sync -->
    <section id="sync">
      <h2>{t('docsTeam.syncTitle')}</h2>
      <p>{t('docsTeam.syncDesc')}</p>
      <pre><code class="language-bash">{`# Sync all workspaces (git fetch + rebuild indexes)
lean-ctx team sync --config team.json

# Sync a specific workspace
lean-ctx team sync --config team.json --workspace backend`}</code></pre>
    </section>
  </div>
</DocsLayout>

<style>
  .lead { font-size: 1.15rem; color: var(--text-muted); margin-bottom: 2rem; }
  .config-table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  .config-table th, .config-table td { border: 1px solid var(--border-color, #333); padding: 0.5rem 1rem; text-align: left; font-size: 0.875rem; }
  .config-table th { background: var(--bg-card, #1a1a2e); font-weight: 600; }
  section { margin-bottom: 3rem; }
  pre { background: var(--bg-code, #0d0d1a); border-radius: 8px; padding: 1rem; overflow-x: auto; font-size: 0.85rem; }
</style>
