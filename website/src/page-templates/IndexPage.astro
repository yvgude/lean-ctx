---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalChrome from '../components/TerminalChrome.astro';
import TerminalStepper from '../components/TerminalStepper.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getMcpManifest } from '../lib/mcpManifest';
import '../styles/index.css';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();

const toolNames = manifest.tools.granular.map((x) => x.name);
const pickTool = (preferred: string, fallbackIndex: number) =>
  (toolNames.includes(preferred) ? preferred : toolNames[fallbackIndex] ?? toolNames[0]);

const tRead = pickTool('ctx_read', 0);
const tSearch = pickTool('ctx_search', 1);
const tShell = pickTool('ctx_shell', 2);
const tMulti = pickTool('ctx_multi_read', 3);

const stepperSteps = [
  {
    number: '01',
    title: t('index.dim1Title'),
    description: t('index.dim1Desc'),
    terminalTitle: `${tRead} — map`,
    terminalLines: [
      `${tRead}({ path: "website/src/lib/mcpManifest.ts", mode: "map" })`,
      `→ exports: getMcpManifest(), getGranularTools(), getToolEnrichments()`,
      `→ tools.granular: ${manifest.counts.granular}`,
    ],
  },
  {
    number: '02',
    title: t('index.dim2Title'),
    description: t('index.dim2Desc'),
    terminalTitle: `${tSearch} — regex`,
    terminalLines: [
      `${tSearch}({ pattern: "getMcpManifest", path: "website/src" })`,
      `→ matches: website/src/page-templates/IndexPage.astro, website/src/lib/mcpManifest.ts`,
      `→ open minimal context, not the whole repo`,
    ],
  },
  {
    number: '03',
    title: t('index.dim3Title'),
    description: t('index.dim3Desc'),
    terminalTitle: `${tShell} — build`,
    terminalLines: [
      `${tShell}({ command: "npx astro build", cwd: "website" })`,
      `→ dist/_astro/* updated`,
      `→ ready for deploy branch`,
    ],
  },
  {
    number: '04',
    title: t('index.dim4Title'),
    description: t('index.dim4Desc'),
    terminalTitle: `${tMulti} — batch`,
    terminalLines: [
      `${tMulti}({ paths: ["website/src/page-templates/IndexPage.astro", "website/src/styles/global.css"], mode: "diff" })`,
      `→ dedup + compress + return only relevant deltas`,
      `→ stable review loop`,
    ],
  },
];

---

<BaseLayout title={t('index.title')} description={t('index.metaDesc')}>

<!-- ═══════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════ -->
<section class="section-hero hero-split" data-hero>
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div class="hero-copy">
        <div class="animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
          <span class="kicker-pill">{t('index.heroLabel')}</span>
        </div>
        <h1 class="font-display fluid-display font-bold text-text-bright animate-entrance">
          {t('index.heroTitle')}<br/>
          <span class="italic-accent">{t('index.heroTitleHighlight')}</span>
        </h1>

        <p class="fluid-body text-muted animate-entrance stagger-1" style="margin-top: clamp(1.25rem, 1rem + 1vw, 2rem); max-width: 46rem;">
          {t('index.heroDescription')}
        </p>

        <div class="flex flex-wrap items-center animate-entrance stagger-2" style="margin-top: clamp(1.5rem, 1rem + 1.25vw, 2.5rem); gap: clamp(0.5rem, 0.375rem + 0.5vw, 1rem);">
          <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center gap-2" style="padding: clamp(0.625rem, 0.5rem + 0.3vw, 0.875rem) clamp(0.875rem, 0.75rem + 0.4vw, 1.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);">
            {t('nav.getStarted')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="btn-outline inline-flex items-center gap-2" style="padding: clamp(0.625rem, 0.5rem + 0.3vw, 0.875rem) clamp(0.875rem, 0.75rem + 0.4vw, 1.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            {t('index.starOnGithub')}
          </a>
          <a href={`${lp('/docs/quick-reference')}#cookbook`} class="btn-outline inline-flex items-center gap-2" style="padding: clamp(0.625rem, 0.5rem + 0.3vw, 0.875rem) clamp(0.875rem, 0.75rem + 0.4vw, 1.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
            {t('index.cookbookCta')}
          </a>
        </div>

        <div class="hero-proof animate-entrance stagger-3" style="margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
          <div class="hero-proof-item">
            <span class="hero-proof-number font-display" id="install-count">—</span>
            <span class="hero-proof-label">{t('index.heroProofInstalls')}</span>
          </div>
          <div class="hero-proof-divider"></div>
          <div class="hero-proof-item">
            <span class="hero-proof-number font-display" id="github-stars-hero">—</span>
            <span class="hero-proof-label">{t('index.heroProofStars')}</span>
          </div>
          <div class="hero-proof-divider"></div>
          <div class="hero-proof-item">
            <span class="hero-proof-number font-display">{manifest.counts.granular}</span>
            <span class="hero-proof-label">{t('index.heroProofTools')}</span>
          </div>
        </div>
      </div>

      <div class="hero-terminal-wrap animate-entrance stagger-2">
        <div class="hero-terminal" data-hero-terminal>
          <div class="terminal-header flex items-center gap-2 px-5 py-3">
            <span class="terminal-dot bg-[#ff5f57]"></span>
            <span class="terminal-dot bg-[#febc2e]"></span>
            <span class="terminal-dot bg-[#28c840]"></span>
            <span class="ml-3 text-xs text-muted font-mono">lean-ctx session</span>
          </div>
          <div class="terminal-body px-5 py-5 font-mono" style="font-size: clamp(0.65rem, 0.6rem + 0.12vw, 0.8125rem); line-height: 1.8;">
            <div class="hero-term-line" data-term-line="0">
              <span class="text-muted">$</span> <span class="text-accent">{tRead}</span>(<span class="text-text-bright">{{ path: "src/lib/mcpManifest.ts", mode: "map" }}</span>)
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="1">
              <span class="text-muted">→</span> <span class="text-text">exports: getMcpManifest(), getGranularTools()</span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="2">
              <span class="text-muted">→</span> <span class="text-text">tools.granular: <span class="text-accent font-semibold">{manifest.counts.granular}</span></span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="3">
              <span class="text-muted">→</span> <span class="text-text">cached — <span class="text-accent">13 tokens</span> on re-read</span>
            </div>
            <div class="hero-term-spacer" data-term-line="4"></div>
            <div class="hero-term-line" data-term-line="5">
              <span class="text-muted">$</span> <span class="text-accent">{tSearch}</span>(<span class="text-text-bright">{{ pattern: "getMcpManifest", path: "src" }}</span>)
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="6">
              <span class="text-muted">→</span> <span class="text-text">2 matches in <span class="text-accent">0.8ms</span></span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="7">
              <span class="text-muted">→</span> <span class="text-text">mcpManifest.ts:14, IndexPage.astro:12</span>
            </div>
            <div class="hero-term-spacer" data-term-line="8"></div>
            <div class="hero-term-line" data-term-line="9">
              <span class="text-muted">$</span> <span class="text-accent">{tShell}</span>(<span class="text-text-bright">{{ command: "npx astro build" }}</span>)
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="10">
              <span class="text-muted">→</span> <span class="text-text">1294 pages built in <span class="text-accent">3.6s</span></span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="11">
              <span class="text-muted">→</span> <span class="text-text">compressed output: <span class="text-accent">847 → 42 tokens</span></span>
            </div>
            <div class="hero-term-cursor" data-term-line="12"></div>
          </div>
        </div>
        <div class="hero-install animate-entrance stagger-4">
          <code class="hero-install-code" id="hero-install-cmd">curl -fsSL https://leanctx.com/install | sh</code>
          <button class="hero-copy-btn" type="button" data-copy="curl -fsSL https://leanctx.com/install | sh" aria-label="Copy install command">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     PROBLEM / WHAT HAPPENS
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="kicker-pill">{t('index.problemLabel')}</span>
        </div>
        <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('index.problemTitle')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem); max-width: 52rem;">
          {t('index.problemDesc')}
        </p>
        <p class="fluid-body text-text-bright font-medium animate-entrance stagger-2" style="margin: 0; max-width: 52rem; font-style: italic;">
          {t('index.problemQuote')}
        </p>
      </div>

      <div class="animate-entrance stagger-3">
        <div class="compare-grid is-stacked">
      <div class="compare-card">
        <div class="compare-header compare-header--bad">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          {t('index.withoutLeanCtx')}
        </div>
        <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-muted">{t('index.without1')}</span></div>
          <div class="compare-line"><span class="text-danger">{t('index.without2')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('index.without3')}</span></div>
          <div class="compare-line"><span class="text-danger">{t('index.without4')}</span></div>
        </div>
      </div>
      <div class="compare-card">
        <div class="compare-header compare-header--good">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {t('index.withLeanCtx')}
        </div>
        <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-muted">{t('index.with1')}</span></div>
          <div class="compare-line"><span class="text-accent">{t('index.with2')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('index.with3')}</span></div>
          <div class="compare-line"><span class="text-accent">{t('index.with4')}</span></div>
        </div>
      </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     LIVE PREVIEW: How it works
     ═══════════════════════════════════════════════════════ -->
<section class="section-y" data-preview style="--pp: 0;">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
          <span class="kicker-pill">{t('index.previewLabel')}</span>
        </div>
        <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('index.previewTitle')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); max-width: 48rem;">
          {t('index.previewDesc')}
        </p>

        <TerminalChrome
          title={`${tRead} — map`}
          chromeClass="animate-entrance stagger-3"
          bodyStyle="font-size: clamp(0.72rem, 0.68rem + 0.1vw, 0.8125rem); line-height: 1.75;"
        >
          <div>
            <span class="text-accent">{t('index.demoAiCallsLabel')}</span>{' '}
            <span class="text-text-bright">{`${tRead}({ path: "src/lib/mcpManifest.ts", mode: "map" })`}</span>
          </div>
          <div class="term-divider"></div>
          <div><span class="text-muted">schema_version</span> <span class="text-text-bright">{manifest.schema_version}</span></div>
          <div><span class="text-muted">tools.granular</span> <span class="text-accent font-semibold">{manifest.counts.granular}</span></div>
          <div><span class="text-muted">tools.unified</span> <span class="text-text-bright">{manifest.counts.unified}</span></div>
          <div><span class="text-muted">read_modes</span> <span class="text-text-bright">{manifest.read_modes.count}</span></div>
          <div class="term-divider"></div>
          <div class="text-muted">modes: <span class="text-text">{manifest.read_modes.modes.slice(0, 6).join(', ')}</span></div>
        </TerminalChrome>
      </div>

      <div class="preview-info-stack animate-entrance stagger-2">
        <div class="preview-info-card">
          <span class="preview-info-number text-accent font-display">{manifest.counts.granular}</span>
          <span class="preview-info-title text-text-bright font-semibold">Granular Tools</span>
          <span class="preview-info-desc text-muted fluid-sm">{t('index.previewDesc')}</span>
        </div>
        <div class="preview-info-card">
          <span class="preview-info-number text-text-bright font-display">{manifest.read_modes.count}</span>
          <span class="preview-info-title text-text-bright font-semibold">Read Modes</span>
          <span class="preview-info-desc text-muted fluid-sm">{manifest.read_modes.modes.slice(0, 8).join(', ')}</span>
        </div>
        <div class="preview-info-card">
          <span class="preview-info-number text-accent font-display">v{manifest.schema_version}</span>
          <span class="preview-info-title text-text-bright font-semibold">Schema</span>
          <span class="preview-info-desc text-muted fluid-sm">Deterministic manifest with full tool metadata, categories, and enrichment data.</span>
        </div>
        <div class="preview-info-card">
          <span class="preview-info-number text-text-bright font-display">~13</span>
          <span class="preview-info-title text-text-bright font-semibold">Re-read tokens</span>
          <span class="preview-info-desc text-muted fluid-sm">Cached reads return in ~13 tokens. No waste, no re-parsing.</span>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     WHAT IS LEANCTX
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="kicker-pill">{t('index.whatLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('index.whatTitle')} <span class="italic-accent">{t('index.whatTitleHighlight')}</span>
    </h2>

    <div class="grid md:grid-cols-3 animate-entrance stagger-2" style="gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);">
      <div class="what-card">
        <div class="what-icon" style="color: var(--color-accent);">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard1Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard1Desc')}</p>
      </div>

      <div class="what-card">
        <div class="what-icon" style="color: var(--color-accent-2);">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard2Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard2Desc')}</p>
      </div>

      <div class="what-card">
        <div class="what-icon" style="color: var(--color-accent-3);">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard3Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard3Desc')}</p>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     FOUR DIMENSIONS
     ═══════════════════════════════════════════════════════ -->
<TerminalStepper
  kicker={t('index.dimensionsLabel')}
  title={t('index.dimensionsTitle')}
  titleHighlight={t('index.dimensionsTitleHighlight')}
  steps={stepperSteps}
/>


<!-- ═══════════════════════════════════════════════════════
     NUMBERS STRIP
     ═══════════════════════════════════════════════════════ -->
<section class="section-y-sm">
  <div class="content-grid">
    <div class="stats-panels animate-entrance">
      <div class="stat-panel">
        <span class="stat-number text-accent">60–99%</span>
        <span class="stat-desc">{t('index.statsReduction')}</span>
      </div>
      <div class="stat-panel">
        <span class="stat-number">{manifest.counts.granular}</span>
        <span class="stat-desc">{t('index.statsTools')}</span>
      </div>
      <div class="stat-panel">
        <span class="stat-number">{manifest.read_modes.count}</span>
