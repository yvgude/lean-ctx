---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getMcpManifest } from '../lib/mcpManifest';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();

---

<BaseLayout title={t('index.title')} description={t('index.metaDesc')}>

<!-- ═══════════════════════════════════════════════════════
     1 · HERO — Riotters two-line statement
     ═══════════════════════════════════════════════════════ -->
<section class="section-hero relative">
  <div class="content-grid relative">
    <h1 class="font-display fluid-display font-bold text-text-bright animate-entrance" style="max-width: 60rem;">
      {t('index.heroTitle')}<br/>
      <span class="italic-accent">{t('index.heroTitleHighlight')}</span>
    </h1>

    <p class="fluid-body text-muted animate-entrance stagger-1" style="margin-top: clamp(1.5rem, 1rem + 1.5vw, 3rem); max-width: 38rem;">
      {t('index.heroDescription')}
    </p>

    <div class="flex flex-wrap items-center animate-entrance stagger-2" style="margin-top: clamp(2rem, 1.5rem + 2vw, 4rem); gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center gap-2.5" style="padding: 0.875rem 2rem; font-size: 0.9375rem;">
        {t('nav.getStarted')}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="btn-outline inline-flex items-center gap-2.5" style="padding: 0.875rem 2rem; font-size: 0.9375rem;">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        {t('index.starOnGithub')}
      </a>
      <a href={`${lp('/docs/quick-reference')}#cookbook`} class="btn-outline inline-flex items-center gap-2.5" style="padding: 0.875rem 2rem; font-size: 0.9375rem;">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
        {t('index.cookbookCta')}
      </a>
    </div>

    <div class="hero-install animate-entrance stagger-3">
      <code class="hero-install-code">curl -fsSL https://leanctx.com/install | sh</code>
    </div>

    <div class="hero-proof animate-entrance stagger-4">
      <div class="hero-proof-item">
        <span class="hero-proof-number font-display" id="install-count">—</span>
        <span class="hero-proof-label">{t('index.heroProofInstalls')}</span>
      </div>
      <span class="hero-proof-dot">·</span>
      <div class="hero-proof-item">
        <span class="hero-proof-number font-display" id="github-stars-hero">—</span>
        <span class="hero-proof-label">{t('index.heroProofStars')}</span>
      </div>
      <span class="hero-proof-dot">·</span>
      <div class="hero-proof-item">
        <span class="hero-proof-number font-display">{manifest.counts.granular}</span>
        <span class="hero-proof-label">{t('index.heroProofTools')}</span>
      </div>
      <span class="hero-proof-dot">·</span>
      <div class="hero-proof-item">
        <span class="hero-proof-number font-display">90+</span>
        <span class="hero-proof-label">{t('index.statsPatterns')}</span>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     2 · INTRO / TAGLINE
     ═══════════════════════════════════════════════════════ -->
<section class="section-y section-elevated">
  <div class="content-grid">
    <div class="animate-entrance" style="max-width: 48rem;">
      <p class="fluid-h2 font-display font-medium text-text-bright" style="line-height: 1.4;">
        {t('index.problemDesc')}
        <a href={lp('/docs/getting-started')} class="italic-accent hover:underline" style="text-decoration-color: rgba(52,211,153,0.3);">
          {t('index.problemQuote')}
        </a>
      </p>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     3 · TERMINAL SHOWCASE — Full-bleed demo
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('index.previewLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 48rem;">
      {t('index.previewTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 3vw, 6rem); max-width: 40rem;">
      {t('index.previewDesc')}
    </p>
  </div>

  <div class="content-grid-wide">
    <div class="grid lg:grid-cols-2 animate-entrance stagger-3" style="gap: clamp(1.25rem, 1rem + 0.5vw, 2rem);">
      <div class="terminal-chrome">
        <div class="terminal-header flex items-center gap-2 px-5 py-3">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="ml-3 text-xs text-muted font-mono">ctx_read — map mode</span>
        </div>
        <div class="terminal-body px-6 py-6 font-mono space-y-3" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem); line-height: 1.7;">
          <div>
            <span class="text-accent-2">{t('index.demoAiCallsLabel')}</span> <span class="text-text-bright">ctx_read("src/auth/service.ts", mode="map")</span>
          </div>
          <div class="term-divider"></div>
          <div><span class="text-muted">F7=service.ts 342L</span></div>
          <div><span class="text-accent">§ AuthService</span></div>
          <div class="pl-4"><span class="text-muted">deps:</span> <span class="text-text">jwt, bcrypt, prisma</span></div>
          <div class="pl-4"><span class="text-muted">exports:</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">login</span><span class="text-muted">(email: string, pwd: string) → Promise&lt;Token&gt;</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">register</span><span class="text-muted">(data: CreateUser) → Promise&lt;User&gt;</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">verify</span><span class="text-muted">(token: string) → Promise&lt;Payload&gt;</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">refresh</span><span class="text-muted">(rt: string) → Promise&lt;TokenPair&gt;</span></div>
          <div class="term-divider"></div>
          <div><span class="text-accent">342L → 48 tokens</span> <span class="text-muted">(98.6% saved)</span></div>
        </div>
      </div>

      <div class="terminal-chrome">
        <div class="terminal-header flex items-center gap-2 px-5 py-3">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="ml-3 text-xs text-muted font-mono">ctx_metrics — session dashboard</span>
        </div>
        <div class="terminal-body px-6 py-6 font-mono space-y-3" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem); line-height: 1.7;">
          <div class="flex justify-between">
            <span class="text-muted">SESSION v287</span>
            <span class="text-muted">42 min active</span>
          </div>
          <div class="term-divider"></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricToolCalls')}</span><span class="text-accent font-semibold">847</span></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricTokensSaved')}</span><span class="text-accent font-semibold">412,830</span></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricCacheHits')}</span><span class="text-accent-2 font-semibold">73%</span></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricAvgCompression')}</span><span class="text-accent-3 font-semibold">91.4%</span></div>
          <div class="term-divider"></div>
          <div class="metrics-row"><span class="text-muted">{t('index.demoMetricFilesCached')}</span><span class="text-text">23</span></div>
          <div class="metrics-row"><span class="text-muted">{t('index.demoMetricRereadCost')}</span><span class="text-text">~13 tok</span></div>
          <div class="metrics-row"><span class="text-muted">{t('index.demoMetricEstCostSaved')}</span><span class="text-accent font-semibold">$1.24</span></div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     4 · THREE PILLARS — What is LeanCTX
     ═══════════════════════════════════════════════════════ -->
<section class="section-y section-elevated">
  <div class="content-grid">
    <p class="fluid-label text-accent animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('index.whatLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('index.whatTitle')} <em class="italic-accent">{t('index.whatTitleHighlight')}</em>
    </h2>

    <div class="grid md:grid-cols-3 animate-entrance stagger-2" style="gap: clamp(1.25rem, 1rem + 1vw, 2rem);">
      <div class="pillar-card">
        <div class="pillar-pills">
          <span class="pill-tag">ctx_read</span>
          <span class="pill-tag">10 modes</span>
          <span class="pill-tag">caching</span>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard1Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard1Desc')}</p>
      </div>

      <div class="pillar-card">
        <div class="pillar-pills">
          <span class="pill-tag">ctx_shell</span>
          <span class="pill-tag">ctx_search</span>
          <span class="pill-tag">90+ patterns</span>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard2Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard2Desc')}</p>
      </div>

      <div class="pillar-card">
        <div class="pillar-pills">
          <span class="pill-tag">profiles</span>
          <span class="pill-tag">budgets</span>
          <span class="pill-tag">governance</span>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard3Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard3Desc')}</p>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     5 · PROCESS — Numbered steps (Riotters-style)
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('index.dimensionsLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('index.dimensionsTitle')} <em class="italic-accent">{t('index.dimensionsTitleHighlight')}</em>
    </h2>

    <div class="animate-entrance stagger-2" style="max-width: 48rem;">
      <div class="numbered-step">
        <span class="step-number">01</span>
        <div class="step-content">
          <h3>{t('index.dim1Title')}</h3>
          <p>{t('index.dim1Desc')}</p>
        </div>
      </div>
      <div class="numbered-step">
        <span class="step-number">02</span>
        <div class="step-content">
          <h3>{t('index.dim2Title')}</h3>
          <p>{t('index.dim2Desc')}</p>
        </div>
      </div>
      <div class="numbered-step">
        <span class="step-number">03</span>
        <div class="step-content">
          <h3>{t('index.dim3Title')}</h3>
          <p>{t('index.dim3Desc')}</p>
        </div>
      </div>
      <div class="numbered-step">
        <span class="step-number">04</span>
        <div class="step-content">
          <h3>{t('index.dim4Title')}</h3>
          <p>{t('index.dim4Desc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     6 · STATS — Big numbers, clean
     ═══════════════════════════════════════════════════════ -->
<section class="section-y-sm section-elevated">
  <div class="content-grid">
    <div class="stats-strip animate-entrance">
      <div class="stat-block">
        <span class="stat-big font-display text-accent">60–99%</span>
        <span class="stat-label">{t('index.statsReduction')}</span>
      </div>
      <div class="stat-block">
        <span class="stat-big font-display text-text-bright">{manifest.counts.granular}</span>
        <span class="stat-label">{t('index.statsTools')}</span>
      </div>
      <div class="stat-block">
        <span class="stat-big font-display text-text-bright">90+</span>
        <span class="stat-label">{t('index.statsPatterns')}</span>
      </div>
      <div class="stat-block">
        <span class="stat-big font-display text-accent">0</span>
        <span class="stat-label">{t('index.statsConfig')}</span>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     7 · ARCHITECTURE — Three layers
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('index.archLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('index.archTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 3vw, 6rem); max-width: 40rem;">
      {t('index.archDesc')}
    </p>

    <div class="grid md:grid-cols-3 animate-entrance stagger-3" style="gap: clamp(1px, 0.1vw, 1px);">
      <a href={lp('/mcp-server')} class="layer-card group">
        <div class="layer-icon" style="color: var(--color-accent);">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008V18m-3 0h.008v.008h-.008V18m-3 0h.008v.008h-.008V18"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1rem 0;">{t('index.archServerTitle')}</h3>
        <p class="fluid-sm text-muted leading-relaxed" style="margin-bottom: 2rem;">{t('index.archServerDesc')}</p>
        <span class="layer-link text-accent">
          {t('index.archServerLink')}
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>

      <a href={lp('/shell-hook')} class="layer-card group">
        <div class="layer-icon" style="color: var(--color-accent-2);">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1rem 0;">{t('index.archHookTitle')}</h3>
        <p class="fluid-sm text-muted leading-relaxed" style="margin-bottom: 2rem;">{t('index.archHookDesc')}</p>
        <span class="layer-link text-accent-2">
          {t('index.archHookLink')}
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>

      <a href={lp('/protocols')} class="layer-card group">
        <div class="layer-icon" style="color: var(--color-accent-3);">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1rem 0;">{t('index.archProtocolsTitle')}</h3>
        <p class="fluid-sm text-muted leading-relaxed" style="margin-bottom: 2rem;">{t('index.archProtocolsDesc')}</p>
        <span class="layer-link text-accent-3">
          {t('index.archProtocolsLink')}
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     8 · TESTIMONIALS — Horizontal scroller
     ═══════════════════════════════════════════════════════ -->
<section class="section-y section-elevated">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('index.testimonialLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(4rem, 3rem + 3vw, 6rem);">
      {t('index.testimonialTitle')}
    </h2>
  </div>

  <div class="content-grid-wide">
    <div class="testimonial-scroller animate-entrance stagger-2">
      <div class="testimonial-card">
        <p class="testimonial-quote">{t('index.testimonial1Text')}</p>
        <footer class="testimonial-attribution">
          <strong class="text-text-bright">Sebastian</strong>
          <span class="text-muted">TypeScript / React</span>
        </footer>
      </div>
      <div class="testimonial-card">
        <p class="testimonial-quote">{t('index.testimonial2Text')}</p>
        <footer class="testimonial-attribution">
          <strong class="text-text-bright">Marco</strong>
          <span class="text-muted">SaaS Builder</span>
        </footer>
      </div>
      <div class="testimonial-card">
        <p class="testimonial-quote">{t('index.testimonial3Text')}</p>
        <footer class="testimonial-attribution">
          <strong class="text-text-bright">Jay</strong>
          <span class="text-muted">AI Tools Enthusiast</span>
        </footer>
      </div>
      <div class="testimonial-card">
        <p class="testimonial-quote">{t('index.testimonial4Text')}</p>
        <footer class="testimonial-attribution">
          <strong class="text-text-bright">Erik</strong>
          <span class="text-muted">Platform Engineer</span>
        </footer>
      </div>
      <div class="testimonial-card">
        <p class="testimonial-quote">{t('index.testimonial5Text')}</p>
