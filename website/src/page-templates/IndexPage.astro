---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getMcpManifest } from '../lib/mcpManifest';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();

---

<BaseLayout title={t('index.title')} description={t('index.metaDesc')}>

<!-- ═══════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════ -->
<section class="section-hero relative">
  <div class="hero-glow"></div>
  <div class="content-grid relative">
    <div class="animate-entrance">
      <p class="fluid-label text-accent" style="margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 3rem);">
        {t('index.heroLabel')}
      </p>
    </div>

    <h1 class="font-display fluid-display font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem); max-width: 56rem;">
      {t('index.heroTitle')}<br/>
      <span class="gradient-text">{t('index.heroTitleHighlight')}</span>
    </h1>

    <p class="fluid-body text-muted animate-entrance stagger-2" style="margin-bottom: clamp(2rem, 1.5rem + 2vw, 4rem); max-width: 40rem;">
      {t('index.heroDescription')}
    </p>

    <div class="hero-proof animate-entrance stagger-3" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);">
      <div class="hero-proof-item">
        <span class="hero-proof-number font-display" id="install-count">—</span>
        <span class="hero-proof-label">{t('index.heroProofInstalls')}</span>
      </div>
      <div class="hero-proof-divider"></div>
      <div class="hero-proof-item">
        <span class="hero-proof-number font-display" id="github-stars-hero">—</span>
        <span class="hero-proof-label">{t('index.heroProofStars')}</span>
      </div>
      <div class="hero-proof-divider"></div>
      <div class="hero-proof-item">
        <span class="hero-proof-number font-display">{manifest.counts.granular}</span>
        <span class="hero-proof-label">{t('index.heroProofTools')}</span>
      </div>
    </div>

    <div class="flex flex-wrap items-center animate-entrance stagger-4" style="gap: clamp(0.875rem, 0.5rem + 0.75vw, 1.5rem);">
      <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center gap-2.5" style="padding: clamp(0.875rem, 0.7rem + 0.35vw, 1.125rem) clamp(1.75rem, 1.25rem + 1vw, 2.75rem); font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem);">
        {t('nav.getStarted')}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="btn-outline inline-flex items-center gap-2.5" style="padding: clamp(0.875rem, 0.7rem + 0.35vw, 1.125rem) clamp(1.75rem, 1.25rem + 1vw, 2.75rem); font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem);">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        {t('index.starOnGithub')}
      </a>
      <a href="https://discord.gg/pTHkG9Hew9" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-muted hover:text-text-bright transition-colors" style="font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem); font-weight: 500;">
        <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        {t('index.joinDiscord')}
      </a>
    </div>

    <div class="hero-install animate-entrance stagger-5">
      <code class="hero-install-code">curl -fsSL https://leanctx.com/install | sh</code>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     PROBLEM / WHAT HAPPENS
     ═══════════════════════════════════════════════════════ -->
<section class="section-y glow-section">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      {t('index.problemLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 48rem;">
      {t('index.problemTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem); max-width: 42rem;">
      {t('index.problemDesc')}
    </p>
    <p class="fluid-body text-text-bright font-medium animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 42rem; font-style: italic;">
      {t('index.problemQuote')}
    </p>

    <div class="grid md:grid-cols-2 animate-entrance stagger-3" style="gap: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <div class="compare-card">
        <div class="compare-header compare-header--bad">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          {t('index.withoutLeanCtx')}
        </div>
        <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-muted">{t('index.without1')}</span></div>
          <div class="compare-line"><span class="text-danger">{t('index.without2')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('index.without3')}</span></div>
          <div class="compare-line"><span class="text-danger">{t('index.without4')}</span></div>
        </div>
      </div>
      <div class="compare-card">
        <div class="compare-header compare-header--good">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {t('index.withLeanCtx')}
        </div>
        <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-muted">{t('index.with1')}</span></div>
          <div class="compare-line"><span class="text-accent">{t('index.with2')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('index.with3')}</span></div>
          <div class="compare-line"><span class="text-accent">{t('index.with4')}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     LIVE PREVIEW: Terminal + Dashboard
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      {t('index.previewLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 48rem;">
      {t('index.previewTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 42rem;">
      {t('index.previewDesc')}
    </p>

    <div class="grid lg:grid-cols-2 animate-entrance stagger-3" style="gap: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      <div class="terminal-chrome">
        <div class="terminal-header flex items-center gap-2 px-5 py-3">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="ml-3 text-xs text-muted font-mono">ctx_read — map mode</span>
        </div>
        <div class="terminal-body px-6 py-6 font-mono space-y-3" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem); line-height: 1.7;">
          <div>
            <span class="text-accent-2">{t('index.demoAiCallsLabel')}</span> <span class="text-text-bright">ctx_read("src/auth/service.ts", mode="map")</span>
          </div>
          <div class="term-divider"></div>
          <div><span class="text-muted">F7=service.ts 342L</span></div>
          <div><span class="text-accent">§ AuthService</span></div>
          <div class="pl-4"><span class="text-muted">deps:</span> <span class="text-text">jwt, bcrypt, prisma</span></div>
          <div class="pl-4"><span class="text-muted">exports:</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">login</span><span class="text-muted">(email: string, pwd: string) → Promise&lt;Token&gt;</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">register</span><span class="text-muted">(data: CreateUser) → Promise&lt;User&gt;</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">verify</span><span class="text-muted">(token: string) → Promise&lt;Payload&gt;</span></div>
          <div class="pl-8"><span class="text-accent-2-bright">λ</span> <span class="text-text-bright">refresh</span><span class="text-muted">(rt: string) → Promise&lt;TokenPair&gt;</span></div>
          <div class="term-divider"></div>
          <div><span class="text-accent">342L → 48 tokens</span> <span class="text-muted">(98.6% saved)</span></div>
        </div>
      </div>

      <div class="terminal-chrome">
        <div class="terminal-header flex items-center gap-2 px-5 py-3">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="ml-3 text-xs text-muted font-mono">ctx_metrics — session dashboard</span>
        </div>
        <div class="terminal-body px-6 py-6 font-mono space-y-3" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem); line-height: 1.7;">
          <div class="flex justify-between">
            <span class="text-muted">SESSION v287</span>
            <span class="text-muted">42 min active</span>
          </div>
          <div class="term-divider"></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricToolCalls')}</span><span class="text-accent font-semibold">847</span></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricTokensSaved')}</span><span class="text-accent font-semibold">412,830</span></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricCacheHits')}</span><span class="text-accent-2 font-semibold">73%</span></div>
          <div class="metrics-row"><span class="text-text-bright">{t('index.demoMetricAvgCompression')}</span><span class="text-accent-3 font-semibold">91.4%</span></div>
          <div class="term-divider"></div>
          <div class="metrics-row"><span class="text-muted">{t('index.demoMetricFilesCached')}</span><span class="text-text">23</span></div>
          <div class="metrics-row"><span class="text-muted">{t('index.demoMetricRereadCost')}</span><span class="text-text">~13 tok</span></div>
          <div class="metrics-row"><span class="text-muted">{t('index.demoMetricEstCostSaved')}</span><span class="text-accent font-semibold">$1.24</span></div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     WHAT IS LEANCTX
     ═══════════════════════════════════════════════════════ -->
<section class="section-y glow-section">
  <div class="content-grid">
    <p class="fluid-label text-accent animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      {t('index.whatLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('index.whatTitle')} <span class="gradient-text">{t('index.whatTitleHighlight')}</span>
    </h2>

    <div class="grid md:grid-cols-3 animate-entrance stagger-2" style="gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);">
      <div class="what-card">
        <div class="what-icon" style="color: var(--color-accent);">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard1Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard1Desc')}</p>
      </div>

      <div class="what-card">
        <div class="what-icon" style="color: var(--color-accent-2);">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard2Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard2Desc')}</p>
      </div>

      <div class="what-card">
        <div class="what-icon" style="color: var(--color-accent-3);">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/></svg>
        </div>
        <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 1.25rem 0 0.625rem;">{t('index.whatCard3Title')}</h3>
        <p class="fluid-sm text-muted leading-relaxed">{t('index.whatCard3Desc')}</p>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     FOUR DIMENSIONS
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      {t('index.dimensionsLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 48rem;">
      {t('index.dimensionsTitle')} <span class="gradient-text">{t('index.dimensionsTitleHighlight')}</span>
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 animate-entrance stagger-2" style="gap: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <div class="dimension-card">
        <div class="dimension-number">1</div>
        <h3 class="font-display fluid-body font-semibold text-text-bright" style="margin-bottom: 0.625rem;">{t('index.dim1Title')}</h3>
        <p class="text-muted" style="font-size: 0.875rem; line-height: 1.65;">{t('index.dim1Desc')}</p>
      </div>
      <div class="dimension-card">
        <div class="dimension-number">2</div>
        <h3 class="font-display fluid-body font-semibold text-text-bright" style="margin-bottom: 0.625rem;">{t('index.dim2Title')}</h3>
        <p class="text-muted" style="font-size: 0.875rem; line-height: 1.65;">{t('index.dim2Desc')}</p>
      </div>
      <div class="dimension-card">
        <div class="dimension-number">3</div>
        <h3 class="font-display fluid-body font-semibold text-text-bright" style="margin-bottom: 0.625rem;">{t('index.dim3Title')}</h3>
        <p class="text-muted" style="font-size: 0.875rem; line-height: 1.65;">{t('index.dim3Desc')}</p>
      </div>
      <div class="dimension-card">
        <div class="dimension-number">4</div>
        <h3 class="font-display fluid-body font-semibold text-text-bright" style="margin-bottom: 0.625rem;">{t('index.dim4Title')}</h3>
        <p class="text-muted" style="font-size: 0.875rem; line-height: 1.65;">{t('index.dim4Desc')}</p>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     NUMBERS STRIP
     ═══════════════════════════════════════════════════════ -->
<section class="section-y-sm">
  <div class="content-grid">
    <div class="stats-grid animate-entrance">
      <div class="stat-item">
        <span class="stat-number font-display text-accent">60–99%</span>
        <span class="stat-desc">{t('index.statsReduction')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-number font-display text-accent-2">{manifest.counts.granular}</span>
        <span class="stat-desc">{t('index.statsTools')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-number font-display text-accent-3">90+</span>
        <span class="stat-desc">{t('index.statsPatterns')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-number font-display text-text-bright">0</span>
        <span class="stat-desc">{t('index.statsConfig')}</span>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     THREE LAYERS
     ═══════════════════════════════════════════════════════ -->
<section class="section-y glow-section">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      {t('index.archLabel')}
    </p>
    <h2 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      {t('index.archTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(4rem, 3rem + 4vw, 7rem); max-width: 42rem;">
      {t('index.archDesc')}
