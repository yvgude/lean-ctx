---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalChrome from '../components/TerminalChrome.astro';
import LiveCompressionDemo from '../components/LiveCompressionDemo.astro';
import BenchmarkScatterChart from '../components/BenchmarkScatterChart.astro';
import TokenComparisonBars from '../components/TokenComparisonBars.astro';
import HowItWorksSteps from '../components/HowItWorksSteps.astro';
import CompressionTable from '../components/CompressionTable.astro';
import ToolIntegrationGrid from '../components/ToolIntegrationGrid.astro';
import UseCases from '../components/UseCases.astro';
import WhyNotX from '../components/WhyNotX.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getMcpManifest } from '../lib/mcpManifest';
import '../styles/index.css';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const manifest = getMcpManifest();

const toolNames = manifest.tools.granular.map((x) => x.name);
const pickTool = (preferred: string, fallbackIndex: number) =>
  (toolNames.includes(preferred) ? preferred : toolNames[fallbackIndex] ?? toolNames[0]);

const tRead = pickTool('ctx_read', 0);
const tSearch = pickTool('ctx_search', 1);
const tShell = pickTool('ctx_shell', 2);

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [1,2,3,4,5].map(i => ({
    '@type': 'Question',
    name: t(`index.faq${i}Q`),
    acceptedAnswer: { '@type': 'Answer', text: t(`index.faq${i}A`) },
  })),
});
---

<BaseLayout title={t('index.title')} description={t('index.metaDesc')} extraJsonLd={faqJsonLd}>

<!-- ═══════════════════════════════════════════════════════
     1. HERO
     ═══════════════════════════════════════════════════════ -->
<section class="section-hero hero-split" data-hero>
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div class="hero-copy">
        <div class="animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
          <span class="kicker-pill">{t('index.heroLabel')}</span>
        </div>
        <h1 class="font-display text-text-bright animate-entrance hero-headline" set:html={t('index.heroHeadline')} />

        <p class="fluid-body text-muted animate-entrance stagger-1" style="margin-top: clamp(1.25rem, 1rem + 1vw, 2rem); max-width: 46rem;">
          {t('index.heroSubline')}
        </p>

        <div class="flex flex-wrap items-center animate-entrance stagger-2" style="margin-top: clamp(1.5rem, 1rem + 1.25vw, 2.5rem); gap: clamp(0.5rem, 0.375rem + 0.5vw, 1rem);">
          <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center gap-2" style="padding: clamp(0.625rem, 0.5rem + 0.3vw, 0.875rem) clamp(0.875rem, 0.75rem + 0.4vw, 1.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);">
            {t('index.heroCta')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href={lp('/how-it-works')} class="btn-outline inline-flex items-center gap-2" style="padding: clamp(0.625rem, 0.5rem + 0.3vw, 0.875rem) clamp(0.875rem, 0.75rem + 0.4vw, 1.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);">
            {t('index.heroCtaSecondary')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="btn-outline inline-flex items-center gap-2" style="padding: clamp(0.625rem, 0.5rem + 0.3vw, 0.875rem) clamp(0.875rem, 0.75rem + 0.4vw, 1.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.12vw, 0.9375rem);">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            {t('index.starOnGithub')}
          </a>
        </div>

        <div class="hero-proof animate-entrance stagger-2" style="margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
          <div class="hero-proof-item">
            <span class="hero-proof-number font-display" id="install-count">-</span>
            <span class="hero-proof-label">{t('index.heroProofInstalls')}</span>
          </div>
          <div class="hero-proof-divider"></div>
          <div class="hero-proof-item">
            <span class="hero-proof-number font-display" id="github-stars-hero">-</span>
            <span class="hero-proof-label">{t('index.heroProofStars')}</span>
          </div>
          <div class="hero-proof-divider"></div>
          <div class="hero-proof-item">
            <span class="hero-proof-number font-display">{manifest.counts.granular}</span>
            <span class="hero-proof-label">{t('index.heroProofTools')}</span>
          </div>
        </div>
      </div>

      <div class="hero-terminal-wrap animate-entrance stagger-2">
        <div class="hero-terminal" data-hero-terminal>
          <div class="terminal-header flex items-center gap-2" style="padding: clamp(0.5rem, 0.375rem + 0.3vw, 0.75rem) clamp(0.75rem, 0.625rem + 0.4vw, 1.25rem);">
            <span class="term-dots" aria-hidden="true">
              <span class="term-dot"></span>
              <span class="term-dot"></span>
              <span class="term-dot term-dot--live"></span>
            </span>
            <span class="ml-2 text-xs text-muted font-mono">lean-ctx session</span>
            <span class="term-status font-mono" aria-hidden="true">live</span>
          </div>
          <div class="terminal-body font-mono" style="padding: clamp(0.75rem, 0.625rem + 0.4vw, 1.25rem); font-size: clamp(0.6rem, 0.55rem + 0.12vw, 0.8125rem); line-height: 1.75;">
            <div class="hero-term-line" data-term-line="0">
              <span class="text-muted">$</span> <span class="text-accent">lean-ctx</span> <span class="text-text-bright">read src/lib/auth.ts -m map</span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="1">
              <span class="text-muted">→</span> <span class="text-text">exports: authenticate(), validateToken(), refreshSession()</span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="2">
              <span class="text-muted">→</span> <span class="text-text">4,200 → <span class="text-accent font-semibold">920 tokens</span> (78% saved)</span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="3">
              <span class="text-muted">→</span> <span class="text-text">cached: <span class="text-accent">13 tokens</span> on re-read</span>
            </div>
            <div class="hero-term-spacer" data-term-line="4"></div>
            <div class="hero-term-line" data-term-line="5">
              <span class="text-muted">$</span> <span class="text-accent">lean-ctx</span> <span class="text-text-bright">grep "authenticate" src/</span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="6">
              <span class="text-muted">→</span> <span class="text-text">3 matches in <span class="text-accent">0.8ms</span></span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="7">
              <span class="text-muted">→</span> <span class="text-text">auth.ts:14, middleware.ts:8, routes.ts:23</span>
            </div>
            <div class="hero-term-spacer" data-term-line="8"></div>
            <div class="hero-term-line" data-term-line="9">
              <span class="text-muted">$</span> <span class="text-accent">lean-ctx</span> <span class="text-text-bright">-c "cargo build --release"</span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="10">
              <span class="text-muted">→</span> <span class="text-text">Compiling lean-ctx v3.6.8 in <span class="text-accent">3.2s</span></span>
            </div>
            <div class="hero-term-line hero-term-result" data-term-line="11">
              <span class="text-muted">→</span> <span class="text-text">compressed: <span class="text-accent">847 → 42 tokens</span></span>
            </div>
            <div class="hero-term-cursor" data-term-line="12"></div>
          </div>
        </div>
        <div class="hero-install animate-entrance stagger-4">
          <code class="hero-install-code" id="hero-install-cmd">curl -fsSL https://leanctx.com/install.sh | sh</code>
          <button class="hero-copy-btn" type="button" data-copy="curl -fsSL https://leanctx.com/install.sh | sh" aria-label="Copy install command">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     1b. TRUST BAR — value at a glance
     ═══════════════════════════════════════════════════════ -->
<section class="trust-bar-section" aria-label="Key metrics">
  <div class="content-grid-wide">
    <div class="trust-bar animate-entrance">
      <div class="trust-stat">
        <span class="trust-stat-num font-display">{t('index.trustStat1Num')}</span>
        <span class="trust-stat-label">{t('index.trustStat1Label')}</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat-num font-display">{t('index.trustStat2Num')}</span>
        <span class="trust-stat-label">{t('index.trustStat2Label')}</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat-num font-display">{t('index.trustStat3Num')}</span>
        <span class="trust-stat-label">{t('index.trustStat3Label')}</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat-num font-display">{t('index.trustStat4Num')}</span>
        <span class="trust-stat-label">{t('index.trustStat4Label')}</span>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     2. PROBLEM — Before / After
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="split split--visual-wide">
      <div>
        <div class="section-eyebrow animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
          <span class="section-ordinal">01</span>
          <span class="kicker-pill">{t('index.problemLabel')}</span>
        </div>
        <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 54rem;">
          {t('index.problemTitle')}
        </h2>
        <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem); max-width: 52rem;">
          {t('index.problemDesc')}
        </p>
        <p class="fluid-body text-text-bright font-medium animate-entrance stagger-2" style="margin: 0; max-width: 52rem; font-style: italic;">
          {t('index.problemQuote')}
        </p>
        <div class="animate-entrance stagger-3" style="margin-top: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
          <a href={lp('/what-is-context-engineering')} class="inline-flex items-center gap-2 text-accent" style="font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem); text-decoration: none;">
            Why context is the real bottleneck
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>

      <div class="animate-entrance stagger-3">
        <div class="compare-grid is-stacked">
      <div class="compare-card">
        <div class="compare-header compare-header--bad">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          {t('index.withoutLeanCtx')}
        </div>
        <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-muted">{t('index.without1')}</span></div>
          <div class="compare-line"><span class="text-danger">{t('index.without2')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('index.without3')}</span></div>
          <div class="compare-line"><span class="text-danger">{t('index.without4')}</span></div>
        </div>
      </div>
      <div class="compare-card">
        <div class="compare-header compare-header--good">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {t('index.withLeanCtx')}
        </div>
        <div class="compare-body font-mono" style="font-size: clamp(0.75rem, 0.7rem + 0.12vw, 0.875rem);">
          <div class="compare-line"><span class="text-muted">{t('index.with1')}</span></div>
          <div class="compare-line"><span class="text-accent">{t('index.with2')}</span></div>
          <div class="compare-line"><span class="text-muted">{t('index.with3')}</span></div>
          <div class="compare-line"><span class="text-accent">{t('index.with4')}</span></div>
        </div>
      </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     2b. WHAT YOU CAN DO — jobs to be done
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="section-eyebrow animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="section-ordinal">02</span>
      <span class="kicker-pill">What you can do</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 48rem;">
      Four jobs, <span class="italic-accent">one binary.</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      You never run these commands yourself. Install lean-ctx once, keep using your AI exactly as you do today — and it quietly handles all four, every day. Pick any one to follow it end to end.
    </p>
    <UseCases />
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     3. HOW IT WORKS — 3 steps (See / Compress / Remember)
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="section-eyebrow animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="section-ordinal">03</span>
      <span class="kicker-pill">{t('index.howItWorksLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 48rem;">
      {t('index.howItWorksTitle')} <span class="italic-accent">{t('index.howItWorksTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      {t('index.howItWorksDesc')}
    </p>

    <HowItWorksSteps />

    <div class="animate-entrance stagger-3" style="margin-top: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      <a href={lp('/how-it-works/')} class="inline-flex items-center gap-2 text-accent" style="font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem); text-decoration: none;">
        {t('index.howItWorksArchLink')}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     3b. WHAT GETS COMPRESSED — table
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="section-eyebrow animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="section-ordinal">04</span>
      <span class="kicker-pill">{t('index.compressTableLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 48rem;">
      {t('index.compressTableTitle')} <span class="italic-accent">{t('index.compressTableTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      {t('index.compressTableDesc')}
    </p>
    <CompressionTable />
    <div class="animate-entrance stagger-3" style="margin-top: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      <a href={lp('/docs/concepts/read-modes')} class="inline-flex items-center gap-2 text-accent" style="font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem); text-decoration: none;">
        Explore all ten read modes
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     3c. WHY NOT JUST USE X — objections answered
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="section-eyebrow animate-entrance" style="margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 2rem);">
      <span class="section-ordinal">05</span>
      <span class="kicker-pill">Why not just…</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 48rem;">
      You already have tools. <span class="italic-accent">Here's the difference.</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      lean-ctx isn't a replacement for grep or your editor — it's the layer that decides what's worth your AI's attention.
    </p>
    <WhyNotX />
    <div class="animate-entrance stagger-3" style="margin-top: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      <a href={lp('/compare')} class="inline-flex items-center gap-2 text-accent" style="font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem); text-decoration: none;">
        See the full comparison
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     4. LIVE COMPRESSION DEMO
     ═══════════════════════════════════════════════════════ -->
<section class="section-y">
  <div class="content-grid-wide">
    <div class="section-eyebrow animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      <span class="section-ordinal">06</span>
      <span class="kicker-pill">{t('index.compressionLabel')}</span>
    </div>
    <h2 class="font-display fluid-h1 text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); max-width: 48rem;">
      {t('index.compressionTitle')}
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 2vw, 5rem); max-width: 48rem;">
      {t('index.compressionDesc')}
    </p>
    <LiveCompressionDemo />
    <div class="animate-entrance stagger-3" style="margin-top: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
      <a href={lp('/docs/concepts/token-savings')} class="inline-flex items-center gap-2 text-accent" style="font-size: clamp(0.875rem, 0.84rem + 0.15vw, 1rem); text-decoration: none;">
        How the savings add up
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     5. BENCHMARK SUPER-SECTION — Scatter + Token Bars
     ═══════════════════════════════════════════════════════ -->
