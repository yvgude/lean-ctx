---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

interface LeaderRow {
  rank: number;
  id: string;
  url: string;
  display_name: string | null;
  tokens_saved: number;
  cost_avoided_usd: number;
  compression_rate_pct: number;
  period: string;
  pricing_estimated: boolean;
}

/**
 * Energy per saved token — a conservative, citable estimate.
 *   • ~0.39 J/token measured for Llama-3-70B (FP8) on H100 + vLLM (John Snow Labs, "Tokens per
 *     Joule", 2025). Query-level estimates (Epoch AI: ~0.3 Wh per GPT-4o query) imply more.
 *   • We use 0.4 J/token to avoid overstating, since lean-ctx mostly removes cheaper prefill/
 *     context tokens rather than expensive autoregressive output tokens.
 * Real figures vary by model and hardware; the page labels this clearly as an estimate.
 */
const J_PER_TOKEN = 0.4;
const WH_PER_PHONE_CHARGE = 12; // ~12 Wh for a full smartphone charge

/**
 * Build-time snapshot — bake the verified, opt-in community totals into the static HTML for SEO
 * and instant first paint. Wrapped in try/catch so the site build never fails if the API is
 * unreachable; the inline client script then refreshes everything live on each page load.
 * Tokens / money / energy are all derived from the leaderboard so they stay mutually consistent.
 */
async function fetchJson<T>(url: string): Promise<T | null> {
  try {
    const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
    return res.ok ? ((await res.json()) as T) : null;
  } catch {
    return null;
  }
}

const board = await fetchJson<{ entries?: LeaderRow[] }>('https://api.leanctx.com/api/leaderboard');
const entries: LeaderRow[] = Array.isArray(board?.entries) ? board!.entries! : [];

const totalTokens = entries.reduce((s, e) => s + (e.tokens_saved || 0), 0);
const totalUsd = entries.reduce((s, e) => s + (e.cost_avoided_usd || 0), 0);
const energyWh = (totalTokens * J_PER_TOKEN) / 3600;
const phoneCharges = energyWh / WH_PER_PHONE_CHARGE;

const fmtInt = (n: number) => (Number.isFinite(n) ? Math.round(n).toLocaleString('en-US') : '0');
const fmtTokens = (n: number): string => {
  if (!Number.isFinite(n) || n <= 0) return '0';
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)}B`;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
  if (n >= 1e3) return `${(n / 1e3).toFixed(1)}K`;
  return `${Math.round(n)}`;
};
const fmtEnergy = (wh: number): string => {
  if (!Number.isFinite(wh) || wh <= 0) return '0 Wh';
  if (wh >= 1e6) return `${(wh / 1e6).toFixed(1)} MWh`;
  if (wh >= 1e3) return `${(wh / 1e3).toFixed(1)} kWh`;
  return `${Math.round(wh)} Wh`;
};
// Per-row energy is derived from tokens (same J/token basis as the totals) so the leaderboard
// stays consistent with the live-savings cards without sharing any extra data.
const energyWhFor = (tokens: number) => (Math.max(0, tokens || 0) * J_PER_TOKEN) / 3600;
const fmtPct = (v: number) => (Number.isFinite(v) && v > 0 ? `${Math.round(v)}%` : '—');

const stats = [
  { id: 'mx-tokens', attr: 'data-count-tokens', value: totalTokens, display: fmtTokens(totalTokens), label: 'Tokens saved', hint: 'stripped from LLM context' },
  { id: 'mx-usd', attr: 'data-count-usd', value: Math.round(totalUsd), display: `$${fmtInt(totalUsd)}`, label: 'Money saved', hint: 'at published model rates' },
  { id: 'mx-energy', attr: 'data-count-energy', value: Math.round(energyWh), display: fmtEnergy(energyWh), label: 'Energy saved', hint: `≈ ${fmtInt(phoneCharges)} phone charges` },
];
---

<BaseLayout
  title="Metrics — community token, cost & energy savings | LeanCTX"
  description="Live community metrics from LeanCTX: tokens saved, money saved, and the energy never burned — with a leaderboard of the most realized savings. Every number is summed from each user's tamper-evident local savings ledger. Join in and watch it climb."
  breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: 'Metrics', url: lp('/metrics/') }]}>

  <!-- ═══════ 1. HERO ═══════ -->
  <PageHero
    label="Community Metrics"
    title="The LeanCTX"
    highlight="community"
    descriptionHtml="Every developer running <strong class='text-text-bright'>LeanCTX</strong> trims the tokens their AI reads &mdash; saving money <strong class='text-text-bright'>and real energy</strong>. This is our shared scoreboard: live, opt-in, summed from tamper-evident local ledgers. <strong class='text-text-bright'>Add yours and push the numbers higher.</strong>"
    kickerTone="accent"
    titleVariant="display"
    highlightStyle="italic"
    descMaxWidth="44rem"
  >
    <Fragment slot="actions">
      <a href={lp('/docs/getting-started')} class="cta-btn btn-primary">
        Install LeanCTX
        <svg class="cta-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href="https://github.com/yvgude/lean-ctx" target="_blank" rel="noopener" class="cta-btn btn-outline">
        <svg class="cta-btn-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        Star on GitHub
      </a>
    </Fragment>
  </PageHero>

  <div class="section-divider content-grid"></div>

  <!-- ═══════ 2. LIVE SAVINGS ═══════ -->
  <section class="relative section-y">
    <div class="content-grid">
      <div class="mx-head">
        <SectionHeading
          label="Live savings"
          title="Collective impact,"
          highlight="measured"
          description="Updated on every visit — real tokens, real dollars, and the energy that compute never had to burn. Every figure reconciles to the opt-in ledgers below, and grows each time someone new joins."
          variant="full"
          breakHighlight={false}
          descMaxWidth="48rem"
          titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
          descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
        />
        <span class="mx-live" aria-label="Live data"><span class="mx-live-dot"></span>Live</span>
      </div>

      <div class="grid md:grid-cols-3 animate-entrance stagger-2" style="gap: clamp(0.75rem, 0.5rem + 0.75vw, 1.25rem);">
        {stats.map((s, i) => (
          <div class={`card mx-stat stagger-${2 + i}`} style="padding: clamp(1.5rem, 1.1rem + 1vw, 2.25rem);">
            <span class="mx-stat-num font-display" id={s.id} {...{ [s.attr]: s.value }}>{s.display}</span>
            <p class="mx-stat-label">{s.label}</p>
            <p class="mx-stat-hint" id={s.id === 'mx-energy' ? 'mx-energy-hint' : undefined}>{s.hint}</p>
          </div>
        ))}
      </div>

      <p class="mx-pitch animate-entrance stagger-4">
        Fewer tokens means less compute &mdash; and less energy burned. Every name on this board is a
        small, <strong class="text-text-bright">verifiable dent in AI's footprint</strong>, multiplied by everyone who joins.
      </p>

      <p class="mx-note animate-entrance stagger-5">
        Energy is an estimate &mdash; tokens saved &times; &asymp;0.4&nbsp;J/token (modern optimized LLM
        inference, e.g. Llama-3-70B FP8 on H100); real figures vary by model and hardware. Sources:
        <a href="https://epoch.ai/gradient-updates/how-much-energy-does-chatgpt-use" target="_blank" rel="noopener">Epoch&nbsp;AI</a>,
        <a href="https://www.johnsnowlabs.com/tokens-per-joule-how-to-quantify-and-reduce-the-energy-footprint-of-clinical-llm-inference/" target="_blank" rel="noopener">John&nbsp;Snow&nbsp;Labs</a>.
      </p>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <!-- ═══════ 3. LEADERBOARD ═══════ -->
  <section class="relative section-y" id="leaderboard">
    <div class="content-grid">
      <SectionHeading
        label="Leaderboard"
        title="Top realized"
        highlight="savings"
        highlightStyle="italic"
        description="These developers have compressed the most context — and saved the most energy doing it. Claim your spot with a single command; every figure is signed by your local ledger and verifiable offline."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />

      <div class="mx-wrap animate-entrance stagger-2">
        <div class="mx-table-card">
          <table class="mx-table">
            <thead>
              <tr>
                <th class="mx-col-rank">#</th>
                <th>Developer</th>
                <th class="num">Tokens saved</th>
                <th class="num mx-col-comp">Compression</th>
                <th class="num">Energy saved</th>
                <th class="num">Saved</th>
              </tr>
            </thead>
            <tbody id="mx-rows">
              {entries.map((e) => (
                <tr class={`mx-row${e.rank === 1 ? ' mx-row--lead' : ''}`} data-href={e.url}>
                  <td class="mx-col-rank"><span class="mx-rank">{e.rank}</span></td>
                  <td>
                    <a class="mx-name" href={e.url}>{e.display_name || 'anonymous'}</a>
                    {e.rank === 1 && <span class="mx-badge">Leader</span>}
                  </td>
                  <td class="num"><span class="mx-tok">{fmtTokens(e.tokens_saved)}</span></td>
                  <td class="num mx-col-comp"><span class="mx-comp">{fmtPct(e.compression_rate_pct)}</span></td>
                  <td class="num"><span class="mx-energy">{fmtEnergy(energyWhFor(e.tokens_saved))}</span></td>
                  <td class="num"><span class="mx-usd">${fmtInt(Math.round(e.cost_avoided_usd))}{e.pricing_estimated ? ' est.' : ''}</span></td>
                </tr>
              ))}
            </tbody>
          </table>

          <div id="mx-empty" class="mx-empty" style={entries.length > 0 ? 'display:none' : ''}>
            No one has opted in yet — be the first to claim&nbsp;#1 and set the pace:
            <code>lean-ctx gain --publish --leaderboard</code>
          </div>
        </div>

        <div class="mx-foot">
          <p>
            <strong class="text-text-bright">Want in?</strong> Once LeanCTX has been compressing your
            context for a while, run <code>lean-ctx gain --publish --leaderboard</code> — then watch
            your name climb.
          </p>
          <ul class="mx-how">
            <li><strong class="text-text-bright">Pick your name.</strong> Add <code>--name="your handle"</code> the first time — it sticks for every future push.</li>
            <li><strong class="text-text-bright">No account, ever.</strong> Your entry is signed by a key that lives only on your machine. That key <em>is</em> your identity — no login, no email, nothing to leak.</li>
            <li><strong class="text-text-bright">Push as often as you like.</strong> Re-publishing refreshes your one entry in place (same link) — it never piles up duplicates.</li>
            <li><strong class="text-text-bright">Stay on the board on autopilot.</strong> <code>lean-ctx config set gain.auto_publish true</code> keeps your numbers fresh as you save more energy.</li>
          </ul>
        </div>

        <p class="mx-privacy">
          <strong class="text-text-bright">What's shared:</strong> only four aggregate numbers &mdash; tokens saved,
          compression rate, energy and dollars saved &mdash; plus the name you pick. Never your code, file paths,
          repo names or prompts. It's all open source &mdash; see the
          <a href="https://github.com/yvgude/lean-ctx/blob/main/docs/contracts/wrapped-permalink-v1.md" target="_blank" rel="noopener">publish contract</a>.
        </p>
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <!-- ═══════ 4. CTA ═══════ -->
  <CtaSection
    eyebrow="Your move"
    title="Claim your spot on the"
    titleHighlight="leaderboard"
    description="Install LeanCTX, let it shrink what your AI reads, and your tokens, dollars and watt-hours start adding to the community total. Publish your recap with one command — your numbers stay verifiable offline, and every saved token is a little less energy burned."
    align="center"
    actions={[
      { label: 'Install LeanCTX', href: lp('/docs/getting-started/'), variant: 'primary', icon: 'arrow' },
      { label: 'Star on GitHub', href: 'https://github.com/yvgude/lean-ctx', variant: 'outline', icon: 'github', external: true },
    ]}
  />

  <script is:inline>
    (function () {
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var J_PER_TOKEN = 0.4;
      var WH_PER_PHONE_CHARGE = 12;

      function fmtInt(n) { return Math.round(n).toLocaleString('en-US'); }
      function fmtUsd(n) { return '$' + fmtInt(n); }
      function fmtTokens(n) {
        if (!isFinite(n) || n <= 0) return '0';
        if (n >= 1e9) return (n / 1e9).toFixed(1) + 'B';
        if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
        if (n >= 1e3) return (n / 1e3).toFixed(1) + 'K';
        return String(Math.round(n));
      }
      function fmtEnergy(wh) {
        if (!isFinite(wh) || wh <= 0) return '0 Wh';
        if (wh >= 1e6) return (wh / 1e6).toFixed(1) + ' MWh';
        if (wh >= 1e3) return (wh / 1e3).toFixed(1) + ' kWh';
        return Math.round(wh) + ' Wh';
      }
      function energyWhFor(t) { return (Math.max(0, t || 0) * J_PER_TOKEN) / 3600; }
      function fmtPct(v) { return (isFinite(v) && v > 0) ? Math.round(v) + '%' : '\u2014'; }
      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function countUp(el, target, fmt) {
        if (!el) return;
        fmt = fmt || fmtInt;
        if (reduceMotion || target <= 0) { el.textContent = fmt(target); return; }
        var startTime = null;
        function step(ts) {
          if (!startTime) startTime = ts;
          var p = Math.min((ts - startTime) / 1100, 1);
          var ease = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(ease * target);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      // Animate the baked build-time numbers immediately.
      document.querySelectorAll('[data-count-tokens]').forEach(function (el) {
        countUp(el, parseFloat(el.getAttribute('data-count-tokens')) || 0, fmtTokens);
      });
      document.querySelectorAll('[data-count-usd]').forEach(function (el) {
        countUp(el, parseFloat(el.getAttribute('data-count-usd')) || 0, fmtUsd);
      });
      document.querySelectorAll('[data-count-energy]').forEach(function (el) {
        countUp(el, parseFloat(el.getAttribute('data-count-energy')) || 0, fmtEnergy);
      });

      function updateSavings(entries) {
        var tok = 0, usd = 0;
        entries.forEach(function (e) { tok += e.tokens_saved || 0; usd += e.cost_avoided_usd || 0; });
        var wh = (tok * J_PER_TOKEN) / 3600;
        var tokensEl = document.getElementById('mx-tokens');
        var usdEl = document.getElementById('mx-usd');
        var energyEl = document.getElementById('mx-energy');
        var hintEl = document.getElementById('mx-energy-hint');
        if (tokensEl && tok > 0) countUp(tokensEl, tok, fmtTokens);
        if (usdEl && usd > 0) countUp(usdEl, usd, fmtUsd);
        if (energyEl && wh > 0) countUp(energyEl, wh, fmtEnergy);
        if (hintEl && wh > 0) hintEl.textContent = '\u2248 ' + fmtInt(wh / WH_PER_PHONE_CHARGE) + ' phone charges';
      }

      // ── Leaderboard live refresh (keeps the build-time snapshot on failure) ──
      var rowsBody = document.getElementById('mx-rows');
      var empty = document.getElementById('mx-empty');

      function rowHtml(e) {
        var est = e.pricing_estimated ? ' est.' : '';
        var name = e.display_name ? esc(e.display_name) : 'anonymous';
        var lead = e.rank === 1 ? ' mx-row--lead' : '';
        var badge = e.rank === 1 ? '<span class="mx-badge">Leader</span>' : '';
        return '<tr class="mx-row' + lead + '" data-href="' + esc(e.url) + '">' +
          '<td class="mx-col-rank"><span class="mx-rank">' + e.rank + '</span></td>' +
          '<td><a class="mx-name" href="' + esc(e.url) + '">' + name + '</a>' + badge + '</td>' +
          '<td class="num"><span class="mx-tok">' + fmtTokens(e.tokens_saved) + '</span></td>' +
          '<td class="num mx-col-comp"><span class="mx-comp">' + fmtPct(e.compression_rate_pct) + '</span></td>' +
          '<td class="num"><span class="mx-energy">' + fmtEnergy(energyWhFor(e.tokens_saved)) + '</span></td>' +
          '<td class="num"><span class="mx-usd">$' + fmtInt(Math.round(e.cost_avoided_usd)) + est + '</span></td>' +
          '</tr>';
      }
      function renderBoard(entries) {
        if (!rowsBody) return;
        if (!entries.length) {
          rowsBody.innerHTML = '';
          if (empty) empty.style.display = '';
          return;
        }
        if (empty) empty.style.display = 'none';
        rowsBody.innerHTML = entries.map(rowHtml).join('');
      }

      // Click anywhere on a row to open the publisher's Wrapped permalink.
      if (rowsBody) {
        rowsBody.addEventListener('click', function (ev) {
          if (ev.target && ev.target.closest('a')) return; // let the name link handle itself
          var tr = ev.target && ev.target.closest('tr[data-href]');
          if (tr) window.location.href = tr.getAttribute('data-href');
        });
      }

      fetch('https://api.leanctx.com/api/leaderboard', { headers: { accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { if (d && Array.isArray(d.entries)) { renderBoard(d.entries); updateSavings(d.entries); } })
        .catch(function () {});
    })();
  </script>

  <style>
    /* ── Live savings heading row ──────────────────────────── */
    .mx-head { position: relative; }
    .mx-live {
      position: absolute;
      top: 0;
      right: 0;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: var(--weight-semibold);
      color: var(--color-accent);
    }
    .mx-live-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--color-accent);
      box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 60%, transparent);
      animation: mx-pulse 2s ease-in-out infinite;
    }
    @keyframes mx-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
    @media (prefers-reduced-motion: reduce) { .mx-live-dot { animation: none; } }

    /* ── Stat cards ────────────────────────────────────────── */
    .mx-stat {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      background:
        radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--color-accent) 7%, transparent), transparent 60%),
        var(--color-surface);
    }
    .mx-stat-num {
      font-size: clamp(2.5rem, 1.9rem + 2.8vw, 3.75rem);
      font-weight: var(--weight-bold);
      line-height: 1;
      letter-spacing: -0.03em;
      font-variant-numeric: tabular-nums;
      background: linear-gradient(135deg, var(--color-accent-bright), var(--color-accent));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .mx-stat-label {
      font-weight: var(--weight-semibold);
      color: var(--color-text-bright);
      font-size: 1rem;
      margin: 0.4rem 0 0;
    }
    .mx-stat-hint {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.03em;
      color: var(--color-muted);
      margin: 0;
    }
    .mx-pitch {
      margin: clamp(1.5rem, 1.1rem + 1vw, 2.25rem) 0 0;
      padding-left: clamp(0.875rem, 0.6rem + 0.5vw, 1.25rem);
      border-left: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
      font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
      line-height: 1.6;
      color: var(--color-text);
      max-width: 46rem;
    }
    .mx-note {
      margin: clamp(1rem, 0.75rem + 0.5vw, 1.5rem) 0 0;
      font-size: 0.78rem;
      line-height: 1.55;
      color: var(--color-muted);
      max-width: 52rem;
    }
    .mx-note a { color: var(--color-accent); text-decoration: none; }
    .mx-note a:hover { text-decoration: underline; }

    /* ── Leaderboard static wrappers ───────────────────────── */
    /* Span the full content column so the board is exactly as wide as the live-savings cards. */
    .mx-wrap { max-width: 100%; }
    .mx-foot { margin-top: 1.25rem; font-size: 0.85rem; color: var(--color-muted); }
    .mx-foot code {
      color: var(--color-accent-bright);
      background: var(--color-surface-3);
      padding: 0.15rem 0.45rem;
      border-radius: 0.375rem;
      font-size: 0.85em;
    }
    .mx-how {
      margin: 1rem 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0.6rem;
    }
    .mx-how li {
      position: relative;
      padding-left: 1.4rem;
      line-height: 1.5;
    }
    .mx-how li::before {
      content: "→";
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: 700;
    }

    /* ── Privacy note (subtle one-liner: exactly what a publish shares) ─ */
    .mx-privacy {
      margin: clamp(1rem, 0.75rem + 0.5vw, 1.5rem) 0 0;
      font-size: 0.78rem;
      line-height: 1.55;
      color: var(--color-muted);
      max-width: 62ch;
    }
    .mx-privacy a { color: var(--color-accent); text-decoration: none; }
    .mx-privacy a:hover { text-decoration: underline; }
  </style>

  <!-- The leaderboard <tbody> is re-rendered via innerHTML on live refresh. Injected nodes do NOT
       carry Astro's scoping attribute, so the table styles must be global — scoped under
       `.mx-table-card` so nothing leaks to the rest of the site. -->
  <style is:global>
    .mx-table-card {
      border: 1px solid var(--color-border);
      border-radius: var(--card-radius-lg);
      background: var(--color-surface);
      overflow: hidden;
    }
    .mx-table-card .mx-table {
      width: 100%;
      border-collapse: collapse;
      font-variant-numeric: tabular-nums;
    }
    .mx-table-card thead th {
      text-align: left;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: var(--weight-semibold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-muted);
      padding: 0.875rem clamp(0.875rem, 0.6rem + 0.6vw, 1.5rem);
      background: var(--color-surface-2);
      border-bottom: 1px solid var(--color-border);
      white-space: nowrap;
    }
    .mx-table-card th.num,
    .mx-table-card td.num { text-align: right; }
    .mx-table-card .mx-col-rank { width: 3.25rem; text-align: center; }
    .mx-table-card th.mx-col-rank { text-align: center; }

    .mx-table-card .mx-row {
      transition: background var(--dur) var(--ease-out);
      cursor: pointer;
    }
    .mx-table-card .mx-row:hover { background: var(--color-surface-2); }
    .mx-table-card .mx-row td {
      padding: clamp(0.85rem, 0.6rem + 0.5vw, 1.1rem) clamp(0.875rem, 0.6rem + 0.6vw, 1.5rem);
      border-bottom: 1px solid var(--color-border);
      vertical-align: middle;
    }
    .mx-table-card .mx-row:last-child td { border-bottom: none; }

    .mx-table-card .mx-row--lead {
      background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    }
    .mx-table-card .mx-row--lead:hover {
      background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    }
    .mx-table-card .mx-row--lead td:first-child {
      box-shadow: inset 3px 0 0 0 var(--color-accent);
    }

    .mx-table-card .mx-rank {
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: 1rem;
      color: var(--color-muted);
    }
    .mx-table-card .mx-row--lead .mx-rank { color: var(--color-accent); }

    .mx-table-card .mx-name {
      font-weight: var(--weight-semibold);
      color: var(--color-text-bright);
      font-size: 0.975rem;
      text-decoration: none;
      transition: color var(--dur) var(--ease-out);
    }
    .mx-table-card .mx-name:hover { color: var(--color-accent); }

    .mx-table-card .mx-badge {
      display: inline-block;
      margin-left: 0.6rem;
      padding: 0.1rem 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-weight: var(--weight-semibold);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-accent);
      border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-accent) 10%, transparent);
      vertical-align: middle;
    }
    .mx-table-card .mx-tok {
      font-family: var(--font-mono);
      font-weight: var(--weight-semibold);
      font-size: 0.975rem;
      color: var(--color-accent);
    }
    .mx-table-card .mx-comp {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      color: var(--color-text);
    }
    .mx-table-card .mx-energy {
      font-family: var(--font-mono);
      font-weight: var(--weight-semibold);
      font-size: 0.875rem;
      color: var(--color-accent-bright);
    }
    .mx-table-card .mx-usd { font-size: 0.8125rem; color: var(--color-muted); }

    .mx-empty {
      padding: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem) 1.5rem;
      text-align: center;
      color: var(--color-text);
    }
    .mx-empty code {
      display: inline-block;
      margin-top: 0.6rem;
      color: var(--color-accent-bright);
      background: var(--color-surface-3);
      padding: 0.2rem 0.55rem;
      border-radius: 0.375rem;
      font-size: 0.85em;
    }

    @media (max-width: 600px) {
      /* Keep the small screen focused on the headline numbers (tokens, energy, $). */
      .mx-table-card .mx-col-comp { display: none; }
      .mx-table-card thead th { padding-left: 0.75rem; padding-right: 0.75rem; }
      .mx-table-card .mx-row td { padding-left: 0.75rem; padding-right: 0.75rem; }
      .mx-table-card .mx-badge { display: none; }
    }
  </style>
</BaseLayout>
