---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { getPillarById, type Pillar } from '../lib/contextOsPillars';
import { getMcpManifest, getToolEnrichments, toolNameToSlug } from '../lib/mcpManifest';

interface Props {
  pillarId: string;
}

const { pillarId } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
const pillar = getPillarById(pillarId)!;
const manifest = getMcpManifest();
const enrichments = getToolEnrichments();

const pillarTools = pillar.tools
  .map(name => manifest.tools.granular.find(g => g.name === name))
  .filter(Boolean);
---

<BaseLayout
  title={`${t(pillar.titleKey)} - LeanCTX Context OS`}
  description={t(pillar.solutionKey)}
  breadcrumbs={[
    { name: t('common.home'), url: lp('/') },
    { name: t('nav.contextOs'), url: lp('/context-os') },
    { name: t(pillar.titleKey), url: lp(`/context-os/${pillar.slug}`) },
  ]}
>

<!-- 1. HERO -->
<PageHero
  label={t(pillar.titleKey)}
  title={t(pillar.headlineKey)}
  descriptionHtml={t(pillar.solutionKey)}
  kickerTone="accent"
  titleVariant="display"
  highlightStyle="italic"
  descMaxWidth="44rem"
>
  <Fragment slot="actions">
    <a
      href={lp('/docs/getting-started')}
      class="btn-primary inline-flex items-center gap-2 font-bold rounded-lg text-bg"
      style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
    >
      {t('nav.getStarted')}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
    <a
      href={lp('/context-os')}
      class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text"
      style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
    >
      {t('nav.contextOs')}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
  </Fragment>
</PageHero>

<div class="section-divider content-grid"></div>

<!-- 2. PROBLEM / SOLUTION -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t(pillar.titleKey)}
      title={t(pillar.headlineKey)}
      description={t(pillar.solutionKey)}
      variant="full"
      breakHighlight={false}
      descMaxWidth="56rem"
    />
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 3. FEATURES GRID -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t('contextOs.toolsLabel')}
      title={`${pillar.features.length} ${t('contextOs.toolsLabel')}`}
      variant="full"
      breakHighlight={false}
    />

    <div class="grid md:grid-cols-2" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      {pillar.features.map((f, i) => (
        <div class={`card animate-entrance stagger-${1 + i}`} style="padding: clamp(1.25rem, 1rem + 0.75vw, 1.75rem);">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center bg-accent/10">
              <span class="w-4 h-4 text-accent" set:html={f.icon} />
            </div>
            <h3 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 0;">
              {t(f.titleKey)}
            </h3>
          </div>
          <p class="fluid-sm text-muted leading-relaxed" style="margin: 0;">{t(f.descKey)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 4. PROTOCOL (conditional) -->
{pillar.protocol && (
  <section class="relative section-y" id={pillar.protocol.legacySlug}>
    <div class="content-grid">
      <SectionHeading
        label={t(pillar.titleKey)}
        title={t(pillar.protocol.titleKey)}
        variant="full"
        breakHighlight={false}
        descMaxWidth="56rem"
      />

      <div class="card animate-entrance stagger-3" style="padding: clamp(1.5rem, 1rem + 1vw, 2.5rem); max-width: 44rem; margin: 0 auto;">
        <p class="fluid-sm text-muted leading-relaxed" style="margin: 0;">{t(pillar.protocol.descKey)}</p>
      </div>
    </div>
  </section>
)}

{pillar.protocol && <div class="section-divider content-grid"></div>}

<!-- 5. TOOLS IN THIS PILLAR -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t('contextOs.toolsLabel')}
      title={`${pillarTools.length} ${t('contextOs.toolsLabel')}`}
      variant="full"
      breakHighlight={false}
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);">
      {pillarTools.map((tool) => tool && (
        <a href={lp(`/docs/tools/${toolNameToSlug(tool.name)}`)} class="card group animate-entrance" style="padding: clamp(1rem, 0.75rem + 0.5vw, 1.5rem); text-decoration: none;">
          <code class="text-sm font-mono font-bold text-accent" style="display: block; margin-bottom: 0.375rem;">
            {tool.name}
          </code>
          <p class="fluid-sm text-muted leading-relaxed tool-desc" style="margin: 0;">{tool.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 6. RELATED DOCS -->
<section class="relative section-y">
  <div class="content-grid">
    <SectionHeading
      label={t(pillar.titleKey)}
      title="Related Documentation"
      variant="full"
      breakHighlight={false}
    />

    <div class="flex flex-wrap items-center justify-center" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      {pillar.docsLinks.map((link) => (
        <a
          href={lp(link)}
          class="inline-flex items-center gap-2 font-medium text-accent"
          style="padding: 0.625rem 1.25rem; border-radius: 14px; border: 1px solid var(--color-border); background: var(--color-surface); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem); text-decoration: none; text-transform: capitalize; transition: border-color 0.2s ease;"
        >
          {link.replace('/docs/', '').replace(/-/g, ' ')}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      ))}
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<!-- 7. CTA -->
<section class="relative section-y">
  <div class="content-grid" style="text-align: center;">
    <SectionHeading
      title={t(pillar.titleKey)}
      descriptionHtml={t(pillar.solutionKey)}
      variant="full"
      align="center"
      breakHighlight={false}
      titleMb="clamp(1rem, 0.75rem + 0.5vw, 1.5rem)"
      descMb="clamp(2rem, 1.5rem + 1vw, 3rem)"
      descMaxWidth="44rem"
    />

    <div class="flex flex-wrap items-center justify-center animate-entrance stagger-3" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      <a
        href={lp('/docs/getting-started')}
        class="btn-primary inline-flex items-center gap-2 font-bold rounded-lg text-bg"
        style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
      >
        {t('nav.getStarted')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href={lp('/context-os')}
        class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text"
        style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
      >
        {t('nav.contextOs')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .tool-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
