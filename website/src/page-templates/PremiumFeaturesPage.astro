---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const features = [
  {
    title: t('premium.cacheSafeTitle'),
    desc: t('premium.cacheSafeDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    color: 'rgba(52, 211, 153, 0.25)',
    bg: 'rgba(52, 211, 153, 0.08)',
  },
  {
    title: t('premium.ghostTitle'),
    desc: t('premium.ghostDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`,
    color: 'rgba(251, 191, 36, 0.25)',
    bg: 'rgba(251, 191, 36, 0.08)',
  },
  {
    title: t('premium.reviewTitle'),
    desc: t('premium.reviewDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>`,
    color: 'rgba(129, 140, 248, 0.25)',
    bg: 'rgba(129, 140, 248, 0.08)',
  },
  {
    title: t('premium.chunkingTitle'),
    desc: t('premium.chunkingDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>`,
    color: 'rgba(192, 132, 252, 0.25)',
    bg: 'rgba(192, 132, 252, 0.08)',
  },
  {
    title: t('premium.searchTitle'),
    desc: t('premium.searchDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
    color: 'rgba(244, 114, 182, 0.25)',
    bg: 'rgba(244, 114, 182, 0.08)',
  },
  {
    title: t('premium.skillsTitle'),
    desc: t('premium.skillsDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>`,
    color: 'rgba(96, 165, 250, 0.25)',
    bg: 'rgba(96, 165, 250, 0.08)',
  },
  {
    title: t('premium.graphExplorerTitle'),
    desc: t('premium.graphExplorerDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    color: 'rgba(16, 185, 129, 0.25)',
    bg: 'rgba(16, 185, 129, 0.08)',
  },
  {
    title: t('premium.teamServerTitle'),
    desc: t('premium.teamServerDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    color: 'rgba(245, 158, 11, 0.25)',
    bg: 'rgba(245, 158, 11, 0.08)',
  },
  {
    title: t('premium.securityTitle'),
    desc: t('premium.securityDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    color: 'rgba(239, 68, 68, 0.25)',
    bg: 'rgba(239, 68, 68, 0.08)',
  },
];
---

<BaseLayout title={t('premium.eyebrow')} description={t('premium.desc')} breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: t('premium.eyebrow'), url: lp('/premium/') }]}>

<PageHero
  label={t('premium.eyebrow')}
  title={t('premium.eyebrow')}
  titleHtml={t('premium.heading')}
  description={t('premium.desc')}
  highlightStyle="italic"
  descMaxWidth="44rem"
/>

<div class="section-divider content-grid"></div>

<section class="relative section-y">
  <div class="content-grid">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {features.map((f, i) => (
        <div class={`card-surface rounded-xl p-6 animate-entrance stagger-${i + 1}`}>
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-lg flex items-center justify-center" style={`border: 1px solid ${f.color}; background: ${f.bg};`}>
              <Fragment set:html={f.icon} />
            </div>
            <div>
              <h3 class="fluid-h3 font-semibold text-text-bright font-display mb-2">{f.title}</h3>
              <p class="fluid-sm text-muted"><Fragment set:html={f.desc} /></p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="section-divider content-grid"></div>

<section class="relative section-y">
  <div class="content-grid text-center">
    <SectionHeading title={t('common.getStarted')} variant="full" align="center" titleMb="1.5rem" />
    <div class="flex flex-wrap justify-center gap-3 animate-entrance stagger-2">
      <a
        href={lp('/docs/getting-started/')}
        class="btn-primary inline-flex items-center gap-2 font-bold rounded-lg text-bg"
        style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
      >
        {t('docs.documentation')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href="https://github.com/yvgude/lean-ctx"
        target="_blank"
        rel="noopener"
        class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text"
        style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        {t('common.starOnGithub')}
      </a>
    </div>
  </div>
</section>

</BaseLayout>
