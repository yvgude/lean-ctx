<script is:inline>
  (function () {
    var section = document.querySelector('.pricing-section');
    if (!section) return;
    var buttons = section.querySelectorAll('[data-cadence-btn]');
    var checkoutCtas = section.querySelectorAll('[data-checkout-cta]');

    function setCadence(cadence) {
      section.setAttribute('data-cadence', cadence);
      buttons.forEach(function (b) {
        var active = b.getAttribute('data-cadence-btn') === cadence;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      checkoutCtas.forEach(function (a) {
        var url = a.getAttribute('href').split('&interval=')[0];
        a.setAttribute('href', url + '&interval=' + cadence);
      });
    }

    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        setCadence(b.getAttribute('data-cadence-btn'));
      });
    });
    setCadence('monthly');
  })();
</script>

<script>
  import { computeRoi, DEFAULT_ROI_INPUTS, type RoiInputs } from '../lib/roiCalculator';
  import { fmtUsd, fmtCompact } from '../lib/roi';

  const form = document.querySelector<HTMLFormElement>('[data-roi-form]');
  if (form) {
    const out = (key: string, text: string) => {
      const el = form.querySelector(`[data-out="${key}"]`);
      if (el) el.textContent = text;
    };
    const res = (key: string, text: string) => {
      const el = document.querySelector(`[data-result="${key}"]`);
      if (el) el.textContent = text;
    };
    const money0 = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const num = (key: string, fallback: number): number => {
      const el = form.querySelector<HTMLInputElement>(`[data-roi="${key}"]`);
      const n = el ? parseFloat(el.value) : NaN;
      return Number.isFinite(n) ? n : fallback;
    };

    const render = () => {
      const v: RoiInputs = {
        developers: num('developers', DEFAULT_ROI_INPUTS.developers),
        tokensPerDevPerDayM: num('tokensPerDevPerDayM', DEFAULT_ROI_INPUTS.tokensPerDevPerDayM),
        pricePerMillionUsd: num('pricePerMillionUsd', DEFAULT_ROI_INPUTS.pricePerMillionUsd),
        savingsPct: num('savingsPct', DEFAULT_ROI_INPUTS.savingsPct),
      };
      out('developers', String(v.developers));
      out('tokensPerDevPerDayM', v.tokensPerDevPerDayM + ' M');
      out('pricePerMillionUsd', fmtUsd(v.pricePerMillionUsd));
      out('savingsPct', v.savingsPct + '%');

      const r = computeRoi(v);
      res('monthlyUsd', money0(r.monthlySavedUsd));
      res('yearlyUsd', money0(r.yearlySavedUsd));
      res('monthlyTokens', fmtCompact(r.monthlySavedTokens));
      res('roiMultiple', r.roiMultiple ? Math.round(r.roiMultiple) + '\u00d7' : '\u2014');
    };

    form.querySelectorAll<HTMLInputElement>('[data-roi]').forEach((el) =>
      el.addEventListener('input', render),
    );
    render();
  }
</script>
