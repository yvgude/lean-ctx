---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaSection from '../components/CtaSection.astro';
import { pricingTiers, pricingFaq, supporterOffer } from '../lib/pricing';
import { WORKING_DAYS_PER_MONTH, TEAM_SEAT_MONTHLY_USD } from '../lib/roiCalculator';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const checkIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

// Roadmap rows use a clock glyph (not a check) so buyers can instantly tell
// "ships today" from "announced / coming soon".
const clockIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>';

const ctaHref = (tier: (typeof pricingTiers)[number]) =>
  tier.cta.href.startsWith('mailto') ? tier.cta.href : lp(tier.cta.href);

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
});
---

<BaseLayout
  title="Pricing — LeanCTX"
  description="LeanCTX is free forever for local use. Pro adds a hosted Personal Cloud that syncs your own context across devices; Team adds a shared, audited context plane — one workspace, role-based access, a full audit log and a live event stream — without ever gating a local feature."
  breadcrumbs={[
    { name: 'Home', url: lp('/') },
    { name: 'Pricing', url: lp('/pricing/') },
  ]}
  extraJsonLd={faqJsonLd}
>
  <PageHero
    label="Pricing"
    title="Start free."
    highlight="Scale when your team does."
    descriptionHtml="Every local capability is <strong class='text-text-bright'>free, forever</strong>. Paid plans are purely additive — <strong class='text-text-bright'>Pro</strong> gives you a hosted Personal Cloud, and <strong class='text-text-bright'>Team</strong> gives your team and its agents one shared, audited context plane. Nothing local is ever locked behind a paywall."
    kickerTone="accent"
    titleVariant="display"
    highlightStyle="italic"
    descMaxWidth="44rem"
  />

  <div class="section-divider content-grid"></div>

  <section class="relative section-y pricing-section" data-cadence="monthly">
    <div class="content-grid">
      <div class="cadence-toggle" role="group" aria-label="Billing cadence">
        <button type="button" class="cadence-btn is-active" data-cadence-btn="monthly" aria-pressed="true">Monthly</button>
        <button type="button" class="cadence-btn" data-cadence-btn="yearly" aria-pressed="false">
          Yearly <span class="cadence-save">save 17%</span>
        </button>
      </div>

      <div class="pricing-grid">
        {pricingTiers.map((tier) => (
          <article class:list={['pricing-card', tier.featured && 'is-featured']}>
            {tier.featured && <span class="pricing-badge">Most popular</span>}

            <header>
              <h2 class="pricing-name font-display">{tier.name}</h2>
              <p class="pricing-tagline">{tier.tagline}</p>
            </header>

            <div class="pricing-price">
              {tier.priceYearly ? (
                <>
                  <span class="price-amount" data-price-monthly>{tier.priceMonthly}</span>
                  <span class="price-amount" data-price-yearly>{tier.priceYearly}</span>
                  <span class="price-unit">
                    <span data-unit-monthly>{tier.unit}</span>
                    <span data-unit-yearly>/year</span>
                  </span>
                </>
              ) : (
                <>
                  <span class="price-amount">{tier.priceMonthly}</span>
                  {tier.unit && <span class="price-unit">{tier.unit}</span>}
                </>
              )}
            </div>

            <p class="pricing-note">{tier.priceNote ?? '\u00A0'}</p>

            <a
              href={ctaHref(tier)}
              class:list={['pricing-cta', tier.featured ? 'btn-primary' : 'btn-outline']}
              data-tier={tier.id}
              {...(tier.cta.kind === 'checkout' ? { 'data-checkout-cta': '' } : {})}
            >
              {tier.cta.label}
            </a>

            <ul class="pricing-features">
              {tier.features.map((f) => (
                <li><span class="feat-check" set:html={checkIcon} />{f}</li>
              ))}
            </ul>

            {tier.roadmap && tier.roadmap.length > 0 && (
              <div class="pricing-roadmap">
                <p class="roadmap-label">On the roadmap</p>
                <ul class="roadmap-list">
                  {tier.roadmap.map((r) => (
                    <li><span class="feat-clock" set:html={clockIcon} />{r}</li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>

      <ul class="pricing-assurances" aria-label="What every plan includes">
        <li><span class="pa-check" set:html={checkIcon} />Local stays free, forever</li>
        <li><span class="pa-check" set:html={checkIcon} />Cancel or change seats anytime</li>
        <li><span class="pa-check" set:html={checkIcon} />Self-host or bring your own keys</li>
        <li><span class="pa-check" set:html={checkIcon} />Apache-2.0 core — no lock-in</li>
      </ul>

      <p class="pricing-localfree">
        <span class="lf-dot" aria-hidden="true"></span>
        <span><strong>Local-Free guarantee.</strong> Upgrading never changes what runs on your machine — the paid plane lives entirely server-side. <a href={lp('/context-os/')}>See how the planes separate →</a></span>
      </p>

      <aside class="supporter-banner">
        <div class="sb-glow" aria-hidden="true"></div>
        <div class="sb-heart" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.55-4.74-10.05-9.36C.4 9.07 1.62 5.4 5.07 4.55c2.04-.5 3.94.42 5.03 1.94l1.9 2.64 1.9-2.64c1.09-1.52 2.99-2.44 5.03-1.94 3.45.85 4.67 4.52 3.12 7.09C19.55 16.26 12 21 12 21z"/></svg>
        </div>
        <div class="sb-body">
          <p class="sb-eyebrow">Solo developer · no team needed</p>
          <h3 class="sb-title font-display">Love LeanCTX? Become a Supporter.</h3>
          <p class="sb-text">
            From <strong>{supporterOffer.priceMonthly}/month</strong> — it unlocks nothing and gates nothing.
            It simply funds the open-source Context OS you rely on every day and keeps it
            independent: no VC, no telemetry, no lock-in.
          </p>
        </div>
        <a class="sb-cta" href={lp(supporterOffer.href)}>
          <span>Support lean-ctx</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </aside>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <section class="relative section-y roi-calc-section">
    <div class="content-grid-narrow">
      <SectionHeading
        label="ROI calculator"
        title="See what lean-ctx"
        highlight="saves your team"
        description="The savings come from the free, local engine — never gated behind a plan. Adjust the assumptions to match your team; everything below is an estimate."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />

      <div class="roi-calc">
        <form class="roi-inputs" data-roi-form>
          <label class="roi-field">
            <span class="roi-label">Developers <output class="roi-val" data-out="developers">5</output></span>
            <input type="range" min="1" max="100" step="1" value="5" data-roi="developers" aria-label="Developers" />
          </label>
          <label class="roi-field">
            <span class="roi-label">Context tokens / dev / day <output class="roi-val" data-out="tokensPerDevPerDayM">2 M</output></span>
            <input type="range" min="0.25" max="20" step="0.25" value="2" data-roi="tokensPerDevPerDayM" aria-label="Context tokens per developer per day, in millions" />
          </label>
          <label class="roi-field">
            <span class="roi-label">Price / 1M tokens <output class="roi-val" data-out="pricePerMillionUsd">$3.00</output></span>
            <input type="range" min="0.5" max="15" step="0.5" value="3" data-roi="pricePerMillionUsd" aria-label="Blended price per million tokens, in USD" />
          </label>
          <label class="roi-field">
            <span class="roi-label">Tokens lean-ctx removes <output class="roi-val" data-out="savingsPct">55%</output></span>
            <input type="range" min="20" max="80" step="5" value="55" data-roi="savingsPct" aria-label="Share of context tokens lean-ctx removes, in percent" />
          </label>
        </form>

        <div class="roi-results">
          <div class="roi-result roi-result--hero">
            <span class="roi-result-label">Estimated savings / month</span>
            <span class="roi-result-value" data-result="monthlyUsd">$0</span>
          </div>
          <div class="roi-result">
            <span class="roi-result-label">Per year</span>
            <span class="roi-result-value" data-result="yearlyUsd">$0</span>
          </div>
          <div class="roi-result">
            <span class="roi-result-label">Tokens saved / month</span>
            <span class="roi-result-value" data-result="monthlyTokens">0</span>
          </div>
          <div class="roi-result">
            <span class="roi-result-label">vs a full Team plan</span>
            <span class="roi-result-value" data-result="roiMultiple">&mdash;</span>
          </div>
        </div>
      </div>

      <p class="roi-disclaimer">
        Estimate only — every input is yours to change. Savings are request-side
        estimates produced by the <strong>free, local</strong> engine; no plan is
        required to realise them. Monthly figures assume {WORKING_DAYS_PER_MONTH} working
        days; the Team comparison uses the ${TEAM_SEAT_MONTHLY_USD}/seat list price.
      </p>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <section class="relative section-y faq-section">
    <div class="content-grid-narrow">
      <SectionHeading
        label="FAQ"
        title="Common"
        highlight="questions"
        description="Everything about plans, billing and the Local-Free guarantee."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />
      <div class="faq-list">
        {pricingFaq.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">
              {item.q}
              <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <CtaSection
    eyebrow="Ready?"
    title="Free to start."
    titleHighlight="Yours to scale."
    description="Install in seconds and keep everything local — upgrade only when your team needs one shared context."
    align="center"
    actions={[
      { label: 'Install LeanCTX', href: lp('/docs/getting-started/'), variant: 'primary', icon: 'arrow' },
      { label: 'Manage your account', href: lp('/account/billing/'), variant: 'outline' },
    ]}
  />
</BaseLayout>

<style>
  .cadence-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    margin: 0 auto clamp(2rem, 1.5rem + 1.5vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    width: fit-content;
  }
  .pricing-section .content-grid { display: flex; flex-direction: column; }
  .cadence-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-muted);
    font-family: inherit;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
    white-space: nowrap;
  }
  .cadence-btn:hover { color: var(--color-text-bright); }
  .cadence-btn.is-active {
    background: var(--color-surface-3);
    color: var(--color-text-bright);
  }
  .cadence-save {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    align-items: stretch;
  }
  @media (min-width: 600px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .pricing-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius-lg);
    background: var(--color-surface);
    transition: border-color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .pricing-card:hover { border-color: var(--color-border-light); }
  .pricing-card.is-featured {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 6%, var(--color-surface)), var(--color-surface));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-accent) 30%, transparent),
      0 24px 60px -30px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  @media (min-width: 1024px) {
    .pricing-card.is-featured { transform: translateY(-0.75rem); }
  }

  .pricing-badge {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.25rem 0.75rem;
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-bg);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .pricing-name {
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-text-bright);
    letter-spacing: var(--tracking-snug);
  }
  .pricing-tagline {
    margin-top: 0.5rem;
    font-size: var(--text-small);
    line-height: var(--leading-normal);
    color: var(--color-muted);
    min-height: 2.8em;
  }

  .pricing-price {
    margin-top: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .price-amount {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3rem);
    font-weight: var(--weight-bold);
    color: var(--color-text-bright);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }
  .price-unit { font-size: var(--text-small); color: var(--color-muted); }
  .pricing-note {
    margin-top: 0.5rem;
    font-size: var(--text-caption);
    color: var(--color-muted);
    min-height: 1.2em;
  }

  /* cadence-driven price visibility (CSS, works without JS) */
  .pricing-section[data-cadence='monthly'] [data-price-yearly],
  .pricing-section[data-cadence='monthly'] [data-unit-yearly],
  .pricing-section[data-cadence='yearly'] [data-price-monthly],
  .pricing-section[data-cadence='yearly'] [data-unit-monthly] { display: none; }

  .pricing-cta {
    margin-top: clamp(1.25rem, 1rem + 0.75vw, 1.75rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.75rem 1.25rem;
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    border-radius: var(--card-radius);
    text-decoration: none;
  }

  .pricing-features {
    margin-top: clamp(1.25rem, 1rem + 0.75vw, 1.75rem);
    padding-top: clamp(1.25rem, 1rem + 0.75vw, 1.75rem);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    list-style: none;
  }
  .pricing-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }
  .feat-check {
    flex-shrink: 0;
    margin-top: 0.05rem;
    color: var(--color-accent);
  }
  .feat-check :global(svg) { width: 1rem; height: 1rem; }

  .pricing-roadmap {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }
  .roadmap-label {
    margin-bottom: 0.6rem;
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .roadmap-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .roadmap-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }
  .feat-clock { flex-shrink: 0; margin-top: 0.05rem; color: var(--color-muted); }
  .feat-clock :global(svg) { width: 1rem; height: 1rem; }

  .pricing-assurances {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem clamp(1rem, 0.5rem + 1.5vw, 2rem);
    margin: clamp(2rem, 1.5rem + 1.5vw, 3rem) auto 0;
    max-width: 52rem;
    padding: 0;
  }
  .pricing-assurances li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }
  .pa-check { display: inline-flex; flex-shrink: 0; color: var(--color-accent); }
  .pa-check :global(svg) { width: 0.95rem; height: 0.95rem; }

  .pricing-localfree {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: clamp(1.25rem, 1rem + 0.75vw, 1.75rem) auto 0;
    max-width: 46rem;
    padding: 1rem 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    border-radius: var(--card-radius);
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }
  .pricing-localfree strong { color: var(--color-text-bright); }
  .pricing-localfree a { color: var(--color-accent); text-decoration: none; white-space: nowrap; }
  .pricing-localfree a:hover { text-decoration: underline; }
  .lf-dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .supporter-banner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
    margin: clamp(1.25rem, 1rem + 0.75vw, 1.75rem) auto 0;
    max-width: 46rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
    border-radius: var(--card-radius-lg);
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 55%),
      radial-gradient(120% 140% at 100% 100%, color-mix(in srgb, var(--color-accent-2) 12%, transparent), transparent 55%),
      var(--color-surface);
    box-shadow: 0 24px 60px -36px color-mix(in srgb, var(--color-accent) 45%, transparent);
    overflow: hidden;
  }
  .sb-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 80% at 12% 0%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 60%);
    pointer-events: none;
  }
  .sb-heart {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    color: #0a0a0f;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
    box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--color-accent) 60%, transparent);
  }
  .sb-heart svg {
    width: 1.6rem;
    height: 1.6rem;
    transform-origin: center;
    animation: sb-beat 2.4s ease-in-out infinite;
  }
  @keyframes sb-beat {
    0%, 60%, 100% { transform: scale(1); }
    20% { transform: scale(1.18); }
    40% { transform: scale(1.06); }
  }
  .sb-body { position: relative; flex: 1; min-width: 0; }
  .sb-eyebrow {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .sb-title {
    margin-top: 0.3rem;
    font-size: var(--text-h4, 1.15rem);
    font-weight: var(--weight-semibold);
    color: var(--color-text-bright);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight, 1.2);
  }
  .sb-text {
    margin-top: 0.5rem;
