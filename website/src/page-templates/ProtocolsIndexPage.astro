<style>
  /* ═══════ Details / Expand / Collapse ═══════════════════ */
  .proto-details {
    border-radius: clamp(10px, 0.8vw, 14px);
  }
  .proto-summary {
    display: block;
    cursor: pointer;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    position: relative;
    text-decoration: none;
    transition: border-color 0.25s ease;
    list-style: none;
  }
  .proto-summary::-webkit-details-marker,
  .proto-summary::marker {
    display: none;
  }
  .proto-summary:hover {
    border-color: rgba(var(--proto-color-rgb), 0.2);
  }

  .proto-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
    font-weight: 500;
    transition: gap 0.2s ease;
  }
  .proto-summary:hover .proto-toggle {
    gap: 0.625rem;
  }
  .proto-chevron {
    transition: transform 0.3s ease;
  }
  .proto-details[open] .proto-chevron {
    transform: rotate(180deg);
  }
  .proto-toggle-close { display: none; }
  .proto-details[open] .proto-toggle-open { display: none; }
  .proto-details[open] .proto-toggle-close { display: inline; }

  .proto-detail-body {
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    padding-top: 0;
    border-top: 1px solid var(--color-border);
    margin-top: clamp(1.5rem, 1rem + 1vw, 2rem);
  }
  .proto-detail-section {
    padding-top: clamp(2rem, 1.5rem + 1.5vw, 3.5rem);
  }
  .proto-detail-section + .proto-detail-section {
    border-top: 1px solid var(--color-border);
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 3.5rem);
  }

  /* ═══════ Overview Cards (shared) ══════════════════════ */
  .proto-badge {
    position: absolute;
    top: -12px;
    left: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    background: var(--color-bg);
    border: 1px solid;
    border-radius: 6px;
    padding: 3px 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .proto-dim-card {
    display: flex;
    flex-direction: column;
    padding: clamp(0.625rem, 0.5rem + 0.25vw, 0.875rem);
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .proto-symbol {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
  }

  .proto-callout-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.12);
    margin-top: 2px;
  }

  .proto-auto-link {
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .proto-auto-link:hover { opacity: 0.8; }

  @media (max-width: 640px) {
    .proto-summary { padding: clamp(1.25rem, 1rem + 0.5vw, 1.5rem); }
    .proto-detail-body { padding: clamp(1.25rem, 1rem + 0.5vw, 1.5rem); padding-top: 0; }
  }
  @media (min-width: 1024px) {
    .proto-summary { padding: clamp(2rem, 1.5rem + 1vw, 2.5rem); }
    .proto-detail-body { padding: clamp(2rem, 1.5rem + 1vw, 2.5rem); padding-top: 0; }
  }

  /* ═══════ CEP Styles ═══════════════════════════════════ */
  .cep-how-card {
    padding: clamp(1.25rem, 1rem + 0.5vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: clamp(10px, 0.8vw, 14px);
    background: var(--color-bg);
  }
  .cep-how-number {
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .cep-dim-card {
    padding: clamp(1.25rem, 1rem + 0.75vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: clamp(10px, 0.8vw, 14px);
    background: var(--color-bg);
  }
  .cep-dim-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .cep-dim-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cep-dim-metric {
    margin-top: 1rem;
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .cep-level-card {
    padding: clamp(1.25rem, 1rem + 0.75vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: clamp(10px, 0.8vw, 14px);
    background: var(--color-bg);
  }
  .cep-level-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .cep-level-instruction {
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .cep-table-wrap {
    border: 1px solid var(--color-border);
    border-radius: clamp(10px, 0.8vw, 14px);
    overflow: hidden;
  }
  .cep-table {
    width: 100%;
    border-collapse: collapse;
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
  }
  .cep-table thead { background: var(--color-surface); }
  .cep-table th {
    padding: 0.75rem 1.25rem;
    text-align: start;
    font-weight: 600;
    color: var(--color-text-bright);
    border-bottom: 1px solid var(--color-border);
    font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cep-table td {
    padding: 0.625rem 1.25rem;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
  }
  .cep-table tr:last-child td { border-bottom: none; }
  .cep-table tr:hover td { background: var(--color-surface); }
