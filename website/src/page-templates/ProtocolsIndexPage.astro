---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';

import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout title={t('protocolsIndex.title')} description={t('protocolsIndex.description')} breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: t('protocolsIndex.heroLabel'), url: lp('/protocols/') }]}>

<!-- ═══════ HERO ═══════ -->
<PageHero
  label={t('protocolsIndex.heroLabel')}
  title={t('protocolsIndex.heroTitle')}
  highlight={t('protocolsIndex.heroHighlight')}
  description={t('protocolsIndex.heroDesc')}
  highlightStyle="italic"
/>


<div class="section-divider content-grid"></div>


<!-- ═══════════════════════════════════════════════════════════
     CEP — Context Efficiency Protocol
     ═══════════════════════════════════════════════════════════ -->
<section class="section-y" id="cep">
  <div class="content-grid">
    <details class="proto-details animate-entrance" style="--proto-color: var(--color-accent); --proto-color-rgb: 52, 211, 153;">
      <summary class="proto-summary card">
        <div class="proto-badge" style="border-color: rgba(52,211,153,0.25); color: var(--color-accent);">CEP</div>

        <div class="grid lg:grid-cols-[1fr_1.1fr]" style="gap: clamp(1.5rem, 1rem + 1.25vw, 2.5rem);">
          <div>
            <h2 class="fluid-h2 font-bold font-display text-text-bright" style="margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);">
              {t('protocolsIndex.cepTitle')}
            </h2>
            <p class="fluid-body text-muted" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2rem);">
              {t('protocolsIndex.cepDesc')}
            </p>

            <div class="grid grid-cols-2" style="gap: clamp(0.5rem, 0.25rem + 0.5vw, 0.75rem); margin-bottom: clamp(1.5rem, 1rem + 1vw, 2rem);">
              <div class="proto-dim-card">
                <span class="text-accent font-bold font-display" style="font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem);">{t('protocolsIndex.cepDimCache')}</span>
                <span class="fluid-sm text-muted">{t('protocolsIndex.cepDimCacheDesc')}</span>
              </div>
              <div class="proto-dim-card">
                <span class="text-accent font-bold font-display" style="font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem);">{t('protocolsIndex.cepDimModes')}</span>
                <span class="fluid-sm text-muted">{t('protocolsIndex.cepDimModesDesc')}</span>
              </div>
              <div class="proto-dim-card">
                <span class="text-accent font-bold font-display" style="font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem);">{t('protocolsIndex.cepDimCompress')}</span>
                <span class="fluid-sm text-muted">{t('protocolsIndex.cepDimCompressDesc')}</span>
              </div>
              <div class="proto-dim-card">
                <span class="text-accent font-bold font-display" style="font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem);">{t('protocolsIndex.cepDimAction')}</span>
                <span class="fluid-sm text-muted">{t('protocolsIndex.cepDimActionDesc')}</span>
              </div>
            </div>

            <span class="proto-toggle text-accent">
              <span class="proto-toggle-open">{t('protocolsIndex.cepLink')}</span>
              <span class="proto-toggle-close">{t('protocolsIndex.collapseLabel') || 'Collapse'}</span>
              <svg class="proto-chevron w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </div>

          <div class="terminal-chrome">
            <div class="terminal-header flex items-center gap-2 px-4 py-2.5">
              <span class="terminal-dot bg-[#ff5f57]"></span>
              <span class="terminal-dot bg-[#febc2e]"></span>
              <span class="terminal-dot bg-[#28c840]"></span>
              <span class="ml-3 text-xs text-muted font-mono">CEP Score</span>
            </div>
            <div class="px-4 sm:px-6 py-4 sm:py-5">
              <pre class="text-[11px] sm:text-[12px] font-mono leading-[1.8] text-text whitespace-pre"><span class="text-accent font-bold">CEP Score: 87/100</span>

<span class="text-muted/60">Dimensions:</span>
  Cache hits      <span class="text-accent">████████░░</span> 82%
  Mode diversity  <span class="text-accent">█████████░</span> 91%
  Compression     <span class="text-accent">████████░░</span> 85%
  Action-first    <span class="text-accent">█████████░</span> 90%

<span class="text-muted/60">Task complexity:</span> <span class="text-accent-2">Standard</span>
<span class="text-muted/50">Instruction: BRIEF DELTA NOREPEAT STRUCT</span></pre>
            </div>
          </div>
        </div>
      </summary>

      <!-- ── CEP Deep Dive ──────────────────────────────── -->
      <div class="proto-detail-body">

        <!-- What CEP Does -->
        <div class="proto-detail-section">
          <p class="fluid-label text-muted" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
            {t('protocolsCep.whatLabel')}
          </p>
          <h3 class="font-display fluid-h3 font-bold text-text-bright" style="margin-bottom: clamp(1.25rem, 1rem + 0.5vw, 2rem);">
            {t('protocolsCep.whatTitle')}
          </h3>
          <p class="text-muted fluid-body" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); max-width: 48rem;">
            {t('protocolsCep.whatDesc')}
          </p>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);">
            <div class="cep-how-card">
              <span class="cep-how-number font-display text-accent">01</span>
              <p class="fluid-sm text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.step1Title')}</p>
              <p class="fluid-sm text-muted">{t('protocolsCep.step1Desc')}</p>
            </div>
            <div class="cep-how-card">
              <span class="cep-how-number font-display text-accent">02</span>
              <p class="fluid-sm text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.step2Title')}</p>
              <p class="fluid-sm text-muted">{t('protocolsCep.step2Desc')}</p>
            </div>
            <div class="cep-how-card">
              <span class="cep-how-number font-display text-accent">03</span>
              <p class="fluid-sm text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.step3Title')}</p>
              <p class="fluid-sm text-muted">{t('protocolsCep.step3Desc')}</p>
            </div>
            <div class="cep-how-card">
              <span class="cep-how-number font-display text-accent">04</span>
              <p class="fluid-sm text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.step4Title')}</p>
              <p class="fluid-sm text-muted">{t('protocolsCep.step4Desc')}</p>
            </div>
          </div>
        </div>

        <!-- The Four Dimensions -->
        <div class="proto-detail-section">
          <p class="fluid-label text-muted" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
            {t('protocolsCep.scoringLabel')}
          </p>
          <h3 class="font-display fluid-h3 font-bold text-text-bright" style="margin-bottom: clamp(1.25rem, 1rem + 0.5vw, 2rem);">
            {t('protocolsCep.scoringTitle')}
          </h3>
          <p class="text-muted fluid-body" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); max-width: 48rem;">
            {t('protocolsCep.scoringDesc')}
          </p>

          <div class="grid sm:grid-cols-2" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);">
            <div class="cep-dim-card">
              <div class="cep-dim-header">
                <span class="cep-dim-icon text-accent">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"/></svg>
                </span>
                <h4 class="font-display fluid-h3 font-semibold text-text-bright">{t('protocolsCep.dimCacheTitle')}</h4>
              </div>
              <p class="fluid-sm text-muted" style="margin-top: 0.5rem;">{t('protocolsCep.dimCacheDesc')}</p>
              <p class="cep-dim-metric font-mono text-accent">{t('protocolsCep.dimCacheMetric')}</p>
            </div>

            <div class="cep-dim-card">
              <div class="cep-dim-header">
                <span class="cep-dim-icon text-accent-2">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
                </span>
                <h4 class="font-display fluid-h3 font-semibold text-text-bright">{t('protocolsCep.dimModesTitle')}</h4>
              </div>
              <p class="fluid-sm text-muted" style="margin-top: 0.5rem;" set:html={t('protocolsCep.dimModesDesc')} />
              <p class="cep-dim-metric font-mono text-accent-2">{t('protocolsCep.dimModesMetric')}</p>
            </div>

            <div class="cep-dim-card">
              <div class="cep-dim-header">
                <span class="cep-dim-icon text-accent-3">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M17.25 21l3.75-3.75"/></svg>
                </span>
                <h4 class="font-display fluid-h3 font-semibold text-text-bright">{t('protocolsCep.dimCompressTitle')}</h4>
              </div>
              <p class="fluid-sm text-muted" style="margin-top: 0.5rem;">{t('protocolsCep.dimCompressDesc')}</p>
              <p class="cep-dim-metric font-mono text-accent-3">{t('protocolsCep.dimCompressMetric')}</p>
            </div>

            <div class="cep-dim-card">
              <div class="cep-dim-header">
                <span class="cep-dim-icon" style="color: var(--color-text-bright);">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
                </span>
                <h4 class="font-display fluid-h3 font-semibold text-text-bright">{t('protocolsCep.dimActionTitle')}</h4>
              </div>
              <p class="fluid-sm text-muted" style="margin-top: 0.5rem;">{t('protocolsCep.dimActionDesc')}</p>
              <p class="cep-dim-metric font-mono text-text-bright">{t('protocolsCep.dimActionMetric')}</p>
            </div>
          </div>
        </div>

        <!-- Complexity Levels -->
        <div class="proto-detail-section">
          <p class="fluid-label text-muted" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
            {t('protocolsCep.complexityLabel')}
          </p>
          <h3 class="font-display fluid-h3 font-bold text-text-bright" style="margin-bottom: clamp(1.25rem, 1rem + 0.5vw, 2rem);">
            {t('protocolsCep.complexityTitle')}
          </h3>
          <p class="text-muted fluid-body" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); max-width: 48rem;">
            {t('protocolsCep.complexityDesc')}
          </p>

          <div class="grid md:grid-cols-3" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);">
            <div class="cep-level-card">
              <span class="cep-level-dot" style="background: var(--color-accent);"></span>
              <h4 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 0.75rem 0 0.375rem;">{t('protocolsCep.mechanicalTitle')}</h4>
              <p class="fluid-sm text-muted" style="margin-bottom: 1rem;">{t('protocolsCep.mechanicalDesc')}</p>
              <div class="cep-level-instruction font-mono">
                <span class="text-accent">ACT1</span> <span class="text-muted">&middot;</span> <span class="text-accent">DELTA</span> <span class="text-muted">&middot;</span> <span class="text-accent">1LINE</span>
              </div>
            </div>
            <div class="cep-level-card">
              <span class="cep-level-dot" style="background: var(--color-accent-2);"></span>
              <h4 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 0.75rem 0 0.375rem;">{t('protocolsCep.standardTitle')}</h4>
              <p class="fluid-sm text-muted" style="margin-bottom: 1rem;">{t('protocolsCep.standardDesc')}</p>
              <div class="cep-level-instruction font-mono">
                <span class="text-accent-2">BRIEF</span> <span class="text-muted">&middot;</span> <span class="text-accent-2">DELTA</span> <span class="text-muted">&middot;</span> <span class="text-accent-2">NOREPEAT</span> <span class="text-muted">&middot;</span> <span class="text-accent-2">STRUCT</span>
              </div>
            </div>
            <div class="cep-level-card">
              <span class="cep-level-dot" style="background: var(--color-accent-3);"></span>
              <h4 class="font-display fluid-h3 font-semibold text-text-bright" style="margin: 0.75rem 0 0.375rem;">{t('protocolsCep.architecturalTitle')}</h4>
              <p class="fluid-sm text-muted" style="margin-bottom: 1rem;">{t('protocolsCep.architecturalDesc')}</p>
              <div class="cep-level-instruction font-mono">
                <span class="text-accent-3">FULL</span> <span class="text-muted">&middot;</span> <span class="text-accent-3">QUALITY</span> <span class="text-muted">&middot;</span> <span class="text-accent-3">NOREPEAT</span> <span class="text-muted">&middot;</span> <span class="text-accent-3">STRUCT</span> <span class="text-muted">&middot;</span> <span class="text-accent-3">FREF</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Instruction Codes -->
        <div class="proto-detail-section">
          <p class="fluid-label text-muted" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
            {t('protocolsCep.refLabel')}
          </p>
          <h3 class="font-display fluid-h3 font-bold text-text-bright" style="margin-bottom: clamp(1.25rem, 1rem + 0.5vw, 2rem);">
            {t('protocolsCep.refTitle')}
          </h3>
          <p class="text-muted fluid-body" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); max-width: 48rem;">
            {t('protocolsCep.refDesc')}
          </p>

          <div class="cep-table-wrap">
            <table class="cep-table">
              <thead>
                <tr>
                  <th>{t('protocolsCep.thCode')}</th>
                  <th>{t('protocolsCep.thDescription')}</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><code class="cep-code text-accent">ACT1</code></td><td>{t('protocolsCep.codeACT1')}</td></tr>
                <tr><td><code class="cep-code text-accent">BRIEF</code></td><td>{t('protocolsCep.codeBRIEF')}</td></tr>
                <tr><td><code class="cep-code text-accent">FULL</code></td><td>{t('protocolsCep.codeFULL')}</td></tr>
                <tr><td><code class="cep-code text-accent">DELTA</code></td><td>{t('protocolsCep.codeDELTA')}</td></tr>
                <tr><td><code class="cep-code text-accent">NOREPEAT</code></td><td>{t('protocolsCep.codeNOREPEAT')}</td></tr>
                <tr><td><code class="cep-code text-accent">STRUCT</code></td><td>{t('protocolsCep.codeSTRUCT')}</td></tr>
                <tr><td><code class="cep-code text-accent">1LINE</code></td><td>{t('protocolsCep.code1LINE')}</td></tr>
                <tr><td><code class="cep-code text-accent">NODOC</code></td><td>{t('protocolsCep.codeNODOC')}</td></tr>
                <tr><td><code class="cep-code text-accent">ACTFIRST</code></td><td>{t('protocolsCep.codeACTFIRST')}</td></tr>
                <tr><td><code class="cep-code text-accent">QUALITY</code></td><td>{t('protocolsCep.codeQUALITY')}</td></tr>
                <tr><td><code class="cep-code text-accent">NOMOCK</code></td><td>{t('protocolsCep.codeNOMOCK')}</td></tr>
                <tr><td><code class="cep-code text-accent">FREF</code></td><td>{t('protocolsCep.codeFREF')}</td></tr>
                <tr><td><code class="cep-code text-accent">DIFF</code></td><td>{t('protocolsCep.codeDIFF')}</td></tr>
                <tr><td><code class="cep-code text-accent">ABBREV</code></td><td>{t('protocolsCep.codeABBREV')}</td></tr>
                <tr><td><code class="cep-code text-accent">SYMBOLS</code></td><td>{t('protocolsCep.codeSYMBOLS')}</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Communication Rules -->
        <div class="proto-detail-section">
          <p class="fluid-label text-muted" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
            {t('protocolsCep.rulesLabel')}
          </p>
          <h3 class="font-display fluid-h3 font-bold text-text-bright" style="margin-bottom: clamp(1.25rem, 1rem + 0.5vw, 2rem);">
            {t('protocolsCep.rulesTitle')}
          </h3>
          <p class="text-muted fluid-body" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem); max-width: 48rem;">
            {t('protocolsCep.rulesDesc')}
          </p>

          <div class="cep-rules-list">
            <div class="cep-rule-item">
              <span class="cep-rule-num font-display text-accent">1</span>
              <div>
                <p class="fluid-body text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.rule1Title')}</p>
                <p class="fluid-sm text-muted">{t('protocolsCep.rule1Desc')}</p>
              </div>
            </div>
            <div class="cep-rule-item">
              <span class="cep-rule-num font-display text-accent">2</span>
              <div>
                <p class="fluid-body text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.rule2Title')}</p>
                <p class="fluid-sm text-muted" set:html={t('protocolsCep.rule2Desc')} />
              </div>
            </div>
            <div class="cep-rule-item">
              <span class="cep-rule-num font-display text-accent">3</span>
              <div>
                <p class="fluid-body text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.rule3Title')}</p>
                <p class="fluid-sm text-muted" set:html={t('protocolsCep.rule3Desc')} />
              </div>
            </div>
            <div class="cep-rule-item">
              <span class="cep-rule-num font-display text-accent">4</span>
              <div>
                <p class="fluid-body text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.rule4Title')}</p>
                <p class="fluid-sm text-muted">{t('protocolsCep.rule4Desc')}</p>
              </div>
            </div>
            <div class="cep-rule-item">
              <span class="cep-rule-num font-display text-accent">5</span>
              <div>
                <p class="fluid-body text-text-bright font-medium" style="margin-bottom: 0.25rem;">{t('protocolsCep.rule5Title')}</p>
                <p class="fluid-sm text-muted">{t('protocolsCep.rule5Desc')}</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </details>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════════════════════════════════════════════════════════
     CCP — Context Continuity Protocol
     ═══════════════════════════════════════════════════════════ -->
<section class="section-y" id="ccp">
  <div class="content-grid">
    <details class="proto-details animate-entrance" style="--proto-color: var(--color-accent-2); --proto-color-rgb: 129, 140, 248;">
      <summary class="proto-summary card">
        <div class="proto-badge" style="border-color: rgba(129,140,248,0.25); color: var(--color-accent-2);">CCP</div>

        <div class="grid lg:grid-cols-[1fr_1.1fr]" style="gap: clamp(1.5rem, 1rem + 1.25vw, 2.5rem);">
          <div>
            <h2 class="fluid-h2 font-bold font-display text-text-bright" style="margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);">
              {t('protocolsIndex.ccpTitle')}
            </h2>
            <p class="fluid-body text-muted" style="margin-bottom: clamp(1.5rem, 1rem + 1vw, 2rem);">
              {t('protocolsIndex.ccpDesc')}
            </p>

            <div class="grid grid-cols-2" style="gap: clamp(0.5rem, 0.25rem + 0.5vw, 0.75rem); margin-bottom: clamp(1.5rem, 1rem + 1vw, 2rem);">
              <div class="proto-dim-card">
                <span class="text-accent-2 font-bold font-display" style="font-size: clamp(1.25rem, 1rem + 0.5vw, 1.75rem);">~400</span>
                <span class="fluid-sm text-muted">{t('protocolsIndex.ccpStatTokens')}</span>
              </div>
              <div class="proto-dim-card">
