---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';

import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout title={t('protocolsIndex.title')} description={t('protocolsIndex.description')} breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: t('protocolsIndex.heroLabel'), url: lp('/protocols/') }]}>

<!-- ═══════ HERO ═══════ -->
<PageHero
  label={t('protocolsIndex.heroLabel')}
  title={t('protocolsIndex.heroTitle')}
  highlight={t('protocolsIndex.heroHighlight')}
  description={t('protocolsIndex.heroDesc')}
  highlightStyle="italic"
/>


<div class="section-divider content-grid"></div>


<!-- ═══════ PROTOCOL CARDS ═══════ -->
<section class="section-y">
  <div class="content-grid">
    <div class="grid md:grid-cols-2 lg:grid-cols-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">

      <!-- CEP -->
      <div class="proto-card card animate-entrance" id="cep">
        <div class="proto-card-badge" style="color: var(--color-accent); border-color: rgba(52,211,153,0.25);">CEP</div>
        <h3 class="fluid-h3 font-bold font-display text-text-bright" style="margin: 0.75rem 0 0.5rem;">
          {t('protocolsIndex.cepTitle')}
        </h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 1.25rem;">
          {t('protocolsIndex.cepDesc')}
        </p>
        <a href={lp('/docs/concepts/protocols#cep')} class="proto-card-link text-accent">
          {t('protocolsIndex.learnMore')} <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- CCP -->
      <div class="proto-card card animate-entrance" id="ccp">
        <div class="proto-card-badge" style="color: var(--color-accent-2); border-color: rgba(129,140,248,0.25);">CCP</div>
        <h3 class="fluid-h3 font-bold font-display text-text-bright" style="margin: 0.75rem 0 0.5rem;">
          {t('protocolsIndex.ccpTitle')}
        </h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 1.25rem;">
          {t('protocolsIndex.ccpDesc')}
        </p>
        <a href={lp('/docs/concepts/protocols#ccp')} class="proto-card-link text-accent-2">
          {t('protocolsIndex.learnMore')} <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- TDD -->
      <div class="proto-card card animate-entrance" id="tdd">
        <div class="proto-card-badge" style="color: var(--color-accent-3); border-color: rgba(192,132,252,0.25);">TDD</div>
        <h3 class="fluid-h3 font-bold font-display text-text-bright" style="margin: 0.75rem 0 0.5rem;">
          {t('protocolsIndex.tddTitle')}
        </h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 1.25rem;">
          {t('protocolsIndex.tddDesc')}
        </p>
        <a href={lp('/docs/concepts/protocols#tdd')} class="proto-card-link text-accent-3">
          {t('protocolsIndex.learnMore')} <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- CLP -->
      <div class="proto-card card animate-entrance" id="clp">
        <div class="proto-card-badge" style="color: var(--color-accent); border-color: rgba(52,211,153,0.25);">CLP</div>
        <h3 class="fluid-h3 font-bold font-display text-text-bright" style="margin: 0.75rem 0 0.5rem;">
          {t('protocolsIndex.clpTitle')}
        </h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 1.25rem;">
          {t('protocolsIndex.clpDesc')}
        </p>
        <a href={lp('/docs/concepts/protocols#clp')} class="proto-card-link text-accent">
          {t('protocolsIndex.learnMore')} <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- A2A -->
      <div class="proto-card card animate-entrance" id="a2a">
        <div class="proto-card-badge" style="color: var(--color-accent-2); border-color: rgba(129,140,248,0.25);">A2A</div>
        <h3 class="fluid-h3 font-bold font-display text-text-bright" style="margin: 0.75rem 0 0.5rem;">
          {t('protocolsIndex.a2aTitle')}
        </h3>
        <p class="fluid-sm text-muted" style="margin-bottom: 1.25rem;">
          {t('protocolsIndex.a2aDesc')}
        </p>
        <a href={lp('/docs/concepts/multi-agent')} class="proto-card-link text-accent-2">
          {t('protocolsIndex.learnMore')} <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ ALL AUTOMATIC ═══════ -->
<section class="section-y">
  <div class="content-grid">
    <div class="animate-entrance" style="max-width: 48rem;">
      <div class="card" style="padding: clamp(1.5rem, 1rem + 1vw, 2.5rem);">
        <div class="flex items-start gap-4">
          <div class="proto-callout-icon flex-shrink-0">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <h3 class="fluid-h3 font-bold font-display text-text-bright" style="margin-bottom: clamp(0.5rem, 0.25rem + 0.25vw, 0.75rem);">{t('protocolsIndex.autoTitle')}</h3>
            <p class="fluid-body text-muted" style="margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1rem);">
              {t('protocolsIndex.autoDesc')}
            </p>
            <div class="flex flex-wrap gap-3 fluid-sm">
              <a href="#cep" class="flex items-center gap-1.5 proto-auto-link">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
                <span class="text-text-bright">CEP</span> <span class="text-muted">- {t('protocolsIndex.autoActive')}</span>
              </a>
              <a href="#ccp" class="flex items-center gap-1.5 proto-auto-link">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent-2"></span>
                <span class="text-text-bright">CCP</span> <span class="text-muted">- {t('protocolsIndex.autoActive')}</span>
              </a>
              <a href="#tdd" class="flex items-center gap-1.5 proto-auto-link">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent-3"></span>
                <span class="text-text-bright">TDD</span> <span class="text-muted">- {t('protocolsIndex.autoActive')}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ CTA ═══════ -->
<section class="section-y">
  <div class="content-grid">
    <SectionHeading
      title={t('protocolsIndex.ctaTitle')}
      highlight={t('protocolsIndex.ctaHighlight')}
      description={t('protocolsIndex.ctaDesc')}
      variant="full"
      breakHighlight={false}
      descMaxWidth="44rem"
      descMb="clamp(2.5rem, 2rem + 2vw, 5rem)"
    />
    <div class="flex flex-wrap items-center gap-3 animate-entrance stagger-3">
      <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center gap-2 rounded-lg" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        {t('protocolsIndex.ctaGetStarted')}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href={lp('/mcp-server')} class="btn-outline inline-flex items-center gap-2 rounded-lg" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        {t('protocolsIndex.ctaExploreTools')}
      </a>
    </div>
  </div>
</section>


<style>
  /* ═══════ Protocol Cards ═══════════════════════════════ */
  .proto-card {
    position: relative;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
  }
  .proto-card-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    border: 1px solid;
    border-radius: 6px;
    padding: 3px 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-block;
    width: fit-content;
  }
  .proto-card-link {
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.875rem);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.15s ease;
    margin-top: auto;
  }
  .proto-card-link:hover { opacity: 0.8; }

  /* ═══════ Shared ═══════════════════════════════════════ */
  .proto-callout-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.12);
    margin-top: 2px;
  }
  .proto-auto-link {
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .proto-auto-link:hover { opacity: 0.8; }
</style>

</BaseLayout>
