---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);

const architectureCards = [
  {
    title: t('safety.architectureLocal'),
    desc: t('safety.architectureLocalDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25A2.25 2.25 0 015.25 3h13.5A2.25 2.25 0 0121 5.25z"/></svg>`,
    color: 'rgba(52, 211, 153, 0.25)',
    bg: 'rgba(52, 211, 153, 0.08)',
  },
  {
    title: t('safety.architectureFallback'),
    desc: t('safety.architectureFallbackDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>`,
    color: 'rgba(96, 165, 250, 0.25)',
    bg: 'rgba(96, 165, 250, 0.08)',
  },
  {
    title: t('safety.architectureReadonly'),
    desc: t('safety.architectureReadonlyDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    color: 'rgba(192, 132, 252, 0.25)',
    bg: 'rgba(192, 132, 252, 0.08)',
  },
];

const securityCards = [
  {
    title: t('safety.securityPathGuard'),
    desc: t('safety.securityPathGuardDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>`,
    color: 'rgba(251, 191, 36, 0.25)',
    bg: 'rgba(251, 191, 36, 0.08)',
  },
  {
    title: t('safety.securitySandbox'),
    desc: t('safety.securitySandboxDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>`,
    color: 'rgba(244, 114, 182, 0.25)',
    bg: 'rgba(244, 114, 182, 0.08)',
  },
  {
    title: t('safety.securityNoNetwork'),
    desc: t('safety.securityNoNetworkDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>`,
    color: 'rgba(129, 140, 248, 0.25)',
    bg: 'rgba(129, 140, 248, 0.08)',
  },
];

const testingCards = [
  {
    title: t('safety.testingTests'),
    desc: t('safety.testingTestsDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    color: 'rgba(52, 211, 153, 0.25)',
    bg: 'rgba(52, 211, 153, 0.08)',
  },
  {
    title: t('safety.testingClippy'),
    desc: t('safety.testingClippyDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>`,
    color: 'rgba(251, 191, 36, 0.25)',
    bg: 'rgba(251, 191, 36, 0.08)',
  },
  {
    title: t('safety.testingCi'),
    desc: t('safety.testingCiDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/></svg>`,
    color: 'rgba(96, 165, 250, 0.25)',
    bg: 'rgba(96, 165, 250, 0.08)',
  },
];

const transparencyCards = [
  {
    title: t('safety.transparencyOpenSource'),
    desc: t('safety.transparencyOpenSourceDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>`,
    color: 'rgba(192, 132, 252, 0.25)',
    bg: 'rgba(192, 132, 252, 0.08)',
  },
  {
    title: t('safety.transparencyNoTelemetry'),
    desc: t('safety.transparencyNoTelemetryDesc'),
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>`,
    color: 'rgba(244, 114, 182, 0.25)',
    bg: 'rgba(244, 114, 182, 0.08)',
  },
];

const sections = [
  { title: t('safety.architectureTitle'), cards: architectureCards },
  { title: t('safety.securityTitle'), cards: securityCards },
  { title: t('safety.testingTitle'), cards: testingCards },
  { title: t('safety.transparencyTitle'), cards: transparencyCards },
];
---

<BaseLayout
  title={`${t('safety.title')} — LeanCTX`}
  description={t('safety.metaDescription')}
  breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: t('safety.title'), url: lp('/safety/') }]}>

<section class="section-hero">
  <div class="content-grid">
    <div class="animate-entrance">
      <p class="fluid-label text-accent" style="margin-bottom: clamp(1.25rem, 1rem + 1vw, 2.5rem);">{t('safety.labelSafety')}</p>
    </div>
    <h1 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: 1rem;">
      {t('safety.title')}
    </h1>
    <p class="fluid-body text-muted animate-entrance stagger-2" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 5rem); max-width: 44rem;">
      {t('safety.heroSubtitle')}
    </p>
  </div>
</section>

{sections.map((section, si) => (
  <Fragment>
    <div class="section-divider content-grid"></div>
    <section class="relative section-y">
      <div class="content-grid">
        <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance" style="margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 3rem);">
          {section.title}
        </h2>
        <div class={`grid grid-cols-1 ${section.cards.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'} gap-6`}>
          {section.cards.map((card, ci) => (
            <div class={`card-surface rounded-xl p-6 animate-entrance stagger-${ci + 1}`}>
              <div class="flex items-start gap-4 mb-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-lg flex items-center justify-center" style={`border: 1px solid ${card.color}; background: ${card.bg};`}>
                  <Fragment set:html={card.icon} />
                </div>
              </div>
              <h3 class="fluid-h3 font-semibold text-text-bright font-display mb-2">{card.title}</h3>
              <p class="fluid-sm text-muted">{card.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </Fragment>
))}

</BaseLayout>
