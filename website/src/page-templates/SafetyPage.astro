---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout
  title={`${t('safety.title')} — LeanCTX`}
  description={t('safety.metaDescription')}
  breadcrumbs={[{ name: t('common.home'), url: lp('/') }, { name: t('safety.title'), url: lp('/safety/') }]}>

<!-- ═══════ HERO ═══════ -->
<section class="section-hero">
  <div class="content-grid">
    <div class="animate-entrance">
      <p class="fluid-label text-muted" style="margin-bottom: clamp(1.25rem, 1rem + 1vw, 2.5rem);">
        {t('safety.heroLabel')}
      </p>
    </div>
    <h1 class="font-display fluid-h1 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 3rem);">
      {t('safety.heroTitlePre')}<br/>
      <span class="gradient-text">{t('safety.heroTitleHighlight')}</span>
    </h1>
    <p class="fluid-body text-muted animate-entrance stagger-2" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 5rem); max-width: 44rem;">
      {t('safety.heroSubtitle')}
    </p>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ ARCHITECTURE GUARANTEES ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.archLabel')}
    </p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.archTitle')} <span class="gradient-text">{t('safety.archTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 3vw, 6rem); max-width: 48rem;">
      {t('safety.archDesc')}
    </p>

    <div class="stats-grid animate-entrance" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
      <div class="stat-item">
        <span class="stat-number font-display text-accent">{t('safety.stat1Value')}</span>
        <span class="stat-desc">{t('safety.stat1Desc')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-number font-display text-accent-2">{t('safety.stat2Value')}</span>
        <span class="stat-desc">{t('safety.stat2Desc')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-number font-display text-accent-3">{t('safety.stat3Value')}</span>
        <span class="stat-desc">{t('safety.stat3Desc')}</span>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.architectureLocal')}</h3>
        <p class="fluid-sm text-muted">{t('safety.architectureLocalDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.architectureFallback')}</h3>
        <p class="fluid-sm text-muted">{t('safety.architectureFallbackDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.architectureReadonly')}</h3>
        <p class="fluid-sm text-muted">{t('safety.architectureReadonlyDesc')}</p>
      </div>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ SECURITY ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.secLabel')}
    </p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.secTitle')} <span class="gradient-text">{t('safety.secTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 3vw, 6rem); max-width: 48rem;">
      {t('safety.secDesc')}
    </p>

    <div class="animate-entrance">
      <div class="terminal-chrome">
        <div class="terminal-header flex items-center gap-2 px-4 py-2.5">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="text-muted text-[11px] ml-2 font-mono">{t('safety.secTerminalLabel')}</span>
        </div>
        <div class="px-4 sm:px-6 py-4 sm:py-5">
          <pre class="text-[11px] sm:text-[13px] font-mono leading-[1.8] text-text whitespace-pre"><span class="text-muted/60">$</span> <span class="text-text-bright">ctx_read</span>(<span class="text-accent">"../../etc/passwd"</span>)

<span class="text-red-400 font-bold">ERROR: Path traversal blocked</span>
  <span class="text-muted/40">├─ Requested: ../../etc/passwd</span>
  <span class="text-muted/40">├─ Resolved:  /etc/passwd</span>
  <span class="text-muted/40">└─ Allowed:   /home/user/project/**</span>

<span class="text-muted/60">$</span> <span class="text-text-bright">ctx_read</span>(<span class="text-accent">"src/main.rs"</span>)

<span class="text-accent font-bold">✓ Reading src/main.rs</span> <span class="text-muted">(mode: auto)</span>
  <span class="text-muted/40">→ 42 lines, 1.2 KB → compressed to 18 tokens</span></pre>
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem); margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.securityPathGuard')}</h3>
        <p class="fluid-sm text-muted">{t('safety.securityPathGuardDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.securitySandbox')}</h3>
        <p class="fluid-sm text-muted">{t('safety.securitySandboxDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.securityNoNetwork')}</h3>
        <p class="fluid-sm text-muted">{t('safety.securityNoNetworkDesc')}</p>
      </div>
    </div>

    <div class="animate-entrance stagger-4" style="margin-top: clamp(2rem, 1.5rem + 1vw, 3rem);">
      <a href={lp('/docs/getting-started')} class="fluid-sm text-accent hover:underline inline-flex items-center gap-1.5 font-medium">
        {t('safety.secLink')}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ TESTING & QUALITY ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.testLabel')}
    </p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.testTitle')} <span class="gradient-text">{t('safety.testTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 3vw, 6rem); max-width: 48rem;">
      {t('safety.testDesc')}
    </p>

    <div class="stats-grid animate-entrance" style="margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
      <div class="stat-item">
        <span class="stat-number font-display text-accent">{t('safety.testStat1Value')}</span>
        <span class="stat-desc">{t('safety.testStat1Desc')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-number font-display text-accent-2">{t('safety.testStat2Value')}</span>
        <span class="stat-desc">{t('safety.testStat2Desc')}</span>
      </div>
      <div class="stat-item">
        <span class="stat-number font-display text-accent-3">{t('safety.testStat3Value')}</span>
        <span class="stat-desc">{t('safety.testStat3Desc')}</span>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);">
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.testingTests')}</h3>
        <p class="fluid-sm text-muted">{t('safety.testingTestsDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.testingClippy')}</h3>
        <p class="fluid-sm text-muted">{t('safety.testingClippyDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.testingCi')}</h3>
        <p class="fluid-sm text-muted">{t('safety.testingCiDesc')}</p>
      </div>
    </div>

    <div class="animate-entrance stagger-4" style="margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
      <div class="compare-card">
        <div class="compare-header compare-header--good">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
          {t('safety.compareTitle')}
        </div>
        <div class="compare-body" style="padding: 1.25rem;">
          <p class="fluid-sm text-muted">{t('safety.compareDesc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ TRANSPARENCY ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.transLabel')}
    </p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.transTitle')} <span class="gradient-text">{t('safety.transTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 3vw, 6rem); max-width: 48rem;">
      {t('safety.transDesc')}
    </p>

    <div class="animate-entrance">
      <div class="terminal-chrome">
        <div class="terminal-header flex items-center gap-2 px-4 py-2.5">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="text-muted text-[11px] ml-2 font-mono">{t('safety.transTerminalLabel')}</span>
        </div>
        <div class="px-4 sm:px-6 py-4 sm:py-5">
          <pre class="text-[11px] sm:text-[13px] font-mono leading-[1.8] text-text whitespace-pre"><span class="text-muted/60">$</span> <span class="text-text-bright">lean-ctx</span> --version

<span class="text-accent font-bold">lean-ctx 3.4.3</span>
  <span class="text-muted/40">├─ License:         Apache-2.0</span>
  <span class="text-muted/40">├─ Source:          github.com/yvgude/lean-ctx</span>
  <span class="text-muted/40">├─ Network calls:   0 (default)</span>
  <span class="text-muted/40">├─ Telemetry:       disabled</span>
  <span class="text-muted/40">└─ Data collection: none</span></pre>
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem); margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.transparencyOpenSource')}</h3>
        <p class="fluid-sm text-muted">{t('safety.transparencyOpenSourceDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.transparencyNoTelemetry')}</h3>
        <p class="fluid-sm text-muted">{t('safety.transparencyNoTelemetryDesc')}</p>
      </div>
    </div>

    <div class="animate-entrance stagger-4" style="margin-top: clamp(2rem, 1.5rem + 1vw, 3rem);">
      <a href="https://github.com/yvgude/lean-ctx" class="fluid-sm text-accent hover:underline inline-flex items-center gap-1.5 font-medium" target="_blank" rel="noopener">
        {t('safety.transLink')}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ OUTPUT VERIFICATION ═══════ -->
<section class="relative section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.verifyLabel')}
    </p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.verifyTitle')} <span class="gradient-text">{t('safety.verifyTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(3rem, 2rem + 3vw, 6rem); max-width: 48rem;">
      {t('safety.verifyDesc')}
    </p>

    <div class="animate-entrance">
      <div class="terminal-chrome">
        <div class="terminal-header flex items-center gap-2 px-4 py-2.5">
          <span class="terminal-dot bg-[#ff5f57]"></span>
          <span class="terminal-dot bg-[#febc2e]"></span>
          <span class="terminal-dot bg-[#28c840]"></span>
          <span class="text-muted text-[11px] ml-2 font-mono">{t('safety.verifyTerminalLabel')}</span>
        </div>
        <div class="px-4 sm:px-6 py-4 sm:py-5">
          <pre class="text-[11px] sm:text-[13px] font-mono leading-[1.8] text-text whitespace-pre"><span class="text-muted/60">ctx_read</span> <span class="text-text-bright">src/auth.rs</span>

<span class="text-accent font-bold">✓ VERIFY PASS</span>
  <span class="text-muted/40">├─ Paths checked:       12/12 preserved</span>
  <span class="text-muted/40">├─ Identifiers:         8/8 preserved</span>
  <span class="text-muted/40">├─ Structure:           balanced</span>
  <span class="text-muted/40">└─ Info loss score:     0.0%</span></pre>
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-3 animate-entrance stagger-3" style="gap: clamp(1rem, 0.75rem + 0.75vw, 1.5rem); margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);">
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.verifyPathsTitle')}</h3>
        <p class="fluid-sm text-muted">{t('safety.verifyPathsDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.verifyIdsTitle')}</h3>
        <p class="fluid-sm text-muted">{t('safety.verifyIdsDesc')}</p>
      </div>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="fluid-h3 font-semibold font-display text-text-bright mb-2">{t('safety.verifyStructTitle')}</h3>
        <p class="fluid-sm text-muted">{t('safety.verifyStructDesc')}</p>
      </div>
    </div>

    <div class="animate-entrance stagger-4" style="margin-top: clamp(2rem, 1.5rem + 1vw, 3rem);">
      <a href={lp('/docs/verification')} class="fluid-sm text-accent hover:underline inline-flex items-center gap-1.5 font-medium">
        {t('safety.verifyLink')}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>


<div class="section-divider content-grid"></div>


<!-- ═══════ CTA ═══════ -->
<section class="section-y">
  <div class="content-grid">
    <p class="fluid-label text-muted animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.ctaLabel')}
    </p>
    <h2 class="font-display fluid-h2 font-bold text-text-bright animate-entrance stagger-1" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
      {t('safety.ctaTitle')} <span class="gradient-text">{t('safety.ctaTitleHighlight')}</span>
    </h2>
    <p class="text-muted fluid-body animate-entrance stagger-2" style="margin-bottom: clamp(2.5rem, 2rem + 2vw, 5rem); max-width: 44rem;">
      {t('safety.ctaDesc')}
    </p>
    <div class="flex flex-wrap items-center animate-entrance stagger-3" style="gap: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);">
      <a href={lp('/docs/getting-started')} class="btn-primary inline-flex items-center font-bold rounded-lg text-bg" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        {t('safety.ctaGetStarted')}
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href={lp('/compare')} class="btn-outline inline-flex items-center font-medium rounded-lg text-text" style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);">
        {t('safety.ctaCompare')}
      </a>
    </div>
  </div>
</section>


<style>
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); border-radius: clamp(10px, 0.8vw, 14px); overflow: hidden; }
  .stat-item { display: flex; flex-direction: column; padding: clamp(1.25rem, 1rem + 1vw, 2rem); background: var(--color-bg); }
  .stat-number { font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1; margin-bottom: 0.625rem; }
  .stat-desc { font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem); color: var(--color-muted); line-height: 1.5; }
  @media (max-width: 640px) { .stats-grid { grid-template-columns: 1fr; } }
  .compare-card { border: 1px solid var(--color-border); border-radius: clamp(10px, 0.8vw, 14px); overflow: hidden; }
  .compare-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; font-size: clamp(0.6875rem, 0.65rem + 0.1vw, 0.8125rem); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1px solid var(--color-border); }
  .compare-header--good { background: rgba(52, 211, 153, 0.04); color: var(--color-accent); }
  .compare-body { padding: 1.25rem; background: var(--color-surface); }
</style>

</BaseLayout>
