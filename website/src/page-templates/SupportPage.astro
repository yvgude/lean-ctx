<script is:inline>
  (function () {
    var card = document.querySelector('.sup-card');
    if (!card) return;

    // Amount ($5/$10/$25) + cadence (monthly/yearly) selector. Each combination
    // maps to a distinct Stripe Payment Link (carried on the tier buttons as
    // data-link-*), so becoming a supporter goes straight to Stripe — no lean-ctx
    // account required. The server-rendered default (featured tier, monthly) is a
    // fully valid no-JS state; this only enhances switching.
    var cadenceBtns = card.querySelectorAll('[data-cadence-btn]');
    var tierBtns = card.querySelectorAll('[data-tier]');
    var priceEl = card.querySelector('[data-price]');
    var unitEl = card.querySelector('[data-unit]');
    var cta = card.querySelector('[data-cta]');
    var ctaAmt = card.querySelector('[data-cta-amt]');
    var ctaUnit = card.querySelector('[data-cta-unit]');
    var state = {
      cadence: 'monthly',
      tier: card.querySelector('[data-tier][aria-pressed="true"]') || tierBtns[0],
    };

    function render() {
      var c = state.cadence;
      var t = state.tier;
      if (!t) return;
      var amt = t.getAttribute('data-amt-' + c);
      var link = t.getAttribute('data-link-' + c);
      tierBtns.forEach(function (b) {
        var label = b.querySelector('[data-tier-amt]');
        if (label) label.textContent = b.getAttribute('data-amt-' + c);
        b.setAttribute('aria-pressed', b === t ? 'true' : 'false');
      });
      cadenceBtns.forEach(function (b) {
        var on = b.getAttribute('data-cadence-btn') === c;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (priceEl && amt) priceEl.textContent = amt;
      if (unitEl) unitEl.textContent = c === 'yearly' ? '/year' : '/month';
      if (ctaAmt && amt) ctaAmt.textContent = amt;
      if (ctaUnit) ctaUnit.textContent = c === 'yearly' ? '/yr' : '/mo';
      if (cta && link) cta.setAttribute('href', link);
      card.setAttribute('data-cadence', c);
    }

    cadenceBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        state.cadence = b.getAttribute('data-cadence-btn');
        render();
      });
    });
    tierBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        state.tier = b;
        render();
      });
    });
    render();

    // Friendly banner when Stripe redirects back after checkout.
    var banner = document.querySelector('[data-banner]');
    function showBanner(kind, msg) {
      if (!banner) return;
      banner.textContent = msg;
      banner.setAttribute('data-kind', kind);
      banner.hidden = false;
    }
    var status = new URLSearchParams(window.location.search).get('status');
    if (status === 'success') showBanner('success', 'Thank you for supporting lean-ctx — your subscription is active. You are the reason this project keeps going.');
    else if (status === 'cancelled' || status === 'canceled') showBanner('info', 'Checkout cancelled — no charge was made.');
  })();
</script>

<script is:inline>
  (function () {
    // Live supporters wall — fetched client-side from the public API so it stays
    // current without a rebuild. All supporter-provided text is inserted via
    // textContent (never innerHTML), so names/messages can't inject markup.
    var section = document.getElementById('supporters');
    if (!section) return;
    var stateEl = section.querySelector('[data-wall-state]');
    var grid = section.querySelector('[data-wall-grid]');
    var countEl = section.querySelector('[data-wall-count]');

    function el(tag, cls, text) {
      var node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text != null) node.textContent = text;
      return node;
    }

    function showEmpty() {
      stateEl.textContent = '';
      stateEl.appendChild(el('p', null, 'No supporters yet — be the first to keep lean-ctx independent.'));
      var cta = el('a', 'sup-wall-cta', 'Become a supporter →');
      cta.href = '#';
      cta.addEventListener('click', function (e) {
        e.preventDefault();
        var pledge = document.querySelector('.sup-card');
        if (pledge) pledge.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      stateEl.appendChild(cta);
    }

    fetch('https://api.leanctx.com/api/supporters', { headers: { accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('bad status')); })
      .then(function (data) {
        var list = (data && data.supporters) || [];
        if (!list.length) { showEmpty(); return; }

        list.forEach(function (s) {
          var card = el('li', 'sup-wall-card');
          var top = el('div', 'sup-wall-card-top');
          top.appendChild(el('span', 'sup-wall-name', s.name || 'Anonymous'));
          if (s.tier) {
            var badge = el('span', 'sup-wall-badge', s.tier);
            badge.setAttribute('data-tier', s.tier);
            top.appendChild(badge);
          }
          card.appendChild(top);
          if (s.message) card.appendChild(el('p', 'sup-wall-msg', s.message));
          grid.appendChild(card);
        });

        stateEl.hidden = true;
        grid.hidden = false;

        if (countEl && typeof data.count === 'number' && data.count > 0) {
          countEl.textContent =
            data.count === 1 ? '1 supporter and counting' : data.count + ' supporters and counting';
          countEl.hidden = false;
        }
      })
      .catch(function () {
        // Never show a broken wall: if the API is unreachable, drop the section
        // entirely rather than leaving a permanent "loading" state.
        section.remove();
      });
  })();
</script>
