---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { supporterOffer, supporterTiers } from '../lib/pricing';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const lp = (path: string) => getLocalizedPath(path, locale);

// The amount pre-selected on load (and the no-JS fallback): the suggested tier,
// billed monthly. Everything else is switched client-side by the card script.
const defaultTier = supporterTiers.find((t) => t.featured) ?? supporterTiers[0];
const defaultAmount = defaultTier.amount;

// Fast presets for the amount picker. Supporters can also drag the slider or type
// any amount; these chips just jump to common values. The ones backed by a fixed
// Stripe Payment Link double as an offline fallback if the checkout API is down.
const quickPicks: Array<{ amount: number; label: string; link: string | null }> = [
  ...supporterTiers.map((t) => ({ amount: t.amount, label: t.monthly, link: t.links.monthly })),
  { amount: 50, label: '$50', link: null },
];

// Wall recognition badge for an amount — mirrors the billing service's tiers
// (≥$25 Sponsor · ≥$10 Backer · else Supporter) so the live preview matches what
// the supporter will actually be shown as on the wall.
const tierForAmount = (a: number) => (a >= 25 ? 'Sponsor' : a >= 10 ? 'Backer' : 'Supporter');
const defaultBadge = tierForAmount(defaultAmount);

const heartPath =
  'M12 21s-7.55-4.74-10.05-9.36C.4 9.07 1.62 5.4 5.07 4.55c2.04-.5 3.94.42 5.03 1.94l1.9 2.64 1.9-2.64c1.09-1.52 2.99-2.44 5.03-1.94 3.45.85 4.67 4.52 3.12 7.09C19.55 16.26 12 21 12 21z';

const checkIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

const arrowIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>';

const lockIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';

const fundsItems = [
  {
    title: 'Ship faster',
    text: 'New read modes, more languages and MCP tools land sooner.',
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
  },
  {
    title: 'Stay secure',
    text: 'Ongoing maintenance, dependency upkeep and security hardening.',
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-4z"/><polyline points="9 12 11 14 15 10"/></svg>',
  },
  {
    title: 'Stay independent',
    text: 'No VC, no ads, no selling your data. The roadmap stays yours.',
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
  },
];

const freeForever = [
  'The entire local engine — reads, search, AST parsing & shell compression',
  'All MCP tools, every read mode and Context Personas',
  'Runs fully offline — your code never leaves your machine',
  'Apache-2.0 — fork it, audit it, self-host it, keep it',
];

const otherWays = [
  {
    title: 'Star on GitHub',
    text: 'The fastest free way to help — it boosts visibility for everyone.',
    cta: 'Give a star',
    href: 'https://github.com/yvgude/lean-ctx',
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
  },
  {
    title: 'Sponsor on GitHub',
    text: 'Prefer GitHub Sponsors? Back the project right where the code lives.',
    cta: 'Open Sponsors',
    href: 'https://github.com/sponsors/yvgude',
    svg: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="${heartPath}"/></svg>`,
  },
  {
    title: 'Buy a coffee',
    text: 'A simple one-off thank-you — no account, no subscription needed.',
    cta: 'Buy a coffee',
    href: 'https://buymeacoffee.com/yvgude',
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>',
  },
  {
    title: 'Spread the word',
    text: 'Tell a teammate or post about lean-ctx — reach beats budget.',
    cta: 'Share on X',
    href:
      'https://twitter.com/intent/tweet?text=' +
      encodeURIComponent('lean-ctx — an open-source Context OS that cuts LLM context cost dramatically. Free & Apache-2.0:') +
      '&url=' +
      encodeURIComponent('https://leanctx.com'),
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>',
  },
];

const faq = [
  {
    q: 'Does supporting unlock any features?',
    a: 'No — and that is the point. Every local feature is free forever under Apache-2.0. Supporting is purely voluntary: it funds development and keeps the project independent.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. Manage or cancel in one click from the Stripe billing portal. Your support stays active until the end of the current period — no questions asked.',
  },
  {
    q: 'I already pay for a Team plan — should I also support?',
    a: 'No need. The Team plan already funds the project. Supporter is for solo developers who rely on the free local tool every day and want to chip in.',
  },
];
---

<BaseLayout
  title="Support lean-ctx — Become a Supporter"
  description="lean-ctx is free and open source forever. Become a Supporter to fund its development — a voluntary subscription that unlocks no features, just our gratitude and a supporter badge."
  breadcrumbs={[
    { name: 'Home', url: lp('/') },
    { name: 'Support', url: lp('/support/') },
  ]}
>
  {/* ── Hero + pledge (landing-style split) ─────────────────── */}
  <section class="section-hero hero-split sup-hero">
    <div class="content-grid">
      <div class="split sup-hero-split">
        {/* Left — the pitch */}
        <div class="hero-copy">
          <div class="animate-entrance" style="margin-bottom: clamp(1rem, 0.75rem + 0.5vw, 1.5rem);">
            <span class="kicker-pill text-accent">Support</span>
          </div>
          <h1 class="font-display fluid-display text-text-bright animate-entrance stagger-1">
            Keep lean-ctx free,<br /><span class="italic-accent">open &amp; independent.</span>
          </h1>
          <p class="fluid-body text-muted animate-entrance stagger-2" style="margin-top: clamp(1.25rem, 1rem + 1vw, 2rem); max-width: 40rem;">
            Every local feature is <strong class="text-text-bright">free forever</strong> — and always
            will be. If lean-ctx saves you time every day, you can fund its development with a small
            recurring subscription. It unlocks nothing — it simply keeps the project alive and independent.
          </p>
          <ul class="sup-hero-trust animate-entrance stagger-3">
            <li><span class="sup-check" set:html={checkIcon} />Apache-2.0, forever</li>
            <li><span class="sup-check" set:html={checkIcon} />No VC, no ads</li>
            <li><span class="sup-check" set:html={checkIcon} />No telemetry, ever</li>
          </ul>
        </div>

        {/* Right — the pledge card */}
        <div class="hero-visual animate-entrance stagger-2">
          <div class="sup-banner" data-banner role="status" hidden></div>
          <div class="sup-card-wrap">
            <div class="sup-card-aura" aria-hidden="true"></div>
            <div class="sup-card">
              <div class="sup-head">
                <div class="sup-head-main">
                  <span class="sup-medallion" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d={heartPath}></path></svg>
                  </span>
                  <div>
                    <span class="sup-eyebrow">{supporterOffer.name}</span>
                    <p class="sup-tagline">{supporterOffer.tagline}</p>
                  </div>
                </div>
                <span class="sup-headflag"><span class="sup-dot" aria-hidden="true"></span>Cancel anytime</span>
              </div>

              <div class="sup-price">
                <span class="sup-amount" data-price>${defaultAmount}</span>
                <span class="sup-unit">/month</span>
                <span class="sup-tierbadge" data-tier-badge title="How you'll be recognised on the supporters wall">{defaultBadge}</span>
              </div>
              <p class="sup-note">{supporterOffer.priceNote}</p>

              <div class="sup-picker">
                <input
                  class="sup-slider"
                  type="range"
                  min="1"
                  max="100"
                  step="1"
                  value={defaultAmount}
                  data-slider
                  aria-label="Monthly support amount in US dollars"
                  style={`--sup-fill:${((defaultAmount - 1) / 99) * 100}%`}
                />
                <div class="sup-quick" role="group" aria-label="Quick amounts">
                  {quickPicks.map((q) => (
                    <button
                      type="button"
                      class="sup-chip"
                      data-quick={q.amount}
                      data-link={q.link}
                      aria-pressed={q.amount === defaultAmount ? 'true' : 'false'}
                    >
                      {q.label}
                    </button>
                  ))}
                  <label class="sup-chip sup-chip--custom">
                    <span class="sup-cur">$</span>
                    <input
                      class="sup-custom"
                      type="number"
                      min="1"
                      max="1000"
                      step="1"
                      inputmode="numeric"
                      data-custom
                      placeholder="Other"
                      aria-label="Custom monthly amount in US dollars"
                    />
                  </label>
                </div>
              </div>

              <a class="sup-cta btn-primary" data-cta href={defaultTier.links.monthly}>
                Become a supporter — <span data-cta-amt>${defaultAmount}</span>/mo
              </a>
              <p class="sup-secure">
                <span class="sup-secure-ic" set:html={lockIcon} />No account needed — secure checkout by Stripe
              </p>

              <ul class="sup-perks">
                {supporterOffer.perks.map((perk) => (
                  <li><span class="sup-check" set:html={checkIcon} />{perk}</li>
                ))}
              </ul>

              <p class="sup-fineprint">
                lean-ctx is Apache-2.0 and <strong>100% free for every local feature, forever</strong> —
                supporting is voluntary and unlocks no functionality. No sign-up required: Stripe handles
                checkout and lets you cancel anytime. Need a shared team workspace instead?
                <a href={lp('/pricing/')}>See the Team plan →</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  {/* ── Where your support goes ────────────────────────────── */}
  <section class="relative section-y">
    <div class="content-grid">
      <SectionHeading
        label="Your impact"
        title="Where your support"
        highlight="goes"
        description="Every subscription flows straight into the work — not marketing, not middlemen."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />
      <div class="sup-funds-grid">
        {fundsItems.map((f, i) => (
          <article class={`sup-fund animate-entrance stagger-${i + 1}`}>
            <span class="sup-fund-ic" aria-hidden="true" set:html={f.svg} />
            <h3 class="sup-fund-title">{f.title}</h3>
            <p class="sup-fund-text">{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  {/* ── Supporters wall ────────────────────────────────────── */}
  <section class="relative section-y" id="supporters">
    <div class="content-grid">
      <SectionHeading
        label="The wall"
        title="People who keep it"
        highlight="independent"
        description="Every name below chose to fund lean-ctx — many left a note. Add yours right at checkout."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />
      <p class="sup-wall-count" data-wall-count hidden></p>
      <div class="sup-wall" data-wall>
        <div class="sup-wall-state" data-wall-state>Loading supporters…</div>
        <ul class="sup-wall-grid" data-wall-grid hidden></ul>
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  {/* ── What stays free (local-free promise) ───────────────── */}
  <section class="relative section-y">
    <div class="content-grid">
      <SectionHeading
        label="Local-Free promise"
        title="What stays free,"
        highlight="forever"
        description="Supporting changes nothing about what runs on your machine. The paid plane lives entirely server-side."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />
      <div class="sup-free animate-entrance">
        <ul class="sup-free-list">
          {freeForever.map((item) => (
            <li><span class="sup-check" set:html={checkIcon} />{item}</li>
          ))}
        </ul>
        <a class="sup-free-link" href={lp('/context-os/')}>
          See how the planes separate <span class="sup-free-arrow" set:html={arrowIcon} />
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  {/* ── Other ways to support ──────────────────────────────── */}
  <section class="relative section-y">
    <div class="content-grid">
      <SectionHeading
        label="No budget? No problem"
        title="Other ways to"
        highlight="support"
        description="A subscription is the deepest help — but it is far from the only one."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />
      <div class="sup-ways-grid">
        {otherWays.map((w, i) => (
          <a class={`sup-way animate-entrance stagger-${(i % 4) + 1}`} href={w.href} target="_blank" rel="noopener">
            <span class="sup-way-ic" aria-hidden="true" set:html={w.svg} />
            <h3 class="sup-way-title">{w.title}</h3>
            <p class="sup-way-text">{w.text}</p>
            <span class="sup-way-cta">{w.cta} <span class="sup-way-arrow" set:html={arrowIcon} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  {/* ── FAQ ────────────────────────────────────────────────── */}
  <section class="relative section-y sup-faq-section">
    <div class="content-grid">
      <SectionHeading
        label="FAQ"
        title="Questions,"
        highlight="answered"
        description="Everything you might want to know before backing the project."
        variant="full"
        breakHighlight={false}
        descMaxWidth="48rem"
        titleMb="clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem)"
        descMb="clamp(2rem, 1.5rem + 1.5vw, 3rem)"
      />
      <div class="sup-faq animate-entrance">
        {faq.map((item) => (
          <details class="sup-faq-item">
            <summary>
              <span>{item.q}</span>
              <svg class="sup-faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p class="sup-closing animate-entrance">
        Built and maintained by one developer, for developers.
        <strong> Thank you for keeping it independent.</strong>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero (landing-style split) ───────────────────────── */
  .sup-hero { padding-bottom: clamp(2rem, 1.25rem + 2vw, 3.5rem); }
  .sup-hero-split { align-items: center; }
  .sup-hero .hero-visual { width: 100%; min-width: 0; }
  .sup-hero-trust {
    margin-top: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
  }
  .sup-hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-small);
    color: var(--color-text);
  }

  /* ── Banner ───────────────────────────────────────────── */
  .sup-banner {
    margin-bottom: 1.5rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--card-radius);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    border: 1px solid transparent;
  }
  .sup-banner[data-kind='success'] {
    color: var(--color-accent-bright);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  .sup-banner[data-kind='error'] {
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-danger) 35%, transparent);
  }
  .sup-banner[data-kind='info'] {
    color: var(--color-text);
    background: var(--color-surface-2);
    border-color: var(--color-border);
  }

  /* ── Pledge card ──────────────────────────────────────── */
  .sup-card-wrap { position: relative; }
  .sup-card-aura {
    position: absolute;
    inset: -28% -8% -16%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(58% 58% at 50% 0%, color-mix(in srgb, var(--color-accent) 24%, transparent), transparent 72%);
    filter: blur(44px);
    opacity: 0.85;
  }
  .sup-card {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    border-radius: var(--card-radius-lg);
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 6%, var(--color-surface)), var(--color-surface));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-accent) 22%, transparent),
      0 24px 60px -34px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .sup-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .sup-head-main { display: flex; align-items: center; gap: 0.9rem; }
  .sup-medallion {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: #0a0a0f;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
    box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--color-accent) 60%, transparent);
  }
  .sup-medallion svg {
    width: 1.5rem;
    height: 1.5rem;
    transform-origin: center;
    animation: sup-beat 2.4s ease-in-out infinite;
  }
  @keyframes sup-beat {
    0%, 60%, 100% { transform: scale(1); }
    20% { transform: scale(1.18); }
    40% { transform: scale(1.06); }
  }
  .sup-eyebrow {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .sup-tagline {
    margin-top: 0.35rem;
    font-size: var(--text-body);
    color: var(--color-text-bright);
    font-weight: var(--weight-medium);
  }

  .sup-price {
    margin-top: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .sup-amount {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3rem);
    font-weight: var(--weight-bold);
    color: var(--color-text-bright);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }
  .sup-unit { font-size: var(--text-small); color: var(--color-muted); }
  .sup-note { margin-top: 0.5rem; font-size: var(--text-caption); color: var(--color-muted); }

  /* Head status pill — balances the heart eyebrow, echoes the hero terminal. */
  .sup-headflag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: var(--text-caption);
    color: var(--color-muted);
    white-space: nowrap;
  }
  .sup-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  /* Live recognition badge shown beside the chosen amount. */
  .sup-tierbadge {
    margin-left: auto;
    align-self: center;
    display: inline-flex;
    align-items: center;
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  /* ── Amount picker: slider + quick chips + free amount ──── */
  .sup-picker {
    margin-top: clamp(1rem, 0.75rem + 0.75vw, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .sup-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      to right,
      var(--color-accent) var(--sup-fill, 10%),
      var(--color-surface-3, var(--color-border)) var(--sup-fill, 10%)
    );
