    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }
  .sup-free-arrow { display: inline-flex; transition: transform var(--dur) var(--ease-out); }
  .sup-free-arrow :global(svg) { width: 1rem; height: 1rem; }
  .sup-free-link:hover .sup-free-arrow { transform: translateX(3px); }

  /* ── Other ways ───────────────────────────────────────── */
  .sup-ways-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }
  @media (min-width: 560px) {
    .sup-ways-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 940px) {
    .sup-ways-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .sup-way {
    display: flex;
    flex-direction: column;
    padding: clamp(1.1rem, 0.9rem + 0.6vw, 1.4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .sup-way:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -28px color-mix(in srgb, var(--color-accent) 50%, transparent);
  }
  .sup-way-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--card-radius);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .sup-way-ic :global(svg) { width: 1.2rem; height: 1.2rem; }
  .sup-way-title {
    margin-top: 0.8rem;
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    color: var(--color-text-bright);
  }
  .sup-way-text {
    margin-top: 0.3rem;
    font-size: var(--text-caption);
    line-height: var(--leading-snug);
    color: var(--color-muted);
    flex: 1;
  }
  .sup-way-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.9rem;
    color: var(--color-accent);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }
  .sup-way-arrow { display: inline-flex; transition: transform var(--dur) var(--ease-out); }
  .sup-way-arrow :global(svg) { width: 0.95rem; height: 0.95rem; }
  .sup-way:hover .sup-way-arrow { transform: translateX(3px); }

  /* ── FAQ ──────────────────────────────────────────────── */
  .sup-faq-title { text-align: center; margin-bottom: clamp(1.25rem, 1rem + 1vw, 2rem); }
  .sup-faq {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 44rem;
    margin: 0 auto;
  }
  .sup-faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    background: var(--color-surface);
    overflow: hidden;
  }
  .sup-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.15rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    color: var(--color-text-bright);
  }
  .sup-faq-item summary::-webkit-details-marker { display: none; }
  .sup-faq-chevron {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-muted);
    transition: transform var(--dur) var(--ease-out);
  }
  .sup-faq-item[open] .sup-faq-chevron { transform: rotate(180deg); }
  .sup-faq-item p {
    padding: 0 1.15rem 1.1rem;
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
