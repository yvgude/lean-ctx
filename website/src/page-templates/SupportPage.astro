<script is:inline>
  (function () {
    var card = document.querySelector('.sup-card');
    if (!card) return;

    // Amount picker — a slider, quick-pick chips and a typed value all set one
    // chosen monthly amount. The CTA creates a custom-amount Stripe Checkout
    // Session via the public API and redirects to it; supporting is a flat monthly
    // donation (no discounts). If the API is ever unreachable it falls back to a
    // fixed preset Payment Link, and the server-rendered <a> already works with no
    // JS at all.
    var API_BASE = 'https://api.leanctx.com';
    var MIN = 1;
    var MAX = 1000;
    var slider = card.querySelector('[data-slider]');
    var custom = card.querySelector('[data-custom]');
    var chips = card.querySelectorAll('[data-quick]');
    var priceEl = card.querySelector('[data-price]');
    var badgeEl = card.querySelector('[data-tier-badge]');
    var cta = card.querySelector('[data-cta]');
    var ctaInner = cta ? cta.innerHTML : '';

    // Preset amount → its fixed Payment Link, used only as an offline fallback.
    var presetLinks = {};
    chips.forEach(function (c) {
      var link = c.getAttribute('data-link');
      if (link) presetLinks[c.getAttribute('data-quick')] = link;
    });

    var amount = parseInt(slider && slider.value, 10) || 10;

    function tierFor(a) {
      return a >= 25 ? 'Sponsor' : a >= 10 ? 'Backer' : 'Supporter';
    }

    function render(opts) {
      opts = opts || {};
      if (priceEl) priceEl.textContent = '$' + amount;
      if (badgeEl) badgeEl.textContent = tierFor(amount);
      var ctaAmt = cta && cta.querySelector('[data-cta-amt]');
      if (ctaAmt) ctaAmt.textContent = '$' + amount;
      var capped = Math.min(100, Math.max(1, amount));
      if (slider && !opts.fromSlider) slider.value = String(capped);
      if (slider) slider.style.setProperty('--sup-fill', ((capped - 1) / 99) * 100 + '%');
      if (custom && !opts.fromCustom) custom.value = '';
      chips.forEach(function (c) {
        c.setAttribute(
          'aria-pressed',
          parseInt(c.getAttribute('data-quick'), 10) === amount ? 'true' : 'false'
        );
      });
    }

    function setAmount(a, opts) {
      a = Math.round(a);
      if (isNaN(a)) return;
      amount = Math.min(MAX, Math.max(MIN, a));
      render(opts);
    }

    if (slider)
      slider.addEventListener('input', function () {
        setAmount(parseInt(slider.value, 10), { fromSlider: true });
      });
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        setAmount(parseInt(c.getAttribute('data-quick'), 10));
      });
    });
    if (custom)
      custom.addEventListener('input', function () {
        var v = parseInt(custom.value, 10);
        if (!isNaN(v)) setAmount(v, { fromCustom: true });
      });

    function fallback() {
      var link = presetLinks[String(amount)];
      if (link) {
        window.location.href = link;
        return true;
      }
      return false;
    }

    if (cta)
      cta.addEventListener('click', function (e) {
        e.preventDefault();
        if (cta.getAttribute('aria-busy') === 'true') return;
        cta.setAttribute('aria-busy', 'true');
        cta.textContent = 'Starting secure checkout…';
        fetch(API_BASE + '/api/supporters/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount_cents: amount * 100 }),
        })
          .then(function (r) {
            return r.ok ? r.json() : Promise.reject(r.status);
          })
          .then(function (d) {
            if (d && d.url) {
              window.location.href = d.url;
              return;
            }
            throw new Error('no url');
          })
          .catch(function () {
            // API down: use the exact preset link if the amount matches one,
            // else restore the button so the supporter can retry.
            if (fallback()) return;
            cta.removeAttribute('aria-busy');
            cta.innerHTML = ctaInner;
            render();
          });
      });

    render();

    // Friendly banner when Stripe redirects back after checkout.
    var banner = document.querySelector('[data-banner]');
    function showBanner(kind, msg) {
      if (!banner) return;
      banner.textContent = msg;
      banner.setAttribute('data-kind', kind);
      banner.hidden = false;
    }
    var status = new URLSearchParams(window.location.search).get('status');
    if (status === 'success') showBanner('success', 'Thank you for supporting lean-ctx — your subscription is active. You are the reason this project keeps going.');
    else if (status === 'cancelled' || status === 'canceled') showBanner('info', 'Checkout cancelled — no charge was made.');
  })();
</script>

<script is:inline>
  (function () {
    // Live supporters wall — fetched client-side from the public API so it stays
    // current without a rebuild. All supporter-provided text is inserted via
    // textContent (never innerHTML), so names/messages can't inject markup.
    var section = document.getElementById('supporters');
    if (!section) return;
    var stateEl = section.querySelector('[data-wall-state]');
    var grid = section.querySelector('[data-wall-grid]');
    var countEl = section.querySelector('[data-wall-count]');

    function el(tag, cls, text) {
      var node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text != null) node.textContent = text;
      return node;
    }

    function showEmpty() {
      stateEl.textContent = '';
      stateEl.appendChild(el('p', null, 'No supporters yet — be the first to keep lean-ctx independent.'));
      var cta = el('a', 'sup-wall-cta', 'Become a supporter →');
      cta.href = '#';
      cta.addEventListener('click', function (e) {
        e.preventDefault();
        var pledge = document.querySelector('.sup-card');
        if (pledge) pledge.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      stateEl.appendChild(cta);
    }

    fetch('https://api.leanctx.com/api/supporters', { headers: { accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('bad status')); })
      .then(function (data) {
        var list = (data && data.supporters) || [];
        if (!list.length) { showEmpty(); return; }

        list.forEach(function (s) {
          var card = el('li', 'sup-wall-card');
          var top = el('div', 'sup-wall-card-top');
          top.appendChild(el('span', 'sup-wall-name', s.name || 'Anonymous'));
          if (s.tier) {
            var badge = el('span', 'sup-wall-badge', s.tier);
            badge.setAttribute('data-tier', s.tier);
            top.appendChild(badge);
          }
          card.appendChild(top);
          if (s.message) card.appendChild(el('p', 'sup-wall-msg', s.message));
          grid.appendChild(card);
        });

        stateEl.hidden = true;
        grid.hidden = false;

        if (countEl && typeof data.count === 'number' && data.count > 0) {
          countEl.textContent =
            data.count === 1 ? '1 supporter and counting' : data.count + ' supporters and counting';
          countEl.hidden = false;
        }
      })
      .catch(function () {
        // Never show a broken wall: if the API is unreachable, drop the section
        // entirely rather than leaving a permanent "loading" state.
        section.remove();
      });
  })();
</script>
