---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProofArtifacts from "../components/ProofArtifacts.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout
  title={`${t("trust.title")} - LeanCTX`}
  description={t("trust.metaDescription")}
  breadcrumbs={[{ name: t("common.home"), url: lp("/") }, { name: t("trust.title"), url: lp("/trust/") }]}
>
  <PageHero
    label={t("trust.heroLabel")}
    title={t("trust.heroTitle")}
    highlight={t("trust.heroTitleHighlight")}
    description={t("trust.heroSubtitle")}
    highlightStyle="italic"
    titleMaxWidth="60rem"
    descMaxWidth="54rem"
  >
    <Fragment slot="actions">
      <a
        href={lp("/docs/verification")}
        class="btn-primary inline-flex items-center gap-2 font-bold rounded-lg text-bg"
        style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
      >
        {t("trust.ctaVerification")}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href={lp("/safety")}
        class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text"
        style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
      >
        {t("trust.ctaSafety")}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href={lp("/docs/replayability")}
        class="btn-outline inline-flex items-center gap-2 font-medium rounded-lg text-text"
        style="padding: clamp(0.7rem, 0.55rem + 0.3vw, 0.9rem) clamp(1.5rem, 1rem + 0.75vw, 2.25rem); font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);"
      >
        {t("trust.ctaReplayability")}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </Fragment>
  </PageHero>

  <div class="section-divider content-grid"></div>

  <section class="section-y">
    <div class="content-grid">
      <SectionHeading
        label={t("trust.principlesLabel")}
        title={t("trust.principlesTitle")}
        highlight={t("trust.principlesTitleHighlight")}
        description={t("trust.principlesDesc")}
        variant="full"
        breakHighlight={false}
        descMaxWidth="56rem"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-4 animate-entrance stagger-3" style="gap: 1rem;">
        {[
          { title: t("trust.p1Title"), desc: t("trust.p1Desc") },
          { title: t("trust.p2Title"), desc: t("trust.p2Desc") },
          { title: t("trust.p3Title"), desc: t("trust.p3Desc") },
          { title: t("trust.p4Title"), desc: t("trust.p4Desc") },
        ].map((x) => (
          <div class="card" style="padding: 1.25rem;">
            <h3 class="font-display fluid-h3 font-semibold text-text-bright mb-2">{x.title}</h3>
            <p class="fluid-sm text-muted leading-relaxed" style="margin: 0;">{x.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <section class="section-y">
    <div class="content-grid">
      <SectionHeading
        label={t("trust.scopeLabel")}
        title={t("trust.scopeTitle")}
        description={t("trust.scopeDesc")}
        variant="full"
        descMaxWidth="56rem"
        descMb="2.5rem"
      />

      <div class="grid lg:grid-cols-2 animate-entrance stagger-3" style="gap: 1rem;">
        <div class="card" style="padding: 1.5rem;">
          <h3 class="font-display fluid-h3 font-semibold text-text-bright mb-3">{t("trust.doesTitle")}</h3>
          <ul class="list-disc pl-5 text-muted fluid-sm leading-relaxed" style="margin: 0;">
            <li>{t("trust.does1")}</li>
            <li>{t("trust.does2")}</li>
            <li>{t("trust.does3")}</li>
            <li>{t("trust.does4")}</li>
          </ul>
        </div>
        <div class="card" style="padding: 1.5rem;">
          <h3 class="font-display fluid-h3 font-semibold text-text-bright mb-3">{t("trust.doesNotTitle")}</h3>
          <ul class="list-disc pl-5 text-muted fluid-sm leading-relaxed" style="margin: 0;">
            <li>{t("trust.doesNot1")}</li>
            <li>{t("trust.doesNot2")}</li>
            <li>{t("trust.doesNot3")}</li>
            <li>{t("trust.doesNot4")}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <section class="section-y">
    <div class="content-grid">
      <SectionHeading
        label={t("trust.verifyLabel")}
        title={t("trust.verifyTitle")}
        description={t("trust.verifyDesc")}
        variant="full"
        descMaxWidth="56rem"
        descMb="2rem"
      />
      <div class="grid md:grid-cols-2 animate-entrance stagger-3" style="gap: 1rem;">
        <a href={lp("/docs/replayability")} class="card group" style="padding: 1.5rem;">
          <h3 class="font-display fluid-h3 font-semibold text-text-bright mb-2">{t("trust.verifyCard1Title")}</h3>
          <p class="fluid-sm text-muted leading-relaxed" style="margin: 0 0 1.25rem 0;">{t("trust.verifyCard1Desc")}</p>
          <span class="inline-flex items-center gap-2 text-accent font-medium">
            {t("common.learnMore")}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </span>
        </a>
        <a href={lp("/docs/quick-reference#cookbook")} class="card group" style="padding: 1.5rem;">
          <h3 class="font-display fluid-h3 font-semibold text-text-bright mb-2">{t("trust.verifyCard2Title")}</h3>
          <p class="fluid-sm text-muted leading-relaxed" style="margin: 0 0 1.25rem 0;">{t("trust.verifyCard2Desc")}</p>
          <span class="inline-flex items-center gap-2 text-accent-2 font-medium">
            {t("trust.openCookbook")}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider content-grid"></div>

  <section class="section-y">
    <div class="content-grid">
      <SectionHeading
        label={t("artifacts.label")}
        title={t("artifacts.title")}
        description={t("artifacts.desc")}
        variant="full"
        descMaxWidth="56rem"
        descMb="2.5rem"
      />
      <div class="animate-entrance stagger-3">
        <ProofArtifacts />
      </div>
    </div>
  </section>
</BaseLayout>

