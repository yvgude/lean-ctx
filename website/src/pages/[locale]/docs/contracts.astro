---
import { getLocaleFromUrl, getLocalizedPath } from '../../../i18n/utils';
import { getLocaleStaticPaths } from '../../../i18n/routing.ts';

export const getStaticPaths = getLocaleStaticPaths;

const locale = getLocaleFromUrl(Astro.url);
const lp = (path: string) => getLocalizedPath(path, locale);

return Astro.redirect(lp('/compatibility#contracts'), 301);
