---
import { getLocaleFromUrl, getLocalizedPath, locales } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.map(l => ({ params: { locale: l } }));
}

const locale = getLocaleFromUrl(Astro.url);
const lp = (path: string) => getLocalizedPath(path, locale);

return Astro.redirect(lp('/docs/api-reference#http-mcp'), 301);
