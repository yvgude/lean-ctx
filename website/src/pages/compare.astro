---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMcpManifest } from '../lib/mcpManifest';

const manifest = getMcpManifest();

const features = [
  { name: 'File-read compression (99%)', leanctx: true, rtk: false, contextplus: false, letta: false, manual: false },
  { name: 'Shell compression (60+ patterns)', leanctx: true, rtk: true, contextplus: false, letta: false, manual: false },
  { name: 'Session memory', leanctx: true, rtk: false, contextplus: false, letta: true, manual: false },
  { name: 'Code graph / semantic search', leanctx: true, rtk: false, contextplus: true, letta: false, manual: false },
  { name: `MCP server (${manifest.counts.granular} tools)`, leanctx: true, rtk: false, contextplus: true, letta: true, manual: false },
  { name: 'CLI-first / single binary', leanctx: true, rtk: true, contextplus: false, letta: false, manual: false },
  { name: 'Output verification', leanctx: true, rtk: false, contextplus: false, letta: false, manual: false },
  { name: 'Governance / budgets', leanctx: true, rtk: false, contextplus: false, letta: false, manual: false },
  { name: 'Zero telemetry / 100% local', leanctx: true, rtk: true, contextplus: true, letta: false, manual: true },
  { name: '24+ AI tools supported', leanctx: true, rtk: false, contextplus: false, letta: false, manual: false },
];

const alternatives = [
  {
    name: 'RTK',
    url: 'https://github.com/rtk-ai/rtk',
    tagline: 'Shell Compression Only',
    does: 'Shell output compression for ~100 commands, 60-90% savings, single Rust binary.',
    missing: 'No file-read compression, no MCP integration, no memory, no verification, no read modes, no code graph.',
    verdict: 'RTK covers shell compression. lean-ctx does everything RTK does plus file I/O, intelligence, and memory.',
  },
  {
    name: 'Context+',
    url: 'https://github.com/ForLoopCodes/contextplus',
    tagline: 'Code Intelligence Only',
    does: 'Semantic search, tree-sitter AST, feature graphs, RAG, blast radius analysis.',
    missing: 'No compression, no caching, no shell patterns, no memory persistence, no CLI mode, no governance.',
    verdict: 'Context+ covers code intelligence. lean-ctx has that plus compression and memory in a single binary.',
  },
  {
    name: 'Letta / MemGPT',
    url: 'https://letta.com',
    tagline: 'Memory Framework',
    does: '3-tier memory (Core/Recall/Archival), context repositories, agent orchestration.',
    missing: 'No token compression, no file-read optimization, not CLI-first, not a single binary, cloud-dependent.',
    verdict: 'Letta is a heavy cloud framework for memory. lean-ctx provides memory plus compression, locally.',
  },
  {
    name: 'Manual .cursorrules',
    url: '',
    tagline: 'Static Prompt Engineering',
    does: 'Static instructions injected into every prompt. Some control over agent behavior.',
    missing: 'No dynamic adaptation, no caching, no compression, no memory, no verification, no automation.',
    verdict: '.cursorrules are the manual mode. lean-ctx automates and optimizes everything dynamically.',
  },
];
---

<BaseLayout title="Compare — lean-ctx vs alternatives" description="How lean-ctx compares to RTK, Context+, Letta/MemGPT, and manual prompt engineering.">
  <section class="page-section">
    <div class="content-grid">
      <h1 class="page-title">lean-ctx vs alternatives</h1>
      <p class="page-sub">Other tools solve one piece of the puzzle. lean-ctx solves all of them in a single, local, zero-cost binary.</p>

      <!-- Comparison Table -->
      <div class="table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th class="col-highlight">lean-ctx</th>
              <th>RTK</th>
              <th>Context+</th>
              <th>Letta</th>
              <th>Manual</th>
            </tr>
          </thead>
          <tbody>
            {features.map(f => (
              <tr>
                <td class="feature-name">{f.name}</td>
                <td class="col-highlight">{f.leanctx ? '✓' : '—'}</td>
                <td>{f.rtk ? '✓' : '—'}</td>
                <td>{f.contextplus ? '✓' : '—'}</td>
                <td>{f.letta ? '✓' : '—'}</td>
                <td>{f.manual ? '✓' : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Detailed Comparisons -->
      <h2 class="section-heading">Detailed comparison</h2>

      <div class="alternatives">
        {alternatives.map(alt => (
          <div class="alt-card">
            <div class="alt-header">
              <h3 class="alt-name">
                {alt.url ? <a href={alt.url} target="_blank" rel="noopener">{alt.name}</a> : alt.name}
              </h3>
              <span class="alt-tagline">{alt.tagline}</span>
            </div>
            <div class="alt-body">
              <div class="alt-section">
                <span class="alt-label">What it does:</span>
                <p>{alt.does}</p>
              </div>
              <div class="alt-section">
                <span class="alt-label">What it doesn't:</span>
                <p>{alt.missing}</p>
              </div>
              <div class="alt-verdict">
                <p>{alt.verdict}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Baseline -->
      <div class="baseline-card">
        <h3 class="baseline-title">No context management (baseline)</h3>
        <ul class="baseline-list">
          <li>Every file read = full token cost (30,000+ tokens per file)</li>
          <li>Every shell output unfiltered</li>
          <li>No session memory, no caching</li>
          <li>AI re-reads same files 20x per session</li>
          <li>= 90% token waste, $30-100+/month in unnecessary costs</li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="compare-cta">
        <p class="cta-statement">lean-ctx combines compression + intelligence + memory + verification in one binary. Free, local, zero telemetry.</p>
        <a href="/setup/" class="cta-btn">Install lean-ctx</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section { padding: clamp(3rem, 6vw, 5rem) 0; }
  .page-title { font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem); font-weight: 800; text-align: center; margin-bottom: 0.75rem; color: var(--color-text-bright); }
  .page-sub { text-align: center; color: var(--color-muted); margin-bottom: 3rem; max-width: 36rem; margin-left: auto; margin-right: auto; }
  .section-heading { font-size: 1.5rem; font-weight: 700; text-align: center; margin: 4rem 0 2rem; color: var(--color-text-bright); }

  .table-wrap { overflow-x: auto; margin: 0 auto; max-width: 56rem; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  .compare-table th { padding: 0.625rem 0.75rem; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-muted); border-bottom: 2px solid var(--color-border); text-align: center; }
  .compare-table th:first-child { text-align: left; }
  .compare-table td { padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--color-border); text-align: center; color: var(--color-muted); }
  .compare-table .feature-name { text-align: left; color: var(--color-text-bright); font-weight: 450; }
  .compare-table .col-highlight { background: color-mix(in srgb, var(--color-accent) 6%, transparent); color: var(--color-accent); font-weight: 600; }

  .alternatives { display: flex; flex-direction: column; gap: 1.25rem; max-width: 48rem; margin: 0 auto; }
  .alt-card { border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; }
  .alt-header { padding: 1rem 1.25rem; background: var(--color-surface); display: flex; align-items: baseline; gap: 0.75rem; }
  .alt-name { font-size: 1rem; font-weight: 600; color: var(--color-text-bright); }
  .alt-name a { color: var(--color-accent); text-decoration: none; }
  .alt-name a:hover { text-decoration: underline; }
  .alt-tagline { font-size: 0.75rem; color: var(--color-muted); }
  .alt-body { padding: 1.25rem; }
  .alt-section { margin-bottom: 0.75rem; }
  .alt-label { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); display: block; margin-bottom: 0.25rem; }
  .alt-section p { font-size: 0.8125rem; color: var(--color-text-bright); line-height: 1.5; margin: 0; }
  .alt-verdict { padding-top: 0.75rem; border-top: 1px solid var(--color-border); }
  .alt-verdict p { font-size: 0.8125rem; color: var(--color-accent); font-weight: 500; margin: 0; }

  .baseline-card {
    max-width: 48rem; margin: 2rem auto; padding: 1.5rem;
    border-radius: 12px; border: 1px solid var(--color-border); background: var(--color-surface);
  }
  .baseline-title { font-size: 1rem; font-weight: 600; color: var(--color-text-bright); margin-bottom: 0.75rem; }
  .baseline-list { padding-left: 1.25rem; }
  .baseline-list li { font-size: 0.8125rem; color: var(--color-muted); line-height: 1.6; }

  .compare-cta { text-align: center; margin-top: 3rem; }
  .cta-statement { font-size: 0.9375rem; color: var(--color-muted); margin-bottom: 1.5rem; max-width: 32rem; margin-left: auto; margin-right: auto; }
  .cta-btn {
    display: inline-flex; align-items: center; gap: 0.375rem;
    padding: 0.75rem 1.5rem; font-size: 0.875rem; font-weight: 600;
    border-radius: 12px; background: var(--color-accent); color: var(--color-bg);
    text-decoration: none; transition: opacity 0.2s;
  }
  .cta-btn:hover { opacity: 0.9; }
</style>
